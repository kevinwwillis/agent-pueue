#!/usr/bin/env python3
"""job (agent-pueue): run long jobs under pueue and wait on them correctly.

A thin wrapper around pueue for agents. Pueue owns every process; this tool
never finds a process by name or command line. One call, `job run`, queues a
command on a host and blocks until it ends, then prints the outcome and exits
with the job's own exit code. See docs/usage.md.

Hosts other than `local` are read from ~/.config/agent-pueue/hosts (one
`name [ssh-destination]` per line). The same file is installed on every host
(~/.local/bin/job). For a remote host
the client runs `ssh <host> ~/.local/bin/job _host <op>` with a JSON request on
stdin and reads a JSON reply on stdout; nothing the user typed goes into the
ssh argv.
"""

import argparse
import base64
import ctypes
import datetime as dt
import fcntl
import json
import os
import shlex
import socket
import sqlite3
import subprocess
import sys
import threading
import time
import uuid

VERSION = "0.6.0"
PROTOCOL = 3
# Protocol 4 is sent only by a submit that asks for normal priority. A host that predates the
# option accepts 3 only, so it refuses such a request instead of queueing it at idle priority.
PROTOCOL_PRIORITY = 4
# Protocol 5 (a superset of 4) is sent by a submit that runs the job in its own systemd scope with a memory
# limit (admission, docs/admission.md). A host that predates it refuses such a request instead of running the
# job without its limit.
PROTOCOL_ADMISSION = 5
ACCEPTED_PROTOCOLS = (PROTOCOL, PROTOCOL_PRIORITY, PROTOCOL_ADMISSION)
SCOPE_PREFIX = "agent-pueue-job-"   # systemd scope unit of an admitted job: SCOPE_PREFIX + token + ".scope"


def _load_hosts():
    """host name -> ssh destination (None = run here), from the hosts file."""
    hosts = {"local": None}
    path = HOSTS_FILE
    try:
        with open(path, encoding="utf-8") as f:
            for n, line in enumerate(f, 1):
                parts = line.split("#", 1)[0].split()
                if not parts:
                    continue
                name, dest = parts[0], (parts[1] if len(parts) > 1 else parts[0])
                ok = name != "local" and not name.startswith("-") and len(parts) <= 2 and all(
                    c.isalnum() or c in "._-" for c in name) and not dest.startswith("-")
                if not ok:
                    sys.stderr.write("job: %s line %d ignored: %r\n" % (path, n, line.strip()))
                    continue
                hosts[name] = dest
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:  # unreadable, a directory, not UTF-8
        sys.stderr.write("job: cannot read the hosts file %s (%s); only 'local' is known\n" % (path, e))
    return hosts


HOSTS_FILE = os.environ.get("JOB_HOSTS_FILE") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "agent-pueue", "hosts")
HOSTS = _load_hosts()
LISTED = list(HOSTS)  # what `job ls` lists by default
# On a server, its own name means this machine too (no ssh to itself).
SELF = socket.gethostname().split(".")[0].lower()
for _name in list(HOSTS):
    if _name.split(".")[0].lower() == SELF:
        HOSTS[_name] = None  # a listed name (any case, short or full) for this machine
if SELF not in {n.lower() for n in HOSTS}:
    HOSTS[SELF] = None  # this machine's own name works even when it is not listed

# Wrapper exit codes for outcomes that are not the job's own exit code.
EXIT = {
    "USAGE": 2,
    "FAILED_TO_SPAWN": 127,
    "KILLED": 137,
    "STALLED": 200,
    "ALERT": 201,
    "UNREACHABLE": 202,
    "ERRORED": 203,
    "DEPENDENCY_FAILED": 203,
    "GONE": 204,
    "WRAPPER_ERROR": 205,
}
# Outcomes that end a multi-job wait at once (the agent must look now).
URGENT = ("STALLED", "ALERT", "UNREACHABLE", "GONE", "WRAPPER_ERROR")

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "agent-pueue"
)
CHUNK = 4 * 1024 * 1024        # max log bytes moved per probe
TAIL_BYTES = 64 * 1024         # the log tail is read from at most this many final bytes
TAIL_LINE_MAX = 1000           # longer tail lines are cut
PARTIAL_MAX = 1024 * 1024      # an unterminated line longer than this goes to the check anyway
SCRIPT_KEEP_DAYS = 30
POLL_LOCAL, POLL_REMOTE = 3.0, 20.0
PUEUE_TIMEOUT = 60

# Variables passed from the submitting shell into the job (pueue stores the
# job's environment in its state file, so nothing else is passed; --env adds more).
ENV_ALLOW = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LANGUAGE", "TZ", "TERM", "TMPDIR",
             "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME")


class JobError(Exception):
    """A failure of the wrapper itself (not of the job)."""


class ProtocolError(JobError):
    """Client and host run different versions of job; retrying cannot help."""


# --------------------------------------------------------------------------
# host side: everything here runs on the machine that owns the pueue daemon
# --------------------------------------------------------------------------

def _pueue_base():
    cmd = ["pueue"]
    cfg = os.environ.get("JOB_PUEUE_CONFIG")
    if cfg:
        cmd += ["-c", cfg]
    return cmd


def _with_local_bin(path):
    local_bin = os.path.expanduser("~/.local/bin")
    parts = (path or "/usr/local/bin:/usr/bin:/bin").split(":")
    return path if local_bin in parts else local_bin + ":" + (path or "/usr/local/bin:/usr/bin:/bin")


def _pueue(args, env=None, check=True):
    if env is None:
        env = dict(os.environ, PATH=_with_local_bin(os.environ.get("PATH")))
    try:
        p = subprocess.run(_pueue_base() + args, capture_output=True, encoding="utf-8",
                           errors="replace", env=env, timeout=PUEUE_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise JobError("pueue %s did not answer within %d s" % (" ".join(args[:2]), PUEUE_TIMEOUT))
    except OSError as e:
        raise JobError("cannot run pueue: %s" % e)
    if check and p.returncode != 0:
        raise JobError("pueue %s failed (exit %d): %s" % (
            " ".join(args[:2]), p.returncode, (p.stderr or p.stdout).strip()[-2000:]))
    return p


def _pueue_status():
    p = _pueue(["status", "--json"])
    try:
        return json.loads(p.stdout)
    except ValueError:
        raise JobError("pueue status --json returned no JSON: %r" % p.stdout[:300])


def _pueue_directory():
    """The daemon's data directory (holds task_logs/<id>.log)."""
    cfg = os.environ.get("JOB_PUEUE_CONFIG") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "pueue", "pueue.yml")
    try:
        with open(cfg, encoding="utf-8", errors="replace") as f:
            for line in f:
                s = line.strip()
                if s.startswith("pueue_directory:"):
                    val = s.split(":", 1)[1].strip().strip("'\"")
                    if val and val not in ("null", "~"):
                        return os.path.expanduser(val)
    except OSError:
        pass
    return os.path.join(
        os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "pueue")


def _log_path(task_id):
    return os.path.join(_pueue_directory(), "task_logs", "%d.log" % int(task_id))


def _proc_tree(token):
    """CPU ticks used so far by the job's processes.

    The job's processes are found by the unique token that `job submit` put in
    the task's environment (pueue starts the task with that environment, and
    children inherit it), plus every descendant of those processes. Names and
    command lines are never looked at. Each process counts its own CPU time and
    that of its children it has already reaped, so work done by short-lived
    children is not lost. Returns (ticks, nprocs, runnable); (None, 0, 0) when no
    process is alive. runnable counts processes in state R (running or waiting
    for a CPU), so a job starved of CPU on a busy machine is not mistaken for an
    idle one.
    """
    if not token:
        return None, 0, 0
    needle = ("JOB_TOKEN=" + token).encode()
    stats = {}
    members = set()
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open("/proc/%d/stat" % pid, "rb") as f:
                raw = f.read().decode("ascii", "replace")
            # comm may hold spaces or parentheses; the fields after the last ')' are fixed.
            rest = raw[raw.rindex(")") + 2:].split()
            ppid = int(rest[1])
            ticks = int(rest[11]) + int(rest[12]) + int(rest[13]) + int(rest[14])  # utime stime cutime cstime
            stats[pid] = (ppid, ticks, rest[0] == "R")
        except (OSError, ValueError, IndexError):
            continue
        try:
            with open("/proc/%d/environ" % pid, "rb") as f:
                if needle in f.read().split(b"\0"):
                    members.add(pid)
        except OSError:
            continue
    if not members:
        return None, 0, 0
    # add descendants (a child may have cleared its environment)
    children = {}
    for pid, (ppid, _, _) in stats.items():
        children.setdefault(ppid, []).append(pid)
    stack = list(members)
    while stack:
        for c in children.get(stack.pop(), []):
            if c not in members:
                members.add(c)
                stack.append(c)
    live = [stats[p] for p in members if p in stats]
    return sum(x[1] for x in live), len(members), sum(1 for x in live if x[2])


def _summarize_task(t):
    status = t.get("status") or {}
    kind = next(iter(status), "Unknown") if isinstance(status, dict) else str(status)
    info = status.get(kind, {}) if isinstance(status, dict) else {}
    if not isinstance(info, dict):
        info = {}
    result = info.get("result")
    if isinstance(result, dict):
        rkind = next(iter(result))
        rval = result[rkind]
    else:
        rkind, rval = result, None
    envs = t.get("envs") or {}
    return {
        "id": t.get("id"),
        "label": t.get("label"),
        "group": t.get("group"),
        "path": t.get("path"),
        "command": t.get("original_command") or t.get("command"),
        "status": kind,
        "result": rkind,
        "result_value": rval,
        "enqueued_at": info.get("enqueued_at"),
        "start": info.get("start"),
        "end": info.get("end"),
        "token": envs.get("JOB_TOKEN"),
        "session": envs.get("JOB_SESSION"),
        "summary": envs.get("JOB_SUMMARY"),
        "submitted_from": envs.get("JOB_SUBMITTED_FROM"),
    }


def _clean_old_files(state, in_use):
    """Remove scripts and result records older than SCRIPT_KEEP_DAYS whose task pueue no longer holds."""
    cutoff = time.time() - SCRIPT_KEEP_DAYS * 86400
    for sub in ("scripts", "results"):
        d = os.path.join(state, sub)
        try:
            for name in os.listdir(d):
                p = os.path.join(d, name)
                if name.split(".")[0] not in in_use and os.path.getmtime(p) < cutoff:
                    os.remove(p)
        except OSError:
            pass


def _request_protocol(op, req):
    """Protocol number a client sends: 5 for a submit with a scope or a size, 4 for one asking for normal
    priority."""
    if op == "submit" and (req.get("scope") is not None or req.get("admission") is not None):
        return PROTOCOL_ADMISSION
    if op == "submit" and req.get("normal_priority"):
        return PROTOCOL_PRIORITY
    return PROTOCOL


def _runner(script, normal_priority=False):
    """The command pueue runs. Idle priority (nice 19, ionice idle) unless normal priority was asked for."""
    if normal_priority:
        return "bash %s" % shlex.quote(script)
    return "nice -n 19 ionice -c 3 bash %s" % shlex.quote(script)


GPU_VARS = ("CUDA_VISIBLE_DEVICES", "CUDA_DEVICE_ORDER", "JOB_GPU_UUIDS")  # set by admission, never by the caller
SCOPE_MIN_MEMORY = 16 << 20


def _env_name_ok(k):
    return (isinstance(k, str) and k != "" and k.isascii() and (k[0].isalpha() or k[0] == "_")
            and all(c.isalnum() or c == "_" for c in k))


def _check_scope(scope):
    """Validate a scope request; return it normalized. See docs/admission.md, "Per-job scope"."""
    if not isinstance(scope, dict):
        raise JobError("scope must be an object")
    mem = scope.get("memory_max")
    if not isinstance(mem, int) or isinstance(mem, bool) or mem < SCOPE_MIN_MEMORY:
        raise JobError("scope.memory_max must be a whole number of bytes, at least %d MiB" % (SCOPE_MIN_MEMORY >> 20))
    gpus = scope.get("gpus")
    if gpus is None:
        gpus = []  # a scoped job sees no GPU unless it was given one
    if not isinstance(gpus, list) or not all(
            isinstance(g, str) and g and g.isascii() and all(c.isalnum() or c in "-_:/." for c in g) for g in gpus):
        raise JobError("scope.gpus must be a list of GPU UUIDs")
    gpu_env = scope.get("gpu_env") or {}
    if not isinstance(gpu_env, dict) or not all(_env_name_ok(k) and isinstance(v, str) for k, v in gpu_env.items()):
        raise JobError("scope.gpu_env must map variable names to strings")
    bad = sorted(k for k in gpu_env if k in GPU_VARS or k.startswith("JOB_"))
    if bad:
        raise JobError("scope.gpu_env may not set %s" % ", ".join(bad))
    adj = scope.get("oom_score_adj", 0)
    if not isinstance(adj, int) or isinstance(adj, bool) or not 0 <= adj <= 1000:
        raise JobError("scope.oom_score_adj must be a whole number from 0 to 1000")
    return {"memory_max": _whole_pages(mem), "gpus": gpus, "gpu_env": gpu_env, "oom_score_adj": adj}


def _whole_pages(n):
    """A memory limit rounded down to whole pages, as the kernel stores it."""
    page = os.sysconf("SC_PAGE_SIZE")
    return int(n) // page * page


def _scope_scripts(token, body, record, scope, assign):
    """The wrapper (pueue's child, outside the scope) and the shim (inside it) of a scoped job.

    The scope is delegated to the shim, which splits it into two cgroups: shim/ (itself) and job/ (the
    command, with the memory limit, no swap and whole-group kill). So the shim outlives a memory kill of the
    job and reads the job's own counters to say why it ended, on any systemd version. The RAM limit and the
    GPUs come from the assignment file (KEY=VALUE lines), written at submit or, for an admitted job, by the
    admission loop at release.
    """
    results = os.path.dirname(record)
    q = shlex.quote
    started, final, result = (os.path.join(results, token + ext) for ext in (".started", ".final", ".scope"))
    shim_path = os.path.join(os.path.dirname(body), token + ".shim")
    unit = SCOPE_PREFIX + token + ".scope"
    sysd = "timeout 30 systemctl --user"
    shim = "\n".join([
        "#!/bin/bash",
        "# job %s: runs inside the job's systemd scope; runs the command in job/ and records how it ended" % VERSION,
        "final=%s" % q(final),
        'fail() { echo "setup_error=$1" > "$final.tmp" && mv "$final.tmp" "$final"; exit 205; }',
        'cg="/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)"',
        '[ "${cg##*/}" = %s ] || fail "not running in its own scope"' % q(unit),
        '[ -w "$cg/cgroup.subtree_control" ] || fail "the scope is not delegated"',
        'mkdir "$cg/shim" "$cg/job" 2>/dev/null || fail "could not make the job cgroups"',
        'echo $$ 2>/dev/null > "$cg/shim/cgroup.procs" || fail "could not move the shim into its cgroup"',
        'echo +memory 2>/dev/null > "$cg/cgroup.subtree_control" || fail "no memory controller in the scope"',
        'case "$JOB_MEMORY_MAX" in ""|*[!0-9]*) fail "no RAM limit was assigned";; esac',
        '{ echo "$JOB_MEMORY_MAX" > "$cg/job/memory.max" && echo 0 > "$cg/job/memory.swap.max" &&'
        ' echo 1 > "$cg/job/memory.oom.group"; } 2>/dev/null || fail "could not set the memory limit"',
        "# the kernel rounds the limit down to whole pages",
        'got=$(cat "$cg/job/memory.max"); case "$got" in ""|*[!0-9]*) got=0;; esac',
        'd=$((JOB_MEMORY_MAX - got)); [ "$got" -gt 0 ] && [ "${d#-}" -lt 65536 ] &&'
        ' [ "$(cat "$cg/job/memory.swap.max")" = 0 ] && [ "$(cat "$cg/job/memory.oom.group")" = 1 ]'
        ' || fail "the memory limit did not take effect"',
        "the_job() {",
        '  echo $BASHPID 2>/dev/null > "$cg/job/cgroup.procs" || exit 0',
        "  : > %s" % q(started),
        ("  echo %d 2>/dev/null > /proc/self/oom_score_adj" % scope["oom_score_adj"]) if scope["oom_score_adj"]
        else "  :",
        "  exec bash -o pipefail %s" % q(body),
        "}",
        "( the_job )",
        "rc=$?",
        '[ -e %s ] || fail "could not move the job into its cgroup"' % q(started),
        "# processes still dying from a kill leave within moments; anything left after that, the job left behind",
        'for i in $(seq 20); do grep -qx "populated 0" "$cg/job/cgroup.events" && break; sleep 0.1; done',
        'left=$(wc -l < "$cg/job/cgroup.procs")',
        'if [ "$left" -gt 0 ]; then',
        '  echo 1 > "$cg/job/cgroup.kill"',
        '  for i in $(seq 100); do grep -qx "populated 0" "$cg/job/cgroup.events" && break; sleep 0.1; done',
        "fi",
        "{",
        '  echo "rc=$rc"',
        '  echo "leftover=$left"',
        '  echo "memory.peak=$(cat "$cg/job/memory.peak" 2>/dev/null)"',
        '  for f in memory.events cpu.stat; do sed "s/^/$f./;s/ /=/" "$cg/job/$f" 2>/dev/null; done',
        '} > "$final.tmp" && mv "$final.tmp" "$final"',
        "exit $rc",
        ""])
    wrapper = "\n".join([
        "#!/bin/bash",
        "# job %s: runs the job in its own systemd scope and records how it ended" % VERSION,
        'export PATH="$HOME/.local/bin:$PATH"',
        'export XDG_RUNTIME_DIR="/run/user/$(id -u)"',
        "rm -f %s %s %s %s" % (q(started), q(final), q(result), q(os.path.join(results, token + ".killed"))),
        "# a restarted job reuses its token, so end any scope an earlier run of it left",
        "%s kill --signal=SIGKILL %s >/dev/null 2>&1" % (sysd, q(unit)),
        "%s stop %s >/dev/null 2>&1" % (sysd, q(unit)),
        "%s reset-failed %s >/dev/null 2>&1" % (sysd, q(unit)),
        "# the RAM limit and GPUs this run was given",
        "if [ ! -r %s ]; then" % q(assign),
        "  echo \"job: this run has no assignment (%s)\" >&2" % assign.replace('"', ""),
        "  printf 'rc=205\\nstarted=0\\n' > %s; echo 205 > %s; exit 205" % (q(result), q(record)),
        "fi",
        "while IFS='=' read -r k v; do",
        '  case "$k" in JOB_MEMORY_MAX|CUDA_VISIBLE_DEVICES|JOB_GPU_UUIDS) export "$k=$v";; esac',
        "done < %s" % q(assign),
        "export CUDA_DEVICE_ORDER=PCI_BUS_ID",
        "systemd-run --user --scope --quiet --unit=%s -p Delegate=yes -p OOMPolicy=continue -p CPUWeight=%d"
        " -- bash %s" % (q(unit), 100 if scope.get("normal_priority") else 1, q(shim_path)),
        "rc=$?",
        "{",
        '  echo "rc=$rc"',
        '  echo "memory_max=$JOB_MEMORY_MAX"',
        "  [ -e %s ] && echo started=1 || echo started=0" % q(started),
        "  %s show %s -p Result -p LoadState 2>/dev/null" % (sysd, q(unit)),
        "} > %s.tmp && mv %s.tmp %s" % (q(result), q(result), q(result)),
        "%s reset-failed %s >/dev/null 2>&1" % (sysd, q(unit)),
        "echo $rc > %s" % q(record),
        "exit $rc",
        ""])
    return wrapper, shim_path, shim


def _read_kv(path):
    out = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                k, sep, v = line.rstrip("\n").partition("=")
                if sep:
                    out[k] = v
    except OSError:
        return None
    return out


def _int_or_none(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _usage(kv, out):
    """Copy a job cgroup's final counters from a shim or kill record into a result."""
    out["memory_peak_incl_cache"] = _int_or_none(kv.get("memory.peak"))  # page cache counts: not a RAM size
    out["memory_events"] = {k.split(".", 2)[2]: _int_or_none(v) for k, v in kv.items()
                            if k.startswith("memory.events.")}
    out["cpu_usage_usec"] = _int_or_none(kv.get("cpu.stat.usage_usec"))


def _scope_result(token):
    """How a scoped job ended, from the files its wrapper, shim or `job kill` wrote; None if not scoped."""
    if not token:
        return None
    results = os.path.join(STATE_DIR, "results")
    kv = _read_kv(os.path.join(results, token + ".scope"))
    final = _read_kv(os.path.join(results, token + ".final"))
    killed = _read_kv(os.path.join(results, token + ".killed"))
    if kv is None and final is None and killed is None:
        return None
    kv = kv or {}
    out = {"rc": _int_or_none(kv.get("rc")), "memory_max": _int_or_none(kv.get("memory_max")),
           "scope_result": kv.get("Result")}
    final_path, killed_path = (os.path.join(results, token + ext) for ext in (".final", ".killed"))
    if killed is not None and final is not None and os.path.getmtime(final_path) < os.path.getmtime(killed_path):
        killed = None  # the job ended by itself before `job kill` reached it
    if killed is not None:
        out["how"] = "killed"
        out["memory_max"] = out["memory_max"] or _int_or_none(killed.get("memory_max"))
        _usage(killed, out)
    elif final is not None and final.get("setup_error"):
        out["how"] = "setup_error"
        out["reason"] = final["setup_error"]
    elif final is not None:
        _usage(final, out)
        ev = out["memory_events"]
        out["leftover"] = _int_or_none(final.get("leftover")) or 0
        rc = _int_or_none(final.get("rc"))
        if rc == 0:
            out["how"] = "exit"  # a memory kill after a clean exit hit a process it left running
        elif ev.get("oom_group_kill") or ev.get("oom_kill"):
            # oom counts the times the job reached its own limit; a kill without it came from the host
            out["how"] = "memory_limit" if ev.get("oom") else "host_oom"
        elif rc == 137:
            out["how"] = "sigkill"
        else:
            out["how"] = "exit"
    elif kv.get("started") != "1":
        out["how"] = "wrapper_error"
    else:
        out["how"] = "scope_killed"  # the shim died with the job: the whole scope was killed from outside
    return out


def _scope_cgroup(token):
    env = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % os.getuid())
    try:
        p = subprocess.run(["systemctl", "--user", "show", "-p", "ControlGroup", "--value",
                            SCOPE_PREFIX + token + ".scope"], env=env, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    cg = p.stdout.strip()
    return "/sys/fs/cgroup" + cg if p.returncode == 0 and cg.startswith("/") else None


def _snapshot_kill(token):
    """Before `job kill` ends a scoped job, keep its use so far, since its shim dies with it."""
    path = os.path.join(STATE_DIR, "results", token + ".killed")
    lines = ["stopped_by=job kill"]
    cg = _scope_cgroup(token)
    if cg:
        job = os.path.join(cg, "job")
        try:
            with open(os.path.join(job, "memory.max")) as f:
                lines.append("memory_max=" + f.read().strip())
            with open(os.path.join(job, "memory.peak")) as f:
                lines.append("memory.peak=" + f.read().strip())
            for name in ("memory.events", "cpu.stat"):
                with open(os.path.join(job, name)) as f:
                    lines += ["%s.%s" % (name, line.strip().replace(" ", "=", 1)) for line in f if line.strip()]
        except OSError:
            pass
    try:
        with open(path + ".tmp", "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def _stop_scope(token):
    """Kill everything left in a job's scope (SIGKILL, as pueue kill does) and forget the unit."""
    unit = SCOPE_PREFIX + token + ".scope"
    env = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % os.getuid())
    for args in (["kill", "--signal=SIGKILL", unit], ["stop", unit], ["reset-failed", unit]):
        try:
            subprocess.run(["systemctl", "--user"] + args, env=env, capture_output=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            pass


def host_submit(req, _admission_checked=False):
    command = req["command"]
    if not isinstance(req.get("normal_priority", False), bool):
        raise JobError("normal_priority must be true or false")
    admitted = req.get("admitted") if _admission_checked else None
    if not _admission_checked:
        settings = _admission_settings()  # an unusable settings file refuses every submit, with the reason
        if settings is not None:
            return host_submit_admitted(req, settings, command)
        if req.get("admission"):
            raise JobError("%s is not an admission host; submit without a size there" % socket.gethostname())
    scope = req.get("scope")
    if admitted:
        scope = {"memory_max": None, "gpus": [], "gpu_env": admitted["gpu_env"],
                 "oom_score_adj": admitted["oom_score_adj"]}
    elif scope is not None:
        if req.get("protocol", PROTOCOL_ADMISSION) != PROTOCOL_ADMISSION:
            raise JobError("protocol mismatch: a job with a scope needs protocol %d" % PROTOCOL_ADMISSION)
        scope = _check_scope(scope)
        bad = sorted(k for k in (req.get("env") or {}) if k in GPU_VARS)
        if bad:
            raise JobError("%s is set by admission; do not pass it with --env" % ", ".join(bad))
    token = req.get("token") or uuid.uuid4().hex
    if not all(c in "0123456789abcdef" for c in token):
        raise JobError("bad token")
    st = _pueue_status()
    tokens = {}
    for _, t in st.get("tasks", {}).items():
        tok = (t.get("envs") or {}).get("JOB_TOKEN")
        if tok:
            tokens[tok] = int(t["id"])
    if token in tokens:  # a retried submit whose first attempt got through
        return {"id": tokens[token], "token": token, "host": socket.gethostname(), "existing": True}

    cwd = os.path.expanduser(req.get("cwd") or "~")
    if not os.path.isdir(cwd):
        raise JobError("working directory does not exist on %s: %s" % (socket.gethostname(), cwd))
    group = req.get("group") or "default"
    if group != "default" and group not in st.get("groups", {}):
        raise JobError("pueue group %r does not exist on %s; create it with "
                       "'job group <host> %s <n>'" % (group, socket.gethostname(), group))

    scripts = os.path.join(STATE_DIR, "scripts")
    results = os.path.join(STATE_DIR, "results")
    os.makedirs(scripts, mode=0o700, exist_ok=True)
    os.makedirs(results, mode=0o700, exist_ok=True)
    _clean_old_files(STATE_DIR, set(tokens))
    script = os.path.join(scripts, token + ".sh")
    body = os.path.join(scripts, token + ".cmd")
    record = os.path.join(results, token + ".exit")
    with open(body, "w", encoding="utf-8") as f:
        f.write(command)
        if not command.endswith("\n"):
            f.write("\n")
    shim_path = assign = None
    if scope is not None:
        if admitted:
            assign = admitted["assign"]  # written by the admission loop when it releases the job
        else:
            assign = os.path.join(results, token + ".assign")
            with open(assign, "w", encoding="utf-8") as f:
                f.write("JOB_MEMORY_MAX=%d\nCUDA_VISIBLE_DEVICES=%s\nJOB_GPU_UUIDS=%s\n" % (
                    scope["memory_max"], ",".join(scope["gpus"]), ",".join(scope["gpus"])))
        # nice ranks processes only inside one cgroup, and each scoped job is a cgroup of its own, so its
        # priority is also its CPU weight: 1 for idle priority (about nice 19's share), 100 for normal
        scope = dict(scope, normal_priority=bool(req.get("normal_priority")))
        wrapper, shim_path, shim = _scope_scripts(token, body, record, scope, assign)
        with open(shim_path, "w", encoding="utf-8") as f:
            f.write(shim)
        os.chmod(shim_path, 0o700)
    with open(script, "w", encoding="utf-8") as f:
        if scope is not None:
            f.write(wrapper)
        else:
            f.write("#!/bin/bash\n")
            f.write("# written by job %s for task %s at %s\n" % (
                VERSION, req.get("task", "?"), dt.datetime.now().astimezone().isoformat()))
            f.write('export PATH="$HOME/.local/bin:$PATH"\n')
            # the command runs in its own bash; its exit code is recorded here, so the record
            # survives pueue's cleanup and cannot be undone by a trap in the command
            f.write("bash -o pipefail %s\n" % shlex.quote(body))
            f.write("rc=$?\n")
            f.write("echo $rc > %s\n" % shlex.quote(record))
            f.write("exit $rc\n")
    os.chmod(script, 0o700)
    runner = _runner(script, req.get("normal_priority", False))

    env = {k: v for k, v in os.environ.items()
           if k in ENV_ALLOW or k.startswith("LC_")}
    env["PATH"] = _with_local_bin(env.get("PATH"))
    if scope is not None:
        # the GPUs (by UUID, so CUDA's own device order does not matter) come from the assignment file;
        # an empty list hides every GPU from a job that did not ask for one
        env.update(scope["gpu_env"])
    env.update(req.get("env") or {})
    env.update({
        "JOB_TOKEN": token,
        "JOB_TASK": req["task"],
        "JOB_SESSION": req.get("session") or "unknown",
        "JOB_SUMMARY": " ".join(command.split())[:200],
        "JOB_SUBMITTED_FROM": req.get("from") or "?",
    })
    args = (["add", "--print-task-id", "--label", req["task"], "--working-directory", cwd, "--group", group]
            + (["--stashed"] if admitted else []) + ["--", runner])
    try:
        p = _pueue(args, env=env)
    except JobError:
        for path in (script, body, shim_path, None if admitted else assign):
            if path:
                os.remove(path)
        raise
    try:
        task_id = int(p.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise JobError("pueue add printed no task id: %r" % p.stdout[:300])
    return {"id": task_id, "token": token, "host": socket.gethostname(), "existing": False}


def host_probe(req):
    tid = int(req["id"])
    st = _pueue_status()
    t = st.get("tasks", {}).get(str(tid))
    want_token = req.get("token")
    if t is None or (want_token and (t.get("envs") or {}).get("JOB_TOKEN") != want_token):
        out = {"found": t is not None, "token_mismatch": t is not None}
        rec = os.path.join(STATE_DIR, "results", "%s.exit" % want_token) if want_token else None
        if rec and os.path.exists(rec):
            try:
                with open(rec) as f:
                    code = int(f.read().strip())
                out["record"] = {"exit": code, "end": dt.datetime.fromtimestamp(
                    os.path.getmtime(rec)).astimezone().isoformat()}
                out["record"]["scope"] = _scope_result(want_token)
            except (OSError, ValueError):
                pass
        return out
    s = _summarize_task(t)
    s["found"] = True
    s["token_mismatch"] = False
    if s["status"] == "Done":
        s["scope"] = _scope_result(s["token"])
    g = st.get("groups", {}).get(s["group"]) or {}
    s["group_parallel"] = g.get("parallel_tasks")
    s["group_running"] = sum(1 for x in st.get("tasks", {}).values()
                             if x.get("group") == s["group"] and "Running" in (x.get("status") or {}))
    s["clk_tck"] = os.sysconf("SC_CLK_TCK")
    path = _log_path(tid)
    s["log_path"] = path
    # status is read before the log, so a Done status means the log is complete
    try:
        size = os.path.getsize(path)
    except OSError:
        size = 0
    s["log_size"] = size
    if s["status"] == "Running":
        s["cpu_ticks"], s["nprocs"], s["runnable"] = _proc_tree(s["token"])
    else:
        s["cpu_ticks"], s["nprocs"], s["runnable"] = None, 0, 0
    off = req.get("log_offset")
    if off is not None and size > off:
        with open(path, "rb") as f:
            f.seek(off)
            data = f.read(min(CHUNK, size - off))
        s["new_offset"] = off + len(data)
        s["new_bytes"] = base64.b64encode(data).decode()
    tail = req.get("tail_lines")
    if tail:
        s["tail"] = _tail(path, int(tail))
    _probe_admission(s, req)
    return s


def _probe_admission(s, req):
    """Add what the admission loop says about this job: why it is held, new alerts, a stopped loop."""
    try:
        settings = _admission_settings()
    except JobError:
        return
    if settings is None or not s.get("token"):
        return
    adm = Admission(settings)
    q = adm.read_json(adm.path("queue", s["token"] + ".json"))
    if q is not None:
        s["held"] = q.get("state") == "held"
        s["held_reason"] = q.get("reason")
    try:
        with open(adm.path("alerts", s["token"] + ".jsonl"), encoding="utf-8") as f:
            alerts = [json.loads(line) for line in f if line.strip()]
    except (OSError, ValueError):
        alerts = []
    s["alert_count"] = len(alerts)
    cursor = req.get("alert_cursor")
    if isinstance(cursor, int) and 0 <= cursor < len(alerts):
        s["alerts"] = alerts[cursor:]
    if s.get("held"):
        age = _heartbeat_age(adm)
        s["admission_stale"] = age is None or age > _heartbeat_limit(settings)


def _tail(path, n):
    """The last n lines among the log's final TAIL_BYTES, each cut to TAIL_LINE_MAX characters."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - TAIL_BYTES))
            buf = f.read()
    except OSError:
        return []
    text = buf.decode("utf-8", "replace").replace("\r\n", "\n")
    lines = []
    for line in text.split("\n"):
        line = line.rsplit("\r", 1)[-1] if "\r" in line else line  # progress bars: keep the last redraw
        if len(line) > TAIL_LINE_MAX:
            line = line[:TAIL_LINE_MAX] + " ...[line cut]"
        lines.append(line)
    if lines and lines[-1] == "":
        lines.pop()
    if size > TAIL_BYTES and lines:
        lines.pop(0)  # the first line is probably partial
    return lines[-n:]


def host_ls(req):
    st = _pueue_status()
    out = [_summarize_task(t) for _, t in sorted(st.get("tasks", {}).items(), key=lambda kv: int(kv[0]))]
    for s in out:
        if s["status"] == "Done" and s.get("token"):
            s["scope"] = _scope_result(s["token"])
        elif s["status"] == "Stashed" and s.get("token"):
            _probe_admission(s, {})
    return {"tasks": out, "groups": st.get("groups", {}), "hostname": socket.gethostname()}


def host_group(req):
    name, n = req["name"], int(req["parallel"])
    if n < 1:
        raise JobError("parallel limit must be at least 1")
    created = False
    if name not in _pueue_status().get("groups", {}):
        _pueue(["group", "add", name])
        created = True
    _pueue(["parallel", str(n), "--group", name])
    return {"name": name, "parallel": n, "created": created}


def host_kill(req):
    tid = int(req["id"])
    t = _pueue_status().get("tasks", {}).get(str(tid))
    if t is None:
        raise JobError("no task %d" % tid)
    tok = req.get("token")
    if tok and (t.get("envs") or {}).get("JOB_TOKEN") != tok:
        raise JobError("task %d now belongs to a different job; not killed" % tid)
    status = next(iter(t.get("status") or {"?": 0}))
    if status == "Running":
        token = (t.get("envs") or {}).get("JOB_TOKEN")
        scoped = bool(token) and os.path.exists(os.path.join(STATE_DIR, "scripts", token + ".shim"))
        if scoped:
            _snapshot_kill(token)  # its shim dies with it, so keep its use so far
        try:
            _pueue(["kill", str(tid)])
        except JobError:
            if scoped:
                try:
                    os.remove(os.path.join(STATE_DIR, "results", token + ".killed"))
                except OSError:
                    pass
            raise
        if scoped:
            _stop_scope(token)  # processes the job detached (setsid, nohup) end with it
        return {"id": tid, "action": "killed"}
    if status in ("Queued", "Stashed", "Locked"):
        _pueue(["remove", str(tid)])
        return {"id": tid, "action": "removed from the queue"}
    raise JobError("task %d is %s; nothing to kill" % (tid, status))


# ---------------------------------------------------------------------------------------------------------------
# Admission (docs/admission.md): settings, measurement and room. The loop and the queue are further down.

ADMISSION_CONFIG = os.environ.get("JOB_ADMISSION_CONFIG") or os.path.expanduser("~/.config/agent-pueue/admission.json")
ADMISSION_DEFAULTS = {
    "state_dir": "~/.local/state/agent-pueue/admission",
    "cpu_busy_threads_max": None,      # default: every thread
    "placed_cores_max": None,          # default: 1.5 times the threads
    "ram_headroom_gb": 8.0,
    "ram_hard_factor": 1.5,
    "memory_pressure_max_pct": 10.0,
    "gpu_headroom_mb": 1024.0,
    "gpu_busy_max_pct": 90.0,
    "iowait_max_pct": 100.0,
    "disk_busy_max_pct": 100.0,
    "disk_heavy_mb_s": 50.0,
    "disks": [],
    "outside_window_s": 600,
    "cpu_window_s": 600,
    "sample_interval_s": 15,
    "pilot_sample_interval_s": 1,
    "fairness_wait_min": 30,
    "small": {"cpus": 1, "ram_gb": 4},
    "pilot": {"max_minutes": 30},
    "margins": {"cpu": 1.2, "ram": 1.25, "gpu_mem": 1.15},
    "preemptible": False,
    "oom_score_adj": 500,
    "gpu_env": {},
}
GB, MB = 1e9, 1e6
GPU_BUSY_WINDOW_S = 60


def _num(v, name, lo=0.0, hi=None, whole=False):
    if isinstance(v, bool) or not isinstance(v, (int, float)) or (whole and not isinstance(v, int)):
        raise JobError("admission setting %s must be a %s" % (name, "whole number" if whole else "number"))
    if v < lo or (hi is not None and v > hi):
        raise JobError("admission setting %s must be from %s to %s" % (name, lo, "any" if hi is None else hi))
    return v


def _admission_settings(path=None, nthreads=None):
    """The host's admission settings, or None when the host is not an admission host.

    Raises JobError when the file exists but cannot be used: admission never falls back to admitting
    without rules.
    """
    path = path or ADMISSION_CONFIG
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise JobError("admission settings %s cannot be read: %s" % (path, e))
    if not isinstance(raw, dict):
        raise JobError("admission settings %s must be a JSON object" % path)
    unknown = sorted(set(raw) - set(ADMISSION_DEFAULTS))
    if unknown:
        raise JobError("admission settings %s: unknown setting %s" % (path, ", ".join(unknown)))
    s = json.loads(json.dumps(ADMISSION_DEFAULTS))
    for k, v in raw.items():
        if isinstance(s.get(k), dict) and k != "gpu_env":
            if not isinstance(v, dict) or set(v) - set(s[k]):
                raise JobError("admission setting %s must be an object with keys %s" % (k, ", ".join(sorted(s[k]))))
            s[k].update(v)
        else:
            s[k] = v
    n = nthreads or os.cpu_count() or 1
    if s["cpu_busy_threads_max"] is None:
        s["cpu_busy_threads_max"] = n
    if s["placed_cores_max"] is None:
        s["placed_cores_max"] = 1.5 * n
    for k in ("cpu_busy_threads_max", "placed_cores_max", "ram_headroom_gb", "gpu_headroom_mb", "disk_heavy_mb_s"):
        _num(s[k], k)
    _num(s["ram_hard_factor"], "ram_hard_factor", lo=1.0)
    for k in ("memory_pressure_max_pct", "gpu_busy_max_pct", "iowait_max_pct", "disk_busy_max_pct"):
        _num(s[k], k, hi=100.0)
    for k in ("outside_window_s", "cpu_window_s", "sample_interval_s", "pilot_sample_interval_s", "fairness_wait_min"):
        _num(s[k], k, lo=1, whole=True)
    _num(s["small"]["cpus"], "small.cpus", lo=0.01)
    _num(s["small"]["ram_gb"], "small.ram_gb", lo=0.01)
    _num(s["pilot"]["max_minutes"], "pilot.max_minutes", lo=1)
    for k in ("cpu", "ram", "gpu_mem"):
        _num(s["margins"][k], "margins." + k, lo=1.0)
    if not isinstance(s["preemptible"], bool):
        raise JobError("admission setting preemptible must be true or false")
    _num(s["oom_score_adj"], "oom_score_adj", hi=1000, whole=True)
    if not isinstance(s["disks"], list) or not all(isinstance(p, str) and p.startswith("/") for p in s["disks"]):
        raise JobError("admission setting disks must be a list of absolute paths")
    try:
        s["gpu_env"] = _check_scope({"memory_max": SCOPE_MIN_MEMORY, "gpu_env": s["gpu_env"]})["gpu_env"]
    except JobError as e:
        raise JobError("admission setting gpu_env: %s" % str(e).replace("scope.gpu_env ", ""))
    if not isinstance(s["state_dir"], str):
        raise JobError("admission setting state_dir must be a path")
    s["state_dir"] = os.path.expanduser(s["state_dir"])
    if not os.path.isabs(s["state_dir"]):
        raise JobError("admission setting state_dir must be an absolute path or start with ~")
    return s


class Measure:
    """Reads one host's state. The roots are parameters so tests can give a fake /proc, /sys, cgroup tree and
    GPU list (a JSON file: {"cards": [{"index", "uuid", "name", "total", "free", "util"}],
    "procs": [{"uuid", "pid", "used"}]})."""

    def __init__(self, proc="/proc", sys_root="/sys", cgroup_root="/sys/fs/cgroup", gpu_file=None, uid=None):
        self.proc, self.sys, self.cg = proc, sys_root, cgroup_root
        self.gpu_file = gpu_file if gpu_file is not None else os.environ.get("JOB_TEST_GPUS")
        self.uid = os.getuid() if uid is None else uid
        self.nvml = None
        self.last_cpu = None
        self.last_disk = None
        self.last_jobs = {}

    # -- host --------------------------------------------------------------------------------------------------

    def _read(self, *parts):
        with open(os.path.join(*parts), encoding="ascii", errors="replace") as f:
            return f.read()

    def threads(self):
        return sum(1 for line in self._read(self.proc, "stat").splitlines()
                   if line.startswith("cpu") and line[3:4].isdigit())

    def cpu(self, now):
        """(busy threads, iowait %) averaged since the last call; (None, None) on the first."""
        f = self._read(self.proc, "stat").splitlines()[0].split()[1:]
        v = [int(x) for x in f[:8]] + [0] * max(0, 8 - len(f))
        user, nice, system, idle, iowait, irq, softirq, steal = v[:8]
        busy, total = user + nice + system + irq + softirq + steal, user + nice + system + idle + iowait + irq + softirq + steal
        last, self.last_cpu = self.last_cpu, (busy, total, iowait)
        if last is None or total <= last[1]:
            return None, None
        dt = total - last[1]
        return self.threads() * (busy - last[0]) / dt, 100.0 * (iowait - last[2]) / dt

    def meminfo(self):
        out = {}
        for line in self._read(self.proc, "meminfo").splitlines():
            k, _, v = line.partition(":")
            parts = v.split()
            if parts and parts[0].isdigit():
                out[k] = int(parts[0]) * (1024 if parts[1:2] == ["kB"] else 1)
        return out

    def memory_pressure(self):
        """The memory pressure full avg10 (percent), or 0.0 where pressure is not reported."""
        try:
            for line in self._read(self.proc, "pressure", "memory").splitlines():
                if line.startswith("full"):
                    return float(dict(kv.split("=") for kv in line.split()[1:])["avg10"])
        except (OSError, KeyError, ValueError):
            pass
        return 0.0

    def disk_of(self, path):
        """The block device (whole disk, not partition) that holds path, or None."""
        try:
            st = os.stat(path)
        except OSError:
            return None
        link = os.path.join(self.sys, "dev", "block", "%d:%d" % (os.major(st.st_dev), os.minor(st.st_dev)))
        real = os.path.realpath(link)
        if not os.path.isdir(real):
            return None
        if os.path.exists(os.path.join(real, "partition")):
            real = os.path.dirname(real)
        return os.path.basename(real)

    def disks(self, now, names):
        """Busy percent of each named disk since the last call."""
        ticks = {}
        try:
            for line in self._read(self.proc, "diskstats").splitlines():
                p = line.split()
                if len(p) > 12 and p[2] in names:
                    ticks[p[2]] = int(p[12])
        except OSError:
            return {}
        last, self.last_disk = self.last_disk, (now, ticks)
        if last is None or now <= last[0]:
            return {}
        ms = (now - last[0]) * 1000.0
        return {n: min(100.0, 100.0 * (t - last[1].get(n, t)) / ms) for n, t in ticks.items()}

    # -- GPUs --------------------------------------------------------------------------------------------------

    def gpus(self):
        """[{index, uuid, name, total, used, util, procs: {pid: bytes}}] in bytes; [] on a host without GPUs."""
        if self.gpu_file:
            with open(self.gpu_file) as f:
                raw = json.load(f)
            cards = [{"index": c["index"], "uuid": c["uuid"], "name": c.get("name", "?"), "total": c["total"],
                      "used": c["total"] - c["free"], "util": c.get("util", 0), "procs": {}} for c in raw["cards"]]
            by = {c["uuid"]: c for c in cards}
            for p in raw.get("procs", []):
                if p["uuid"] in by:
                    by[p["uuid"]]["procs"][int(p["pid"])] = p["used"]
            return cards
        if self.nvml is None:
            self.nvml = _Nvml.open() or False
        if self.nvml:
            try:
                return self.nvml.cards()
            except OSError:
                self.nvml = False
        return _nvidia_smi_cards()

    # -- admitted jobs -----------------------------------------------------------------------------------------

    def user_root(self):
        return os.path.join(self.cg, "user.slice", "user-%d.slice" % self.uid, "user@%d.service" % self.uid)

    def scopes(self):
        """{token: path of the job's scope} for every agent-pueue job scope of this user."""
        out = {}
        root = self.user_root()
        for dirpath, dirnames, _ in os.walk(root):
            depth = dirpath[len(root):].count(os.sep)
            keep = []
            for d in dirnames:
                if d.startswith(SCOPE_PREFIX) and d.endswith(".scope"):
                    tok = d[len(SCOPE_PREFIX):-len(".scope")]
                    if len(tok) == 32 and all(c in "0123456789abcdef" for c in tok):
                        out[tok] = os.path.join(dirpath, d)
                elif depth < 2:
                    keep.append(d)
            dirnames[:] = keep
        return out

    def job_use(self, now, scopes):
        """{token: {ram, cpu, pids, populated}} for each scope: RAM size basis (bytes, file cache excluded),
        CPU threads since the last call, and the job's pids."""
        out, seen = {}, {}
        for tok, scope in scopes.items():
            job = os.path.join(scope, "job")
            base = job if os.path.isdir(job) else scope
            try:
                cur = int(self._read(base, "memory.current"))
                stat = dict((ln.split() + ["0"])[:2] for ln in self._read(base, "memory.stat").splitlines() if ln)
                usec = int(dict((ln.split() + ["0"])[:2] for ln in self._read(base, "cpu.stat").splitlines()
                                if ln).get("usage_usec", 0))
                pids = [int(x) for x in self._read(base, "cgroup.procs").split()]
            except (OSError, ValueError):
                continue
            ram = max(0, cur - int(stat.get("active_file", 0)) - int(stat.get("inactive_file", 0)))
            last = self.last_jobs.get(tok)
            cpu = (usec - last[1]) / 1e6 / (now - last[0]) if last and now > last[0] else None
            seen[tok] = (now, usec)
            out[tok] = {"ram": ram, "cpu": cpu, "pids": pids, "populated": bool(pids)}
        self.last_jobs = seen
        return out

    def cgroup_of(self, pid):
        try:
            return self._read(self.proc, str(pid), "cgroup").split("::", 1)[1].strip()
        except (OSError, IndexError):
            return None


class _Nvml:
    """The few NVML calls admission needs, through ctypes (standard library)."""

    class Memory(ctypes.Structure):
        _fields_ = [("total", ctypes.c_ulonglong), ("free", ctypes.c_ulonglong), ("used", ctypes.c_ulonglong)]

    class Util(ctypes.Structure):
        _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]

    class Proc(ctypes.Structure):  # nvmlProcessInfo_v2_t, used by the _v3 calls
        _fields_ = [("pid", ctypes.c_uint), ("usedGpuMemory", ctypes.c_ulonglong),
                    ("gpuInstanceId", ctypes.c_uint), ("computeInstanceId", ctypes.c_uint)]

    @classmethod
    def open(cls):
        try:
            lib = ctypes.CDLL("libnvidia-ml.so.1")
            if lib.nvmlInit_v2() != 0:
                return None
            lib.nvmlDeviceGetCount_v2
            lib.nvmlDeviceGetComputeRunningProcesses_v3
        except (OSError, AttributeError):
            return None
        n = cls()
        n.lib = lib
        return n

    def _ok(self, rc, what):
        if rc != 0:
            raise OSError("NVML %s failed (%d)" % (what, rc))

    def _procs(self, fn, h):
        count = ctypes.c_uint(64)
        arr = (self.Proc * 64)()
        rc = fn(h, ctypes.byref(count), arr)
        if rc == 7:  # NVML_ERROR_INSUFFICIENT_SIZE
            arr = (self.Proc * count.value)()
            rc = fn(h, ctypes.byref(count), arr)
        self._ok(rc, "process list")
        return {arr[i].pid: arr[i].usedGpuMemory for i in range(count.value)
                if arr[i].usedGpuMemory < (1 << 63)}  # NVML_VALUE_NOT_AVAILABLE is all ones

    def cards(self):
        lib, out = self.lib, []
        count = ctypes.c_uint()
        self._ok(lib.nvmlDeviceGetCount_v2(ctypes.byref(count)), "device count")
        for i in range(count.value):
            h = ctypes.c_void_p()
            self._ok(lib.nvmlDeviceGetHandleByIndex_v2(i, ctypes.byref(h)), "device handle")
            uuid, name = ctypes.create_string_buffer(96), ctypes.create_string_buffer(96)
            self._ok(lib.nvmlDeviceGetUUID(h, uuid, 96), "UUID")
            self._ok(lib.nvmlDeviceGetName(h, name, 96), "name")
            mem, util = self.Memory(), self.Util()
            self._ok(lib.nvmlDeviceGetMemoryInfo(h, ctypes.byref(mem)), "memory")
            busy = util.gpu if lib.nvmlDeviceGetUtilizationRates(h, ctypes.byref(util)) == 0 else 0
            procs = self._procs(lib.nvmlDeviceGetGraphicsRunningProcesses_v3, h)
            procs.update(self._procs(lib.nvmlDeviceGetComputeRunningProcesses_v3, h))  # they overlap
            out.append({"index": i, "uuid": uuid.value.decode(), "name": name.value.decode(), "total": mem.total,
                        "used": mem.total - mem.free, "util": busy, "procs": procs})
        return out


def _nvidia_smi_cards():
    """The same as _Nvml.cards, from nvidia-smi; [] when there is no nvidia-smi."""
    try:
        p = subprocess.run(["nvidia-smi", "--query-gpu=index,uuid,name,memory.total,memory.free,utilization.gpu",
                            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=30)
        q = subprocess.run(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory",
                            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if p.returncode != 0:
        return []
    cards = []
    for line in p.stdout.splitlines():
        f = [x.strip() for x in line.split(",")]
        if len(f) == 6:
            total = int(float(f[3])) << 20
            cards.append({"index": int(f[0]), "uuid": f[1], "name": f[2], "total": total,
                          "used": total - (int(float(f[4])) << 20),
                          "util": int(float(f[5])) if f[5].replace(".", "").isdigit() else 0, "procs": {}})
    by = {c["uuid"]: c for c in cards}
    for line in q.stdout.splitlines() if q.returncode == 0 else []:
        f = [x.strip() for x in line.split(",")]
        if len(f) == 3 and f[0] in by and f[1].isdigit() and f[2].isdigit():
            by[f[0]]["procs"][int(f[1])] = int(f[2]) << 20
    return cards


def _gbs(n):
    return "%.1f GB" % (n / GB)


def _in_window(samples, now, seconds):
    return [s for s in samples if now - s["t"] <= seconds]


def compute_room(settings, samples, inflight, holds, now):
    """The room left on a host, from its recent samples (docs/admission.md, "Room").

    samples: oldest first, each {t, busy, iowait, avail, psi, disks: {name: pct},
      gpus: {gid: {index, name, total, used, util}}, jobs: {token: {ram, cpu, gpu: {gid: bytes}}},
      holds: {hold_id: {gid: bytes}}}.
    inflight: [{token, released, size: {cpus, ram, gpu_mem, gpu_share}, gpus: [gid], ram_counted,
      gpu_counted: {gid: bytes}}].
    holds: [{id, gid, size}]. Returns None until there is a sample to count from.
    """
    if not samples:
        return None
    last = samples[-1]
    out = {"t": last["t"], "psi": last["psi"], "pressure_ok": last["psi"] <= settings["memory_pressure_max_pct"]}
    use = {tok: j for tok, j in last["jobs"].items()}

    # RAM: what would be available with no admitted job, at its lowest over the window
    win = _in_window(samples, now, settings["outside_window_s"])
    free_no_jobs = min(s["avail"] + sum(j["ram"] for j in s["jobs"].values()) for s in win)
    counted = sum(max(j["ram_counted"], use.get(j["token"], {}).get("ram", 0)) for j in inflight)
    out["ram"] = {"free_no_jobs": free_no_jobs, "counted": counted,
                  "room": free_no_jobs - settings["ram_headroom_gb"] * GB - counted}

    # CPU: outside use averaged over the window; older jobs count at their measured use
    cwin = [s for s in _in_window(samples, now, settings["cpu_window_s"]) if s["busy"] is not None]
    outside = (sum(max(0.0, s["busy"] - sum(j["cpu"] or 0.0 for j in s["jobs"].values())) for s in cwin) / len(cwin)
               if cwin else 0.0)
    committed = 0.0
    for j in inflight:
        vals = [s["jobs"][j["token"]]["cpu"] for s in cwin
                if j["token"] in s["jobs"] and s["jobs"][j["token"]]["cpu"] is not None]
        avg = sum(vals) / len(vals) if vals else 0.0
        committed += avg if now - j["released"] > settings["cpu_window_s"] else max(j["size"]["cpus"], avg)
    out["cpu"] = {"outside": outside, "committed": committed,
                  "placed": sum(j["size"]["cpus"] for j in inflight),
                  "room": settings["cpu_busy_threads_max"] - outside - committed,
                  "placed_room": settings["placed_cores_max"] - sum(j["size"]["cpus"] for j in inflight),
                  "iowait": (sum(s["iowait"] for s in cwin[-4:]) / len(cwin[-4:])) if cwin else 0.0}

    # GPUs, per card
    gwin = _in_window(samples, now, settings["outside_window_s"])
    recent = _in_window(samples, now, GPU_BUSY_WINDOW_S)
    out["gpus"] = {}
    for gid, card in last["gpus"].items():
        series = []
        for s in gwin:
            c = s["gpus"].get(gid)
            if c is None:
                continue
            ours = sum(j.get("gpu", {}).get(gid, 0) for j in s["jobs"].values())
            held = sum(h.get(gid, 0) for h in s.get("holds", {}).values())
            series.append(max(0, c["used"] - ours - held))
        # device and process values come from separate calls: a sample's value is the lower of two in a row
        paired = [min(a, b) for a, b in zip(series, series[1:])] or series
        gpu_outside = max(paired) if paired else 0
        jobs_on = [j for j in inflight if gid in j["gpus"]]
        jobs_counted = sum(max(j["gpu_counted"].get(gid, 0), use.get(j["token"], {}).get("gpu", {}).get(gid, 0))
                           for j in jobs_on)
        held_own = {hid: h.get(gid, 0) for hid, h in last.get("holds", {}).items()}
        holds_counted = sum(max(h["size"], held_own.get(h["id"], 0)) for h in holds if h["gid"] == gid)
        utils = [s["gpus"][gid]["util"] for s in recent if gid in s["gpus"]]
        util = sum(utils) / len(utils) if utils else 0.0
        shares = sum(j["size"].get("gpu_share") or 0 for j in jobs_on)
        out["gpus"][gid] = {
            "index": card["index"], "name": card["name"], "total": card["total"], "outside": gpu_outside,
            "jobs": jobs_counted, "holds": holds_counted, "util": util, "shares": shares,
            "room": card["total"] - settings["gpu_headroom_mb"] * MB - gpu_outside - jobs_counted - holds_counted}

    # disks: busy time over the last minute
    out["disks"] = {}
    for name in last["disks"]:
        vals = [s["disks"][name] for s in recent if name in s["disks"]]
        out["disks"][name] = sum(vals) / len(vals) if vals else 0.0
    return out


def fits(settings, room, job, data_disk=None):
    """Whether a held job fits the room now. Returns (True, {gpus, ram_counted, gpu_counted}) or (False, reason).

    job: {size: {cpus, ram, gpus, gpu_mem, gpu_share, disk_mb_s}, pilot, constraints: {gpu_model}}.
    A pilot is counted at all the RAM room and, with GPUs, all the room on its cards.
    """
    if room is None:
        return False, "no measurement yet"
    if not room["pressure_ok"]:
        return False, "memory pressure %.1f%% is over %.1f%%" % (room["psi"], settings["memory_pressure_max_pct"])
    size, pilot = job["size"], job.get("pilot")
    ram_room = room["ram"]["room"]
    if pilot:
        if ram_room <= size["ram"]:
            return False, "a pilot needs RAM room; %s free" % _gbs(max(0, ram_room))
        ram_counted = ram_room
    else:
        if size["ram"] > ram_room:
            return False, "needs %s RAM, %s free" % (_gbs(size["ram"]), _gbs(max(0, ram_room)))
        ram_counted = size["ram"]
    cpu = room["cpu"]
    if size["cpus"] > cpu["room"] + 1e-9:
        return False, "needs %g CPU threads, %.1f free" % (size["cpus"], max(0.0, cpu["room"]))
    if size["cpus"] > cpu["placed_room"] + 1e-9:
        return False, "needs %g CPU threads, %.1f left to place" % (size["cpus"], max(0.0, cpu["placed_room"]))
    if (size.get("disk_mb_s") or 0) > settings["disk_heavy_mb_s"] and data_disk in room["disks"]:
        busy = room["disks"][data_disk]
        if busy > settings["disk_busy_max_pct"]:
            return False, "disk %s is busy %.0f%% of the time (over %.0f%%)" % (data_disk, busy,
                                                                                 settings["disk_busy_max_pct"])
        if (cpu["iowait"] > settings["iowait_max_pct"]
                and busy >= max(room["disks"].values())):
            return False, "iowait %.0f%% is over %.0f%% and disk %s is the busiest" % (
                cpu["iowait"], settings["iowait_max_pct"], data_disk)
    chosen, gpu_counted = [], {}
    n = size.get("gpus") or 0
    if n:
        model = (job.get("constraints") or {}).get("gpu_model")
        ok, why = [], []
        for gid, g in room["gpus"].items():
            if model and model.lower() not in g["name"].lower():
                continue
            if g["util"] > settings["gpu_busy_max_pct"]:
                why.append("GPU %d is busy %.0f%%" % (g["index"], g["util"]))
                continue
            if g["shares"] + (size.get("gpu_share") or 0) > settings["gpu_busy_max_pct"]:
                why.append("GPU %d time is taken (%.0f%% shared)" % (g["index"], g["shares"]))
                continue
            need = 1 if pilot else size["gpu_mem"]
            if g["room"] < need:
                why.append("GPU %d has %s free" % (g["index"], _gbs(max(0, g["room"]))))
                continue
            ok.append((g["room"], g["index"], gid))
        if len(ok) < n:
            want = "a pilot needs %d GPU(s) with room" % n if pilot else "needs %d GPU(s) with %s free" % (
                n, _gbs(size["gpu_mem"]))
            return False, "%s; %s" % (want, ", ".join(why) or "no GPU matches")
        ok.sort()  # least room that still fits
        picked = ok[-n:] if pilot else ok[:n]
        chosen = [u for _, _, u in picked]
        gpu_counted = {u: (r if pilot else size["gpu_mem"]) for r, _, u in picked}
    return True, {"gpus": chosen, "ram_counted": ram_counted, "gpu_counted": gpu_counted}


def fits_empty(settings, capacity, job):
    """Why a job could not fit this host even with nothing else on it, or None."""
    size = job["size"]
    ram_max = capacity["mem_total"] - settings["ram_headroom_gb"] * GB
    if size["ram"] > ram_max:
        return "needs %s RAM; this host has at most %s for jobs" % (_gbs(size["ram"]), _gbs(ram_max))
    if size["cpus"] > min(settings["cpu_busy_threads_max"], settings["placed_cores_max"]):
        return "needs %g CPU threads; this host admits at most %g" % (
            size["cpus"], min(settings["cpu_busy_threads_max"], settings["placed_cores_max"]))
    n = size.get("gpus") or 0
    if n:
        model = (job.get("constraints") or {}).get("gpu_model")
        cards = [c for c in capacity["gpus"] if not model or model.lower() in c["name"].lower()]
        big = [c for c in cards if job.get("pilot") or c["total"] - settings["gpu_headroom_mb"] * MB >= size["gpu_mem"]]
        if len(big) < n:
            return "needs %d GPU(s)%s%s; this host has %d that could hold it" % (
                n, " like %r" % model if model else "",
                "" if job.get("pilot") else " with %s" % _gbs(size["gpu_mem"]), len(big))
    return None


SCHED_GROUP, SCHED_PARALLEL = "sched", 256
HEARTBEAT_MIN_S = 120
IN_FLIGHT = ("Queued", "Running", "Paused", "Locked")
RECORD_FIELDS = ("token", "task", "session", "host", "pueue_id", "grp", "submitted", "released", "started", "ended",
                 "exit", "how", "size", "size_source", "like_from", "pilot", "constraints", "gpus", "peak_cpu",
                 "peak_ram", "memory_peak", "peak_gpu_mem", "peaks_final")


class Admission:
    """One admission host's files: queue, assignments, alerts, records, heartbeat and room snapshot."""

    def __init__(self, settings):
        self.s = settings
        self.dir = settings["state_dir"]
        for d in ("queue", "assign", "alerts"):
            os.makedirs(os.path.join(self.dir, d), mode=0o700, exist_ok=True)

    def path(self, *parts):
        return os.path.join(self.dir, *parts)

    def lock(self, name):
        """An exclusive lock on state_dir/<name>; release with os.close."""
        fd = os.open(self.path(name), os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd

    def write_json(self, path, obj):
        tmp = "%s.tmp.%d" % (path, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(obj, f)
        os.replace(tmp, path)

    def read_json(self, path):
        try:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError):
            return None

    def queue(self):
        """Every queue file, oldest submit first."""
        out = []
        for name in os.listdir(self.path("queue")):
            if name.endswith(".json"):
                q = self.read_json(self.path("queue", name))
                if q and q.get("token") == name[:-5]:
                    out.append(q)
        return sorted(out, key=lambda q: (q["submitted"], q["token"]))

    def save(self, q):
        self.write_json(self.path("queue", q["token"] + ".json"), q)

    def assign_path(self, token):
        return self.path("assign", token + ".env")

    def alert(self, q, kind, msg):
        """Append an ALERT for the job's waits, once per kind per job."""
        if kind in q.setdefault("alerted", []):
            return
        q["alerted"].append(kind)
        with open(self.path("alerts", q["token"] + ".jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps({"t": time.time(), "kind": kind, "message": msg}) + "\n")

    # -- records -----------------------------------------------------------------------------------------------

    def db(self):
        con = sqlite3.connect(self.path("admission.sqlite"), timeout=30)
        con.execute("CREATE TABLE IF NOT EXISTS jobs (%s, PRIMARY KEY (token))" % ", ".join(RECORD_FIELDS))
        con.execute("CREATE TABLE IF NOT EXISTS samples (t REAL, kind TEXT, key TEXT, value REAL)")
        con.execute("CREATE INDEX IF NOT EXISTS samples_t ON samples (t)")
        return con

    def record(self, con, row):
        cols = [k for k in RECORD_FIELDS if k in row]
        vals = [json.dumps(row[k]) if isinstance(row[k], (dict, list)) else row[k] for k in cols]
        con.execute("INSERT INTO jobs (%s) VALUES (%s) ON CONFLICT(token) DO UPDATE SET %s" % (
            ", ".join(cols), ", ".join("?" * len(cols)), ", ".join("%s=excluded.%s" % (c, c) for c in cols)), vals)

    def find(self, con, ref):
        """The record a --like names: a token, or HOST#ID for the newest job with that id here."""
        con.row_factory = sqlite3.Row
        if "#" in ref:
            try:
                tid = int(ref.rsplit("#", 1)[1])
            except ValueError:
                return None
            r = con.execute("SELECT * FROM jobs WHERE pueue_id = ? ORDER BY submitted DESC LIMIT 1", (tid,)).fetchone()
        else:
            r = con.execute("SELECT * FROM jobs WHERE token = ?", (ref,)).fetchone()
        con.row_factory = None
        return dict(r) if r else None


def _size_from(settings, adm, capacity, req):
    """The size a submit asks for: (size, source, pilot, like_from). Raises JobError naming the options."""
    a = req.get("admission") or {}
    explicit = {k: a.get(k) for k in ("cpus", "ram", "gpus", "gpu_mem", "gpu_share") if a.get(k) is not None}
    chosen = [k for k in ("pilot", "like", "small") if a.get(k)] + (["explicit"] if explicit else [])
    if len(chosen) != 1:
        raise JobError("an admission host needs exactly one size: --pilot, --like TOKEN, --small, or "
                       "--cpus/--ram/--gpus/--gpu-mem/--gpu-share" + ("" if not chosen else
                                                                     " (got %s)" % ", ".join(chosen)))
    small = settings["small"]
    size = {"cpus": float(small["cpus"]), "ram": int(small["ram_gb"] * GB), "gpus": 0, "gpu_mem": 0,
            "gpu_share": 0.0, "disk_mb_s": 0.0}
    for k in ("cpus", "gpu_share"):
        if k in explicit:
            size[k] = float(_num(explicit[k], "--" + k.replace("_", "-"), lo=0.0))
    for k in ("ram", "gpus", "gpu_mem"):
        if k in explicit:
            size[k] = int(_num(explicit[k], "--" + k.replace("_", "-"), lo=0, whole=True))
    if "gpu_mem" in explicit and not size["gpus"]:
        size["gpus"] = 1
    if size["gpus"] and not size["gpu_mem"] and not a.get("pilot"):
        raise JobError("--gpus needs --gpu-mem (memory per GPU), or use --pilot to measure it")
    if a.get("pilot"):
        size["gpus"] = int(a.get("gpus") or 0)
        if "cpus" in a and a["cpus"] is not None:
            size["cpus"] = float(a["cpus"])
        return size, "pilot", True, None
    if a.get("small"):
        return size, "small", False, None
    if a.get("like"):
        con = adm.db()
        try:
            r = adm.find(con, str(a["like"]))
        finally:
            con.close()
        if r is None:
            raise JobError("--like %s: no record of that job on %s" % (a["like"], socket.gethostname()))
        if not ((r["how"] == "exit" and r["exit"] == 0) or r["how"] == "pilot time limit"):
            raise JobError("--like %s: that run ended by %s (exit %s), so its peaks are only a lower bound; "
                           "size it from a run that exited 0 or a pilot that reached its time limit"
                           % (a["like"], r["how"] or "?", r["exit"]))
        m = settings["margins"]
        ram_max = capacity["mem_total"] - settings["ram_headroom_gb"] * GB
        gpu_max = max([c["total"] for c in capacity["gpus"]] or [0]) - settings["gpu_headroom_mb"] * MB
        peak_ram, peak_gpu = r["peak_ram"] or 0, r["peak_gpu_mem"] or 0
        size["cpus"] = max(0.1, round((r["peak_cpu"] or 0) * m["cpu"], 1))
        size["ram"] = int(min(peak_ram * m["ram"], ram_max) if peak_ram <= ram_max else peak_ram * m["ram"])
        size["gpus"] = len(json.loads(r["gpus"] or "[]"))
        size["gpu_mem"] = int(min(peak_gpu * m["gpu_mem"], gpu_max) if peak_gpu <= gpu_max else peak_gpu * m["gpu_mem"])
        return size, "like", False, r["token"]
    return size, "explicit", False, None


def _capacity(measure):
    mem = measure.meminfo()
    try:
        cards = measure.gpus()
    except (OSError, ValueError):
        cards = []
    return {"mem_total": mem.get("MemTotal", 0), "threads": measure.threads(),
            "gpus": [{"uuid": c["uuid"], "index": c["index"], "name": c["name"], "total": c["total"]} for c in cards]}


def _measure_from_env():
    return Measure(proc=os.environ.get("JOB_TEST_PROC", "/proc"), sys_root=os.environ.get("JOB_TEST_SYS", "/sys"),
                   cgroup_root=os.environ.get("JOB_TEST_CGROUP", "/sys/fs/cgroup"))


def _heartbeat_age(adm):
    hb = adm.read_json(adm.path("heartbeat"))
    return None if not hb else time.time() - hb.get("t", 0)


def _heartbeat_limit(settings):
    return max(3 * settings["sample_interval_s"], HEARTBEAT_MIN_S)


def _simulate_fit(settings, adm, job):
    """For fit_now: would the loop release this job in its next cycle, counting the held jobs ahead of it?"""
    snap = adm.read_json(adm.path("room.json"))
    age = _heartbeat_age(adm)
    if not snap or age is None or age > _heartbeat_limit(settings):
        return False, "the admission loop is not running here"
    room = snap["room"]
    for q in adm.queue():
        if q.get("state") == "held":
            ok, got = fits(settings, room, q)
            if ok:
                _take(room, q, got)
    return fits(settings, room, job)


def _take(room, job, got):
    """Count a released job against a room (within one cycle, before the next measurement)."""
    room["ram"]["room"] -= got["ram_counted"]
    room["cpu"]["room"] -= job["size"]["cpus"]
    room["cpu"]["placed_room"] -= job["size"]["cpus"]
    for gid in got["gpus"]:
        g = room["gpus"][gid]
        g["room"] -= got["gpu_counted"][gid]
        g["shares"] += job["size"].get("gpu_share") or 0


def host_submit_admitted(req, settings, command):
    """host_submit on an admission host: size the job, queue it held, and let the loop release it."""
    if req.get("protocol") != PROTOCOL_ADMISSION or not isinstance(req.get("admission"), dict):
        raise JobError("protocol mismatch: %s admits jobs by size (job %s); update job on the submitting machine "
                       "and give a size (--pilot, --like, --small or --cpus/--ram/--gpus/--gpu-mem)"
                       % (socket.gethostname(), VERSION))
    if req.get("scope") is not None:
        raise JobError("an admission host sets the scope itself; do not send one")
    bad = sorted(k for k in (req.get("env") or {}) if k in GPU_VARS)
    if bad:
        raise JobError("%s is set by admission; ask for GPUs with --gpus" % ", ".join(bad))
    adm = Admission(settings)
    measure = _measure_from_env()
    capacity = _capacity(measure)
    size, source, pilot, like_from = _size_from(settings, adm, capacity, req)
    a = req["admission"]
    constraints = {k: a[k] for k in ("gpu_model", "data", "stop_at", "in_containers", "restartable") if a.get(k)}
    job = {"size": size, "pilot": pilot, "constraints": constraints}
    why = fits_empty(settings, capacity, job)
    if why:
        raise JobError("cannot run on %s even when it is empty: %s" % (socket.gethostname(), why))
    if settings["preemptible"] and not constraints.get("restartable"):
        raise JobError("%s may be reclaimed; only --restartable jobs run here" % socket.gethostname())
    fd = adm.lock("queue.lock")
    try:
        st = _pueue_status()
        token = req.get("token") or uuid.uuid4().hex
        if not all(c in "0123456789abcdef" for c in token) or len(token) != 32:
            raise JobError("bad token")
        for _, t in st.get("tasks", {}).items():
            if (t.get("envs") or {}).get("JOB_TOKEN") == token:  # a retried submit whose first attempt got through
                return {"id": int(t["id"]), "token": token, "host": socket.gethostname(), "existing": True}
        group = req.get("group") or SCHED_GROUP
        groups = st.get("groups", {})
        if group == SCHED_GROUP and group not in groups:
            _pueue(["group", "add", SCHED_GROUP])
            _pueue(["parallel", str(SCHED_PARALLEL), "--group", SCHED_GROUP])
        elif group not in groups:
            raise JobError("pueue group %r does not exist on %s; create it with 'job group <host> %s <n>'"
                           % (group, socket.gethostname(), group))
        data_disk = measure.disk_of(constraints["data"]) if constraints.get("data") else None
        q = {"token": token, "task": req["task"], "session": req.get("session") or "unknown",
             "from": req.get("from") or "?", "submitted": time.time(), "group": group, "size": size,
             "size_source": source, "like_from": like_from, "pilot": pilot, "constraints": constraints,
             "data_disk": data_disk, "state": "held"}
        if a.get("fit_now"):
            ok, got = _simulate_fit(settings, adm, q)
            if not ok:
                raise JobError("no room on %s now: %s" % (socket.gethostname(), got))
        adm.save(q)
        try:
            reply = host_submit(dict(req, token=token, group=group, stashed=True,
                                     admitted={"assign": adm.assign_path(token),
                                               "oom_score_adj": settings["oom_score_adj"],
                                               "gpu_env": settings["gpu_env"]}), _admission_checked=True)
        except JobError:
            os.remove(adm.path("queue", token + ".json"))
            raise
        q["pueue_id"] = reply["id"]
        adm.save(q)
        con = adm.db()
        try:
            adm.record(con, {"token": token, "task": q["task"], "session": q["session"], "host": socket.gethostname(),
                             "pueue_id": reply["id"], "grp": group, "submitted": q["submitted"], "size": size,
                             "size_source": source, "like_from": like_from, "pilot": int(pilot),
                             "constraints": constraints, "peaks_final": 0})
            con.commit()
        finally:
            con.close()
        reply["held"] = True
        return reply
    finally:
        os.close(fd)


HOW_LABEL = {"exit": "exit", "memory_limit": "memory limit", "host_oom": "host out of memory", "sigkill": "killed",
             "scope_killed": "killed", "killed": "killed", "setup_error": "wrapper error",
             "wrapper_error": "wrapper error"}


def _task_status(t):
    return next(iter(t.get("status") or {"?": 0})) if t else None


class Loop:
    """The admission loop of one host (docs/admission.md, "The admission loop")."""

    def __init__(self, settings, measure=None, clock=time.time):
        self.s, self.adm = settings, Admission(settings)
        self.m = measure or _measure_from_env()
        self.clock = clock
        self.samples = []
        self.keep_s = max(settings["outside_window_s"], settings["cpu_window_s"], GPU_BUSY_WINDOW_S) + 60
        self.disk_names = {}
        for p in settings["disks"]:
            d = self.m.disk_of(p)
            if d:
                self.disk_names[p] = d
        self.capacity = _capacity(self.m)
        self.room = self.room_empty = None
        self.peaks = {}

    # -- one cycle -----------------------------------------------------------------------------------------------

    def sample(self, now, scopes):
        busy, iowait = self.m.cpu(now)
        mem = self.m.meminfo()
        try:
            cards = self.m.gpus()
        except (OSError, ValueError):
            cards = []
        jobs = self.m.job_use(now, scopes)
        by_cg = {}
        for tok, path in scopes.items():
            by_cg[path[len(self.m.cg):]] = tok
        for c in cards:
            for pid, used in c["procs"].items():
                cg = self.m.cgroup_of(pid) or ""
                for prefix, tok in by_cg.items():
                    if (cg == prefix or cg.startswith(prefix + "/")) and tok in jobs:
                        g = jobs[tok].setdefault("gpu", {})
                        g[c["uuid"]] = g.get(c["uuid"], 0) + used
        s = {"t": now, "busy": busy, "iowait": iowait or 0.0, "avail": mem.get("MemAvailable", 0),
             "psi": self.m.memory_pressure(), "disks": self.m.disks(now, set(self.disk_names.values())),
             "gpus": {c["uuid"]: {k: c[k] for k in ("index", "name", "total", "used", "util")} for c in cards},
             "jobs": {tok: {"ram": j["ram"], "cpu": j["cpu"], "gpu": j.get("gpu", {})} for tok, j in jobs.items()},
             "holds": {}}
        self.samples.append(s)
        self.samples = [x for x in self.samples if now - x["t"] <= self.keep_s]
        return s, jobs

    def cycle(self):
        """Measure, account, end, release; returns the seconds to sleep before the next cycle."""
        now = self.clock()
        scopes = self.m.scopes()
        s, use = self.sample(now, scopes)
        try:
            st = _pueue_status()
        except JobError:
            st = None
        queue = self.adm.queue()
        con = self.adm.db()
        try:
            if st is not None:
                tasks = {}
                for _, t in st.get("tasks", {}).items():
                    tok = (t.get("envs") or {}).get("JOB_TOKEN")
                    if tok:
                        tasks[tok] = t
                self.account(con, now, queue, tasks, use, st)
                inflight = [q for q in queue if q.get("state") == "released"]
                self.room = compute_room(self.s, self.samples, [self._counted(q) for q in inflight], [], now)
                self.room_empty = compute_room(self.s, self.samples, [], [], now)  # as if no admitted job ran
                self.release(con, now, queue, tasks, st)
                self.clean_scopes(scopes, queue, tasks, use)
            con.execute("DELETE FROM samples WHERE t < ?", (now - 7 * 86400,))
            con.executemany("INSERT INTO samples VALUES (?, ?, ?, ?)", self._sample_rows(s))
            con.commit()
        finally:
            con.close()
        self.write_snapshot(now, queue, st is not None)
        pilots = any(q.get("pilot") and q.get("state") == "released" for q in queue)
        return self.s["pilot_sample_interval_s"] if pilots else self.s["sample_interval_s"]

    def _sample_rows(self, s):
        rows = [(s["t"], "host", "busy", s["busy"]), (s["t"], "host", "avail", s["avail"]),
                (s["t"], "host", "psi", s["psi"]), (s["t"], "host", "iowait", s["iowait"])]
        rows += [(s["t"], "disk", n, v) for n, v in s["disks"].items()]
        for u, g in s["gpus"].items():
            rows += [(s["t"], "gpu_used", u, g["used"]), (s["t"], "gpu_util", u, g["util"])]
        return [r for r in rows if r[3] is not None]

    def _counted(self, q):
        return {"token": q["token"], "released": q["released"], "size": q["size"], "gpus": q.get("gpus", []),
                "ram_counted": q.get("ram_counted", q["size"]["ram"]), "gpu_counted": q.get("gpu_counted", {})}

    def account(self, con, now, queue, tasks, use, st):
        """Track released jobs until their scope is empty; record peaks; end jobs; enforce time limits."""
        for q in queue:
            t = tasks.get(q["token"])
            status = _task_status(t)
            u = use.get(q["token"])
            if q.get("state") == "held":
                if t is None:  # removed before release, or still being added: give a submit time to finish
                    if now - q["submitted"] > 120:
                        self.end(con, q, now, "removed", None)
                elif q["constraints"].get("stop_at") and _parse_time(q["constraints"]["stop_at"]) <= now:
                    _pueue(["remove", str(t["id"])])
                    self.end(con, q, now, "dropped at stop-at", None)
                continue
            # released
            p = self.peaks.setdefault(q["token"], {"cpu": 0.0, "ram": 0, "gpu": 0})
            if u:
                p["cpu"] = max(p["cpu"], u["cpu"] or 0.0)
                p["ram"] = max(p["ram"], u["ram"])
                p["gpu"] = max([p["gpu"]] + list(u.get("gpu", {}).values()))
                over = [uu for uu, b in u.get("gpu", {}).items() if b > q["size"]["gpu_mem"] > 0 and not q.get("pilot")]
                if over:
                    self.adm.alert(q, "gpu_over_size", "uses %s on a GPU, over its GPU memory size of %s; no new job "
                                   "goes on that card until it is back under" % (
                                       _gbs(max(u["gpu"].values())), _gbs(q["size"]["gpu_mem"])))
            if status == "Running" and not q.get("started"):
                q["started"] = now
            if status in ("Running", "Paused") and q.get("stop_reason") is None:
                limit = None
                if q.get("pilot"):
                    limit = q["released"] + 60 * float(q["constraints"].get("max_minutes") or
                                                       self.s["pilot"]["max_minutes"])
                    reason = "pilot time limit"
                if q["constraints"].get("stop_at"):
                    at = _parse_time(q["constraints"]["stop_at"])
                    if limit is None or at < limit:
                        limit, reason = at, "stop-at"
                if limit is not None and now >= limit:
                    q["stop_reason"] = reason
                    self.adm.save(q)
                    try:
                        host_kill({"id": t["id"], "token": q["token"]})
                    except JobError:
                        pass
                    continue
            running = status in IN_FLIGHT or (u is not None and u["populated"])
            if running:
                self.record_peaks(con, q, final=False)
                self.adm.save(q)
                continue
            if t is None and st is None:
                continue  # never end a job on a failed pueue read
            self.end(con, q, now, None, t)

    def record_peaks(self, con, q, final):
        p = self.peaks.get(q["token"], {})
        self.adm.record(con, {"token": q["token"], "released": q.get("released"), "started": q.get("started"),
                              "gpus": q.get("gpus", []), "peak_cpu": p.get("cpu"), "peak_ram": p.get("ram"),
                              "peak_gpu_mem": p.get("gpu"), "peaks_final": int(final)})

    def end(self, con, q, now, how, t):
        """A job ended (or left the queue): write its final record and forget it."""
        row = {"token": q["token"], "ended": now}
        if how is None:
            res = _scope_result(q["token"]) or {}
            if q.get("stop_reason"):
                how = q["stop_reason"]
            elif t is not None and (t.get("status") or {}).get("Done", {}).get("result") == "Killed":
                how = "killed"
            else:
                how = HOW_LABEL.get(res.get("how"), res.get("how") or "exit")
            rec = os.path.join(STATE_DIR, "results", q["token"] + ".exit")
            try:
                with open(rec) as f:
                    row["exit"] = int(f.read().strip())
            except (OSError, ValueError):
                row["exit"] = None
            row["memory_peak"] = res.get("memory_peak_incl_cache")
            self.record_peaks(con, q, final=True)
        row["how"] = how
        self.adm.record(con, row)
        for path in (self.adm.path("queue", q["token"] + ".json"), self.adm.assign_path(q["token"])):
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
        self.peaks.pop(q["token"], None)
        q["state"] = "ended"

    def release(self, con, now, queue, tasks, st):
        """Release held jobs that fit, oldest first; once the oldest has waited fairness_wait_min, a younger
        job is released only if it takes nothing from a resource the oldest is short of."""
        if self.room is None:
            return
        room = json.loads(json.dumps(self.room))
        groups = st.get("groups", {})
        running = {}
        for t in st.get("tasks", {}).values():
            if _task_status(t) in ("Running", "Queued"):  # an enqueued job takes a slot as soon as one is free
                running[t.get("group")] = running.get(t.get("group"), 0) + 1
        blocked = None  # the resources the waiting oldest job is short of
        fd = self.adm.lock("queue.lock")
        try:
            for q in queue:
                if q.get("state") != "held":
                    continue
                t = tasks.get(q["token"])
                if t is None or _task_status(t) != "Stashed":
                    continue
                g = groups.get(q["group"]) or {}
                if g.get("status") == "Paused":
                    q["reason"] = "its group %s is paused" % q["group"]
                    self.adm.alert(q, "group_paused", "held: its pueue group %s is paused; resume it with "
                                   "'pueue start --group %s'" % (q["group"], q["group"]))
                    self.adm.save(q)
                    continue
                if running.get(q["group"], 0) >= (g.get("parallel_tasks") or 1):
                    q["reason"] = "its group %s is full" % q["group"]
                    self.adm.save(q)
                    continue
                ok, got = fits(self.s, room, q, q.get("data_disk"))
                if ok and blocked is not None and blocked & self._resources(q, got):
                    ok, got = False, "waiting behind an older job that needs the same room"
                if not ok:
                    q["reason"] = got
                    self.adm.save(q)
                    if (blocked is None and now - q["submitted"] >= 60 * self.s["fairness_wait_min"]
                            and fits(self.s, self.room_empty, q, q.get("data_disk"))[0]):
                        # it would fit once admitted jobs end, so younger jobs must not take that room
                        blocked = self._short_of(room, q)
                    continue
                self.enqueue(con, now, q, t, got)
                _take(room, q, got)
                running[q["group"]] = running.get(q["group"], 0) + 1
        finally:
            os.close(fd)

    def _resources(self, q, got):
        r = {"ram", "cpu"} if q["size"]["ram"] or q["size"]["cpus"] else set()
        r |= {"gpu:" + u for u in got["gpus"]}
        if q.get("data_disk"):
            r.add("disk:" + q["data_disk"])
        return r

    def _short_of(self, room, q):
        """What a held job lacks now; an empty set when it is held for some other reason."""
        short = set()
        size = q["size"]
        if size["ram"] > room["ram"]["room"] or q.get("pilot"):
            short.add("ram")
        if size["cpus"] > room["cpu"]["room"]:
            short.add("cpu")
        if size.get("gpus"):
            short |= {"gpu:" + u for u in room["gpus"]}
        if q.get("data_disk"):
            short.add("disk:" + q["data_disk"])
        return short

    def enqueue(self, con, now, q, t, got):
        """Release one job: write its assignment, then pueue enqueue <id> (never without an id)."""
        memory_max = int(got["ram_counted"] if q.get("pilot") else q["size"]["ram"] * self.s["ram_hard_factor"])
        memory_max = _whole_pages(max(memory_max, SCOPE_MIN_MEMORY))
        lines = ["JOB_MEMORY_MAX=%d" % memory_max, "CUDA_VISIBLE_DEVICES=%s" % ",".join(got["gpus"]),
                 "JOB_GPU_UUIDS=%s" % ",".join(got["gpus"])]
        path = self.adm.assign_path(q["token"])
        with open(path + ".tmp", "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(path + ".tmp", path)
        q.update({"state": "released", "released": now, "gpus": got["gpus"], "ram_counted": got["ram_counted"],
                  "gpu_counted": got["gpu_counted"], "memory_max": memory_max, "reason": None})
        self.adm.save(q)
        try:
            _pueue(["enqueue", str(int(t["id"]))])
        except JobError as e:
            q.update({"state": "held", "reason": "release failed: %s" % e})
            self.adm.save(q)
            os.remove(path)
            return
        self.adm.record(con, {"token": q["token"], "released": now, "gpus": got["gpus"]})

    def clean_scopes(self, scopes, queue, tasks, use):
        """Stop a job scope whose task is Done or gone; scopes of other names are never touched."""
        known = {q["token"] for q in queue if q.get("state") != "ended"}
        for tok in scopes:
            t = tasks.get(tok)
            if tok in known or (t is not None and _task_status(t) != "Done"):
                continue
            if t is None and not os.path.exists(os.path.join(STATE_DIR, "scripts", tok + ".shim")):
                continue  # not a job of this host's pueue: leave it alone
            if use.get(tok, {}).get("populated"):
                _stop_scope(tok)

    def write_snapshot(self, now, queue, pueue_ok):
        held = [{"token": q["token"], "task": q["task"], "reason": q.get("reason"), "waited_s": now - q["submitted"],
                 "size": q["size"], "pilot": q.get("pilot")} for q in queue if q.get("state") == "held"]
        jobs = [{"token": q["token"], "task": q["task"], "size": q["size"], "gpus": q.get("gpus"),
                 "released": q.get("released")} for q in queue if q.get("state") == "released"]
        self.adm.write_json(self.adm.path("room.json"), {"t": now, "host": socket.gethostname(), "room": self.room,
                                                         "capacity": self.capacity, "held": held, "jobs": jobs,
                                                         "pueue_ok": pueue_ok})
        self.adm.write_json(self.adm.path("heartbeat"), {"t": now, "pid": os.getpid(), "version": VERSION})


def admit_main(once=False):
    """`job _admit`: run the admission loop of this host (one instance per host)."""
    settings = _admission_settings()
    if settings is None:
        raise JobError("no admission settings at %s; this host is not an admission host" % ADMISSION_CONFIG)
    adm = Admission(settings)
    fd = os.open(adm.path("loop.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise JobError("the admission loop already runs on %s" % socket.gethostname())
    me = os.path.realpath(__file__)
    started_mtime = os.path.getmtime(me)
    loop = Loop(settings)
    results = os.path.join(STATE_DIR, "results")
    os.makedirs(results, mode=0o700, exist_ok=True)
    while True:
        wait = loop.cycle()
        if once:
            return 0
        marks = (os.path.getmtime(results), os.path.getmtime(adm.path("queue")))
        end = time.monotonic() + wait
        while time.monotonic() < end:
            time.sleep(1)
            try:
                if (os.path.getmtime(results), os.path.getmtime(adm.path("queue"))) != marks:
                    break  # a job ended or one was submitted
            except OSError:
                break
        try:
            if os.path.getmtime(me) != started_mtime:  # a new job was installed: run it
                os.close(fd)
                os.execv(sys.executable, [sys.executable, me, "_admit"])
        except OSError:
            pass


def host_room(req):
    """The admission loop's last snapshot and its age; {"admission": false} on other hosts."""
    settings = _admission_settings()
    if settings is None:
        return {"admission": False, "hostname": socket.gethostname()}
    adm = Admission(settings)
    snap = adm.read_json(adm.path("room.json")) or {}
    age = _heartbeat_age(adm)
    snap.update({"admission": True, "hostname": socket.gethostname(), "heartbeat_age": age,
                 "stale": age is None or age > _heartbeat_limit(settings), "settings": settings,
                 "paths": [x for x in (req.get("paths") or []) if isinstance(x, str) and os.path.exists(x)]})
    return snap


HOST_OPS = {"submit": host_submit, "probe": host_probe, "ls": host_ls,
            "group": host_group, "kill": host_kill, "room": host_room}


def host_main(op):
    try:
        req = json.loads(sys.stdin.read() or "{}")
        if req.get("pueue_config"):  # tests: point the host side at a throwaway pueued
            os.environ["JOB_PUEUE_CONFIG"] = req["pueue_config"]
            global STATE_DIR
            STATE_DIR = os.path.join(os.path.dirname(req["pueue_config"]), "state")
        if req.get("protocol") not in ACCEPTED_PROTOCOLS:
            raise JobError("protocol mismatch: client %s, host %s (job %s on %s); install the same "
                           "version on both (install.sh)" % (req.get("protocol"),
                                                             "/".join(str(p) for p in ACCEPTED_PROTOCOLS),
                                                             VERSION, socket.gethostname()))
        reply = {"ok": True, "data": HOST_OPS[op](req)}
    except JobError as e:
        reply = {"ok": False, "error": str(e)}
    except Exception as e:  # report, never hang the client
        reply = {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
    sys.stdout.write("\n" + json.dumps(reply) + "\n")
    return 0


# --------------------------------------------------------------------------
# client side
# --------------------------------------------------------------------------

class Unreachable(Exception):
    pass


def call(host, op, req, timeout=120):
    """Run a host op on `host` and return its data, raising JobError or Unreachable."""
    if host not in HOSTS:
        raise JobError("unknown host %r; known hosts: %s (add it to %s)" % (host, ", ".join(HOSTS), HOSTS_FILE))
    req = dict(req, protocol=_request_protocol(op, req))
    dest = HOSTS[host]
    if dest is None:
        try:
            return HOST_OPS[op](req)
        except OSError as e:
            raise JobError(str(e))
    if os.environ.get("JOB_REMOTE_PUEUE_CONFIG"):
        req["pueue_config"] = os.environ["JOB_REMOTE_PUEUE_CONFIG"]
    remote_cmd = "$HOME/.local/bin/job _host %s" % op
    try:
        p = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20",
             "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4",
             "-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/job-cm-%C", "-o", "ControlPersist=5m",
             dest, remote_cmd],
            input=json.dumps(req), capture_output=True, encoding="utf-8", errors="replace", timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Unreachable("ssh %s timed out after %ds" % (dest, timeout))
    except OSError as e:
        raise JobError("cannot run ssh: %s" % e)
    if p.returncode == 255:
        raise Unreachable("ssh %s: %s" % (dest, p.stderr.strip()[-500:]))
    reply = None
    for line in reversed(p.stdout.splitlines()):  # tolerate login noise before the reply
        if line.startswith("{"):
            try:
                reply = json.loads(line)
            except ValueError:
                reply = None
            break
    if not isinstance(reply, dict):
        raise JobError("%s: no reply from job on the host (exit %d): %s" % (
            host, p.returncode, (p.stderr or p.stdout).strip()[-800:]))
    if not reply.get("ok"):
        err = reply.get("error") or ""
        if err.startswith("protocol mismatch"):
            raise ProtocolError("%s: %s" % (host, err))
        raise JobError("%s: %s" % (host, err))
    return reply["data"]


def _session():
    for k in ("JOB_SESSION", "CLAUDE_CODE_HOST_SESSION_ID", "CLAUDE_CODE_SESSION_ID"):
        v = os.environ.get(k)
        if v:
            return v
    return "unknown"


def _parse_time(s):
    if not s:
        return None
    # pueue prints nanoseconds; Python before 3.11 wants at most microseconds
    try:
        head, frac_tz = s.split(".", 1)
        i = 0
        while i < len(frac_tz) and frac_tz[i].isdigit():
            i += 1
        s = head + "." + frac_tz[:i][:6].ljust(6, "0") + frac_tz[i:]
    except ValueError:
        pass
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def _fmt_dur(seconds):
    if seconds is None:
        return "?"
    seconds = float(seconds)
    if seconds < 90:
        return "%.0f s" % seconds
    if seconds < 5400:
        return "%.1f min" % (seconds / 60)
    if seconds < 172800:
        return "%.1f h" % (seconds / 3600)
    return "%.1f d" % (seconds / 86400)


def _fmt_et(t):
    """A time in this machine's local zone."""
    if t is None:
        return "?"
    return t.astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")


def _runtime(s):
    start, end = _parse_time(s.get("start")), _parse_time(s.get("end"))
    if start is None:
        return None
    end = end or dt.datetime.now(start.tzinfo)
    return (end - start).total_seconds()


def _parse_env(items):
    env = {}
    for it in items or []:
        if "=" in it:
            k, v = it.split("=", 1)
        else:
            k, v = it, os.environ.get(it)
            if v is None:
                raise JobError("--env %s: not set in this shell" % it)
        if not k or k.startswith("JOB_"):
            raise JobError("--env: bad variable name %r" % k)
        env[k] = v
    return env


def submit(args, command):
    """Queue the command, on args.host or, for auto, on the host admission places it on."""
    adm = _admission_request(args)
    if args.host == "auto":
        if adm is None:
            raise JobError("auto needs a size: --pilot, --like TOKEN, --small, or --cpus/--ram/--gpus/--gpu-mem")
        if getattr(args, "only_hosts", None):
            adm["hosts"] = args.only_hosts
        host, tid, token = place(args, command, adm)
        args.host = host
        return {"id": tid, "token": token}
    tid, token = submit_to(args, args.host, command, adm)
    return {"id": tid, "token": token}


def submit_to(args, host, command, adm):
    """Queue on one host; retried safely when the connection drops (the token makes it idempotent)."""
    token = uuid.uuid4().hex
    req = {"command": command, "task": args.task, "group": args.group, "cwd": args.cwd,
           "session": _session(), "from": socket.gethostname(), "token": token,
           "env": _parse_env(args.env), "normal_priority": bool(args.normal_priority)}
    if adm is not None:
        req["admission"] = adm
    if args.cwd is None and HOSTS.get(host) is None:
        req["cwd"] = os.getcwd()
    last = None
    for attempt in range(4):
        try:
            r = call(host, "submit", req)
            return r["id"], r["token"]
        except Unreachable as e:
            last = e
            sys.stderr.write("job: %s unreachable while queueing (%s); retrying\n" % (host, e))
            time.sleep(15 * (attempt + 1))
    raise Unreachable("%s; the job may or may not have been queued: check 'job ls %s' for task %s"
                      % (last, host, args.task))


SIZE_UNITS = {"": 1, "K": 10 ** 3, "M": 10 ** 6, "G": 10 ** 9, "T": 10 ** 12,
              "KI": 1 << 10, "MI": 1 << 20, "GI": 1 << 30, "TI": 1 << 40}
HELD_NOTICE_S = 600


def _parse_size(text):
    """'20G' (10^9), '512Mi' (2^20), '1.5T' or plain bytes, to whole bytes."""
    t = text.strip().upper().rstrip("B")
    i = len(t)
    while i and not (t[i - 1].isdigit() or t[i - 1] == "."):
        i -= 1
    num, unit = t[:i], t[i:]
    try:
        value = float(num)
    except ValueError:
        value = None
    if value is None or unit not in SIZE_UNITS or value < 0:
        raise argparse.ArgumentTypeError("not a size: %r (examples: 20G, 512Mi, 1.5T)" % text)
    return int(value * SIZE_UNITS[unit])


def _admission_request(args):
    """The size and constraints the caller gave, or None when none were given."""
    a = {}
    for k in ("cpus", "ram", "gpus", "gpu_mem", "gpu_share", "like", "gpu_model", "data", "stop_at", "max_minutes"):
        v = getattr(args, k, None)
        if v is not None:
            a[k] = v
    for k in ("pilot", "small", "in_containers", "restartable"):
        if getattr(args, k, False):
            a[k] = True
    if a.get("stop_at"):
        if _parse_time(a["stop_at"]) is None:
            raise JobError("--stop-at needs a time like 2026-11-10T08:00-05:00")
        a["stop_at"] = _parse_time(a["stop_at"]).isoformat()
    return a or None


def _rooms(hosts, timeout=60, paths=()):
    """{host: snapshot or error text} from each host's admission loop, asked in parallel."""
    out = {}

    def ask(h):
        try:
            out[h] = call(h, "room", {"paths": list(paths)}, timeout=timeout)
        except (JobError, Unreachable) as e:
            out[h] = str(e)

    threads = [threading.Thread(target=ask, args=(h,)) for h in hosts]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout + 5)
    return out


def _placement_hosts():
    return ["local"] + [h for h in LISTED if h != "local"] if "local" not in LISTED else list(LISTED)


def place(args, command, adm):
    """`auto`: try each admission host with room now (fit_now), else hold the job on the best host."""
    names = _placement_hosts()
    rooms = _rooms(names, paths=[adm["data"]] if adm.get("data") else [])
    usable, skipped = [], []
    for h in names:
        r = rooms.get(h)
        if not isinstance(r, dict):
            skipped.append("%s (%s)" % (h, r))
        elif not r.get("admission"):
            continue
        elif r.get("stale") or not r.get("room"):
            skipped.append("%s (its admission loop is not running)" % h)
        else:
            usable.append(h)
    if skipped:
        sys.stderr.write("job: auto skipped %s\n" % "; ".join(skipped))
    if not usable:
        raise JobError("no admission host is available for auto")
    want_host = set(adm.pop("hosts", []) or [])
    if want_host:
        usable = [h for h in usable if h in want_host]

    def order(h):
        r = rooms[h]
        probe = {"size": _probe_size(adm), "pilot": bool(adm.get("pilot")), "constraints": adm}
        try:
            ok = fits(r["settings"], r["room"], probe)[0] if r.get("settings") else False
        except (KeyError, TypeError):
            ok = False
        return (not ok, -int(bool(adm.get("data")) and adm["data"] in (r.get("paths") or [])), len(r.get("held") or []))

    usable.sort(key=order)
    for h in usable:
        try:
            tid, token = submit_to(args, h, command, dict(adm, fit_now=True))
            sys.stderr.write("job: auto placed the job on %s\n" % h)
            return h, tid, token
        except JobError as e:
            if "no room" not in str(e):
                raise
    h = usable[0]
    tid, token = submit_to(args, h, command, adm)
    sys.stderr.write("job: no host has room now; the job is held on %s until it fits\n" % h)
    return h, tid, token


def _probe_size(adm):
    small = {"cpus": 1.0, "ram": 4 * 10 ** 9}
    return {"cpus": float(adm.get("cpus") or small["cpus"]), "ram": int(adm.get("ram") or small["ram"]),
            "gpus": int(adm.get("gpus") or (1 if adm.get("gpu_mem") else 0)), "gpu_mem": int(adm.get("gpu_mem") or 0),
            "gpu_share": float(adm.get("gpu_share") or 0), "disk_mb_s": 0}


def cmd_room(args):
    hosts = args.hosts or _placement_hosts()
    rooms = _rooms(hosts)
    if args.json:
        print(json.dumps(rooms, indent=1, default=str))
        return 0
    for h in hosts:
        r = rooms.get(h)
        if not isinstance(r, dict):
            print("%s: unreachable (%s)" % (h, r))
            continue
        if not r.get("admission"):
            print("%s: not an admission host" % h)
            continue
        if r.get("stale") or not r.get("room"):
            age = r.get("heartbeat_age")
            print("%s: admission loop not running%s" % (h, "" if age is None else " (heartbeat %s old)" % _fmt_dur(age)))
            continue
        room = r["room"]
        cap = r.get("capacity") or {}
        print("%s: snapshot %s old; CPU %.1f busy of %s threads, %.1f free to admit; RAM %s free to admit; "
              "memory pressure %.1f%%" % (h, _fmt_dur(r.get("heartbeat_age") or 0), room["cpu"]["outside"]
                                           + room["cpu"]["committed"], cap.get("threads", "?"),
                                           max(0.0, room["cpu"]["room"]), _gbs(max(0, room["ram"]["room"])),
                                           room["psi"]))
        for name, busy in sorted(room.get("disks", {}).items()):
            print("  disk %s busy %.0f%%" % (name, busy))
        for gid, g in sorted(room.get("gpus", {}).items(), key=lambda kv: kv[1]["index"]):
            print("  GPU %d %s: %s free to admit of %s; outside use %s; busy %.0f%%" % (
                g["index"], g["name"], _gbs(max(0, g["room"])), _gbs(g["total"]), _gbs(g["outside"]), g["util"]))
        for j in r.get("jobs") or []:
            print("  running %s (%s): %g CPU, %s RAM%s" % (j["token"][:8], j["task"], j["size"]["cpus"],
                                                          _gbs(j["size"]["ram"]),
                                                          ", GPU %s" % ",".join(x[:12] for x in j["gpus"])
                                                          if j.get("gpus") else ""))
        for j in r.get("held") or []:
            print("  held %s (%s) for %s: %s" % (j["token"][:8], j["task"], _fmt_dur(j["waited_s"]),
                                                 j.get("reason") or "not checked yet"))
    return 0


def verdict_of(s):
    """Map a finished pueue task to (verdict, exit code)."""
    r, v = s.get("result"), s.get("result_value")
    if r == "Success":
        return "SUCCESS", 0
    if r == "Failed":
        try:
            return "FAILED", int(v)
        except (TypeError, ValueError):
            return "FAILED", 1
    if r == "Killed":
        return "KILLED", EXIT["KILLED"]
    if r == "FailedToSpawn":
        return "FAILED_TO_SPAWN", EXIT["FAILED_TO_SPAWN"]
    if r == "DependencyFailed":
        return "DEPENDENCY_FAILED", EXIT["DEPENDENCY_FAILED"]
    return "ERRORED", EXIT["ERRORED"]


def _gb(n):
    return "%.2f GB" % (n / 1e9)


def scope_verdict(verdict, code, scope):
    """Adjust a finished job's verdict with how its scope ended. Returns (verdict, code, note or None)."""
    if not scope:
        return verdict, code, None
    how, limit = scope.get("how"), scope.get("memory_max")
    if how == "wrapper_error":
        return ("WRAPPER_ERROR", EXIT["WRAPPER_ERROR"],
                "the job's systemd scope could not be started (systemd-run exit %s), so the job never ran; "
                "systemd-run's message went to the job's log" % scope.get("rc"))
    if how == "setup_error":
        return ("WRAPPER_ERROR", EXIT["WRAPPER_ERROR"],
                "the job's memory limit could not be set up (%s), so the job never ran" % scope.get("reason"))
    if how == "memory_limit":
        return verdict, code, "it went over its RAM limit of %s; the whole job was stopped" % _gb(limit or 0)
    if how == "host_oom":
        return verdict, code, ("the host ran out of memory and its out-of-memory killer stopped the job, which was "
                               "under its RAM limit of %s; the whole job was stopped" % _gb(limit or 0))
    if how == "sigkill":
        return verdict, code, ("it ended with signal 9 and no out-of-memory event, so not by its RAM limit: "
                               "systemd-oomd under memory pressure, a person, or the job itself sent it")
    if how == "scope_killed":
        return verdict, code, ("its whole scope was killed from outside, with its bookkeeping, for example by "
                               "systemd-oomd under memory pressure")
    notes = []
    ev = scope.get("memory_events") or {}
    if how == "exit" and (ev.get("oom_kill") or ev.get("oom_group_kill")):
        notes.append("after its command ended, a process it left running was killed for memory")
    elif how == "exit" and ev.get("oom"):
        notes.append("it reached its RAM limit of %s (allocations failed) but was not killed" % _gb(limit or 0))
    if scope.get("leftover"):
        notes.append("%d process(es) it left running were stopped when it ended" % scope["leftover"])
    return verdict, code, "; ".join(notes) or None


def report(host, o, out):
    s, verdict, code = o["s"], o["verdict"], o["code"]
    label = s.get("label") or "-"
    head = "job: %s %s#%s (%s)" % (verdict, host, s.get("id"), label)
    if verdict in ("SUCCESS", "FAILED"):
        head += " exit %d" % code
    head += " after %s" % _fmt_dur(_runtime(s))
    lines = [head]
    if o.get("note"):
        lines.append("note: " + o["note"])
    if s.get("status"):
        lines.append("status: %s%s" % (s.get("status"), (" / %s" % s.get("result")) if s.get("result") else ""))
        lines.append("started: %s   ended: %s" % (
            _fmt_et(_parse_time(s.get("start"))),
            _fmt_et(_parse_time(s.get("end"))) if s.get("end") else "not ended"))
        if s.get("summary") or s.get("command"):
            lines.append("command: %s" % (s.get("summary") or s.get("command")))
        if s.get("log_path"):
            lines.append("log: %s:%s" % (host, s.get("log_path")))
    if verdict == "ALERT" and s.get("status") == "Done":
        v, c = verdict_of(s)
        lines.append("the job has also ended: %s exit %d" % (v, c))
    if verdict in URGENT and s.get("status") not in (None, "Done"):
        tok = (" --token %s" % s["token"]) if s.get("token") else ""
        lines.append("the job was left running; reattach: job wait %s %s%s ; stop it: job kill %s %s%s"
                     % (host, s.get("id"), tok, host, s.get("id"), tok))
    tail = o.get("tail")
    if tail:
        lines.append("--- last %d log lines ---" % len(tail))
        lines.extend(tail)
        lines.append("--- end of log tail ---")
    out.write("\n".join(lines) + "\n")


def run_check(check, data, host, tid):
    env = dict(os.environ, JOB_HOST=host, JOB_ID=str(tid))
    try:
        p = subprocess.run([check], input=data, capture_output=True, env=env, timeout=300)
    except subprocess.TimeoutExpired:
        return False, "check script timed out after 300 s"
    except OSError as e:
        return False, "check script could not run: %s" % e
    msg = (p.stdout + p.stderr).decode("utf-8", "replace").strip()
    return p.returncode == 0, msg[-4000:] or ("check exited %d" % p.returncode)


class Waiter:
    """Follows one pueue task; step() returns None while it should keep waiting, else an outcome."""

    AGAIN = "again"  # more log output is waiting; step again before sleeping

    def __init__(self, host, tid, token=None, stall_min=30.0, stall_cpu=0.5, check=None,
                 from_start=False, tail=40, unreachable_min=15.0):
        self.host, self.tid, self.token = host, int(tid), token
        self.stall_s = stall_min * 60.0
        self.stall_cpu = stall_cpu / 100.0  # fraction of one core
        self.check, self.from_start, self.tail = check, from_start, tail
        self.unreachable_s = unreachable_min * 60.0
        self.offset = None
        self.partial = b""
        self.samples = []  # (monotonic time, log size, cpu ticks) while Running
        self.err_since = None
        self.told_queued = False
        self.told_notoken = False
        self.alert_cursor = None  # admission alerts already seen; a new wait starts at the current end
        self.told_held = None
        self.told_stale = False

    def _outcome(self, verdict, code, s, note=None, tail=True):
        """The verdict is already decided; a last probe only refreshes what is shown (status, tail)."""
        o = {"verdict": verdict, "code": code, "s": s, "note": note}
        if tail and s.get("found"):
            try:
                fresh = call(self.host, "probe", {"id": self.tid, "token": self.token, "tail_lines": self.tail})
            except (JobError, Unreachable):
                fresh = None
            if fresh and fresh.get("found") and not fresh.get("token_mismatch"):
                o["s"], o["tail"] = fresh, fresh.get("tail")
        return o

    def _run_check(self, data, s):
        ok, msg = run_check(self.check, data, self.host, self.tid)
        if ok:
            return None
        return self._outcome("ALERT", EXIT["ALERT"], s, note="check %s failed: %s" % (self.check, msg))

    def step(self):
        req = {"id": self.tid, "token": self.token}
        if self.alert_cursor is not None:
            req["alert_cursor"] = self.alert_cursor
        if self.check and self.offset is not None:
            req["log_offset"] = self.offset
        try:
            s = call(self.host, "probe", req)
        except ProtocolError as e:
            return self._outcome("WRAPPER_ERROR", EXIT["WRAPPER_ERROR"], {"id": self.tid},
                                 note="%s. The job keeps running; after reinstalling, reattach with: "
                                      "job wait %s %s%s" % (e, self.host, self.tid,
                                                            (" --token %s" % self.token) if self.token else ""),
                                 tail=False)
        except (Unreachable, JobError) as e:
            now = time.monotonic()
            self.err_since = self.err_since or now
            if now - self.err_since >= self.unreachable_s:
                return self._outcome(
                    "UNREACHABLE", EXIT["UNREACHABLE"], {"id": self.tid},
                    note="no state from %s for %s (last error: %s). The job may still be running; "
                         "reattach with: job wait %s %s%s" % (
                             self.host, _fmt_dur(now - self.err_since), e, self.host, self.tid,
                             (" --token %s" % self.token) if self.token else ""), tail=False)
            sys.stderr.write("job: cannot get the state of %s#%s (%s); retrying\n" % (self.host, self.tid, e))
            return None
        self.err_since = None
        if not s.get("found") or s.get("token_mismatch"):
            why = ("task id %s on %s now belongs to a different job" % (self.tid, self.host)
                   if s.get("token_mismatch") else
                   "task %s no longer exists in pueue on %s" % (self.tid, self.host))
            rec = s.get("record")
            if rec is not None:  # the job's own exit record survived pueue's cleanup
                stub = {"id": self.tid, "status": "Done", "end": rec["end"],
                        "result": "Success" if rec["exit"] == 0 else "Failed", "result_value": rec["exit"]}
                verdict, code = verdict_of(stub)
                verdict, code, why_scope = scope_verdict(verdict, code, rec.get("scope"))
                note = ("%s (its pueue entry was removed); the exit code comes from the job's own record; "
                        "the log is gone" % why)
                return self._outcome(verdict, code, stub, tail=False,
                                     note=(why_scope + ". " + note) if why_scope else note)
            return self._outcome("GONE", EXIT["GONE"], {"id": self.tid},
                                 note="%s; the job left no exit record (removed before it ran, or killed "
                                      "outright)" % why, tail=False)
        self.token = self.token or s.get("token")
        status, size = s.get("status"), s.get("log_size", 0)
        if "alert_count" in s:
            if self.alert_cursor is None:
                self.alert_cursor = s["alert_count"]
            elif s.get("alerts"):
                self.alert_cursor += len(s["alerts"])
                return self._outcome("ALERT", EXIT["ALERT"], s, note="admission: %s; the job keeps its place" %
                                     "; ".join(a["message"] for a in s["alerts"]))
        if status == "Stashed" and s.get("held"):
            now = time.monotonic()
            if self.told_held is None or now - self.told_held >= HELD_NOTICE_S:
                self.told_held = now
                sys.stderr.write("job: %s#%s held: %s\n" % (self.host, self.tid,
                                                             s.get("held_reason") or "waiting for the next check"))
            if s.get("admission_stale") and not self.told_stale:
                self.told_stale = True
                return self._outcome("ALERT", EXIT["ALERT"], s, note="the admission loop on %s is not running, so "
                                     "the job stays held until it runs again" % self.host)

        if self.check:
            if self.offset is None:
                # first probe: start at the current end unless asked to read it all
                self.offset = 0 if self.from_start else size
                if self.offset < size:
                    return self.AGAIN
            elif s.get("new_bytes") is not None:
                data = self.partial + base64.b64decode(s["new_bytes"])
                self.offset = s["new_offset"]
                complete = status == "Done" and self.offset >= size
                cut = max(data.rfind(b"\n"), data.rfind(b"\r"))  # \r ends a progress-bar line
                if complete or len(data) - (cut + 1) > PARTIAL_MAX:
                    self.partial = b""
                else:  # hold back an unfinished last line until it is finished
                    self.partial, data = data[cut + 1:], data[:cut + 1]
                if data:
                    alert = self._run_check(data, s)
                    if alert:
                        return alert
                if self.offset < size:
                    return self.AGAIN
            if status == "Done" and self.partial:
                data, self.partial = self.partial, b""
                alert = self._run_check(data, s)
                if alert:
                    return alert

        if status == "Done":
            verdict, code = verdict_of(s)
            verdict, code, note = scope_verdict(verdict, code, s.get("scope"))
            return self._outcome(verdict, code, s, note=note)

        if status != "Running":  # queued, paused, stashed: not a stall
            self.samples = []
            running, limit = s.get("group_running") or 0, s.get("group_parallel") or 0
            if status == "Queued" and not self.told_queued and limit and running >= limit:
                self.told_queued = True
                sys.stderr.write("job: %s#%s is queued behind %s running job(s) in group %s (limit %s); "
                                 "it starts when one ends\n" % (self.host, self.tid, s.get("group_running"),
                                                                 s.get("group"), s.get("group_parallel")))
            return None
        if not self.token:  # started with plain pueue add: its processes cannot be found
            if not self.told_notoken:
                self.told_notoken = True
                sys.stderr.write("job: %s#%s was not started by job; stall detection is off for it\n"
                                 % (self.host, self.tid))
            return None
        now = time.monotonic()
        ticks = s.get("cpu_ticks")
        self.samples.append((now, size, ticks, s.get("runnable") or 0))
        if self.stall_s <= 0:
            return None
        base = None
        while len(self.samples) > 1 and self.samples[1][0] <= now - self.stall_s:
            self.samples.pop(0)
        if self.samples[0][0] <= now - self.stall_s:
            base = self.samples[0]
        if base is None or size != base[1]:
            return None
        if any(x[3] for x in self.samples):
            return None  # a process was running or waiting for a CPU: starved, not idle
        if ticks is None and any(x[2] is not None for x in self.samples):
            return None  # the processes just went away: the job is ending, or pueue has not noticed yet
        span = now - base[0]
        used = max(0, (ticks or 0) - (base[2] or 0)) / float(s.get("clk_tck") or 100)
        if used / span >= self.stall_cpu:
            return None
        what = ("its processes used %.2f%% of one CPU" % (100 * used / span) if ticks is not None
                else "no live process of the job was found")
        return self._outcome("STALLED", EXIT["STALLED"], s,
                             note="for %s the log did not grow and %s; the job was left running"
                                  % (_fmt_dur(span), what))


def wait_all(host, waiters, poll=None, out=sys.stdout):
    """Wait on one or more jobs on one host. Returns the exit code."""
    poll = poll if poll is not None else (POLL_REMOTE if HOSTS.get(host) else POLL_LOCAL)
    pending = list(waiters)
    done = []
    while pending:
        for w in list(pending):
            for _ in range(10000):
                o = w.step()
                if o != Waiter.AGAIN:
                    break
            if o is None or o == Waiter.AGAIN:
                continue
            pending.remove(w)
            done.append((w, o))
            if o["verdict"] in URGENT:
                return _finish(host, waiters, done, pending, o, out)
        if pending:
            time.sleep(poll)
    return _finish(host, waiters, done, [], None, out)


def _finish(host, waiters, done, pending, urgent, out):
    if len(waiters) == 1:
        o = done[0][1]
        report(host, o, out)
        out.write("job: exit %d\n" % o["code"])
        out.flush()
        return o["code"]
    by_id = sorted(done, key=lambda wo: wo[0].tid)
    if urgent:
        code = urgent["code"]
        out.write("job: %s %s#%s; %d of %d jobs ended, still waiting: %s\n" % (
            urgent["verdict"], host, urgent["s"].get("id"), len(done), len(waiters),
            " ".join(str(w.tid) for w in pending) or "none"))
        report(host, urgent, out)
        others = [wo for wo in by_id if wo[1] is not urgent]
    else:
        bad = [wo for wo in by_id if wo[1]["code"] != 0]
        code = bad[0][1]["code"] if bad else 0
        counts = {}
        for _, o in by_id:
            counts[o["verdict"]] = counts.get(o["verdict"], 0) + 1
        out.write("job: ALL ENDED %s: %s\n" % (host, ", ".join("%d %s" % (n, v) for v, n in sorted(counts.items()))))
        others = by_id
    for _, o in others:
        out.write("\n")
        report(host, o, out)
    out.write("job: exit %d\n" % code)
    out.flush()
    return code


QUEUED_HINT = None


def _command_from(args):
    if args.script:
        if args.command:
            raise JobError("give either --script FILE or a command after --, not both")
        with open(args.script, encoding="utf-8", errors="replace") as f:
            return f.read()
    cmd = list(args.command or [])
    if not cmd:
        raise JobError("no command given; put it after --, or use --script FILE")
    if len(cmd) == 1:
        return cmd[0]  # one argument: a shell command line
    return shlex.join(cmd)


def _check_ok(args):
    if getattr(args, "check", None):
        if not (os.path.isfile(args.check) and os.access(args.check, os.X_OK)):
            raise JobError("--check %s: not an executable file" % args.check)
        args.check = os.path.abspath(args.check)


def _waiter(args, tid, token):
    return Waiter(args.host, tid, token=token, stall_min=args.stall, stall_cpu=args.stall_cpu,
                  check=args.check, from_start=getattr(args, "from_start", True), tail=args.tail)


def cmd_run(args, queue_only=False):
    command = _command_from(args)
    if not queue_only:
        _check_ok(args)
    sub = submit(args, command)
    tid, tok = sub["id"], sub["token"]
    again = "job wait %s %s --token %s" % (args.host, tid, tok)
    global QUEUED_HINT
    QUEUED_HINT = "the job %s#%s was queued and keeps running; reattach with: %s" % (args.host, tid, again)
    if queue_only:
        print(tid)
        sys.stderr.write("job: queued %s#%s (%s). Wait on it with: %s\n" % (args.host, tid, args.task, again))
        return 0
    sys.stderr.write("job: queued %s#%s (%s); waiting. If this wait is lost, reattach with: %s\n"
                     % (args.host, tid, args.task, again))
    sys.stderr.flush()
    args.from_start = True
    return wait_all(args.host, [_waiter(args, tid, tok)], poll=args.poll)


def cmd_wait(args):
    _check_ok(args)
    if args.token and len(args.ids) != 1:
        raise JobError("--token goes with a single job id")
    return wait_all(args.host, [_waiter(args, tid, args.token) for tid in args.ids], poll=args.poll)


def cmd_ls(args):
    if args.hosts:
        hosts = args.hosts
    else:  # each machine once: a listed name for this machine replaces "local"
        here = [h for h in LISTED if h != "local" and HOSTS[h] is None]
        hosts = [h for h in LISTED if not (h == "local" and here)]
    bad = [h for h in hosts if h not in HOSTS]
    if bad:
        raise JobError("unknown host(s) %s; known hosts: %s (add it to %s)" % (
            ", ".join(bad), ", ".join(HOSTS), HOSTS_FILE))
    results = {}

    def fetch(h):
        try:
            results[h] = call(h, "ls", {}, timeout=60)
        except (JobError, Unreachable) as e:
            results[h] = e

    threads = [threading.Thread(target=fetch, args=(h,)) for h in hosts]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    rows, unreachable = [], []
    for h in hosts:
        r = results.get(h)
        if isinstance(r, Exception):
            unreachable.append("%s: UNREACHABLE: %s" % (h, r))
            continue
        for s in r["tasks"]:
            if not args.all and s["status"] == "Done":
                end = _parse_time(s.get("end"))
                if end and (dt.datetime.now(end.tzinfo) - end).total_seconds() > args.recent * 3600:
                    continue
            state = s["status"]
            if state == "Done":
                v, c, _ = scope_verdict(*verdict_of(s), s.get("scope"))
                state = v if v != "FAILED" else "FAILED(%d)" % c
            what = (s.get("summary") or s.get("command") or "")[:60]
            if s.get("held"):
                state, what = "Held", "[%s] %s" % (s.get("held_reason") or "not checked yet", what)
            rows.append((h, str(s["id"]), s.get("label") or "-", state, _fmt_dur(_runtime(s)),
                         s.get("group") or "", s.get("session") or "unknown", what))
    head = ("HOST", "ID", "TASK", "STATUS", "RUN TIME", "GROUP", "SESSION", "COMMAND")
    if rows:
        widths = [max(len(r[i]) for r in rows + [head]) for i in range(len(head))]
        for r in [head] + rows:
            print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip())
    else:
        print("no jobs on the reachable hosts" + ("" if args.all else
              " (finished jobs older than %g h hidden; --all shows them)" % args.recent))
    for u in unreachable:
        print(u)
    return EXIT["UNREACHABLE"] if unreachable else 0


def cmd_group(args):
    r = call(args.host, "group", {"name": args.name, "parallel": args.parallel})
    print("%s: group %s %s, runs %d at a time" % (args.host, r["name"],
                                                  "created" if r["created"] else "exists", r["parallel"]))
    return 0


def cmd_kill(args):
    r = call(args.host, "kill", {"id": int(args.id), "token": args.token})
    print("%s#%s %s" % (args.host, args.id, r["action"]))
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="job", description="Run long jobs under pueue and wait on them correctly.")
    p.add_argument("--version", action="version", version="job %s" % VERSION)
    sub = p.add_subparsers(dest="cmd")

    def waitopts(q):
        q.add_argument("--stall", type=float, default=30.0, metavar="MIN",
                       help="end with STALLED after MIN minutes in which the log did not grow and the job "
                            "used less than --stall-cpu of one CPU (default 30; 0 turns it off)")
        q.add_argument("--stall-cpu", type=float, default=0.5, metavar="PCT",
                       help="CPU use, in percent of one core, below which the job counts as idle (default 0.5)")
        q.add_argument("--check", metavar="SCRIPT",
                       help="run SCRIPT on each new chunk of whole output lines (on stdin); nonzero exit "
                            "ends the wait with ALERT")
        q.add_argument("--poll", type=float, default=None, metavar="SEC",
                       help="seconds between probes (default %g local, %g remote)" % (POLL_LOCAL, POLL_REMOTE))
        q.add_argument("--tail", type=int, default=40, metavar="N", help="log lines to print at the end (default 40)")

    for name in ("run", "submit"):
        q = sub.add_parser(name, help="queue a command and wait for it" if name == "run" else "queue a command, print its id")
        q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
        q.add_argument("task", help="the task id the job belongs to (becomes the pueue label)")
        q.add_argument("--group", default=None, help="pueue group (create it with 'job group')")
        q.add_argument("--cwd", default=None, help="working directory on the host (default: here for local, home for remote)")
        q.add_argument("--script", default=None, metavar="FILE", help="read the command from FILE instead of after --")
        q.add_argument("--env", action="append", metavar="NAME[=VALUE]",
                       help="pass this variable to the job (repeatable); only a small fixed set is passed otherwise")
        q.add_argument("--normal-priority", action="store_true",
                       help="run the job at normal CPU and disk priority instead of nice 19 / ionice idle")
        a = q.add_argument_group("size and constraints, for admission hosts and auto (docs/admission.md)")
        a.add_argument("--pilot", action="store_true", help="a first run to measure the job (time-limited)")
        a.add_argument("--max-minutes", type=int, default=None, metavar="N", help="a pilot's time limit")
        a.add_argument("--like", default=None, metavar="TOKEN|HOST#ID", help="size it from that earlier job's peaks")
        a.add_argument("--small", action="store_true", help="the host's small size")
        a.add_argument("--cpus", type=float, default=None, metavar="N", help="CPU threads")
        a.add_argument("--ram", type=_parse_size, default=None, metavar="SIZE", help="RAM, e.g. 20G or 512Mi")
        a.add_argument("--gpus", type=int, default=None, metavar="N", help="GPUs on one host")
        a.add_argument("--gpu-mem", type=_parse_size, default=None, metavar="SIZE", help="GPU memory per GPU")
        a.add_argument("--gpu-share", type=float, default=None, metavar="PCT", help="share of the GPU's time")
        a.add_argument("--gpu-model", default=None, metavar="TEXT", help="only GPUs whose name contains TEXT")
        a.add_argument("--data", default=None, metavar="PATH", help="the data it reads (names its disk)")
        a.add_argument("--stop-at", default=None, metavar="TIME", help="stop it then (YYYY-MM-DDTHH:MM+-HH:MM)")
        a.add_argument("--in-containers", action="store_true", help="its work runs in containers")
        a.add_argument("--restartable", action="store_true", help="it may run on hosts that can be reclaimed")
        a.add_argument("--host", dest="only_hosts", action="append", default=None, metavar="NAME",
                       help="with auto: only this host (repeatable)")
        if name == "run":
            waitopts(q)

    q = sub.add_parser("wait", help="wait on one or more queued or finished jobs on one host")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("ids", type=int, nargs="+", metavar="id")
    q.add_argument("--token", default=None, help="the token 'job submit' printed; refuses a reused id")
    q.add_argument("--from-start", action="store_true",
                   help="with --check: check the output already written too (default: only new output)")
    waitopts(q)

    q = sub.add_parser("ls", help="list jobs on all hosts")
    q.add_argument("hosts", nargs="*", help="hosts to list (default: all)")
    q.add_argument("--all", action="store_true", help="include finished jobs older than --recent")
    q.add_argument("--recent", type=float, default=24.0, metavar="H", help="hide finished jobs older than H hours (default 24)")

    q = sub.add_parser("room", help="free room on admission hosts")
    q.add_argument("hosts", nargs="*", help="hosts to show (default: all)")
    q.add_argument("--json", action="store_true", help="print the hosts' snapshots as JSON")

    q = sub.add_parser("group", help="create a group or set its parallel limit")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("name")
    q.add_argument("parallel", type=int)

    q = sub.add_parser("kill", help="kill a running job")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("id", type=int)
    q.add_argument("--token", default=None, help="refuse if the id now belongs to another job")
    return p


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) == 2 and argv[0] == "_host" and argv[1] in HOST_OPS:
        return host_main(argv[1])
    if argv[:1] == ["_admit"] and set(argv[1:]) <= {"--once"}:
        try:
            return admit_main(once="--once" in argv)
        except JobError as e:
            sys.stderr.write("job _admit: %s\n" % e)
            return EXIT["WRAPPER_ERROR"]
    command = None
    if "--" in argv:  # everything after the first -- is the job's command, untouched
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    parser = build_parser()
    args = parser.parse_args(argv)
    args.command = command
    if command is not None and args.cmd not in ("run", "submit"):
        parser.error("only run and submit take a command after --")
    if not args.cmd:
        parser.print_help()
        return EXIT["USAGE"]
    if getattr(args, "host", None) is not None and args.host not in HOSTS:
        mine = [n for n in HOSTS if HOSTS[n] is None and n != "local"
                and n.split(".")[0].lower() == args.host.split(".")[0].lower()]
        if mine:  # this machine's name in another case, or its full name
            args.host = mine[0]
    auto = args.cmd in ("run", "submit") and args.host == "auto"  # admission chooses the host
    if getattr(args, "host", None) is not None and args.host not in HOSTS and not auto:
        sys.stdout.write("job: WRAPPER_ERROR unknown host %r; known hosts: %s (add it to %s)\njob: exit %d\n"
                         % (args.host, ", ".join(HOSTS), HOSTS_FILE, EXIT["WRAPPER_ERROR"]))
        return EXIT["WRAPPER_ERROR"]
    handlers = {"run": cmd_run, "submit": lambda a: cmd_run(a, queue_only=True), "wait": cmd_wait,
                "ls": cmd_ls, "group": cmd_group, "kill": cmd_kill, "room": cmd_room}
    try:
        return handlers[args.cmd](args)
    except JobError as e:
        sys.stdout.write("job: WRAPPER_ERROR %s\n%sjob: exit %d\n" % (
            e, ("note: %s\n" % QUEUED_HINT) if QUEUED_HINT else "", EXIT["WRAPPER_ERROR"]))
        return EXIT["WRAPPER_ERROR"]
    except Unreachable as e:
        sys.stdout.write("job: UNREACHABLE %s\njob: exit %d\n" % (e, EXIT["UNREACHABLE"]))
        return EXIT["UNREACHABLE"]
    except KeyboardInterrupt:
        sys.stderr.write("job: interrupted; the job itself keeps running under pueue\n")
        return 130
    except Exception as e:  # never exit 1, which would look like the job's own exit 1
        sys.stdout.write("job: WRAPPER_ERROR internal error %s: %s\n%sjob: exit %d\n"
                         % (type(e).__name__, e, ("note: %s\n" % QUEUED_HINT) if QUEUED_HINT else "",
                            EXIT["WRAPPER_ERROR"]))
        return EXIT["WRAPPER_ERROR"]


if __name__ == "__main__":
    sys.exit(main())
