#!/usr/bin/env python3
"""job (agent-pueue): run long jobs under pueue and wait on them correctly.

A thin wrapper around pueue for agents. Pueue owns every process; this tool
never finds a process by name or command line. One call, `job run`, queues a
command on a host and blocks until it ends, then prints the outcome and exits
with the job's own exit code. See docs/usage.md.

Hosts other than `local` are read from ~/.config/agent-pueue/hosts (one
`name [ssh-destination]` per line). The same file is installed on every host
(~/.local/bin/job). For a remote host
the client runs `ssh <host> ~/.local/bin/job _host <op>` with a JSON request on
stdin and reads a JSON reply on stdout; nothing the user typed goes into the
ssh argv.
"""

import argparse
import base64
import ctypes
import datetime as dt
import errno
import fcntl
import hashlib
import json
import math
import os
import re
import shlex
import socket
import sqlite3
import subprocess
import sys
import threading
import time
import traceback
import uuid

VERSION = "0.9.2"
PROTOCOL = 3
# Protocol 4 is sent only by a submit that asks for normal priority. A host that predates the
# option accepts 3 only, so it refuses such a request instead of queueing it at idle priority.
PROTOCOL_PRIORITY = 4
# Protocol 5 (a superset of 4) is sent by a submit that runs the job in its own systemd scope with a memory
# limit (admission, docs/admission.md). A host that predates it refuses such a request instead of running the
# job without its limit.
PROTOCOL_ADMISSION = 5
ACCEPTED_PROTOCOLS = (PROTOCOL, PROTOCOL_PRIORITY, PROTOCOL_ADMISSION)
SCOPE_PREFIX = "agent-pueue-job-"   # systemd scope unit of an admitted job: SCOPE_PREFIX + token + ".scope"


def _load_hosts():
    """host name -> ssh destination (None = run here), from the hosts file."""
    hosts = {"local": None}
    path = HOSTS_FILE
    try:
        with open(path, encoding="utf-8") as f:
            for n, line in enumerate(f, 1):
                parts = line.split("#", 1)[0].split()
                if not parts:
                    continue
                name, dest = parts[0], (parts[1] if len(parts) > 1 else parts[0])
                ok = name != "local" and not name.startswith("-") and len(parts) <= 2 and all(
                    c.isalnum() or c in "._-" for c in name) and not dest.startswith("-")
                if not ok:
                    sys.stderr.write("job: %s line %d ignored: %r\n" % (path, n, line.strip()))
                    continue
                hosts[name] = dest
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:  # unreadable, a directory, not UTF-8
        sys.stderr.write("job: cannot read the hosts file %s (%s); only 'local' is known\n" % (path, e))
    return hosts


HOSTS_FILE = os.environ.get("JOB_HOSTS_FILE") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "agent-pueue", "hosts")
HOSTS = _load_hosts()
LISTED = list(HOSTS)  # what `job ls` lists by default
# On a server, its own name means this machine too (no ssh to itself).
SELF = socket.gethostname().split(".")[0].lower()
for _name in list(HOSTS):
    if _name.split(".")[0].lower() == SELF:
        HOSTS[_name] = None  # a listed name (any case, short or full) for this machine
if SELF not in {n.lower() for n in HOSTS}:
    HOSTS[SELF] = None  # this machine's own name works even when it is not listed

# Wrapper exit codes for outcomes that are not the job's own exit code.
EXIT = {
    "USAGE": 2,
    "FAILED_TO_SPAWN": 127,
    "KILLED": 137,
    "STALLED": 200,
    "ALERT": 201,
    "UNREACHABLE": 202,
    "ERRORED": 203,
    "DEPENDENCY_FAILED": 203,
    "GONE": 204,
    "WRAPPER_ERROR": 205,
    "NO_ROOM": 206,
    "PILOT_TIME_LIMIT": 207,
    "KILLED_BY_RESTART": 208,
    "UNTRACKED": 209,
}
# Outcomes that end a multi-job wait at once (the agent must look now).
URGENT = ("STALLED", "ALERT", "UNREACHABLE", "GONE", "WRAPPER_ERROR")

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "agent-pueue"
)
CHUNK = 4 * 1024 * 1024        # max log bytes moved per probe
TAIL_BYTES = 64 * 1024         # the log tail is read from at most this many final bytes
TAIL_LINE_MAX = 1000           # longer tail lines are cut
PARTIAL_MAX = 1024 * 1024      # an unterminated line longer than this goes to the check anyway
SCRIPT_KEEP_DAYS = 30
POLL_LOCAL, POLL_REMOTE = 3.0, 20.0
PUEUE_TIMEOUT = 60

# Variables passed from the submitting shell into the job (pueue stores the
# job's environment in its state file, so nothing else is passed; --env adds more).
ENV_ALLOW = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LANGUAGE", "TZ", "TERM", "TMPDIR",
             "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME")


class JobError(Exception):
    """A failure of the wrapper itself (not of the job)."""


class ProtocolError(JobError):
    """Client and host run different versions of job; retrying cannot help."""


class NoRoom(JobError):
    """A hold refused because the host has no room for it now (not because admission is unavailable)."""


# --------------------------------------------------------------------------
# host side: everything here runs on the machine that owns the pueue daemon
# --------------------------------------------------------------------------

def _pueue_base():
    cmd = ["pueue"]
    cfg = os.environ.get("JOB_PUEUE_CONFIG")
    if cfg:
        cmd += ["-c", cfg]
    return cmd


def _with_local_bin(path):
    local_bin = os.path.expanduser("~/.local/bin")
    parts = (path or "/usr/local/bin:/usr/bin:/bin").split(":")
    return path if local_bin in parts else local_bin + ":" + (path or "/usr/local/bin:/usr/bin:/bin")


def _pueue(args, env=None, check=True):
    if env is None:
        env = dict(os.environ, PATH=_with_local_bin(os.environ.get("PATH")))
    try:
        p = subprocess.run(_pueue_base() + args, capture_output=True, encoding="utf-8",
                           errors="replace", env=env, timeout=PUEUE_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise JobError("pueue %s did not answer within %d s" % (" ".join(args[:2]), PUEUE_TIMEOUT))
    except OSError as e:
        raise JobError("cannot run pueue: %s" % e)
    if check and p.returncode != 0:
        raise JobError("pueue %s failed (exit %d): %s" % (
            " ".join(args[:2]), p.returncode, _pueue_error_text(p.stderr or p.stdout)))
    return p


def _pueue_error_text(text):
    """pueue's error output in one line: its messages without colors, source locations or backtrace hints."""
    text = re.sub(r"\x1b\[[0-9;]*m", "", text or "")
    keep = []
    skip = False
    for line in text.splitlines():
        s = line.strip()
        if not s or s in ("Error:",) or s.startswith(("Backtrace omitted", "Run with RUST_BACKTRACE")):
            continue
        if s.startswith("Location:"):
            skip = True
            continue
        if skip and ("/src/" in s or s.endswith(".rs") or ".rs:" in s):
            continue
        skip = False
        if s[:1].isdigit() and ": " in s[:5]:
            s = s.split(": ", 1)[1]  # "0: message"
        keep.append(s[6:].strip() if s.startswith("Error:") else s)
    return " ".join(keep)[-600:] or "no message"


def _pueue_status():
    p = _pueue(["status", "--json"])
    try:
        st = json.loads(p.stdout)
    except ValueError:
        raise JobError("pueue status --json returned no JSON: %r" % p.stdout[:300])
    _record_daemon_start()
    return st


def _pueue_setting(key):
    """A shared setting from the pueue config file, or None when it is unset (null)."""
    cfg = os.environ.get("JOB_PUEUE_CONFIG") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "pueue", "pueue.yml")
    try:
        with open(cfg, encoding="utf-8", errors="replace") as f:
            for line in f:
                s = line.strip()
                if s.startswith(key + ":"):
                    val = s.split(":", 1)[1].strip().strip("'\"")
                    if val and val not in ("null", "~"):
                        return os.path.expanduser(val)
    except OSError:
        pass
    return None


def _daemon_start(proc="/proc"):
    """When the running pueue daemon started (epoch seconds), from its pid file and /proc; None if unknown."""
    dirs = [_pueue_setting("runtime_directory"), os.environ.get("XDG_RUNTIME_DIR"), "/run/user/%d" % os.getuid(),
            _pueue_directory()]
    for d in dirs:
        if not d:
            continue
        try:
            with open(os.path.join(d, "pueue.pid")) as f:
                pid = int(f.read().strip())
            with open(os.path.join(proc, str(pid), "stat")) as f:
                ticks = int(f.read().rsplit(")", 1)[1].split()[19])  # start time, clock ticks after boot
            with open(os.path.join(proc, "stat")) as f:
                btime = next(int(x.split()[1]) for x in f if x.startswith("btime "))
            return btime + ticks / float(os.sysconf("SC_CLK_TCK"))
        except (OSError, ValueError, IndexError, StopIteration):
            continue
    return None


DAEMON_STARTS_KEEP = 200  # the daemon starts job saw, kept in STATE_DIR/daemon-starts


def _daemon_starts():
    """The start times of the pueue daemons a job command saw running here (epoch seconds, oldest first)."""
    try:
        with open(os.path.join(STATE_DIR, "daemon-starts"), encoding="utf-8") as f:
            return sorted(float(x) for x in f.read().split() if x.strip())
    except (OSError, ValueError):
        return []


def _record_daemon_start():
    """Add the running daemon's start to STATE_DIR/daemon-starts, so a job killed by a restart is still known as one
    after a later restart. Returns the start, or None when unknown."""
    d = _daemon_start()
    if d is None:
        return None
    starts = _daemon_starts()
    if any(abs(x - d) < 2 for x in starts):
        return d
    path = os.path.join(STATE_DIR, "daemon-starts")
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        tmp = "%s.%d.tmp" % (path, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("".join("%.3f\n" % x for x in sorted(starts + [d])[-DAEMON_STARTS_KEEP:]))
        os.replace(tmp, path)
    except OSError:
        pass  # a later call records it
    return d


STOP_SPREAD_S = 5.0  # a clean stop of the pueue daemon kills its running tasks within this many seconds of each other


def _stop_time(st, d):
    """When the previous pueue daemon stopped, from the state: the last task event (queued, started, ended) before
    the daemon now running started at d. After a clean stop nothing happens until the next start, so the tasks the
    stop killed are the last thing that happened; None when the state holds no event before d."""
    last = None
    for t in (st or {}).get("tasks", {}).values():
        x = _summarize_task(t)
        for k in ("enqueued_at", "start", "end"):
            v = _parse_time(x.get(k))
            if v is not None and v.timestamp() < d and (last is None or v.timestamp() > last):
                last = v.timestamp()
    return last


def _exit_record(token, start):
    """The job's own exit record ({"exit", "end"}) when its wrapper wrote it after the task started, else None."""
    path = os.path.join(STATE_DIR, "results", token + ".exit")
    try:
        at = os.path.getmtime(path)
        with open(path) as f:
            code = int(f.read().strip())
    except (OSError, ValueError):
        return None
    if start is not None and at < start.timestamp() - 1:
        return None
    return {"exit": code, "end": dt.datetime.fromtimestamp(at).astimezone().isoformat()}


def _killed_by(s, st=None):
    """Who ended a Killed task: "job kill" (or the admission loop's reason), "daemon" when it was running when the
    pueue daemon stopped, "daemon-lost" when that daemon died without stopping it, or None when unknown.
    The restart that can have killed it is the first daemon start after the task started, among the running daemon
    and the earlier ones job recorded (STATE_DIR/daemon-starts), and the restart must show in the times:
      - it ended at or after that start d: the daemon died without stopping it (SIGKILL, out of memory, a crash),
        and the new daemon marked it Killed when it started;
      - it ended before d, within STOP_SPREAD_S of the last task event before d (st's tasks): a clean stop kills
        every running task at once and nothing happens after it until the next start.
    For both, s gets daemon_start and alive_pids: the job's processes still alive, found by its token as job kill
    finds them. When any is alive, or the job's own exit record was written after it started, or its processes were
    seen alive before (STATE_DIR/results/<token>.lost), the daemon lost track of a job that ran on: "daemon-lost", and
    s gets exit_record when there is one. A client that knows only "daemon" treats "daemon-lost" as a plain kill,
    never as "submit it again"."""
    if s.get("result") != "Killed":
        return None
    tok = s.get("token")
    results = os.path.join(STATE_DIR, "results")
    if tok:
        killed = _read_kv(os.path.join(results, tok + ".killed"))
        if killed is not None:
            return killed.get("stopped_by") or "job kill"
        if os.path.exists(os.path.join(results, tok + ".jobkill")):
            return "job kill"
    now = _daemon_start()
    start, end = _parse_time(s.get("start")), _parse_time(s.get("end"))
    if now is None or start is None or end is None:
        return None
    after = sorted(x for x in set(_daemon_starts() + [now]) if x <= now + 1 and x > start.timestamp())
    if not after:
        return None
    d = after[0]
    if end.timestamp() >= d - 1:  # the second: the pid file's start time and pueue's clock may differ by a little
        by_restart = end.timestamp() <= d + 120
    else:
        stop = _stop_time(st, d)  # no state given: no evidence of the stop
        by_restart = stop is not None and end.timestamp() >= stop - STOP_SPREAD_S
    if not by_restart:
        return None
    s["daemon_start"] = d
    s["alive_pids"] = sorted(_job_procs(tok)) if tok else []
    if not tok:
        return "daemon"
    lost = os.path.join(results, tok + ".lost")
    if s["alive_pids"] and not os.path.exists(lost):
        try:
            _mark(lost)  # so a later look, once they are gone, still knows they outlived the daemon
        except OSError:
            pass
    rec = _exit_record(tok, start)
    if rec is not None:
        s["exit_record"] = rec
    if s["alive_pids"] or rec is not None or os.path.exists(lost):
        return "daemon-lost"
    return "daemon"


def _pueue_directory():
    """The daemon's data directory (holds task_logs/<id>.log)."""
    cfg = os.environ.get("JOB_PUEUE_CONFIG") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "pueue", "pueue.yml")
    try:
        with open(cfg, encoding="utf-8", errors="replace") as f:
            for line in f:
                s = line.strip()
                if s.startswith("pueue_directory:"):
                    val = s.split(":", 1)[1].strip().strip("'\"")
                    if val and val not in ("null", "~"):
                        return os.path.expanduser(val)
    except OSError:
        pass
    return os.path.join(
        os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "pueue")


def _log_path(task_id):
    return os.path.join(_pueue_directory(), "task_logs", "%d.log" % int(task_id))


def _proc_tree(token):
    """CPU ticks used so far by the job's processes.

    The job's processes are found by the unique token that `job submit` put in
    the task's environment (pueue starts the task with that environment, and
    children inherit it), plus every descendant of those processes. Names and
    command lines are never looked at. Each process counts its own CPU time and
    that of its children it has already reaped, so work done by short-lived
    children is not lost. Returns (ticks, nprocs, runnable); (None, 0, 0) when no
    process is alive. runnable counts processes in state R (running or waiting
    for a CPU), so a job starved of CPU on a busy machine is not mistaken for an
    idle one.
    """
    if not token:
        return None, 0, 0
    needle = ("JOB_TOKEN=" + token).encode()
    stats = {}
    members = set()
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open("/proc/%d/stat" % pid, "rb") as f:
                raw = f.read().decode("ascii", "replace")
            # comm may hold spaces or parentheses; the fields after the last ')' are fixed.
            rest = raw[raw.rindex(")") + 2:].split()
            ppid = int(rest[1])
            ticks = int(rest[11]) + int(rest[12]) + int(rest[13]) + int(rest[14])  # utime stime cutime cstime
            stats[pid] = (ppid, ticks, rest[0] == "R")
        except (OSError, ValueError, IndexError):
            continue
        try:
            with open("/proc/%d/environ" % pid, "rb") as f:
                if needle in f.read().split(b"\0"):
                    members.add(pid)
        except OSError:
            continue
    if not members:
        return None, 0, 0
    # add descendants (a child may have cleared its environment)
    children = {}
    for pid, (ppid, _, _) in stats.items():
        children.setdefault(ppid, []).append(pid)
    stack = list(members)
    while stack:
        for c in children.get(stack.pop(), []):
            if c not in members:
                members.add(c)
                stack.append(c)
    live = [stats[p] for p in members if p in stats]
    return sum(x[1] for x in live), len(members), sum(1 for x in live if x[2])


def _job_procs(token, proc="/proc"):
    """{pid: start time} of the job's processes: those with its token in their environment, and their descendants.
    Zombies are left out (they are already dead)."""
    if not token:
        return {}
    needle = ("JOB_TOKEN=" + token).encode()
    stats, members = {}, set()
    for name in os.listdir(proc):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open(os.path.join(proc, name, "stat"), "rb") as f:
                raw = f.read().decode("ascii", "replace")
            rest = raw[raw.rindex(")") + 2:].split()
            stats[pid] = (int(rest[1]), rest[19], rest[0])
            with open(os.path.join(proc, name, "environ"), "rb") as f:
                if needle in f.read().split(b"\0"):
                    members.add(pid)
        except (OSError, ValueError, IndexError):
            continue
    children = {}
    for pid, (ppid, _, _) in stats.items():
        children.setdefault(ppid, []).append(pid)
    stack = list(members)
    while stack:
        for c in children.get(stack.pop(), []):
            if c not in members:
                members.add(c)
                stack.append(c)
    me = {os.getpid(), os.getppid()}
    return {p: stats[p][1] for p in members if p in stats and stats[p][2] != "Z" and p not in me}


def _same_process(pid, start, proc="/proc"):
    try:
        with open(os.path.join(proc, str(pid), "stat"), "rb") as f:
            raw = f.read().decode("ascii", "replace")
        rest = raw[raw.rindex(")") + 2:].split()
        return rest[19] == start and rest[0] != "Z"
    except (OSError, ValueError, IndexError):
        return False


def _end_leftovers(token, before, wait_s=3.0):
    """SIGKILL every process of the job still alive after pueue's kill: those seen before it (pueue kills only the
    job's own process group, so a child in another group, like `timeout`'s, or one that called setsid, lives on) and
    any found by the token now. Returns the pids still alive after wait_s."""
    end = time.monotonic() + wait_s
    while True:
        alive = {p: st for p, st in before.items() if _same_process(p, st)}
        alive.update(_job_procs(token))
        if not alive or time.monotonic() >= end:
            return sorted(alive)
        for pid, st in alive.items():
            if _same_process(pid, st):
                try:
                    os.kill(pid, 9)
                except OSError:
                    pass
        time.sleep(0.1)


def _token_ok(tok):
    """Whether tok is a job token as job makes them (32 lowercase hex characters), so it can name a file."""
    return isinstance(tok, str) and len(tok) == 32 and all(c in "0123456789abcdef" for c in tok)


def _env_token(t):
    """A pueue task's job token, or None when it has none or one job could not have made (it names files)."""
    tok = (t.get("envs") or {}).get("JOB_TOKEN")
    return tok if _token_ok(tok) else None


def _summarize_task(t):
    status = t.get("status") or {}
    kind = next(iter(status), "Unknown") if isinstance(status, dict) else str(status)
    info = status.get(kind, {}) if isinstance(status, dict) else {}
    if not isinstance(info, dict):
        info = {}
    result = info.get("result")
    if isinstance(result, dict):
        rkind = next(iter(result))
        rval = result[rkind]
    else:
        rkind, rval = result, None
    envs = t.get("envs") or {}
    return {
        "id": t.get("id"),
        "label": t.get("label"),
        "group": t.get("group"),
        "path": t.get("path"),
        "command": t.get("original_command") or t.get("command"),
        "status": kind,
        "result": rkind,
        "result_value": rval,
        "enqueued_at": info.get("enqueued_at"),
        "start": info.get("start"),
        "end": info.get("end"),
        "token": _env_token(t),
        "session": envs.get("JOB_SESSION"),
        "summary": envs.get("JOB_SUMMARY"),
        "submitted_from": envs.get("JOB_SUBMITTED_FROM"),
    }


def _clean_old_files(state, in_use):
    """Remove scripts and result records older than SCRIPT_KEEP_DAYS whose task pueue no longer holds."""
    cutoff = time.time() - SCRIPT_KEEP_DAYS * 86400
    for sub in ("scripts", "results"):
        d = os.path.join(state, sub)
        try:
            for name in os.listdir(d):
                p = os.path.join(d, name)
                if name.split(".")[0] not in in_use and os.path.getmtime(p) < cutoff:
                    os.remove(p)
        except OSError:
            pass


def _request_protocol(op, req):
    """Protocol number a client sends: 5 for a submit with a scope or a size, 4 for one asking for normal
    priority."""
    if op == "submit" and (req.get("scope") is not None or req.get("admission") is not None):
        return PROTOCOL_ADMISSION
    if op == "submit" and req.get("normal_priority"):
        return PROTOCOL_PRIORITY
    return PROTOCOL


def _runner(script, normal_priority=False):
    """The command pueue runs. Idle priority (nice 19, ionice idle) unless normal priority was asked for."""
    if normal_priority:
        return "bash %s" % shlex.quote(script)
    return "nice -n 19 ionice -c 3 bash %s" % shlex.quote(script)


GPU_VARS = ("CUDA_VISIBLE_DEVICES", "CUDA_DEVICE_ORDER", "JOB_GPU_UUIDS")  # set by admission, never by the caller
SCOPE_MIN_MEMORY = 16 << 20


def _env_name_ok(k):
    return (isinstance(k, str) and k != "" and k.isascii() and (k[0].isalpha() or k[0] == "_")
            and all(c.isalnum() or c == "_" for c in k))


def _check_scope(scope):
    """Validate a scope request; return it normalized. See docs/admission.md, "Per-job scope"."""
    if not isinstance(scope, dict):
        raise JobError("scope must be an object")
    mem = scope.get("memory_max")
    if not isinstance(mem, int) or isinstance(mem, bool) or mem < SCOPE_MIN_MEMORY:
        raise JobError("scope.memory_max must be a whole number of bytes, at least %d MiB" % (SCOPE_MIN_MEMORY >> 20))
    gpus = scope.get("gpus")
    if gpus is None:
        gpus = []  # a scoped job sees no GPU unless it was given one
    if not isinstance(gpus, list) or not all(
            isinstance(g, str) and g and g.isascii() and all(c.isalnum() or c in "-_:/." for c in g) for g in gpus):
        raise JobError("scope.gpus must be a list of GPU UUIDs")
    gpu_env = scope.get("gpu_env") or {}
    if not isinstance(gpu_env, dict) or not all(_env_name_ok(k) and isinstance(v, str) for k, v in gpu_env.items()):
        raise JobError("scope.gpu_env must map variable names to strings")
    bad = sorted(k for k in gpu_env if k in GPU_VARS or k.startswith("JOB_"))
    if bad:
        raise JobError("scope.gpu_env may not set %s" % ", ".join(bad))
    adj = scope.get("oom_score_adj", 0)
    if not isinstance(adj, int) or isinstance(adj, bool) or not 0 <= adj <= 1000:
        raise JobError("scope.oom_score_adj must be a whole number from 0 to 1000")
    return {"memory_max": _whole_pages(mem), "gpus": gpus, "gpu_env": gpu_env, "oom_score_adj": adj}


def _whole_pages(n):
    """A memory limit rounded down to whole pages, as the kernel stores it."""
    page = os.sysconf("SC_PAGE_SIZE")
    return int(n) // page * page


def _scope_scripts(token, body, record, scope, assign):
    """The wrapper (pueue's child, outside the scope) and the shim (inside it) of a scoped job.

    The scope is delegated to the shim, which splits it into two cgroups: shim/ (itself) and job/ (the
    command, with the memory limit, no swap and whole-group kill). So the shim outlives a memory kill of the
    job and reads the job's own counters to say why it ended, on any systemd version. The RAM limit and the
    GPUs come from the assignment file (KEY=VALUE lines), written at submit or, for an admitted job, by the
    admission loop at release.
    """
    results = os.path.dirname(record)
    q = shlex.quote
    started, final, result = (os.path.join(results, token + ext) for ext in (".started", ".final", ".scope"))
    progress = os.path.join(results, token + ".progress")
    shim_path = os.path.join(os.path.dirname(body), token + ".shim")
    unit = SCOPE_PREFIX + token + ".scope"
    sysd = "timeout 30 systemctl --user"
    shim = "\n".join([
        "#!/bin/bash",
        "# job %s: runs inside the job's systemd scope; runs the command in job/ and records how it ended" % VERSION,
        "final=%s" % q(final),
        'fail() { echo "setup_error=$1" > "$final.tmp" && mv "$final.tmp" "$final"; exit 205; }',
        'cg="/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)"',
        '[ "${cg##*/}" = %s ] || fail "not running in its own scope"' % q(unit),
        '[ -w "$cg/cgroup.subtree_control" ] || fail "the scope is not delegated"',
        'mkdir "$cg/shim" "$cg/job" 2>/dev/null || fail "could not make the job cgroups"',
        'echo $$ 2>/dev/null > "$cg/shim/cgroup.procs" || fail "could not move the shim into its cgroup"',
        'echo +memory 2>/dev/null > "$cg/cgroup.subtree_control" || fail "no memory controller in the scope"',
        'case "$JOB_MEMORY_MAX" in ""|*[!0-9]*) fail "no RAM limit was assigned";; esac',
        '{ echo "$JOB_MEMORY_MAX" > "$cg/job/memory.max" && echo 0 > "$cg/job/memory.swap.max" &&'
        ' echo 1 > "$cg/job/memory.oom.group"; } 2>/dev/null || fail "could not set the memory limit"',
        "# the kernel rounds the limit down to whole pages",
        'got=$(cat "$cg/job/memory.max"); case "$got" in ""|*[!0-9]*) got=0;; esac',
        'd=$((JOB_MEMORY_MAX - got)); [ "$got" -gt 0 ] && [ "${d#-}" -lt 65536 ] &&'
        ' [ "$(cat "$cg/job/memory.swap.max")" = 0 ] && [ "$(cat "$cg/job/memory.oom.group")" = 1 ]'
        ' || fail "the memory limit did not take effect"',
        "the_job() {",
        '  echo $BASHPID 2>/dev/null > "$cg/job/cgroup.procs" || exit 0',
        "  : > %s" % q(started),
        ("  echo %d 2>/dev/null > /proc/self/oom_score_adj" % scope["oom_score_adj"]) if scope["oom_score_adj"]
        else "  :",
        "  exec bash -o pipefail %s" % q(body),
        "}",
        "( the_job )",
        "rc=$?",
        '[ -e %s ] || fail "could not move the job into its cgroup"' % q(started),
        "# processes still dying from a kill leave within moments; anything left after that, the job left behind",
        'for i in $(seq 20); do grep -qx "populated 0" "$cg/job/cgroup.events" && break; sleep 0.1; done',
        'left=$(wc -l < "$cg/job/cgroup.procs")',
        'if [ "$left" -gt 0 ]; then',
        '  echo 1 > "$cg/job/cgroup.kill"',
        '  for i in $(seq 100); do grep -qx "populated 0" "$cg/job/cgroup.events" && break; sleep 0.1; done',
        "fi",
        "{",
        '  echo "rc=$rc"',
        '  echo "leftover=$left"',
        '  echo "memory.peak=$(cat "$cg/job/memory.peak" 2>/dev/null)"',
        "  # the limit it ended under, which job resize may have lowered since it started",
        '  echo "memory.max=$(cat "$cg/job/memory.max" 2>/dev/null)"',
        '  for f in memory.events cpu.stat; do sed "s/^/$f./;s/ /=/" "$cg/job/$f" 2>/dev/null; done',
        '} > "$final.tmp" && mv "$final.tmp" "$final"',
        "exit $rc",
        ""])
    wrapper = "\n".join([
        "#!/bin/bash",
        "# job %s: runs the job in its own systemd scope and records how it ended" % VERSION,
        'export PATH="$HOME/.local/bin:$PATH"',
        "export JOB_PROGRESS=%s" % q(progress),
        'export XDG_RUNTIME_DIR="/run/user/$(id -u)"',
        "rm -f %s %s %s %s" % (q(started), q(final), q(result), q(os.path.join(results, token + ".killed"))),
        "# a restarted job reuses its token, so end any scope an earlier run of it left",
        "%s kill --signal=SIGKILL %s >/dev/null 2>&1" % (sysd, q(unit)),
        "%s stop %s >/dev/null 2>&1" % (sysd, q(unit)),
        "%s reset-failed %s >/dev/null 2>&1" % (sysd, q(unit)),
        "# the RAM limit and GPUs this run was given",
        "if [ ! -r %s ]; then" % q(assign),
        "  echo \"job: this run has no assignment (%s)\" >&2" % assign.replace('"', ""),
        "  printf 'rc=205\\nstarted=0\\n' > %s; echo 205 > %s; exit 205" % (q(result), q(record)),
        "fi",
        "while IFS='=' read -r k v; do",
        '  case "$k" in JOB_MEMORY_MAX|CUDA_VISIBLE_DEVICES|JOB_GPU_UUIDS) export "$k=$v";; esac',
        "done < %s" % q(assign),
        "export CUDA_DEVICE_ORDER=PCI_BUS_ID",
        "systemd-run --user --scope --quiet --unit=%s -p Delegate=yes -p OOMPolicy=continue -p CPUWeight=%d"
        " -- bash %s" % (q(unit), 100 if scope.get("normal_priority") else 1, q(shim_path)),
        "rc=$?",
        "{",
        '  echo "rc=$rc"',
        '  echo "memory_max=$JOB_MEMORY_MAX"',
        "  [ -e %s ] && echo started=1 || echo started=0" % q(started),
        "  %s show %s -p Result -p LoadState 2>/dev/null" % (sysd, q(unit)),
        "} > %s.tmp && mv %s.tmp %s" % (q(result), q(result), q(result)),
        "%s reset-failed %s >/dev/null 2>&1" % (sysd, q(unit)),
        "echo $rc > %s" % q(record),
        "exit $rc",
        ""])
    return wrapper, shim_path, shim


def _read_kv(path):
    out = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                k, sep, v = line.rstrip("\n").partition("=")
                if sep:
                    out[k] = v
    except OSError:
        return None
    return out


def _int_or_none(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def _usage(kv, out):
    """Copy a job cgroup's final counters from a shim or kill record into a result."""
    out["memory_peak_incl_cache"] = _int_or_none(kv.get("memory.peak"))  # page cache counts: not a RAM size
    if _int_or_none(kv.get("memory.max")):  # the limit at its end (job resize may have lowered it), not at its start
        out["memory_max"] = out["memory_max_at_end"] = _int_or_none(kv.get("memory.max"))
    out["memory_events"] = {k.split(".", 2)[2]: _int_or_none(v) for k, v in kv.items()
                            if k.startswith("memory.events.")}
    out["cpu_usage_usec"] = _int_or_none(kv.get("cpu.stat.usage_usec"))


def _scope_result(token):
    """How a scoped job ended, from the files its wrapper, shim or `job kill` wrote; None if not scoped."""
    if not token:
        return None
    results = os.path.join(STATE_DIR, "results")
    kv = _read_kv(os.path.join(results, token + ".scope"))
    final = _read_kv(os.path.join(results, token + ".final"))
    killed = _read_kv(os.path.join(results, token + ".killed"))
    if kv is None and final is None and killed is None:
        return None
    kv = kv or {}
    out = {"rc": _int_or_none(kv.get("rc")), "memory_max": _int_or_none(kv.get("memory_max")),
           "scope_result": kv.get("Result")}
    final_path, killed_path = (os.path.join(results, token + ext) for ext in (".final", ".killed"))
    if killed is not None and final is not None and os.path.getmtime(final_path) < os.path.getmtime(killed_path):
        killed = None  # the job ended by itself before `job kill` reached it
    if killed is not None:
        out["how"] = "killed"
        out["stopped_by"] = killed.get("stopped_by")
        if _int_or_none(killed.get("memory_max")):  # read when it was killed
            out["memory_max"] = out["memory_max_at_end"] = _int_or_none(killed.get("memory_max"))
        _usage(killed, out)
    elif final is not None and final.get("setup_error"):
        out["how"] = "setup_error"
        out["reason"] = final["setup_error"]
    elif final is not None:
        _usage(final, out)
        ev = out["memory_events"]
        out["leftover"] = _int_or_none(final.get("leftover")) or 0
        rc = _int_or_none(final.get("rc"))
        if rc == 0:
            out["how"] = "exit"  # a memory kill after a clean exit hit a process it left running
        elif ev.get("oom_group_kill") or ev.get("oom_kill"):
            # oom counts the times the job reached its own limit; a kill without it came from the host
            out["how"] = "memory_limit" if ev.get("oom") else "host_oom"
        elif rc == 137:
            out["how"] = "sigkill"
        else:
            out["how"] = "exit"
    elif kv.get("started") != "1":
        out["how"] = "wrapper_error"
    else:
        out["how"] = "scope_killed"  # the shim died with the job: the whole scope was killed from outside
    return out


def _scope_cgroup(token):
    env = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % os.getuid())
    try:
        p = subprocess.run(["systemctl", "--user", "show", "-p", "ControlGroup", "--value",
                            SCOPE_PREFIX + token + ".scope"], env=env, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    cg = p.stdout.strip()
    return "/sys/fs/cgroup" + cg if p.returncode == 0 and cg.startswith("/") else None


LOOP_STOPS = ("pilot time limit", "stop-at")  # why the admission loop stops a running job


def _snapshot_kill(token, by="job kill"):
    """Before `job kill` ends a scoped job, keep its use so far, since its shim dies with it."""
    path = os.path.join(STATE_DIR, "results", token + ".killed")
    lines = ["stopped_by=" + by]
    cg = _scope_cgroup(token)
    if cg:
        job = os.path.join(cg, "job")
        try:
            with open(os.path.join(job, "memory.max")) as f:
                lines.append("memory_max=" + f.read().strip())
            with open(os.path.join(job, "memory.peak")) as f:
                lines.append("memory.peak=" + f.read().strip())
            for name in ("memory.events", "cpu.stat"):
                with open(os.path.join(job, name)) as f:
                    lines += ["%s.%s" % (name, line.strip().replace(" ", "=", 1)) for line in f if line.strip()]
        except OSError:
            pass
    try:
        with open(path + ".tmp", "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(path + ".tmp", path)
    except OSError:
        pass


def _stop_scope(token):
    """Kill everything left in a job's scope (SIGKILL, as pueue kill does) and forget the unit."""
    unit = SCOPE_PREFIX + token + ".scope"
    env = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % os.getuid())
    for args in (["kill", "--signal=SIGKILL", unit], ["stop", unit], ["reset-failed", unit]):
        try:
            subprocess.run(["systemctl", "--user"] + args, env=env, capture_output=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            pass


SESSION_GROUP_PREFIX = "session-"
SESSION_GROUP_IDLE_S = 3600


def _session_group_name(session):
    """The pueue group of a session's jobs that name no group: session- and the session id (cut to 24 characters,
    with a short hash of the whole id when it was cut or had other characters)."""
    clean = "".join(c if c.isascii() and (c.isalnum() or c in "_-") else "_" for c in session)
    if len(clean) > 24 or clean != session or not clean:
        clean = clean[:24] + "-" + hashlib.sha256(session.encode("utf-8", "replace")).hexdigest()[:6]
    return SESSION_GROUP_PREFIX + clean


SESSION_GROUP_KEEP_S = 24 * 3600  # a session group's finished jobs are kept this long (job ls, job wait --mine)


def _session_group(st, session):
    """Make sure the session's own group exists and return its name. It runs as many jobs at a time as the host's
    default group. Groups job made for sessions are remembered in STATE_DIR/session-groups (each submit touches its
    mark). A group whose mark is over SESSION_GROUP_IDLE_S old, that holds no unfinished job and whose jobs all
    ended over SESSION_GROUP_KEEP_S ago is removed here, with those finished jobs (their logs go with them; their
    exit records stay in STATE_DIR/results for SCRIPT_KEEP_DAYS)."""
    name = _session_group_name(session)
    marks = os.path.join(STATE_DIR, "session-groups")
    os.makedirs(marks, mode=0o700, exist_ok=True)
    groups = st.setdefault("groups", {})
    now = time.time()
    for other in os.listdir(marks):
        if other == name:
            continue
        try:
            if now - os.path.getmtime(os.path.join(marks, other)) < SESSION_GROUP_IDLE_S:
                continue  # a submit may be about to add its job to it
            if other in groups:
                mine = [_summarize_task(t) for t in st.get("tasks", {}).values() if t.get("group") == other]
                if any(x["status"] != "Done" for x in mine):
                    continue
                ends = [_parse_time(x.get("end")) for x in mine]
                if any(e is None or now - e.timestamp() < SESSION_GROUP_KEEP_S for e in ends):
                    continue  # its results are still shown and reported
                if any(x.get("token") and not os.path.exists(os.path.join(STATE_DIR, "results",
                                                                          x["token"] + ".delivered"))
                       for x in mine):
                    continue  # an outcome no wait has reported: job wait --mine and job ls --all still find it
                if any(x.get("token") and _job_procs(x["token"]) for x in mine):
                    continue  # pueue lost track of a job whose processes still run
                if mine:  # these exact tasks, all finished: a job submitted meanwhile is not among them
                    _pueue(["remove"] + [str(int(x["id"])) for x in mine])
                _pueue(["group", "remove", other])
                groups.pop(other, None)
            os.remove(os.path.join(marks, other))
        except (JobError, OSError, ValueError):
            pass  # a task arrived in it meanwhile, or another submit removed it: try again next time
    with open(os.path.join(marks, name), "w"):
        pass  # touched: in use now
    if name not in groups:
        p = _pueue(["group", "add", name], check=False)
        if p.returncode != 0 and name not in _pueue_status().get("groups", {}):  # not a submit that raced us
            raise JobError("could not create the pueue group %s: %s" % (name, _pueue_error_text(p.stderr or p.stdout)))
        n = (groups.get("default") or {}).get("parallel_tasks") or 1
        if p.returncode == 0 and n > 1:  # pueue's limit for a new group is 1
            _pueue(["parallel", str(int(n)), "--group", name], check=False)
        groups[name] = {"status": "Running", "parallel_tasks": n}
    return name


def host_submit(req, _admission_checked=False):
    command = req["command"]
    if not isinstance(req.get("normal_priority", False), bool):
        raise JobError("normal_priority must be true or false")
    admitted = req.get("admitted") if _admission_checked else None
    if not _admission_checked:
        settings = _admission_settings()  # an unusable settings file refuses every submit, with the reason
        if settings is not None:
            return host_submit_admitted(req, settings, command)
        if req.get("admission"):
            raise JobError("%s is not an admission host; submit without a size there" % socket.gethostname())
    scope = req.get("scope")
    if admitted:
        scope = {"memory_max": None, "gpus": [], "gpu_env": admitted["gpu_env"],
                 "oom_score_adj": admitted["oom_score_adj"]}
    elif scope is not None:
        if req.get("protocol", PROTOCOL_ADMISSION) != PROTOCOL_ADMISSION:
            raise JobError("protocol mismatch: a job with a scope needs protocol %d" % PROTOCOL_ADMISSION)
        scope = _check_scope(scope)
        bad = sorted(k for k in (req.get("env") or {}) if k in GPU_VARS)
        if bad:
            raise JobError("%s is set by admission; do not pass it with --env" % ", ".join(bad))
    token = req.get("token") or uuid.uuid4().hex
    if not _token_ok(token):
        raise JobError("bad token")
    st = _pueue_status()
    tokens = {}
    for _, t in st.get("tasks", {}).items():
        tok = (t.get("envs") or {}).get("JOB_TOKEN")
        if tok:
            tokens[tok] = int(t["id"])
    if token in tokens:  # a retried submit whose first attempt got through
        return {"id": tokens[token], "token": token, "host": socket.gethostname(), "existing": True}

    cwd = os.path.expanduser(req.get("cwd") or "~")
    if not os.path.isdir(cwd):
        raise JobError("working directory does not exist on %s: %s" % (socket.gethostname(), cwd))
    group = req.get("group")
    if not group and not admitted:
        # without --group, a job queues only behind its own session's jobs, not behind every session's in the shared
        # default group
        group = _session_group(st, req.get("session") or "unknown")
    group = group or "default"
    if group != "default" and group not in st.get("groups", {}):
        raise JobError("pueue group %r does not exist on %s; create it with "
                       "'job group <host> %s <n>'" % (group, socket.gethostname(), group))

    scripts = os.path.join(STATE_DIR, "scripts")
    results = os.path.join(STATE_DIR, "results")
    os.makedirs(scripts, mode=0o700, exist_ok=True)
    os.makedirs(results, mode=0o700, exist_ok=True)
    _clean_old_files(STATE_DIR, set(tokens))
    script = os.path.join(scripts, token + ".sh")
    body = os.path.join(scripts, token + ".cmd")
    record = os.path.join(results, token + ".exit")
    progress = os.path.join(results, token + ".progress")  # JOB_PROGRESS: where the job may write `done total`
    with open(body, "w", encoding="utf-8") as f:
        f.write(command)
        if not command.endswith("\n"):
            f.write("\n")
    shim_path = assign = None
    if scope is not None:
        if admitted:
            assign = admitted["assign"]  # written by the admission loop when it releases the job
        else:
            assign = os.path.join(results, token + ".assign")
            with open(assign, "w", encoding="utf-8") as f:
                f.write("JOB_MEMORY_MAX=%d\nCUDA_VISIBLE_DEVICES=%s\nJOB_GPU_UUIDS=%s\n" % (
                    scope["memory_max"], ",".join(scope["gpus"]), ",".join(scope["gpus"])))
        # nice ranks processes only inside one cgroup, and each scoped job is a cgroup of its own, so its
        # priority is also its CPU weight: 1 for idle priority (about nice 19's share), 100 for normal
        scope = dict(scope, normal_priority=bool(req.get("normal_priority")))
        wrapper, shim_path, shim = _scope_scripts(token, body, record, scope, assign)
        with open(shim_path, "w", encoding="utf-8") as f:
            f.write(shim)
        os.chmod(shim_path, 0o700)
    with open(script, "w", encoding="utf-8") as f:
        if scope is not None:
            f.write(wrapper)
        else:
            f.write("#!/bin/bash\n")
            f.write("# written by job %s for task %s at %s\n" % (
                VERSION, req.get("task", "?"), dt.datetime.now().astimezone().isoformat()))
            f.write('export PATH="$HOME/.local/bin:$PATH"\n')
            f.write("export JOB_PROGRESS=%s\n" % shlex.quote(progress))
            # the command runs in its own bash; its exit code is recorded here, so the record
            # survives pueue's cleanup and cannot be undone by a trap in the command
            f.write("bash -o pipefail %s\n" % shlex.quote(body))
            f.write("rc=$?\n")
            f.write("echo $rc > %s\n" % shlex.quote(record))
            f.write("exit $rc\n")
    os.chmod(script, 0o700)
    runner = _runner(script, req.get("normal_priority", False))

    env = {k: v for k, v in os.environ.items()
           if k in ENV_ALLOW or k.startswith("LC_")}
    env["PATH"] = _with_local_bin(env.get("PATH"))
    if scope is not None:
        # the GPUs (by UUID, so CUDA's own device order does not matter) come from the assignment file;
        # an empty list hides every GPU from a job that did not ask for one
        env.update(scope["gpu_env"])
    env.update(req.get("env") or {})
    env.update({
        "JOB_TOKEN": token,
        "JOB_TASK": req["task"],
        "JOB_SESSION": req.get("session") or "unknown",
        "JOB_SUMMARY": " ".join(command.split())[:200],
        "JOB_SUBMITTED_FROM": req.get("from") or "?",
    })
    args = (["add", "--print-task-id", "--label", req["task"], "--working-directory", cwd, "--group", group]
            + (["--stashed"] if admitted else []) + ["--", runner])
    try:
        p = _pueue(args, env=env)
    except JobError:
        for path in (script, body, shim_path, None if admitted else assign):
            if path:
                os.remove(path)
        raise
    try:
        task_id = int(p.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise JobError("pueue add printed no task id: %r" % p.stdout[:300])
    return {"id": task_id, "token": token, "host": socket.gethostname(), "existing": False}


def host_probe(req):
    tid = int(req["id"])
    want_token = req.get("token")
    if want_token is not None and not _token_ok(want_token):
        raise JobError("bad token %r: a token is the 32-character token job printed" % str(want_token)[:40])
    st = _pueue_status()
    t = st.get("tasks", {}).get(str(tid))
    if t is None or (want_token and (t.get("envs") or {}).get("JOB_TOKEN") != want_token):
        out = {"found": t is not None, "token_mismatch": t is not None}
        removed = os.path.join(STATE_DIR, "results", "%s.removed" % want_token) if want_token else None
        if removed and t is None and os.path.exists(removed):
            out["removed"] = {"by": "job kill", "at": os.path.getmtime(removed)}
        rec = os.path.join(STATE_DIR, "results", "%s.exit" % want_token) if want_token else None
        if rec and os.path.exists(rec):
            try:
                with open(rec) as f:
                    code = int(f.read().strip())
                out["record"] = {"exit": code, "end": dt.datetime.fromtimestamp(
                    os.path.getmtime(rec)).astimezone().isoformat()}
                out["record"]["scope"] = _scope_result(want_token)
            except (OSError, ValueError):
                pass
        return out
    s = _summarize_task(t)
    s["found"] = True
    s["token_mismatch"] = False
    if s["status"] == "Done":
        s["scope"] = _scope_result(s["token"])
        s["killed_by"] = _killed_by(s, st)
    g = st.get("groups", {}).get(s["group"]) or {}
    s["group_parallel"] = g.get("parallel_tasks")
    s["group_status"] = g.get("status")
    s["group_running"] = sum(1 for x in st.get("tasks", {}).values()
                             if x.get("group") == s["group"] and "Running" in (x.get("status") or {}))
    s["clk_tck"] = os.sysconf("SC_CLK_TCK")
    path = _log_path(tid)
    s["log_path"] = path
    # status is read before the log, so a Done status means the log is complete
    try:
        size = os.path.getsize(path)
    except OSError:
        size = 0
    s["log_size"] = size
    if s["status"] == "Running" or _lost_running(s):
        s["cpu_ticks"], s["nprocs"], s["runnable"] = _proc_tree(s["token"])
    else:
        s["cpu_ticks"], s["nprocs"], s["runnable"] = None, 0, 0
    off = req.get("log_offset")
    if off is not None and size > off:
        with open(path, "rb") as f:
            f.seek(off)
            data = f.read(min(CHUNK, size - off))
        s["new_offset"] = off + len(data)
        s["new_bytes"] = base64.b64encode(data).decode()
    tail = req.get("tail_lines")
    if tail:
        s["tail"] = _tail(path, int(tail))
    _probe_admission(s, req)
    return s


def _probe_admission(s, req):
    """Add what the admission loop says about this job: why it is held, new alerts, a stopped loop."""
    try:
        settings = _admission_settings()
    except JobError:
        return
    if settings is None or not s.get("token"):
        return
    try:
        adm = Admission(settings)
    except OSError:
        return
    q = adm.read_json(adm.path("queue", s["token"] + ".json"))
    if q is not None:
        s["held"] = q.get("state") == "held"
        s["held_reason"] = q.get("reason")
        s["held_hint"] = q.get("hint")
    try:
        with open(adm.path("alerts", s["token"] + ".jsonl"), encoding="utf-8") as f:
            alerts = [json.loads(line) for line in f if line.strip()]
    except (OSError, ValueError):
        alerts = []
    s["alert_count"] = len(alerts)
    cursor = req.get("alert_cursor")
    if isinstance(cursor, int) and 0 <= cursor < len(alerts):
        s["alerts"] = alerts[cursor:]
    if s.get("held"):
        age = _heartbeat_age(adm)
        s["admission_stale"] = age is None or age > _heartbeat_limit(settings)


def _tail(path, n, max_bytes=TAIL_BYTES):
    """The last n lines among the log's final max_bytes, each cut to TAIL_LINE_MAX characters."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            buf = f.read()
    except OSError:
        return []
    text = buf.decode("utf-8", "replace").replace("\r\n", "\n")
    lines = []
    for line in text.split("\n"):
        line = line.rsplit("\r", 1)[-1] if "\r" in line else line  # progress bars: keep the last redraw
        if len(line) > TAIL_LINE_MAX:
            line = line[:TAIL_LINE_MAX] + " ...[line cut]"
        lines.append(line)
    if lines and lines[-1] == "":
        lines.pop()
    if size > max_bytes and lines:
        lines.pop(0)  # the first line is probably partial
    return lines[-n:]


def host_ls(req):
    st = _pueue_status()
    out = [_summarize_task(t) for _, t in sorted(st.get("tasks", {}).items(), key=lambda kv: int(kv[0]))]
    for s in out:
        if s["status"] == "Done" and s.get("token"):
            s["scope"] = _scope_result(s["token"])
            s["killed_by"] = _killed_by(s, st)
            s["delivered"] = os.path.exists(os.path.join(STATE_DIR, "results", s["token"] + ".delivered"))
        elif s["status"] == "Stashed" and s.get("token"):
            _probe_admission(s, {})
        elif s["status"] == "Running" and s.get("token"):
            _probe_progress(s)
    return {"tasks": out, "groups": st.get("groups", {}), "hostname": socket.gethostname()}


def _probe_progress(s):
    """A running admitted job's latest progress and projected end, from its queue entry."""
    try:
        settings = _admission_settings()
    except JobError:
        return
    if settings is None:
        return
    try:
        q = Admission(settings).read_json(os.path.join(settings["state_dir"], "queue", s["token"] + ".json"))
    except OSError:
        return
    if q and q.get("progress"):
        s["progress"] = q["progress"][-1][1:3]
        s["projected_end"] = q.get("projected_end")


LOG_FULL_MAX = 32 * 1024 * 1024  # job log --full sends at most this many final bytes


def _task_of(st, req):
    """The pueue task a request names by id (and token, when given); JobError when there is none."""
    tid = int(req["id"])
    t = st.get("tasks", {}).get(str(tid))
    if t is None:
        raise JobError("no task %d on %s" % (tid, socket.gethostname()))
    tok = req.get("token")
    if tok and (t.get("envs") or {}).get("JOB_TOKEN") != tok:
        raise JobError("task %d on %s now belongs to a different job" % (tid, socket.gethostname()))
    return tid, t


def _lines_of(raw):
    """A log's text as display lines: a progress bar's line keeps its last redraw, long lines are cut."""
    line = raw.decode("utf-8", "replace").rstrip("\n").rstrip("\r")
    line = line.rsplit("\r", 1)[-1] if "\r" in line else line
    return line[:TAIL_LINE_MAX] + " ...[line cut]" if len(line) > TAIL_LINE_MAX else line


def host_log(req):
    """A job's output: its last lines, the last lines matching a pattern, or all of it."""
    import collections
    tid, t = _task_of(_pueue_status(), req)
    path = _log_path(tid)
    try:
        size = os.path.getsize(path)
    except OSError:
        raise JobError("task %d on %s has no log file (%s)" % (tid, socket.gethostname(), path))
    n = req.get("lines", 50)
    if n is None:
        n = 50
    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
        raise JobError("lines must be a whole number of at least 1")
    out = {"id": tid, "log_path": path, "size": size, "status": _task_status(t)}
    if req.get("full"):
        with open(path, "rb") as f:
            f.seek(max(0, size - LOG_FULL_MAX))
            out["text"] = f.read(LOG_FULL_MAX).decode("utf-8", "replace")
        out["cut"] = size > LOG_FULL_MAX
        return out
    if req.get("grep") is not None:
        try:
            rx = re.compile(str(req["grep"]))
        except re.error as e:
            raise JobError("--grep %r is not a valid regular expression: %s" % (req["grep"], e))
        keep, count = collections.deque(maxlen=n), 0
        with open(path, "rb") as f:
            for raw in f:
                line = _lines_of(raw)
                if rx.search(line):
                    count += 1
                    keep.append(line)
        out.update(lines=list(keep), matches=count)
        return out
    out["lines"] = _tail(path, n, max_bytes=max(TAIL_BYTES, min(n * 2 * TAIL_LINE_MAX, LOG_FULL_MAX)))
    return out


def host_show(req):
    """Everything known about one job: command, task, group, size, state, times, token, log."""
    st = _pueue_status()
    tid, t = _task_of(st, req)
    s = _summarize_task(t)
    s["runner"] = t.get("command")
    s["log_path"] = _log_path(tid)
    g = st.get("groups", {}).get(s["group"]) or {}
    s["group_status"], s["group_parallel"] = g.get("status"), g.get("parallel_tasks")
    tok = s.get("token")
    if tok:
        try:
            with open(os.path.join(STATE_DIR, "scripts", tok + ".cmd"), encoding="utf-8", errors="replace") as f:
                s["full_command"] = f.read(65536)
        except OSError:
            pass
    if s["status"] == "Done":
        s["scope"] = _scope_result(tok)
        s["killed_by"] = _killed_by(s, st)
    try:
        settings = _admission_settings()
    except JobError:
        settings = None
    if settings is not None and tok:
        _probe_admission(s, {})
        q = Admission(settings).read_queue(tok)
        if q:
            s["admission"] = {k: q.get(k) for k in ("state", "size", "size_source", "like_from", "pilot", "constraints",
                                                    "memory_max", "ram_counted", "gpus", "reason", "submitted",
                                                    "released", "projected_end")}
    return s


def host_delivered(req):
    """A wait reported these jobs' outcomes: mark each (STATE_DIR/results/<token>.delivered), so the session-group
    cleanup may remove them once they are old."""
    toks = [t for t in (req.get("tokens") or []) if _token_ok(t)]
    for t in toks:
        _mark(os.path.join(STATE_DIR, "results", t + ".delivered"))
    return {"marked": len(toks)}


def host_resume(req):
    """Start a paused group again (pueue start --group)."""
    group = req.get("group")
    st = _pueue_status()
    g = st.get("groups", {}).get(group) if isinstance(group, str) else None
    if g is None:
        raise JobError("no pueue group %r on %s" % (group, socket.gethostname()))
    _pueue(["start", "--group", group])
    after = (_pueue_status().get("groups", {}).get(group) or {}).get("status")
    waiting = sum(1 for t in st.get("tasks", {}).values()
                  if t.get("group") == group and _task_status(t) in ("Queued", "Paused"))
    return {"group": group, "was": g.get("status"), "status": after, "waiting": waiting}


def host_group(req):
    name, n = req["name"], int(req["parallel"])
    if n < 1:
        raise JobError("parallel limit must be at least 1")
    created = False
    if name not in _pueue_status().get("groups", {}):
        _pueue(["group", "add", name])
        created = True
    _pueue(["parallel", str(n), "--group", name])
    return {"name": name, "parallel": n, "created": created}


def _mark(path):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    with open(path, "w") as f:
        f.write("%f\n" % time.time())


def host_kill(req):
    tid = int(req["id"])
    st = _pueue_status()
    t = st.get("tasks", {}).get(str(tid))
    if t is None:
        raise JobError("no task %d" % tid)
    tok = req.get("token")
    if tok and (t.get("envs") or {}).get("JOB_TOKEN") != tok:
        raise JobError("task %d now belongs to a different job; not killed" % tid)
    status = next(iter(t.get("status") or {"?": 0}))
    token = _env_token(t)
    results = os.path.join(STATE_DIR, "results")
    if status in ("Running", "Paused"):
        scoped = bool(token) and os.path.exists(os.path.join(STATE_DIR, "scripts", token + ".shim"))
        before = _job_procs(token)
        if token and req.get("stopped_by") not in LOOP_STOPS:
            _mark(os.path.join(results, token + ".jobkill"))  # its verdict says job kill ended it
        if scoped:  # its shim dies with it, so keep its use so far
            _snapshot_kill(token, req.get("stopped_by") if req.get("stopped_by") in LOOP_STOPS else "job kill")
        try:
            _pueue(["kill", str(tid)])
        except JobError:
            try:
                os.remove(os.path.join(results, token + ".jobkill"))
            except (OSError, TypeError):
                pass
            if scoped:
                try:
                    os.remove(os.path.join(STATE_DIR, "results", token + ".killed"))
                except OSError:
                    pass
            raise
        if scoped:
            _stop_scope(token)  # processes the job detached (setsid, nohup) end with it
        left = _end_leftovers(token, before) if token else []
        return {"id": tid, "action": "killed", "processes": len(before), "left": left}
    if status in ("Queued", "Stashed", "Locked"):
        mark = os.path.join(results, token + ".removed") if token else None
        if mark:
            _mark(mark)  # a wait on it ends KILLED, removed by job kill, not GONE
        try:
            _pueue(["remove", str(tid)])
        except JobError:
            if mark:
                try:
                    os.remove(mark)
                except OSError:
                    pass
            raise
        return {"id": tid, "action": "removed from the queue"}
    if status == "Done" and token:
        # pueue lost track of it (its daemon died without stopping it): its processes are found by the token. Only
        # such a job: the leftovers of a job that ended (a service it detached on purpose) are not job kill's.
        s = _summarize_task(t)
        before = _job_procs(token) if _killed_by(s, st) == "daemon-lost" else {}
        if before:
            if s.get("exit_record") is None:  # its command still ran: its verdict says job kill ended it
                _mark(os.path.join(results, token + ".jobkill"))
            if os.path.exists(os.path.join(STATE_DIR, "scripts", token + ".shim")):
                _stop_scope(token)
            left = _end_leftovers(token, before)
            return {"id": tid, "action": "killed (pueue had lost track of it)", "processes": len(before),
                    "left": left}
    raise JobError("task %d is %s; nothing to kill" % (tid, status))


# ---------------------------------------------------------------------------------------------------------------
# Admission (docs/admission.md): settings, measurement and room. The loop and the queue are further down.

ADMISSION_CONFIG = os.environ.get("JOB_ADMISSION_CONFIG") or os.path.expanduser("~/.config/agent-pueue/admission.json")
ADMISSION_DEFAULTS = {
    "state_dir": "~/.local/state/agent-pueue/admission",
    "cpu_busy_threads_max": None,      # default: every thread
    "placed_cores_max": None,          # default: 1.5 times the threads
    "ram_headroom_gb": 8.0,
    "ram_hard_factor": 1.5,
    "memory_pressure_max_pct": 10.0,
    "gpu_headroom_mb": 1024.0,
    "gpu_busy_max_pct": 90.0,
    "iowait_max_pct": 100.0,
    "disk_busy_max_pct": 100.0,
    "disk_heavy_mb_s": 50.0,
    "disks": [],
    "outside_window_s": 600,
    "cpu_window_s": 600,
    "sample_interval_s": 15,
    "pilot_sample_interval_s": 1,
    "warmup_s": None,                  # default: the longer of the two windows
    "fairness_wait_min": 30,
    "fairness_small_fraction": 0.1,    # a younger job taking under this share of what the oldest lacks may start
    "oversize_after_min": 30,          # a running job whose RAM peak stays under oversize_fraction of its size
    "oversize_fraction": 0.5,          # this long gets one ALERT saying so, with the command to shrink it
    "resize_margin": 1.25,             # a running job's new RAM limit must cover its measured peak times this
    "undersize_stall_pct": 10.0,       # a running job stalled this share of its time (memory full avg60) against its
                                       # own RAM limit gets one ALERT that it is undersized
    "auto_resize": True,               # the loop itself shrinks oversized running jobs and pilots, and grows a job
                                       # that presses against its RAM limit while the host has room
    "auto_shrink_min_saving": 0.2,     # a shrink is made only when it lowers the limit by at least this share
    "grow_at_fraction": 0.9,           # a job whose use (file cache excluded) reaches this share of its limit grows
    "grow_stall_pct": 2.0,             # so does one stalled this share of the last minute against its own limit
    "grow_factor": 1.5,                # a grow raises its limit to this times the old one at most, room allowing
    "auto_resize_retry_min": 5,        # a refused auto shrink is tried again after this long
    "small": {"cpus": 1, "ram_gb": 4},
    "pilot": {"max_minutes": 30, "max_minutes_ceiling": None, "gpu_min_gb": 2, "ram_floor_gb": 16,
              "shrink_after_min": 5, "shrink_margin": 2.0},
    "margins": {"cpu": 1.2, "ram": 1.25, "gpu_mem": 1.15},
    "preemptible": False,
    "oom_score_adj": 500,
    "gpu_env": {},
}
GB, MB = 1e9, 1e6
GPU_BUSY_WINDOW_S = 60


def _num(v, name, lo=0.0, hi=None, whole=False):
    what = name if name.startswith("--") else "admission setting " + name
    if (isinstance(v, bool) or not isinstance(v, (int, float)) or (whole and not isinstance(v, int))
            or not math.isfinite(v)):
        raise JobError("%s must be a %s" % (what, "whole number" if whole else "number"))
    if v < lo or (hi is not None and v > hi):
        raise JobError("%s must be from %s to %s" % (what, lo, "any" if hi is None else hi))
    return v


def _admission_settings(path=None, nthreads=None):
    """The host's admission settings, or None when the host is not an admission host.

    Raises JobError when the file exists but cannot be used: admission never falls back to admitting
    without rules.
    """
    path = path or ADMISSION_CONFIG
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise JobError("admission settings %s cannot be read: %s" % (path, e))
    if not isinstance(raw, dict):
        raise JobError("admission settings %s must be a JSON object" % path)
    unknown = sorted(set(raw) - set(ADMISSION_DEFAULTS))
    if unknown:
        raise JobError("admission settings %s: unknown setting %s" % (path, ", ".join(unknown)))
    s = json.loads(json.dumps(ADMISSION_DEFAULTS))
    for k, v in raw.items():
        if isinstance(s.get(k), dict) and k != "gpu_env":
            if not isinstance(v, dict) or set(v) - set(s[k]):
                raise JobError("admission setting %s must be an object with keys %s" % (k, ", ".join(sorted(s[k]))))
            s[k].update(v)
        else:
            s[k] = v
    n = nthreads or os.cpu_count() or 1
    if s["cpu_busy_threads_max"] is None:
        s["cpu_busy_threads_max"] = n
    if s["placed_cores_max"] is None:
        s["placed_cores_max"] = 1.5 * n
    for k in ("cpu_busy_threads_max", "placed_cores_max", "ram_headroom_gb", "gpu_headroom_mb", "disk_heavy_mb_s"):
        _num(s[k], k)
    _num(s["ram_hard_factor"], "ram_hard_factor", lo=1.0, hi=10.0)
    for k in ("memory_pressure_max_pct", "gpu_busy_max_pct", "iowait_max_pct", "disk_busy_max_pct",
              "undersize_stall_pct"):
        _num(s[k], k, hi=100.0)
    for k in ("outside_window_s", "cpu_window_s", "sample_interval_s", "pilot_sample_interval_s", "fairness_wait_min",
              "oversize_after_min"):
        _num(s[k], k, lo=1, whole=True)
    _num(s["oversize_fraction"], "oversize_fraction", lo=0.01, hi=1.0)
    _num(s["fairness_small_fraction"], "fairness_small_fraction", lo=0.0, hi=1.0)
    _num(s["resize_margin"], "resize_margin", lo=1.0, hi=10.0)
    if s["warmup_s"] is None:
        s["warmup_s"] = max(s["outside_window_s"], s["cpu_window_s"])
    _num(s["warmup_s"], "warmup_s", lo=0, hi=max(s["outside_window_s"], s["cpu_window_s"]), whole=True)
    _num(s["small"]["cpus"], "small.cpus", lo=0.01)
    _num(s["small"]["ram_gb"], "small.ram_gb", lo=0.01)
    _num(s["pilot"]["max_minutes"], "pilot.max_minutes", lo=1)
    if s["pilot"]["max_minutes_ceiling"] is None:  # default: an hour, or the default limit if that is longer
        s["pilot"]["max_minutes_ceiling"] = max(60, s["pilot"]["max_minutes"])
    _num(s["pilot"]["max_minutes_ceiling"], "pilot.max_minutes_ceiling", lo=s["pilot"]["max_minutes"])
    _num(s["pilot"]["shrink_after_min"], "pilot.shrink_after_min", lo=1)
    _num(s["pilot"]["shrink_margin"], "pilot.shrink_margin", lo=1.0, hi=10.0)
    if not isinstance(s["auto_resize"], bool):
        raise JobError("admission setting auto_resize must be true or false")
    _num(s["auto_shrink_min_saving"], "auto_shrink_min_saving", lo=0.0, hi=0.9)
    _num(s["grow_at_fraction"], "grow_at_fraction", lo=0.5, hi=1.0)
    _num(s["grow_stall_pct"], "grow_stall_pct", lo=0.0, hi=100.0)
    _num(s["grow_factor"], "grow_factor", lo=1.05, hi=10.0)
    _num(s["auto_resize_retry_min"], "auto_resize_retry_min", lo=0)
    _num(s["pilot"]["gpu_min_gb"], "pilot.gpu_min_gb", lo=0)
    _num(s["pilot"]["ram_floor_gb"], "pilot.ram_floor_gb", lo=0)
    for k in ("cpu", "ram", "gpu_mem"):
        _num(s["margins"][k], "margins." + k, lo=1.0)
    if not isinstance(s["preemptible"], bool):
        raise JobError("admission setting preemptible must be true or false")
    _num(s["oom_score_adj"], "oom_score_adj", hi=1000, whole=True)
    if not isinstance(s["disks"], list) or not all(isinstance(p, str) and p.startswith("/") for p in s["disks"]):
        raise JobError("admission setting disks must be a list of absolute paths")
    try:
        s["gpu_env"] = _check_scope({"memory_max": SCOPE_MIN_MEMORY, "gpu_env": s["gpu_env"]})["gpu_env"]
    except JobError as e:
        raise JobError("admission setting gpu_env: %s" % str(e).replace("scope.gpu_env ", ""))
    if not isinstance(s["state_dir"], str):
        raise JobError("admission setting state_dir must be a path")
    s["state_dir"] = os.path.expanduser(s["state_dir"])
    if not os.path.isabs(s["state_dir"]):
        raise JobError("admission setting state_dir must be an absolute path or start with ~")
    return s


def _gone(e):
    """Whether an OSError from a cgroup file means the cgroup is gone: ENOENT, or ENODEV when it was removed between
    the open and the read."""
    return isinstance(e, FileNotFoundError) or getattr(e, "errno", None) == errno.ENODEV


def _droppable_cache(stat):
    """The file cache a lower RAM limit makes the kernel drop, from a memory.stat dict: inactive_file, and the part of
    active_file that is not memory-mapped (hot mapped file pages, such as a program's or library's code and data it
    reads through mmap, are its working set: dropping them makes it fault them straight back), less the pages that
    are dirty or under writeback (file_dirty, file_writeback), which must be written out before they can go."""
    def n(k):
        try:
            return int(stat.get(k, 0))
        except (TypeError, ValueError):
            return 0
    return max(0, n("inactive_file") + max(0, n("active_file") - n("file_mapped"))
               - n("file_dirty") - n("file_writeback"))


def _refaults(stat):
    """A memory.stat dict's count of file pages read back in after the kernel dropped them (workingset_refault_file;
    workingset_refault on kernels before 5.9), or None."""
    for k in ("workingset_refault_file", "workingset_refault"):
        try:
            return int(stat[k])
        except (KeyError, TypeError, ValueError):
            continue
    return None


OUTSIDE_QUIET_PCT = 1.0  # outside the jobs, a cgroup stalled this little (full avg10) is quiet: noise, not a shortage
SHRINK_STALL_PCT = 1.0   # a job stalled more than this (its own full avg60) is not shrunk, nor told it is oversized


def _parse_pressure(text):
    """A pressure file ("some avg10=0.00 avg60=0.00 avg300=0.00 total=0" and a "full" line) as
    {"some": {"avg10": "0.00", ...}, "full": {...}}."""
    out = {}
    for line in text.splitlines():
        parts = line.split()
        if parts:
            out[parts[0]] = dict(kv.split("=", 1) for kv in parts[1:] if "=" in kv)
    return out


class Measure:
    """Reads one host's state. The roots are parameters so tests can give a fake /proc, /sys, cgroup tree and
    GPU list (a JSON file: {"cards": [{"index", "uuid", "name", "total", "free", "util"}],
    "procs": [{"uuid", "pid", "used"}]})."""

    def __init__(self, proc="/proc", sys_root="/sys", cgroup_root="/sys/fs/cgroup", gpu_file=None, uid=None,
                 psi_root=None):
        self.proc, self.sys, self.cg = proc, sys_root, cgroup_root
        self.psi_root = psi_root or cgroup_root  # the tree whose memory.pressure files are read (tests give a fake)
        self.last_stall = {}  # {job cgroup path: (memory.events max, pressure full total)} at the last sample
        self.last_allocstall = None  # the sum of /proc/vmstat allocstall_* at the last sample
        self.gpu_file = gpu_file if gpu_file is not None else os.environ.get("JOB_TEST_GPUS")
        self.uid = os.getuid() if uid is None else uid
        self.nvml = None
        self.nvml_retry = 0.0
        self.last_cpu = None
        self.last_io = {}
        self.last_disk = None
        self.last_jobs = {}

    # -- host --------------------------------------------------------------------------------------------------

    def _read(self, *parts):
        with open(os.path.join(*parts), encoding="ascii", errors="replace") as f:
            return f.read()

    def threads(self):
        return sum(1 for line in self._read(self.proc, "stat").splitlines()
                   if line.startswith("cpu") and line[3:4].isdigit())

    def cpu(self, now):
        """(busy threads, iowait %) averaged since the last call; (None, None) on the first."""
        f = self._read(self.proc, "stat").splitlines()[0].split()[1:]
        v = [int(x) for x in f[:8]] + [0] * max(0, 8 - len(f))
        user, nice, system, idle, iowait, irq, softirq, steal = v[:8]
        busy, total = user + nice + system + irq + softirq + steal, user + nice + system + idle + iowait + irq + softirq + steal
        last, self.last_cpu = self.last_cpu, (busy, total, iowait)
        if last is None or total <= last[1]:
            return None, None
        dt = total - last[1]
        return self.threads() * (busy - last[0]) / dt, 100.0 * (iowait - last[2]) / dt

    def meminfo(self):
        out = {}
        for line in self._read(self.proc, "meminfo").splitlines():
            k, _, v = line.partition(":")
            parts = v.split()
            if parts and parts[0].isdigit():
                out[k] = int(parts[0]) * (1024 if parts[1:2] == ["kB"] else 1)
        return out

    def memory_pressure(self):
        """The host-wide memory pressure full avg10 (percent, /proc/pressure/memory), or 0.0 where pressure is not
        reported."""
        try:
            return float(_parse_pressure(self._read(self.proc, "pressure", "memory"))["full"]["avg10"])
        except (OSError, KeyError, ValueError):
            return 0.0

    def cgroup_pressure(self, path):
        """{"some": {...}, "full": {"avg10", "avg60", ...}} of a cgroup's memory.pressure (an absolute path); raises
        OSError when it cannot be read (FileNotFoundError when the cgroup or its pressure file is gone)."""
        return _parse_pressure(self._read(path, "memory.pressure"))

    def limit_events(self, cg):
        """The count of memory.events "max" plus "high" of a cgroup: how often its use (or, as the counts are
        hierarchical, a descendant's) reached its own memory.max, or the soft limit (memory.high) the loop gives a job
        cut to its use, and the kernel reclaimed or throttled inside it. None when it cannot be read."""
        n = None
        try:
            for line in self._read(cg, "memory.events").splitlines():
                k, _, v = line.partition(" ")
                if k in ("max", "high"):
                    n = (n or 0) + int(v)
        except (OSError, ValueError):
            return None
        return n

    def effective_limit(self, cg, top):
        """The lowest memory.max of a cgroup and its ancestors below top (absolute paths): the limit its use reclaims
        against. None when none is set."""
        top = top.rstrip("/")
        lims, d = [], cg.rstrip("/")
        while d.startswith(top + "/"):
            v = _read_cg_int(d, "memory.max")
            if v:
                lims.append(v)
            d = os.path.dirname(d)
        return min(lims) if lims else None

    def global_reclaim(self):
        """Whether the host is in global reclaim: the sum of /proc/vmstat's allocstall_* counters (allocstall before
        4.8) grew since the last call. The kernel counts these only for direct reclaim that is not aimed at one
        cgroup (mm/vmscan.c do_try_to_free_pages: `if (!cgroup_reclaim(sc))`), so a cgroup reclaiming against its
        own memory.max never adds to them. True when it can't be told (the first call, no such counters, or an
        unreadable file): the safe side, which excludes nothing."""
        try:
            vals = [int(ln.split()[1]) for ln in self._read(self.proc, "vmstat").splitlines()
                    if ln.startswith("allocstall")]
        except (OSError, ValueError, IndexError):
            vals = []
        n = sum(vals)
        if not vals:
            self.last_allocstall = None
            return True
        last, self.last_allocstall = self.last_allocstall, n
        return last is None or n > last

    def job_stall(self, cg, top, seen):
        """The stall of one job's cgroup (an absolute path) and whether it is stalled against its own limit
        (docs/admission.md, "Memory pressure"). Since its last sample: at its own limit when both its "full" stall
        time (memory.pressure total=) and its memory.events "max" count grew; stalled at all only when the stall time
        grew. On first sight (a new job, or a restarted loop): at its limit when it has reached it before and
        memory.current is within 5% of its effective limit, and stalled as its full avg10 says. seen collects this
        sample's counters. Returns {full10, full60, at_limit, stalled}; raises OSError when its pressure cannot be
        read."""
        p = self.cgroup_pressure(cg)
        full10, full60 = float(p["full"]["avg10"]), float(p["full"]["avg60"])
        try:
            total = int(p["full"]["total"])
        except (KeyError, ValueError):
            total = None
        ev = self.limit_events(cg)
        seen[cg] = (ev, total)
        prev = self.last_stall.get(cg)
        if prev is not None and total is not None and prev[1] is not None:
            stalled = total > prev[1]
            at_limit = stalled and ev is not None and prev[0] is not None and ev > prev[0]
        else:
            stalled = full10 > 0
            cur, lim = _read_cg_int(cg, "memory.current"), self.effective_limit(cg, top)
            at_limit = bool(ev) and bool(cur) and bool(lim) and cur >= 0.95 * lim
        return {"full10": full10, "full60": full60, "at_limit": at_limit, "stalled": stalled}

    def pressure(self, scopes):
        """Memory pressure for the admission check, and each job's own stall (docs/admission.md, "Memory pressure").

        scopes: {token: absolute path} of every agent-pueue job scope of this user. The cgroup tree under psi_root
        is split into the job scopes and the member cgroups that hold none of them (walking down only through
        user.slice and the ancestors of job scopes: each other user's slice, system.slice and the other top-level
        cgroups, each read as one, and this user's other units). A member counts at its full avg10, whatever its
        own limits. A job counts at its full avg10 while its stall time grows, except when it is stalled against its
        own limit and the host is not in global reclaim (global_reclaim): that is it being undersized, not host
        pressure. In global reclaim, the system-wide full avg10 is the figure, excluding nothing. Otherwise the
        cgroup figure is the highest of the members' and the jobs' figures, and the host's figure is the lower of it
        and the system-wide full avg10, so it is never more sensitive than the system-wide figure alone. Where any
        member's pressure cannot be read, or none can, the system-wide figure is used alone (it counts a job's own
        stall, the safe side), and the unreadable cgroups are named.

        Returns {psi, system, source ("cgroups" when the cgroup figure is the lower, else "system"), where,
        cgroups (the cgroup figure, None when not used), cg_where, outside (the highest figure among the members,
        None when not all were read), unreadable (a count), unreadable_paths (up to 5 of them), global (whether the
        host is in global reclaim), jobs: {token: {full10, full60, at_limit}}}."""
        system = self.memory_pressure()
        glob = self.global_reclaim()
        out = {"psi": system, "system": system, "source": "system", "where": None, "cgroups": None, "cg_where": None,
               "outside": None, "unreadable": 0, "unreadable_paths": [], "global": glob, "jobs": {}}
        root = self.psi_root.rstrip("/")
        cgr = self.cg.rstrip("/")
        rel = {}
        for tok, path in scopes.items():
            if path.startswith(cgr + "/"):
                rel[path[len(cgr):]] = tok
        above = {"/user.slice"}  # each user's slice on its own: "full" of all users together hides one who stalls
        for r in rel:
            parts = r.strip("/").split("/")
            for i in range(1, len(parts)):
                above.add("/" + "/".join(parts[:i]))
        seen, members, bad, todo = {}, [], [], [""]
        while todo:
            d = todo.pop()
            try:
                names = sorted(e.name for e in os.scandir(root + d) if e.is_dir(follow_symlinks=False))
            except OSError as e:
                if not _gone(e):
                    bad.append(d or "/")
                continue
            for n in names:
                c = d + "/" + n
                if c in rel:
                    continue
                if c in above:
                    todo.append(c)
                    continue
                try:
                    members.append((float(self.cgroup_pressure(root + c)["full"]["avg10"]), c))
                except OSError as e:
                    if not _gone(e):  # gone since it was listed, or a kernel without pressure files
                        bad.append(c)
                except (KeyError, ValueError):
                    bad.append(c)
        outside = max(members) if members else (0.0, None)
        best = outside
        for c, tok in rel.items():
            job = scopes[tok] + "/job"
            base = job if os.path.isdir(job) else scopes[tok]
            try:
                j = self.job_stall(base, cgr, seen)
            except (OSError, KeyError, ValueError):
                continue  # ended, or not readable: its stall is unknown, and the cgroups outside still count
            out["jobs"][tok] = {"full10": j["full10"], "full60": j["full60"], "at_limit": j["at_limit"]}
            fig = j["full10"] if j["stalled"] and (glob or not j["at_limit"]) else 0.0
            if fig > best[0]:
                best = (fig, c)
        self.last_stall = seen
        out["unreadable"], out["unreadable_paths"] = len(bad), bad[:5]
        if members and not bad:
            out["outside"] = outside[0]
            if not glob:
                out.update(cgroups=best[0], cg_where=best[1])
                if best[0] <= system:
                    out.update(psi=best[0], source="cgroups", where=best[1])
        return out

    def disk_of(self, path):
        """The block device (whole disk, not partition) that holds path, or None."""
        try:
            st = os.stat(path)
        except OSError:
            return None
        link = os.path.join(self.sys, "dev", "block", "%d:%d" % (os.major(st.st_dev), os.minor(st.st_dev)))
        real = os.path.realpath(link)
        if not os.path.isdir(real):
            return None
        if os.path.exists(os.path.join(real, "partition")):
            real = os.path.dirname(real)
        return os.path.basename(real)

    def disks(self, now, names):
        """Busy percent of each named disk since the last call."""
        ticks = {}
        try:
            for line in self._read(self.proc, "diskstats").splitlines():
                p = line.split()
                if len(p) > 12 and p[2] in names:
                    ticks[p[2]] = int(p[12])
        except OSError:
            return {}
        last, self.last_disk = self.last_disk, (now, ticks)
        if last is None or now <= last[0]:
            return {}
        ms = (now - last[0]) * 1000.0
        return {n: min(100.0, 100.0 * (t - last[1].get(n, t)) / ms) for n, t in ticks.items()}

    # -- GPUs --------------------------------------------------------------------------------------------------

    def gpus(self):
        """[{index, uuid, name, total, used, util, procs: {pid: bytes}, procs_ok}] in bytes (procs_ok False when the
        process list could not be read); [] on a host without GPUs."""
        if self.gpu_file:
            with open(self.gpu_file) as f:
                raw = json.load(f)
            cards = [{"index": c["index"], "uuid": c["uuid"], "name": c.get("name", "?"), "total": c["total"],
                      "used": c["total"] - c["free"], "util": c.get("util", 0), "procs": {},
                      "procs_ok": c.get("procs_ok", True)} for c in raw["cards"]]
            by = {c["uuid"]: c for c in cards}
            for p in raw.get("procs", []):
                if p["uuid"] in by:
                    by[p["uuid"]]["procs"][int(p["pid"])] = p["used"]
            return cards
        if self.nvml is None or (self.nvml is False and time.time() >= self.nvml_retry):
            self.nvml = _Nvml.open() or False
            self.nvml_retry = time.time() + 600  # without NVML, try it again in 10 minutes
        if self.nvml:
            try:
                return self.nvml.cards()
            except (OSError, AttributeError):
                self.nvml, self.nvml_retry = False, time.time() + 600
        return _nvidia_smi_cards()

    # -- admitted jobs -----------------------------------------------------------------------------------------

    def user_root(self):
        return os.path.join(self.cg, "user.slice", "user-%d.slice" % self.uid, "user@%d.service" % self.uid)

    def scopes(self):
        """{token: path of the job's scope} for every agent-pueue job scope of this user."""
        out = {}
        root = self.user_root()
        for dirpath, dirnames, _ in os.walk(root):
            depth = dirpath[len(root):].count(os.sep)
            keep = []
            for d in dirnames:
                if d.startswith(SCOPE_PREFIX) and d.endswith(".scope"):
                    tok = d[len(SCOPE_PREFIX):-len(".scope")]
                    if len(tok) == 32 and all(c in "0123456789abcdef" for c in tok):
                        out[tok] = os.path.join(dirpath, d)
                elif depth < 2:
                    keep.append(d)
            dirnames[:] = keep
        return out

    def job_use(self, now, scopes):
        """{token: {ram, cache, files, need, current, refault, limit, cpu, disk_mb_s, pids, populated}} for each
        scope: RAM size basis (bytes, all file cache excluded), the file cache a lower limit drops (_droppable_cache),
        all its file cache, what it can't give back (memory.current less that droppable cache), memory.current, its
        file refault count (None when not reported), its memory.max (None for none), CPU threads and disk MB/s (read
        plus written) since the last call, and the job's pids."""
        out, seen = {}, {}
        io_seen = {}
        for tok, scope in scopes.items():
            job = os.path.join(scope, "job")
            base = job if os.path.isdir(job) else scope
            try:
                cur = int(self._read(base, "memory.current"))
                stat = dict((ln.split() + ["0"])[:2] for ln in self._read(base, "memory.stat").splitlines() if ln)
                usec = int(dict((ln.split() + ["0"])[:2] for ln in self._read(base, "cpu.stat").splitlines()
                                if ln).get("usage_usec", 0))
                pids = [int(x) for x in self._read(base, "cgroup.procs").split()]
            except (OSError, ValueError):
                continue
            files = int(stat.get("active_file", 0)) + int(stat.get("inactive_file", 0))
            ram = max(0, cur - files)
            cache = min(files, _droppable_cache(stat))
            last = self.last_jobs.get(tok)
            cpu = (usec - last[1]) / 1e6 / (now - last[0]) if last and now > last[0] else None
            seen[tok] = (now, usec)
            moved = 0
            for pid in pids:
                b = self._io_bytes(pid)
                if b is None:
                    continue
                io_seen[pid] = b
                moved += max(0, b - self.last_io.get(pid, 0))  # a new pid started since the last call
            disk = moved / 1e6 / (now - last[0]) if last and now > last[0] else None
            out[tok] = {"ram": ram, "cache": cache, "files": files, "need": max(0, cur - cache), "current": cur,
                        "refault": _refaults(stat), "limit": _read_cg_int(base, "memory.max"), "cpu": cpu,
                        "disk_mb_s": disk, "pids": pids, "populated": bool(pids)}
        self.last_jobs = seen
        self.last_io = io_seen
        return out

    def cgroup_mem(self, path):
        """(RAM on a job's basis, droppable file cache, memory.current, file refaults) of a cgroup (a path under the
        cgroup root): memory.current less all file cache, the file cache a lower limit drops (_droppable_cache),
        memory.current and the stat's file refault count (None when not reported); (None, 0, None, None) when it
        cannot be read."""
        try:
            cur = int(self._read(self.cg + path, "memory.current"))
            stat = dict((ln.split() + ["0"])[:2] for ln in self._read(self.cg + path, "memory.stat").splitlines() if ln)
        except (OSError, ValueError):
            return None, 0, None, None
        files = int(stat.get("active_file", 0)) + int(stat.get("inactive_file", 0))
        return max(0, cur - files), min(files, _droppable_cache(stat)), cur, _refaults(stat)

    def cgroup_ram(self, path):
        """RAM of a cgroup (a path under the cgroup root) on a job's basis: memory.current less file cache; None
        when it cannot be read."""
        return self.cgroup_mem(path)[0]

    def pids_ram(self, pids):
        """Anonymous and shared memory of pids, file-backed pages excluded (as for a job): Pss_Anon + Pss_Shmem from
        smaps_rollup, summed, so memory shared between them counts once. Where a process's smaps_rollup cannot be
        read (another user's process, a kernel without Pss_Anon), a lower bound instead: the larger of that sum and
        the biggest single process's RssAnon + RssShmem. Own use counted too high would give its room out twice;
        too low only keeps some room back."""
        pss, exact = 0, True
        for pid in pids:
            try:
                f = dict(ln.split(":", 1) for ln in self._read(self.proc, str(pid), "smaps_rollup").splitlines()
                         if ":" in ln)
                if "Pss_Anon" in f:
                    pss += sum(int(f[k].split()[0]) * 1024 for k in ("Pss_Anon", "Pss_Shmem") if k in f)
                    continue
            except (OSError, ValueError, IndexError):
                pass
            exact = False
        if exact:
            return pss
        biggest = 0
        for pid in pids:
            try:
                f = dict(ln.split(":", 1) for ln in self._read(self.proc, str(pid), "status").splitlines() if ":" in ln)
                biggest = max(biggest, sum(int(f[k].split()[0]) * 1024 for k in ("RssAnon", "RssShmem") if k in f))
            except (OSError, ValueError, IndexError):
                continue
        return max(pss, biggest)

    def _io_bytes(self, pid):
        try:
            f = dict(ln.split(": ", 1) for ln in self._read(self.proc, str(pid), "io").splitlines() if ": " in ln)
            return int(f["read_bytes"]) + int(f["write_bytes"])
        except (OSError, KeyError, ValueError):
            return None

    def cgroup_of(self, pid):
        try:
            return self._read(self.proc, str(pid), "cgroup").split("::", 1)[1].strip()
        except (OSError, IndexError):
            return None


class _Nvml:
    """The few NVML calls admission needs, through ctypes (standard library)."""

    class Memory(ctypes.Structure):
        _fields_ = [("total", ctypes.c_ulonglong), ("free", ctypes.c_ulonglong), ("used", ctypes.c_ulonglong)]

    class Util(ctypes.Structure):
        _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]

    class Proc(ctypes.Structure):  # nvmlProcessInfo_v2_t, used by the _v3 calls
        _fields_ = [("pid", ctypes.c_uint), ("usedGpuMemory", ctypes.c_ulonglong),
                    ("gpuInstanceId", ctypes.c_uint), ("computeInstanceId", ctypes.c_uint)]

    @classmethod
    def open(cls):
        try:
            lib = ctypes.CDLL("libnvidia-ml.so.1")
            if lib.nvmlInit_v2() != 0:
                return None
            lib.nvmlDeviceGetCount_v2
            lib.nvmlDeviceGetComputeRunningProcesses_v3
        except (OSError, AttributeError):
            return None
        n = cls()
        n.lib = lib
        return n

    def _ok(self, rc, what):
        if rc != 0:
            raise OSError("NVML %s failed (%d)" % (what, rc))

    def _procs(self, fn, h):
        count = ctypes.c_uint(64)
        arr = (self.Proc * 64)()
        rc = fn(h, ctypes.byref(count), arr)
        if rc == 7:  # NVML_ERROR_INSUFFICIENT_SIZE
            arr = (self.Proc * count.value)()
            rc = fn(h, ctypes.byref(count), arr)
        self._ok(rc, "process list")
        # NVML_VALUE_NOT_AVAILABLE (all ones): the process is on the card but its memory is not known; it is kept,
        # at 0, so the card is not taken for one no one else uses
        return {arr[i].pid: arr[i].usedGpuMemory if arr[i].usedGpuMemory < (1 << 63) else 0
                for i in range(count.value)}

    def cards(self):
        lib, out = self.lib, []
        count = ctypes.c_uint()
        self._ok(lib.nvmlDeviceGetCount_v2(ctypes.byref(count)), "device count")
        for i in range(count.value):
            h = ctypes.c_void_p()
            self._ok(lib.nvmlDeviceGetHandleByIndex_v2(i, ctypes.byref(h)), "device handle")
            uuid, name = ctypes.create_string_buffer(96), ctypes.create_string_buffer(96)
            self._ok(lib.nvmlDeviceGetUUID(h, uuid, 96), "UUID")
            self._ok(lib.nvmlDeviceGetName(h, name, 96), "name")
            mem, util = self.Memory(), self.Util()
            self._ok(lib.nvmlDeviceGetMemoryInfo(h, ctypes.byref(mem)), "memory")
            busy = util.gpu if lib.nvmlDeviceGetUtilizationRates(h, ctypes.byref(util)) == 0 else 0
            procs = self._procs(lib.nvmlDeviceGetGraphicsRunningProcesses_v3, h)
            procs.update(self._procs(lib.nvmlDeviceGetComputeRunningProcesses_v3, h))  # they overlap
            out.append({"index": i, "uuid": uuid.value.decode(), "name": name.value.decode(), "total": mem.total,
                        "used": mem.total - mem.free, "util": busy, "procs": procs})
        return out


def _nvidia_smi_cards():
    """The same as _Nvml.cards, from nvidia-smi; [] when there is no nvidia-smi."""
    try:
        p = subprocess.run(["nvidia-smi", "--query-gpu=index,uuid,name,memory.total,memory.free,utilization.gpu",
                            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=30)
        q = subprocess.run(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory",
                            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if p.returncode != 0:
        return []
    cards = []
    for line in p.stdout.splitlines():
        f = [x.strip() for x in line.split(",")]
        if len(f) == 6:
            total = int(float(f[3])) << 20
            cards.append({"index": int(f[0]), "uuid": f[1], "name": f[2], "total": total,
                          "used": total - (int(float(f[4])) << 20),
                          "util": int(float(f[5])) if f[5].replace(".", "").isdigit() else 0, "procs": {}})
    by = {c["uuid"]: c for c in cards}
    if q.returncode != 0:
        for c in cards:
            c["procs_ok"] = False  # its processes are not known, so it is not taken to have none
    for line in q.stdout.splitlines() if q.returncode == 0 else []:
        f = [x.strip() for x in line.split(",")]
        if len(f) == 3 and f[0] in by and f[1].isdigit():
            by[f[0]]["procs"][int(f[1])] = int(f[2]) << 20 if f[2].isdigit() else 0  # "[N/A]": on the card, size unknown
    return cards


def _gbs(n):
    return "%.1f GB" % (n / GB)


def _in_window(samples, now, seconds):
    return [s for s in samples if now - s["t"] <= seconds]


def compute_room(settings, samples, inflight, holds, now):
    """The room left on a host, from its recent samples (docs/admission.md, "Room").

    samples: oldest first, each {t, busy, iowait, avail, psi, disks: {name: pct},
      gpus: {gid: {index, name, total, used, util}}, jobs: {token: {ram, cpu, gpu: {gid: bytes}}},
      holds: {hold_id: {gid: bytes}}, hold_ram: {hold_id: bytes}}.
    inflight: [{token, released, size: {cpus, ram, gpu_mem, gpu_share}, gpus: [gid], ram_counted,
      gpu_counted: {gid: bytes}}].
    holds: [{id, gid (None for a RAM-only hold), size (GPU bytes), ram (bytes)}]. Returns None until there is a
    sample to count from.
    """
    if not samples:
        return None
    last = samples[-1]
    out = {"t": last["t"], "psi": last["psi"], "pressure_ok": last["psi"] <= settings["memory_pressure_max_pct"],
           "psi_source": last.get("psi_source") or "system", "psi_where": last.get("psi_where"),
           "psi_system": last.get("psi_system", last["psi"]), "psi_unreadable": last.get("psi_unreadable") or 0,
           "psi_cgroups": last.get("psi_cgroups"), "psi_cg_where": last.get("psi_cg_where"),
           "psi_global": last.get("psi_global"), "psi_unreadable_paths": last.get("psi_unreadable_paths") or []}
    use = {tok: j for tok, j in last["jobs"].items()}

    # RAM: what would be available with no admitted job, at its lowest over the window
    win = _in_window(samples, now, settings["outside_window_s"])
    free_no_jobs = min(s["avail"] + sum(j["ram"] for j in s["jobs"].values()) + sum(s.get("hold_ram", {}).values())
                       for s in win)
    counted = sum(max(j["ram_counted"], use.get(j["token"], {}).get("ram", 0)) for j in inflight)
    own_ram = last.get("hold_ram", {})
    held_ram = sum(max(h.get("ram") or 0, own_ram.get(h["id"], 0)) for h in holds if h.get("ram"))
    out["ram"] = {"free_no_jobs": free_no_jobs, "counted": counted, "holds": held_ram,
                  "room": free_no_jobs - settings["ram_headroom_gb"] * GB - counted - held_ram}

    # CPU: outside use averaged over the window; older jobs count at their measured use
    cwin = [s for s in _in_window(samples, now, settings["cpu_window_s"]) if s["busy"] is not None]
    outside = (sum(max(0.0, s["busy"] - sum(j["cpu"] or 0.0 for j in s["jobs"].values())) for s in cwin) / len(cwin)
               if cwin else 0.0)
    committed = 0.0
    for j in inflight:
        vals = [s["jobs"][j["token"]]["cpu"] for s in cwin
                if j["token"] in s["jobs"] and s["jobs"][j["token"]]["cpu"] is not None]
        avg = sum(vals) / len(vals) if vals else 0.0
        committed += avg if now - j["released"] > settings["cpu_window_s"] else max(j["size"]["cpus"], avg)
    out["cpu"] = {"outside": outside, "committed": committed,
                  "placed": sum(j["size"]["cpus"] for j in inflight),
                  "room": settings["cpu_busy_threads_max"] - outside - committed,
                  "placed_room": settings["placed_cores_max"] - sum(j["size"]["cpus"] for j in inflight),
                  "iowait": (sum(s["iowait"] for s in cwin[-4:]) / len(cwin[-4:])) if cwin else 0.0}

    # GPUs, per card
    gwin = _in_window(samples, now, settings["outside_window_s"])
    recent = _in_window(samples, now, GPU_BUSY_WINDOW_S)
    out["gpus"] = {}
    for gid, card in last["gpus"].items():
        series = []
        for s in gwin:
            c = s["gpus"].get(gid)
            if c is None:
                continue
            ours = sum(j.get("gpu", {}).get(gid, 0) for j in s["jobs"].values())
            held = sum(h.get(gid, 0) for h in s.get("holds", {}).values())
            series.append(max(0, c["used"] - ours - held))
        # device and process values come from separate calls: a sample's value is the lower of two in a row
        paired = [min(a, b) for a, b in zip(series, series[1:])] or series
        gpu_outside = max(paired) if paired else 0
        jobs_on = [j for j in inflight if gid in j["gpus"]]
        # every admitted job's use on this card, given or not: it was taken out of outside use above
        jobs_counted = sum(max(j["gpu_counted"].get(gid, 0), use.get(j["token"], {}).get("gpu", {}).get(gid, 0))
                           for j in inflight)
        held_own = {hid: h.get(gid, 0) for hid, h in last.get("holds", {}).items()}
        holds_counted = sum(max(h["size"], held_own.get(h["id"], 0)) for h in holds if h.get("gid") == gid)
        utils = [s["gpus"][gid]["util"] for s in recent if gid in s["gpus"]]
        util = sum(utils) / len(utils) if utils else 0.0
        shares = sum(j["size"].get("gpu_share") or 0 for j in jobs_on)
        out["gpus"][gid] = {
            "index": card["index"], "name": card["name"], "total": card["total"], "outside": gpu_outside,
            "jobs": jobs_counted, "holds": holds_counted, "util": util, "shares": shares,
            "others": card.get("others", 0),
            "room": card["total"] - settings["gpu_headroom_mb"] * MB - gpu_outside - jobs_counted - holds_counted}

    # disks: busy time over the last minute
    out["disks"] = {}
    for name in last["disks"]:
        vals = [s["disks"][name] for s in recent if name in s["disks"]]
        out["disks"][name] = sum(vals) / len(vals) if vals else 0.0
    return out


def _psi_where(room):
    """Where a room's memory pressure figure comes from, for messages."""
    if room.get("psi_source") == "cgroups":
        if not room.get("psi_where"):
            return " (nothing is stalled other than jobs against their own RAM limits)"
        return " (in %s, the highest of the cgroups, leaving out jobs stalled against their own RAM limits)" % (
            room["psi_where"])
    if room.get("psi_cgroups") is not None:
        return " (system-wide, lower than the highest of the cgroups leaving out jobs stalled against their own " \
               "RAM limits, %.1f%% in %s)" % (room["psi_cgroups"], room.get("psi_cg_where") or "?")
    if room.get("psi_unreadable"):
        paths = room.get("psi_unreadable_paths") or []
        return " (system-wide: %d cgroup(s) could not be read%s, so jobs' own stalls are counted too)" % (
            room["psi_unreadable"], ": " + ", ".join(paths) + (", ..." if room["psi_unreadable"] > len(paths) else "")
            if paths else "")
    if room.get("psi_global"):
        return " (system-wide: the host is in global reclaim, so no job's stall is left out)"
    return " (system-wide)"


def _pilot_ram_need(settings, size):
    """The RAM room a pilot needs before it is released: at least pilot.ram_floor_gb, so that a pilot released on
    a busy host is not limited to a few GB and killed within minutes."""
    return max(size["ram"], settings["pilot"]["ram_floor_gb"] * GB)


def ram_limit(settings, ram):
    """The hard RAM limit of a job sized `ram`. A job is counted at it, not at its size, so jobs that grow up to their
    limits together still leave ram_headroom free."""
    return _whole_pages(max(int(ram * settings["ram_hard_factor"]), SCOPE_MIN_MEMORY))


def fits(settings, room, job, data_disk=None):
    """Whether a held job fits the room now. Returns (True, {gpus, ram_counted, gpu_counted}) or (False, reason).

    job: {size: {cpus, ram, gpus, gpu_mem, gpu_share, disk_mb_s}, pilot, constraints: {gpu_model}}.
    A pilot is counted at all the RAM room and, with GPUs, all the room on its cards.
    """
    if room is None:
        return False, "no measurement yet"
    if not room["pressure_ok"]:
        return False, "memory pressure %.1f%%%s is over %.1f%%" % (room["psi"], _psi_where(room),
                                                                   settings["memory_pressure_max_pct"])
    size, pilot = job["size"], job.get("pilot")
    ram_room = room["ram"]["room"]
    if pilot:
        if ram_room <= size["ram"] or ram_room < _pilot_ram_need(settings, size):
            return False, "a pilot needs at least %s of RAM room (pilot.ram_floor_gb), %s free" % (
                _gbs(_pilot_ram_need(settings, size)), _gbs(max(0, ram_room)))
        ram_counted = ram_room
    else:
        ram_counted = ram_limit(settings, size["ram"])
        if ram_counted > ram_room:
            return False, "needs %s RAM (its limit, %g times its size), %s free" % (
                _gbs(ram_counted), settings["ram_hard_factor"], _gbs(max(0, ram_room)))
    cpu = room["cpu"]
    if size["cpus"] > cpu["room"] + 1e-9:
        return False, "needs %g CPU threads, %.1f free" % (size["cpus"], max(0.0, cpu["room"]))
    if size["cpus"] > cpu["placed_room"] + 1e-9:
        return False, "needs %g CPU threads, %.1f left to place" % (size["cpus"], max(0.0, cpu["placed_room"]))
    if (size.get("disk_mb_s") or 0) > settings["disk_heavy_mb_s"] and data_disk in room["disks"]:
        busy = room["disks"][data_disk]
        if busy > settings["disk_busy_max_pct"]:
            return False, "disk %s is busy %.0f%% of the time (over %.0f%%)" % (data_disk, busy,
                                                                                 settings["disk_busy_max_pct"])
        if (cpu["iowait"] > settings["iowait_max_pct"]
                and busy >= max(room["disks"].values())):
            return False, "iowait %.0f%% is over %.0f%% and disk %s is the busiest" % (
                cpu["iowait"], settings["iowait_max_pct"], data_disk)
    chosen, gpu_counted = [], {}
    n = size.get("gpus") or 0
    if n:
        model = (job.get("constraints") or {}).get("gpu_model")
        ok, why = [], []
        for gid, g in room["gpus"].items():
            if model and model.lower() not in g["name"].lower():
                continue
            if g["util"] > settings["gpu_busy_max_pct"]:
                why.append("GPU %d is busy %.0f%%" % (g["index"], g["util"]))
                continue
            if g["shares"] + (size.get("gpu_share") or 0) > settings["gpu_busy_max_pct"]:
                why.append("GPU %d has %.0f%% of its time left to share, it needs %g%%" % (
                    g["index"], max(0.0, settings["gpu_busy_max_pct"] - g["shares"]), size.get("gpu_share") or 0))
                continue
            need = settings["pilot"]["gpu_min_gb"] * GB if pilot else size["gpu_mem"]
            if g["room"] < max(need, 1):
                why.append("GPU %d has %s free" % (g["index"], _gbs(max(0, g["room"]))))
                continue
            ok.append((g["room"], g["index"], gid))
        if len(ok) < n:
            want = "a pilot needs %d GPU(s) with room" % n if pilot else "needs %d GPU(s) with %s free" % (
                n, _gbs(size["gpu_mem"]))
            return False, "%s; %s" % (want, ", ".join(why) or "no GPU matches")
        ok.sort()  # least room that still fits
        picked = ok[-n:] if pilot else ok[:n]
        chosen = [u for _, _, u in picked]
        gpu_counted = {u: (r if pilot else size["gpu_mem"]) for r, _, u in picked}
    return True, {"gpus": chosen, "ram_counted": ram_counted, "gpu_counted": gpu_counted}


def _lack(settings, room, q):
    """{resource: how much a held job lacks of it in this room}: "ram", "cpu", "gpu:<uuid>", "disk:<name>"."""
    lack = {}
    size = q["size"]
    if q.get("pilot"):
        if _pilot_ram_need(settings, size) >= room["ram"]["room"]:  # its floor, as fits() asks
            lack["ram"] = max(1.0, _pilot_ram_need(settings, size) - room["ram"]["room"])
    elif ram_limit(settings, size["ram"]) > room["ram"]["room"]:
        lack["ram"] = ram_limit(settings, size["ram"]) - room["ram"]["room"]
    cpu = max(size["cpus"] - room["cpu"]["room"], size["cpus"] - room["cpu"]["placed_room"])
    if cpu > 1e-9:
        lack["cpu"] = cpu
    if size.get("gpus"):
        model = (q.get("constraints") or {}).get("gpu_model")
        need = settings["pilot"]["gpu_min_gb"] * GB if q.get("pilot") else size["gpu_mem"]
        for u, g in room["gpus"].items():
            if model and model.lower() not in g["name"].lower():
                continue
            if g["util"] > settings["gpu_busy_max_pct"]:
                lack["gpu:" + u] = 0.0
            elif g["room"] < need:
                lack["gpu:" + u] = need - g["room"]
    if q.get("data_disk"):
        lack["disk:" + q["data_disk"]] = 0.0
    return lack


def fits_empty(settings, capacity, job):
    """Why a job could not fit this host even with nothing else on it, or None."""
    size = job["size"]
    if (size.get("gpu_share") or 0) > settings["gpu_busy_max_pct"]:
        return "needs %g%% of a GPU's time; this host shares out at most %g%% of a card" % (
            size["gpu_share"], settings["gpu_busy_max_pct"])
    ram_max = capacity["mem_total"] - settings["ram_headroom_gb"] * GB
    if job.get("pilot") and _pilot_ram_need(settings, size) > ram_max:
        return "a pilot needs at least %s of RAM room (pilot.ram_floor_gb); this host has at most %s for jobs" % (
            _gbs(_pilot_ram_need(settings, size)), _gbs(ram_max))
    if not job.get("pilot") and ram_limit(settings, size["ram"]) > ram_max:  # a job is counted at its limit
        return "needs %s RAM (its limit, %g times its size); this host has at most %s for jobs" % (
            _gbs(ram_limit(settings, size["ram"])), settings["ram_hard_factor"], _gbs(ram_max))
    if size["cpus"] > min(settings["cpu_busy_threads_max"], settings["placed_cores_max"]):
        return "needs %g CPU threads; this host admits at most %g" % (
            size["cpus"], min(settings["cpu_busy_threads_max"], settings["placed_cores_max"]))
    n = size.get("gpus") or 0
    if n:
        model = (job.get("constraints") or {}).get("gpu_model")
        cards = [c for c in capacity["gpus"] if not model or model.lower() in c["name"].lower()]
        big = [c for c in cards if job.get("pilot") or c["total"] - settings["gpu_headroom_mb"] * MB >= size["gpu_mem"]]
        if len(big) < n:
            return "needs %d GPU(s)%s%s; this host has %d that could hold it" % (
                n, " like %r" % model if model else "",
                "" if job.get("pilot") else " with %s" % _gbs(size["gpu_mem"]), len(big))
    return None


SCHED_GROUP, SCHED_PARALLEL = "sched", 256
HEARTBEAT_MIN_S = 120
IN_FLIGHT = ("Queued", "Running", "Paused", "Locked")
RECORD_FIELDS = ("token", "task", "session", "host", "pueue_id", "grp", "submitted", "released", "started", "ended",
                 "exit", "how", "size", "size_source", "like_from", "pilot", "constraints", "gpus", "peak_cpu",
                 "peak_ram", "memory_peak", "peak_gpu_mem", "peaks_final", "peak_samples", "peak_current",
                 "peak_disk_mb_s", "progress", "projected_end", "ram_counted", "gpu_counted", "memory_max", "resized",
                 "soft_capped")
HOLD_FIELDS = ("id", "name", "card", "size", "start", "ended", "how", "ram")
PROGRESS_KEEP = 200     # progress points kept per job
PROGRESS_FIT = 20       # the projected end comes from the rate over the last this many points
LIKE_MIN_SAMPLES = 3  # a --like source must have been measured at least this many times while it ran


class Admission:
    """One admission host's files: queue, assignments, alerts, records, heartbeat and room snapshot."""

    def __init__(self, settings):
        self.s = settings
        self.dir = settings["state_dir"]
        for d in ("queue", "assign", "alerts", "resize"):
            os.makedirs(os.path.join(self.dir, d), mode=0o700, exist_ok=True)

    def path(self, *parts):
        return os.path.join(self.dir, *parts)

    def lock(self, name):
        """An exclusive lock on state_dir/<name>; release with os.close."""
        fd = os.open(self.path(name), os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd

    def write_json(self, path, obj):
        tmp = "%s.tmp.%d" % (path, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(obj, f)
        os.replace(tmp, path)

    def read_json(self, path):
        try:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError):
            return None

    def queue(self):
        """Every queue file, oldest submit first, with any resize applied."""
        out = []
        for name in os.listdir(self.path("queue")):
            if name.endswith(".json"):
                q = self.read_json(self.path("queue", name))
                if q and q.get("token") == name[:-5]:
                    out.append(self.overlay(q))
        return sorted(out, key=lambda q: (q["submitted"], q["token"]))

    def read_queue(self, token):
        q = self.read_json(self.path("queue", token + ".json"))
        return self.overlay(q) if q and q.get("token") == token else None

    def resize_path(self, token):
        return self.path("resize", token + ".json")

    def overlay(self, q):
        """Apply a `job resize` to a queue entry. A resize is written to its own file under the queue lock, never to
        the queue file, which the loop rewrites from the copy it read at the start of its cycle; the loop applies the
        file again under the lock before it releases, so a resize is never lost or a cycle late for a release."""
        r = self.read_json(self.resize_path(q["token"]))
        if isinstance(r, dict) and isinstance(r.get("size"), dict):
            q["size"] = r["size"]
            soft = [x for x in q.get("resized") or [] if _is_soft(x)]
            own = [x for x in r.get("resized") or [] if not _is_soft(x)]  # a resize file written before 0.9.2 may
            # carry soft limits too; taking them from both files doubled them on every read (TASK-021)
            q["resized"] = sorted(_unique(own + soft),  # the loop's soft limits live in the queue file
                                  key=lambda x: x.get("t") or 0 if isinstance(x, dict) else 0)
            last = q["resized"][-1] if q["resized"] and isinstance(q["resized"][-1], dict) else {}
            if q.get("fair_base") is not None and (last.get("t") or 0) > (q.get("fair_base_at") or 0):
                # what it lacked when first blocked was for its old size: the fairness budget starts again
                q.pop("fair_base", None)
                q.pop("fair_passed", None)
            if q.get("state") == "released" and r.get("memory_max"):
                q["memory_max"], q["ram_counted"] = r["memory_max"], r["ram_counted"]
        return q

    def save(self, q):
        self.write_json(self.path("queue", q["token"] + ".json"), q)

    def assign_path(self, token):
        return self.path("assign", token + ".env")

    def alert(self, q, kind, msg, extra=None):
        """Append an ALERT for the job's waits, once per kind per job."""
        if kind in q.setdefault("alerted", []):
            return
        q["alerted"].append(kind)
        with open(self.path("alerts", q["token"] + ".jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(dict(extra or {}, t=time.time(), kind=kind, message=msg)) + "\n")

    # -- records -----------------------------------------------------------------------------------------------

    def db(self):
        con = sqlite3.connect(self.path("admission.sqlite"), timeout=30)
        try:
            con.execute("CREATE TABLE IF NOT EXISTS jobs (%s, PRIMARY KEY (token))" % ", ".join(RECORD_FIELDS))
            con.execute("CREATE TABLE IF NOT EXISTS holds (id PRIMARY KEY, %s)" % ", ".join(HOLD_FIELDS[1:]))
            tables = (("jobs", RECORD_FIELDS), ("holds", HOLD_FIELDS))

            def missing():
                return [(t, c) for t, cols in tables
                        for c in set(cols) - {r[1] for r in con.execute("PRAGMA table_info(%s)" % t)}]
            if missing():
                # a records file from an older job: add the missing columns under the write lock, read again
                # inside it, so two processes upgrading the file at once do not both add the same column
                con.execute("BEGIN IMMEDIATE")
                for t, c in missing():
                    con.execute("ALTER TABLE %s ADD COLUMN %s" % (t, c))
                con.commit()
            con.execute("CREATE TABLE IF NOT EXISTS samples (t REAL, kind TEXT, key TEXT, value REAL)")
            con.execute("CREATE TABLE IF NOT EXISTS recent (t REAL, sample TEXT)")  # the loop's windows, kept over restarts
            con.execute("CREATE INDEX IF NOT EXISTS samples_t ON samples (t)")
        except BaseException:
            con.close()
            raise
        return con

    def record(self, con, row):
        if isinstance(row.get("resized"), list):
            row = dict(row, resized=_unique(row["resized"]))  # a record grown before 0.9.2 shrinks back (TASK-021)
        cols = [k for k in RECORD_FIELDS if k in row]
        vals = [json.dumps(row[k]) if isinstance(row[k], (dict, list)) else row[k] for k in cols]
        con.execute("INSERT INTO jobs (%s) VALUES (%s) ON CONFLICT(token) DO UPDATE SET %s" % (
            ", ".join(cols), ", ".join("?" * len(cols)), ", ".join("%s=excluded.%s" % (c, c) for c in cols)), vals)

    def find_last(self, con, task, session=None):
        """The run of a task here to size its next run from, measured often enough: the newest that exited 0, or,
        only when none did, the newest pilot that reached its time limit (a pilot stopped early may not have reached
        the job's peak, so a complete run, even an older one, is the better measure). Runs of the same session come
        first; another session's runs of the same task id only when that session has none (a task id is the
        caller's name for its work, and another session may use it for other work)."""
        con.row_factory = sqlite3.Row
        try:
            for same in ((True, False) if session else (False,)):
                for cond in ("how = 'exit' AND exit = 0", "how = 'pilot time limit' AND soft_capped IS NULL"):
                    r = con.execute("SELECT * FROM jobs WHERE task = ? AND ended IS NOT NULL AND %s AND peak_samples "
                                    ">= ?%s ORDER BY ended DESC LIMIT 1" % (cond, " AND session = ?" if same else ""),
                                    (task, LIKE_MIN_SAMPLES) + ((session,) if same else ())).fetchone()
                    if r:
                        return dict(r)
            return None
        finally:
            con.row_factory = None

    def find(self, con, ref):
        """The record a --like names: a token, or HOST#ID for the newest job with that id here."""
        con.row_factory = sqlite3.Row
        if "#" in ref:  # HOST#ID: the client sends it only to HOST
            try:
                tid = int(ref.rsplit("#", 1)[1])
            except ValueError:
                return None
            r = con.execute("SELECT * FROM jobs WHERE pueue_id = ? ORDER BY submitted DESC LIMIT 1", (tid,)).fetchone()
        else:
            r = con.execute("SELECT * FROM jobs WHERE token = ?", (ref,)).fetchone()
        con.row_factory = None
        return dict(r) if r else None


def _size_from(settings, adm, capacity, req):
    """The size a submit asks for: (size, source, pilot, like_from). Raises JobError naming the options."""
    a = req.get("admission") or {}
    explicit = {k: a.get(k) for k in ("cpus", "ram", "gpus", "gpu_mem", "gpu_share") if a.get(k) is not None}
    pilot_with = {}
    if a.get("pilot"):
        extra = sorted(set(explicit) - {"cpus", "gpus"})
        if extra:
            raise JobError("a pilot gets all the free RAM, and all the free memory on its GPUs; it takes --cpus and "
                           "--gpus but not %s" % ", ".join("--" + k.replace("_", "-") for k in extra))
        pilot_with, explicit = explicit, {}
    chosen = [k for k in ("pilot", "like", "small") if a.get(k)] + (["explicit"] if explicit else [])
    if len(chosen) != 1:
        raise JobError("an admission host needs exactly one size: --pilot, --like TOKEN, --small, or "
                       "--cpus/--ram/--gpus/--gpu-mem/--gpu-share" + ("" if not chosen else
                                                                     " (got %s)" % ", ".join(chosen)))
    small = settings["small"]
    size = {"cpus": float(small["cpus"]), "ram": int(small["ram_gb"] * GB), "gpus": 0, "gpu_mem": 0,
            "gpu_share": 0.0, "disk_mb_s": 0.0}
    if "cpus" in explicit:
        size["cpus"] = float(_num(explicit["cpus"], "--cpus", lo=0.01))
    if "gpu_share" in explicit:
        size["gpu_share"] = float(_num(explicit["gpu_share"], "--gpu-share", lo=0.0, hi=100.0))
    if "ram" in explicit:
        size["ram"] = int(_num(explicit["ram"], "--ram", lo=SCOPE_MIN_MEMORY, whole=True))
    for k in ("gpus", "gpu_mem"):
        if k in explicit:
            size[k] = int(_num(explicit[k], "--" + k.replace("_", "-"), lo=0, whole=True))
    if explicit and "ram" not in explicit:
        raise JobError("an explicit size needs --ram (the job's RAM; its hard limit is that times the host's "
                       "ram_hard_factor); or use --pilot to measure the job, or --small")
    if "gpu_mem" in explicit and not size["gpus"]:
        size["gpus"] = 1
    if size["gpus"] and not size["gpu_mem"] and not a.get("pilot"):
        raise JobError("--gpus needs --gpu-mem (memory per GPU), or use --pilot to measure it")
    if a.get("pilot"):
        if "gpus" in pilot_with:
            size["gpus"] = int(_num(pilot_with["gpus"], "--gpus", lo=0, whole=True))
        if "cpus" in pilot_with:
            size["cpus"] = float(_num(pilot_with["cpus"], "--cpus", lo=0.01))
        return size, "pilot", True, None
    if a.get("small"):
        return size, "small", False, None
    if a.get("like"):
        last = str(a["like"]) == "last"
        con = adm.db()
        try:
            r = (adm.find_last(con, req.get("task"), req.get("session") or "unknown") if last
                 else adm.find(con, str(a["like"])))
        finally:
            con.close()
        if r is None and last:
            raise JobError("--like last: no run of %s on %s exited 0 or was a pilot that reached its time limit, "
                           "measured at least %d times; run a --pilot first" % (req.get("task"), socket.gethostname(),
                                                                                LIKE_MIN_SAMPLES))
        if r is None:
            raise JobError("--like %s: no record of that job on %s" % (a["like"], socket.gethostname()))
        if not ((r["how"] == "exit" and r["exit"] == 0) or r["how"] == "pilot time limit"):
            raise JobError("--like %s: that run ended by %s (exit %s), so its peaks are only a lower bound; "
                           "size it from a run that exited 0 or a pilot that reached its time limit"
                           % (a["like"], r["how"] or "?", r["exit"]))
        if r["how"] == "pilot time limit" and r.get("soft_capped"):
            raise JobError("--like %s: that pilot was held at the soft limit the loop gave it while it waited for room, "
                           "so its peak may be under what the job needs; run it again as a --pilot, or give --ram"
                           % a["like"])
        if (r.get("peak_samples") or 0) < LIKE_MIN_SAMPLES:
            raise JobError("--like %s: that run was measured %d times while it ran, too few to size from; size it "
                           "from a longer run or a pilot, or give --cpus/--ram" % (a["like"], r.get("peak_samples") or 0))
        m = settings["margins"]
        ram_max = capacity["mem_total"] - settings["ram_headroom_gb"] * GB
        gpu_max = max([c["total"] for c in capacity["gpus"]] or [0]) - settings["gpu_headroom_mb"] * MB
        peak_ram, peak_gpu = r["peak_ram"] or 0, r["peak_gpu_mem"] or 0
        size["cpus"] = max(0.1, round((r["peak_cpu"] or 0) * m["cpu"], 1))
        # the margin is cut so the job's limit (its size times ram_hard_factor, what it is counted at) fits the
        # host; the limit still covers the peak, since the peak fits
        size["ram"] = int(min(peak_ram * m["ram"], ram_max / settings["ram_hard_factor"]) if peak_ram <= ram_max
                          else peak_ram * m["ram"])
        size["gpus"] = len(json.loads(r["gpus"] or "[]"))
        size["gpu_mem"] = int(min(peak_gpu * m["gpu_mem"], gpu_max) if peak_gpu <= gpu_max else peak_gpu * m["gpu_mem"])
        size["disk_mb_s"] = float(r.get("peak_disk_mb_s") or 0.0)
        return size, "like", False, r["token"]
    return size, "explicit", False, None


def _like_source_text(adm, token):
    """Which run a --like last size came from, with its session and peaks; "?" when its record can't be read (it is
    only text for a reply, sent after the job is queued, so it never fails)."""
    try:
        con = adm.db()
        try:
            r = adm.find(con, token)
        finally:
            con.close()
        if not r:
            return "?"
        return _like_source_line(r)
    except Exception:  # noqa: BLE001 -- the job is already queued; nothing here may report a failure
        return "?"


def _like_source_line(r):
    return "#%s of session %s (%s, ended %s), peaks %.1f CPU, %s RAM%s from %d samples" % (
        r.get("pueue_id"), r.get("session") or "?",
        "pilot stopped at its time limit" if r.get("how") == "pilot time limit" else "exit 0",
        dt.datetime.fromtimestamp(r["ended"]).astimezone().strftime("%Y-%m-%d %H:%M %Z") if r.get("ended") else "?",
        r.get("peak_cpu") or 0, _gbs(r.get("peak_ram") or 0),
        ", GPU %s" % _gbs(r["peak_gpu_mem"]) if r.get("peak_gpu_mem") else "", r.get("peak_samples") or 0)


def _read_progress(token):
    """The last valid `done total` line of a job's progress file, or None."""
    try:
        with open(os.path.join(STATE_DIR, "results", token + ".progress"), "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 4096))
            tail = f.read().decode("utf-8", "replace")
    except OSError:
        return None
    for line in reversed(tail.splitlines()):
        parts = line.split()
        if len(parts) != 2:
            continue
        try:
            done, total = float(parts[0]), float(parts[1])
        except ValueError:
            continue
        if total > 0 and 0 <= done <= total:
            return done, total
    return None


def _slope(xs, ys):
    """Least-squares slope of ys on xs, or None when xs do not vary."""
    n = len(xs)
    mx, my = sum(xs) / n, sum(ys) / n
    sxx = sum((x - mx) ** 2 for x in xs)
    return None if sxx <= 0 else sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / sxx


def _projected_end(points):
    """When a job will reach its total at its recent rate: points are [t, done, total, ram]."""
    recent = points[-PROGRESS_FIT:]
    if len(recent) < 2:
        return None
    rate = _slope([p[0] for p in recent], [p[1] for p in recent])
    if not rate or rate <= 0:
        return None
    t, done, total = recent[-1][0], recent[-1][1], recent[-1][2]
    return t + (total - done) / rate


def _ram_at_total(points):
    """The RAM a job will have at its total if RAM keeps growing with done as it has, or None."""
    pts = [p for p in points if p[3]]
    if len(pts) < 3 or pts[-1][1] - pts[0][1] < 0.05 * pts[-1][2]:
        return None
    b = _slope([p[1] for p in pts], [p[3] for p in pts])
    if not b or b <= 0:
        return None
    return pts[-1][3] + b * (pts[-1][2] - pts[-1][1])


def _capacity(measure):
    mem = measure.meminfo()
    try:
        cards = measure.gpus()
    except (OSError, ValueError):
        cards = []
    return {"mem_total": mem.get("MemTotal", 0), "threads": measure.threads(),
            "gpus": [{"uuid": c["uuid"], "index": c["index"], "name": c["name"], "total": c["total"]} for c in cards]}


def _measure_from_env():
    return Measure(proc=os.environ.get("JOB_TEST_PROC", "/proc"), sys_root=os.environ.get("JOB_TEST_SYS", "/sys"),
                   cgroup_root=os.environ.get("JOB_TEST_CGROUP", "/sys/fs/cgroup"))


def _is_soft(x):
    """A resize entry the loop wrote for a soft limit; these live in the queue file only, never in the resize file."""
    return isinstance(x, dict) and "soft_limit" in x


def _no_soft(resized):
    return [x for x in resized or [] if not _is_soft(x)]


def _unique(entries):
    """The entries without repeats, first occurrence kept (a record grown by TASK-021 shrinks back on its next save)."""
    seen, out = set(), []
    for x in entries:
        k = json.dumps(x, sort_keys=True)
        if k not in seen:
            seen.add(k)
            out.append(x)
    return out


def _heartbeat_age(adm):
    hb = adm.read_json(adm.path("heartbeat"))
    return None if not hb else time.time() - hb.get("t", 0)


def _heartbeat_limit(settings):
    return max(3 * settings["sample_interval_s"], HEARTBEAT_MIN_S)


def _simulate_fit(settings, adm, job, room_out=None):
    """For fit_now: would the loop release this job in its next cycle, counting the held jobs ahead of it? room_out,
    a dict, gets the room left for the job."""
    snap = adm.read_json(adm.path("room.json"))
    age = _heartbeat_age(adm)
    if not snap or age is None or age > _heartbeat_limit(settings):
        return False, "the admission loop is not running here"
    if not snap.get("room"):
        return False, "the admission loop is still measuring this host"
    room = snap["room"]
    for q in adm.queue():
        if q.get("state") == "held":
            ok, got = fits(settings, room, q, q.get("data_disk"))
            if ok:
                _take(room, q, got)
    if room_out is not None:
        room_out.update(room)
    return fits(settings, room, job, job.get("data_disk"))


RAM_SIZE_HINT = ("a size below what the job needs ends in exit 137, so size it from a measured run (--pilot, then "
                 "--like)")


def _ram_hint(q, lack):
    """The exit-137 hint for a job held short of RAM, or None: only for a size that was not measured (not --like),
    and not for a pilot, which is measuring the job."""
    if q.get("pilot") or q.get("size_source") == "like" or not (lack or {}).get("ram"):
        return None
    return RAM_SIZE_HINT


def _job_resources(q, got):
    """The resources a job that fits is counted on: "ram", "cpu", "gpu:<uuid>", "disk:<name>"."""
    r = {"ram", "cpu"} if q["size"]["ram"] or q["size"]["cpus"] else set()
    r |= {"gpu:" + u for u in got["gpus"]}
    if q.get("data_disk"):
        r.add("disk:" + q["data_disk"])
    return r


def _job_need(q, got):
    """What a job that fits takes of each resource it is counted on."""
    need = {"ram": got["ram_counted"], "cpu": q["size"]["cpus"]}
    need.update({"gpu:" + u: b for u, b in got["gpu_counted"].items()})
    return need


def _fair_pass(settings, fair, q, got):
    """Whether the fairness rule lets a job that fits start past the oldest held job, fair = {lack, taken} (what that
    job lacks and what younger jobs let past it take): it may if it takes nothing it lacks, or together with those
    jobs under fairness_small_fraction of each such resource. Returns (passes, the resources it takes from it)."""
    hit = set(fair["lack"]) & _job_resources(q, got)
    need = _job_need(q, got)
    small = settings["fairness_small_fraction"]
    ok = not hit or all((fair["taken"].get(r, 0) + need.get(r, math.inf)) < small * fair["lack"][r] for r in hit)
    return ok, {r: need.get(r, 0) for r in hit}


def _submit_reason(settings, adm, job, st=None):
    """Why a job just submitted is held, and the exit-137 hint or None, from pueue's groups and the loop's last
    snapshot, by the checks the loop makes in this order: its group, the room, the fairness rule (the loop gives its
    own reason when it next looks at the job)."""
    snap = adm.read_json(adm.path("room.json"))
    age = _heartbeat_age(adm)
    if age is None or age > _heartbeat_limit(settings):  # with no snapshot either: no loop has ever run here
        return "the admission loop on this host is not running, so the job stays held until it runs again", None
    if not snap:
        return "the admission loop is measuring this host; it looks at the job in its next cycle", None
    if st is not None:
        g = (st.get("groups") or {}).get(job.get("group")) or {}
        if g.get("status") == "Paused":
            return "its group %s is paused; start it with: %s" % (job["group"], _resume_command(job["group"])), None
        busy = len([t for t in (st.get("tasks") or {}).values()
                    if t.get("group") == job.get("group") and _task_status(t) in ("Running", "Queued")])
        if g and busy >= (g.get("parallel_tasks") or 1):
            return "its group %s is full (%d running or queued of %d); it starts when one of them ends" % (
                job["group"], busy, g.get("parallel_tasks") or 1), None
    if not snap.get("room"):
        w = snap.get("warmup") or {}
        return "the loop is measuring this host first (%s of %s)" % (_fmt_dur(w.get("covered_s")),
                                                                      _fmt_dur(w.get("needed_s"))), None
    room = {}
    ok, got = _simulate_fit(settings, adm, job, room)
    if not ok:
        return got, _ram_hint(job, _lack(settings, room, job) if room else None)
    fair = snap.get("fairness")
    if isinstance(fair, dict) and isinstance(fair.get("lack"), dict) and isinstance(fair.get("taken"), dict):
        passes, _ = _fair_pass(settings, fair, job, got)
        if not passes:
            return "waiting behind an older job, %s (token %s), that needs: %s" % (
                _shown_task(fair.get("task")), fair.get("token"), fair.get("reason")), None
    return "it fits the room now; the admission loop starts it in its next cycle", None


def start_estimate(lack, running, gpus_needed=0, gpus_fitting=0):
    """When enough room should free for a held job that lacks {resource: amount}, as running jobs end at their
    projected ends. running: [(projected end or None, {resource: what it frees}, task)]. Returns (time, task) or
    (None, why none is known). A job needing n GPUs needs only n - gpus_fitting of the cards it is short on."""
    def when(r, amt):
        freed = 0.0
        for end, frees, task in sorted((x for x in running if x[1].get(r)), key=lambda x: (x[0] is None, x[0] or 0)):
            if end is None:
                return None, ("none known: a running job that holds that room has no projected end (a job gets one "
                              "by appending 'done total' lines to $JOB_PROGRESS)")
            freed += frees[r]
            if freed >= amt:
                return (end, task), None
        return None, "none known: the room it lacks is not held by running jobs (outside use or holds)"
    times, gpu_times, busy_gpus = [], [], 0
    for r, amt in lack.items():
        if r.startswith("disk:"):
            return None, "none known: it waits on a busy disk, not on room a running job holds"
        if r.startswith("gpu:"):
            if amt <= 0:  # a busy card: no amount of room frees it, but another card may do
                busy_gpus += 1
                continue
            got, why = when(r, amt)
            if got:
                gpu_times.append(got)
            continue
        if amt <= 0:
            continue
        got, why = when(r, amt)
        if got is None:
            return None, why
        times.append(got)
    gpu_keys = [r for r in lack if r.startswith("gpu:")]
    if gpu_keys:
        k = max(1, gpus_needed - gpus_fitting)
        if len(gpu_times) < k:
            return None, ("none known: no running job with a projected end frees enough GPU memory%s" % (
                "; %d of the GPUs it could use %s busy" % (busy_gpus, "is" if busy_gpus == 1 else "are")
                if busy_gpus else ""))
        times.append(sorted(gpu_times)[k - 1])
    if not times:
        return None, "none known"
    return max(times), None


def _take(room, job, got):
    """Count a released job against a room (within one cycle, before the next measurement)."""
    room["ram"]["room"] -= got["ram_counted"]
    room["cpu"]["room"] -= job["size"]["cpus"]
    room["cpu"]["placed_room"] -= job["size"]["cpus"]
    for gid in got["gpus"]:
        g = room["gpus"][gid]
        g["room"] -= got["gpu_counted"][gid]
        g["jobs"] = g.get("jobs", 0) + got["gpu_counted"][gid]
        g["shares"] += job["size"].get("gpu_share") or 0


def _stop_at(v):
    """--stop-at as epoch seconds; a time without its UTC offset is refused."""
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return float(v)
    t = _parse_time(v) if isinstance(v, str) else None
    if t is None or t.tzinfo is None:
        raise JobError("--stop-at needs a time with its UTC offset, like 2026-11-10T08:00-05:00")
    return t.timestamp()


def host_submit_admitted(req, settings, command):
    """host_submit on an admission host: size the job, queue it held, and let the loop release it."""
    if req.get("protocol") != PROTOCOL_ADMISSION or not isinstance(req.get("admission"), dict):
        raise JobError("protocol mismatch: %s admits jobs by size (job %s); update job on the submitting machine "
                       "and give a size (--pilot, --like, --small or --cpus/--ram/--gpus/--gpu-mem)"
                       % (socket.gethostname(), VERSION))
    if req.get("scope") is not None:
        raise JobError("an admission host sets the scope itself; do not send one")
    bad = sorted(k for k in (req.get("env") or {}) if k in GPU_VARS)
    if bad:
        raise JobError("%s is set by admission; ask for GPUs with --gpus" % ", ".join(bad))
    adm = Admission(settings)
    measure = _measure_from_env()
    capacity = _capacity(measure)
    size, source, pilot, like_from = _size_from(settings, adm, capacity, req)
    a = req["admission"]
    constraints = {k: a[k] for k in ("gpu_model", "data", "in_containers", "restartable") if a.get(k)}
    missing = [x for x in (a.get("needs_path") or []) if not (isinstance(x, str) and os.path.exists(x))]
    if missing:
        raise JobError("%s does not have %s" % (socket.gethostname(), ", ".join(map(str, missing))))
    if a.get("stop_at") is not None:
        constraints["stop_at"] = _stop_at(a["stop_at"])
    if a.get("max_minutes") is not None:
        if not pilot:
            raise JobError("--max-minutes is a pilot's time limit; use --stop-at to stop another job at a time")
        constraints["max_minutes"] = float(_num(a["max_minutes"], "--max-minutes", lo=1))
        if constraints["max_minutes"] > settings["pilot"]["max_minutes_ceiling"]:
            raise JobError("--max-minutes %g is over this host's ceiling for a pilot, %g minutes "
                           "(pilot.max_minutes_ceiling): a pilot only measures the job; run the job itself with "
                           "--like after the pilot" % (constraints["max_minutes"],
                                                       settings["pilot"]["max_minutes_ceiling"]))
    job = {"size": size, "pilot": pilot, "constraints": constraints}
    why = fits_empty(settings, capacity, job)
    if why:
        raise JobError("cannot run on %s even when it is empty: %s" % (socket.gethostname(), why))
    if settings["preemptible"] and not constraints.get("restartable"):
        raise JobError("%s may be reclaimed; only --restartable jobs run here" % socket.gethostname())
    fd = adm.lock("queue.lock")
    try:
        st = _pueue_status()
        token = req.get("token") or uuid.uuid4().hex
        if not all(c in "0123456789abcdef" for c in token) or len(token) != 32:
            raise JobError("bad token")
        for _, t in st.get("tasks", {}).items():
            if (t.get("envs") or {}).get("JOB_TOKEN") == token:  # a retried submit whose first attempt got through
                if _task_status(t) == "Stashed" and not os.path.exists(adm.path("queue", token + ".json")):
                    _pueue(["remove", str(int(t["id"]))])  # the first attempt failed after pueue add: start over
                    break
                return {"id": int(t["id"]), "token": token, "host": socket.gethostname(), "existing": True}
        group = req.get("group") or SCHED_GROUP
        groups = st.get("groups", {})
        if group == SCHED_GROUP and group not in groups:
            _pueue(["group", "add", SCHED_GROUP])
            _pueue(["parallel", str(SCHED_PARALLEL), "--group", SCHED_GROUP])
        elif group not in groups:
            raise JobError("pueue group %r does not exist on %s; create it with 'job group <host> %s <n>'"
                           % (group, socket.gethostname(), group))
        data_disk = measure.disk_of(constraints["data"]) if constraints.get("data") else None
        q = {"token": token, "task": req["task"], "session": req.get("session") or "unknown",
             "from": req.get("from") or "?", "submitted": time.time(), "group": group, "size": size,
             "size_source": source, "like_from": like_from, "pilot": pilot, "constraints": constraints,
             "data_disk": data_disk, "state": "held"}
        if a.get("fit_now"):
            ok, got = _simulate_fit(settings, adm, q)
            if not ok:
                raise JobError("no room on %s now: %s" % (socket.gethostname(), got))
        q["reason"], q["hint"] = _submit_reason(settings, adm, q, st)  # the first held line says why, before the
        # loop looks
        # The record and queue file come first: once pueue has the task, nothing may report the submit as failed
        # (the job would run anyway, and a resubmit would run it twice).
        qpath = adm.path("queue", token + ".json")
        adm.save(q)
        try:
            con = adm.db()
            try:
                adm.record(con, {"token": token, "task": q["task"], "session": q["session"],
                                 "host": socket.gethostname(), "grp": group, "submitted": q["submitted"],
                                 "size": size, "size_source": source, "like_from": like_from, "pilot": int(pilot),
                                 "constraints": constraints, "peaks_final": 0})
                con.commit()
            finally:
                con.close()
            reply = host_submit(dict(req, token=token, group=group, stashed=True,
                                     admitted={"assign": adm.assign_path(token),
                                               "oom_score_adj": settings["oom_score_adj"],
                                               "gpu_env": settings["gpu_env"]}), _admission_checked=True)
        except BaseException:
            os.remove(qpath)
            try:
                con = adm.db()
                con.execute("DELETE FROM jobs WHERE token = ?", (token,))
                con.commit()
                con.close()
            except sqlite3.Error:
                pass
            try:  # pueue may have added the task before the failure: a held task without a queue file never runs
                for _, t in _pueue_status().get("tasks", {}).items():
                    if (t.get("envs") or {}).get("JOB_TOKEN") == token and _task_status(t) == "Stashed":
                        _pueue(["remove", str(int(t["id"]))])
            except JobError:
                pass  # a retry with this token removes it
            raise
        q["pueue_id"] = reply["id"]
        try:
            adm.save(q)
            con = adm.db()
            try:
                con.execute("UPDATE jobs SET pueue_id = ? WHERE token = ?", (reply["id"], token))
                con.commit()
            finally:
                con.close()
        except (OSError, sqlite3.Error):
            pass  # the job is queued; the loop records its id when it releases it
        reply["held"] = True
        reply["held_reason"] = q["reason"]
        reply["held_hint"] = q.get("hint")
        if source == "like":
            try:  # text only: the job is queued, so nothing from here on may report the submit as failed
                reply["sized"] = "sized like %s: %g CPU threads, %s RAM%s" % (
                    like_from, size["cpus"], _gbs(size["ram"]),
                    ", %d GPU(s) with %s each" % (size["gpus"], _gbs(size["gpu_mem"])) if size["gpus"] else "")
                if str(a.get("like")) == "last":
                    src = _like_source_text(adm, like_from)
                    if "pilot stopped at its time limit" in src:
                        reply["sized"] += ("; no run of %s here exited 0, so it is sized from the newest pilot that "
                                           "reached its time limit, %s" % (q["task"], src))
                    else:
                        reply["sized"] += "; that is the newest run of %s here that exited 0, %s" % (q["task"], src)
            except Exception as e:  # noqa: BLE001
                reply["sized"] = "sized like %s (its details could not be read: %s)" % (like_from, e)
        return reply
    finally:
        os.close(fd)


PEAK_SEEN_FRACTION = 1.02  # memory.peak within this factor of the highest sampled memory.current was seen by sampling
PEAK_AT_LIMIT_FRACTION = 0.9  # memory.peak at or over this share of the job's memory.max: it reached its limit


def _cache_off_peak(kernel_peak, sampled_current, limit):
    """Whether the file cache may be taken off a job's memory.peak for its resize floor: the peak is under
    PEAK_AT_LIMIT_FRACTION of its memory.max (limit; a peak at its limit says only that it filled it, and what with
    is unknown), and it was seen by sampling (within PEAK_SEEN_FRACTION of the highest memory.current the loop
    sampled). False when its limit is not known."""
    return bool(kernel_peak and limit and kernel_peak < PEAK_AT_LIMIT_FRACTION * limit
                and kernel_peak <= PEAK_SEEN_FRACTION * (sampled_current or 0))


def _resize_floor(settings, peak, use, kernel_peak=0, cache=0, sampled_current=0, limit=None):
    """The lowest RAM limit a running job may be given: what it can't give back if its limit is lowered, the largest
    of its sampled RAM peak times resize_margin (the loop samples once a cycle, so that is a lower bound), its use
    now less the file cache a lower limit drops (use: memory.current less _droppable_cache), and the kernel's own
    peak of its cgroup (memory.peak, which catches spikes between samples).

    memory.peak counts file cache too. The cache is taken off it only when _cache_off_peak: the peak is under 0.9 of
    the job's memory.max (limit) and was seen by sampling (within PEAK_SEEN_FRACTION of the highest memory.current
    the loop sampled, sampled_current; never a reading taken at resize time), so the sampled peak (the first term)
    measured what was not cache at that peak. Otherwise the whole memory.peak is the floor: a peak between samples
    is of unknown make-up (an anonymous spike, with the cache squeezed out then and refilled since, looks the same),
    and a job that sits at its limit cannot be shrunk. A limit under a real spike ends the job; one too high only
    keeps room idle."""
    kernel_peak = kernel_peak or 0
    if _cache_off_peak(kernel_peak, sampled_current, limit):
        kernel_peak = max(0, kernel_peak - (cache or 0))
    return max(use, peak * settings["resize_margin"], kernel_peak)


def _resize_suggestion(settings, peak, use, kernel_peak=0, cache=0, projected=0, sampled_current=0, limit=None):
    """The size to suggest for an oversized job, in bytes: what --like would give from its peak (peak times
    margins.ram; the RAM its progress trend projects at its end, if higher, stands in for the peak), at least the
    smallest size whose limit covers the resize floor, rounded up to 0.1 GB, and raised further if the size as
    written (--ram 4.1G) would parse to a limit a byte under the floor."""
    floor = _resize_floor(settings, peak, use, kernel_peak, cache, sampled_current, limit)
    want = max(max(peak, projected or 0) * settings["margins"]["ram"], floor / settings["ram_hard_factor"],
               SCOPE_MIN_MEMORY)
    n = int(math.ceil(want / 1e8 - 1e-9)) * 10 ** 8
    while ram_limit(settings, _parse_size(_size_arg(n))) < floor:
        n += 10 ** 8
    return n


def _shrink_blocked(full60, refault_grew):
    """Why a job must not be shrunk (nor told it is oversized) now, or None: it is short of memory in its own cgroup
    (its memory.pressure full avg60 over SHRINK_STALL_PCT), or file pages it dropped are being read back
    (workingset_refault_file grew since the loop's last sample), so the file cache it holds is working set. Either
    one None (could not be read) blocks it too: a shrink is refused when its safety can't be checked."""
    if full60 is None:
        return "its own memory pressure (memory.pressure of its cgroup) could not be read, so a shrink can't be checked"
    if refault_grew is None:
        return ("its file refault count (memory.stat workingset_refault_file) could not be read or compared, so a "
                "shrink can't be checked")
    if full60 > SHRINK_STALL_PCT:
        return ("it spent %.1f%% of the last minute stalled reclaiming memory in its own cgroup (memory.pressure full "
                "avg60, over %g%%): it is short of memory now, and a lower limit would make that worse" % (
                    full60, SHRINK_STALL_PCT))
    if refault_grew:
        return ("file pages it dropped are being read back in (workingset_refault_file grew since the loop's last "
                "sample): the file cache it holds is part of what it works on, and a lower limit would make it read "
                "them again and again")
    return None


def _size_arg(n):
    """Bytes as a --ram argument (decimal GB, 0.1 GB steps; whole bytes below that)."""
    return ("%.1fG" % (n / 1e9)) if n % 10 ** 8 == 0 else str(int(n))


def _read_cg_int(job_cg, name):
    """An integer cgroup file of a job cgroup (memory.max, memory.peak), or None ("max", missing or unreadable)."""
    try:
        with open(os.path.join(job_cg, name)) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def _set_memory_max(job_cg, limit):
    """Set a job cgroup's memory.max and check that it took effect (the kernel keeps whole pages)."""
    try:
        with open(os.path.join(job_cg, "memory.max"), "w") as f:
            f.write(str(int(limit)))
        with open(os.path.join(job_cg, "memory.max")) as f:
            got = f.read().strip()
    except OSError as e:
        raise JobError("could not set its RAM limit: %s" % e)
    if got == "max" or abs(int(got) - int(limit)) >= 65536:
        raise JobError("its RAM limit did not take effect (memory.max reads %s)" % got)


def _set_assigned_limit(adm, token, limit):
    """Write a job's RAM limit into its assignment file, which a restart of the job reads."""
    assign = adm.assign_path(token)
    try:
        with open(assign) as f:
            lines = [ln.rstrip("\n") for ln in f if not ln.startswith("JOB_MEMORY_MAX=")]
        with open(assign + ".tmp", "w") as f:
            f.write("\n".join(["JOB_MEMORY_MAX=%d" % limit] + lines) + "\n")
        os.replace(assign + ".tmp", assign)
    except OSError:
        pass


def _resize_target(adm, tid, req):
    """(pueue task, token, queue entry) of the admitted job a resize names, held or running; JobError otherwise."""
    host = socket.gethostname()
    t = _pueue_status().get("tasks", {}).get(str(tid))
    if t is None:
        raise JobError("no task %d on %s" % (tid, host))
    token = _env_token(t)
    if req.get("token") and token != req["token"]:
        raise JobError("task %d now belongs to a different job; not resized" % tid)
    q = adm.read_queue(token) if token else None
    if q is None or q.get("state") not in ("held", "released"):
        raise JobError("task %d is not an admitted job held or running on %s" % (tid, host))
    if q.get("pilot"):
        raise JobError("task %d is a pilot, which is measuring the job, so it is not resized; when it ends, size "
                       "the next run with --like %s" % (tid, token))
    return t, token, q


def _ended_record(con, token):
    r = con.execute("SELECT ended FROM jobs WHERE token = ?", (token,)).fetchone()
    return bool(r and r[0] is not None)


def host_resize(req):
    """`job resize`: change a held job's size (it keeps its place), or shrink a running one (docs/admission.md).
    A refusal or a reported failure means nothing changed."""
    settings = _admission_settings()
    if settings is None:
        raise JobError("%s is not an admission host; only an admitted job can be resized" % socket.gethostname())
    ram, cpus = req.get("ram"), req.get("cpus")
    if ram is None and cpus is None:
        raise JobError("job resize needs --ram SIZE, --cpus N or both")
    if ram is not None:
        ram = int(_num(ram, "--ram", lo=SCOPE_MIN_MEMORY, whole=True))
    if cpus is not None:
        cpus = float(_num(cpus, "--cpus", lo=0.01))
    tid, host = int(req["id"]), socket.gethostname()
    adm = Admission(settings)
    # What is slow is done before the queue lock, which submits and the loop wait on: for a held job, the host's
    # capacity (its could-it-ever-fit check; a GPU query can take up to two 30 s timeouts), read only then; for a
    # running one, lowering its cgroup's memory.max, which can force a long reclaim. Its count is lowered only under
    # the lock, after the limit, and the job is checked again there to be the same job in the same state.
    t, token, q = _resize_target(adm, tid, req)
    old = dict(q["size"])
    new = dict(old, **{k: v for k, v in (("ram", ram), ("cpus", cpus)) if v is not None})
    capacity = change = undo = None
    if q["state"] == "held":
        capacity = _capacity(_measure_from_env())
    elif _task_status(t) in IN_FLIGHT:
        con = adm.db()
        try:
            if _ended_record(con, token):
                raise JobError("task %d has ended; nothing to resize" % tid)
            change, undo = _resize_running(settings, con, q, old, new)
        finally:
            con.close()
    elif _task_status(t) == "Stashed":  # released this cycle and not yet enqueued, or about to be held again
        raise JobError("task %d is being released by the admission loop now; try again after its next cycle "
                       "(about %d s)" % (tid, settings["sample_interval_s"]))
    else:
        raise JobError("task %d has ended; nothing to resize" % tid)
    done = False
    try:
        fd = adm.lock("queue.lock")  # the loop ends a job under this lock too, so a resize never outlives its job
        try:
            t2, token2, q2 = _resize_target(adm, tid, req)
            same = (token2 == token and q2.get("state") == q["state"] and q2.get("size") == q["size"]
                    and q2.get("memory_max") == q.get("memory_max")
                    and (q["state"] == "held" or _task_status(t2) in IN_FLIGHT))
            if not same:
                raise JobError("task %d changed while it was being resized (released, ended or resized by another "
                               "call); nothing changed, try again" % tid)
            con = adm.db()
            try:
                if _ended_record(con, token):
                    raise JobError("task %d has ended; nothing to resize" % tid)
                used = None
                if q["state"] == "held":
                    change, used = _resize_held(settings, con, q, new, capacity)
                resized = (q.get("resized") or []) + [{"t": time.time(), "state": q["state"], "from": {
                    "cpus": old["cpus"], "ram": old["ram"]}, "to": {"cpus": new["cpus"], "ram": new["ram"]}}]
                before = dict({k: q.get(k) for k in change if k in RECORD_FIELDS}, token=token, size=old,
                              resized=q.get("resized") or None)
                # The RAM limit was lowered first (above); then the record, then the resize file, which is what the
                # loop counts by. A step that fails undoes the ones before it, so a reported failure leaves nothing
                # changed. Between the steps the job is counted at no less than its real limit: the loop counts a
                # running job at the larger of its recorded limit and its cgroup's memory.max.
                try:
                    adm.record(con, dict({k: v for k, v in change.items() if k in RECORD_FIELDS}, token=token,
                                         size=new, resized=resized))
                    con.commit()
                    try:
                        adm.write_json(adm.resize_path(token), dict(change, size=new, resized=_no_soft(resized)))
                    except OSError:
                        adm.record(con, before)
                        con.commit()
                        raise
                except (OSError, sqlite3.Error) as e:
                    try:
                        con.rollback()
                    except sqlite3.Error:
                        pass
                    raise JobError("task %d was not resized: %s" % (tid, e))
                done = True
            finally:
                con.close()
            if change.get("memory_max"):
                _set_assigned_limit(adm, token, change["memory_max"])  # a restart of the job runs under the new limit
            try:
                os.utime(adm.path("queue"))  # the loop wakes on a change here, so a held job is looked at again now
            except OSError:
                pass
            return dict(change, id=tid, token=token, state=q["state"], was=old, size=new, host=host,
                        checked_against=used)
        finally:
            os.close(fd)
    finally:
        if undo and not done:
            undo()


def _resize_held(settings, con, q, new, capacity):
    """A held job may take any size it could run at, but never less RAM than an earlier run of its task peaked at:
    the highest peak of the same session's earlier runs of the task, or of any session's when that session has none
    (a task id is the caller's name for its work and may be reused by another session for other work). Returns
    (change, the run whose peak it was checked against, or None)."""
    r = None
    for same in (True, False):
        r = con.execute("SELECT token, pueue_id, peak_ram, ended, session FROM jobs WHERE task = ? AND token != ? AND "
                        "ended IS NOT NULL AND peak_ram > 0%s ORDER BY peak_ram DESC LIMIT 1" % (
                            " AND session = ?" if same else ""),
                        (q["task"], q["token"]) + ((q.get("session"),) if same else ())).fetchone()
        if r:
            break
    if r and new["ram"] < r[2]:
        raise JobError("--ram %s is below the RAM peak of %s of an earlier run of %s here (#%s, token %s, session %s, "
                       "ended %s); a job sized below what it needs ends in exit 137" % (
                           _gbs(new["ram"]), _gbs(r[2]), _shown_task(q["task"]), r[1], r[0], r[4] or "?",
                           dt.datetime.fromtimestamp(r[3]).astimezone().strftime("%Y-%m-%d %H:%M %Z")))
    why = fits_empty(settings, capacity, {"size": new, "pilot": False, "constraints": q.get("constraints")})
    if why:
        raise JobError("cannot run on %s even when it is empty: %s" % (socket.gethostname(), why))
    return {}, ({"id": r[1], "token": r[0], "session": r[4], "peak_ram": r[2]} if r else None)


def _resize_running(settings, con, q, old, new):
    """A running job may only shrink. Its RAM limit is never raised: a CPU-only resize keeps the limit it runs under,
    and a RAM shrink gives it a lower limit that still covers its measured peaks and its use now, written to its
    cgroup's memory.max at once (it is counted at that from the loop's next cycle). Its CPU threads may not go under
    its measured CPU peak. Returns (change, undo), undo putting the old RAM limit back."""
    if new["ram"] > old["ram"] or new["cpus"] > old["cpus"]:
        raise JobError("a running job can only shrink (it has %g CPU threads and %s RAM); to grow it, kill it and "
                       "submit it again with the larger size" % (old["cpus"], _gbs(old["ram"])))
    r = con.execute("SELECT peak_ram, peak_samples, peak_cpu, peak_current FROM jobs WHERE token = ?",
                    (q["token"],)).fetchone() or (0, 0, 0, 0)
    if (r[1] or 0) < LIKE_MIN_SAMPLES:
        raise JobError("it has been measured %d times so far, too few to know its peak; resize it after the loop has "
                       "measured it %d times" % (r[1] or 0, LIKE_MIN_SAMPLES))
    m = _measure_from_env()
    path = m.scopes().get(q["token"])
    if not path:
        raise JobError("its scope (%s%s.scope) is not among this user's job scopes on %s: it has not started yet, or "
                       "it runs as another user; not resized" % (SCOPE_PREFIX, q["token"], socket.gethostname()))
    job_cg = os.path.join(path, "job")
    have = _read_cg_int(job_cg, "memory.max")
    known = [x for x in (q.get("memory_max"), have) if x]
    if not known:
        raise JobError("its RAM limit is not known (no recorded limit, and its cgroup's memory.max reads none); "
                       "not resized")
    limit_now = min(known)  # the limit it runs under now
    peak_cpu = r[2] or 0.0
    if new["cpus"] < old["cpus"] and new["cpus"] < peak_cpu - 1e-9:
        raise JobError("--cpus %g is under its measured CPU use, %.2f threads at its peak; the smallest accepted is "
                       "--cpus %g" % (new["cpus"], peak_cpu, math.ceil(peak_cpu * 100 - 1e-9) / 100))
    if new["ram"] == old["ram"]:  # only its CPU threads change: it keeps the RAM limit it runs under
        return {"memory_max": limit_now, "ram_counted": limit_now, "was_memory_max": q.get("memory_max")}, None
    limit = ram_limit(settings, new["ram"])
    if limit > limit_now:
        raise JobError("--ram %s gives a RAM limit of %s, above the limit it runs under now, %s (ram_hard_factor has "
                       "changed since it was released); a running job's limit is never raised, so give a --ram whose "
                       "limit is at most %s" % (_gbs(new["ram"]), _gbs(limit), _gbs(limit_now), _gbs(limit_now)))
    ram_now, cache, usage, refault = m.cgroup_mem(job_cg[len(m.cg):])
    if ram_now is None:
        raise JobError("its cgroup's memory could not be read; not resized")
    use = max(0, usage - cache)  # what it can't give back now: memory.current less the cache a lower limit drops
    kernel_peak = _read_cg_int(job_cg, "memory.peak") or 0
    sampled_current = r[3] or 0  # the loop's samples only: a reading taken now would make any peak look seen
    peak = max(r[0] or 0, ram_now)
    floor = _resize_floor(settings, peak, use, kernel_peak, cache, sampled_current, limit_now)
    if limit < floor:
        smallest = _resize_suggestion(settings, peak, use, kernel_peak, cache, sampled_current=sampled_current,
                                      limit=limit_now)
        seen = _cache_off_peak(kernel_peak, sampled_current, limit_now)
        raise JobError("--ram %s gives a RAM limit of %s, under %s: the largest of its measured peak so far, %s, times "
                       "resize_margin %g, its use now less the file cache a lower limit drops, %s, and the kernel's "
                       "peak of its cgroup, %s%s; the smallest size accepted is about --ram %s" % (
                           _gbs(new["ram"]), _gbs(limit), _gbs(floor), _gbs(peak), settings["resize_margin"],
                           _gbs(use), _gbs(kernel_peak),
                           " less the file cache it holds now, %s (memory.peak counts file cache, and this peak was "
                           "seen by the loop's sampling)" % _gbs(cache) if seen else
                           " whole (memory.peak reached 90% of its limit, or came between the loop's samples, so "
                           "what it was made of is unknown)",
                           _size_arg(smallest)))
    try:
        full60 = float(m.cgroup_pressure(job_cg)["full"]["avg60"])
    except (OSError, KeyError, ValueError):
        full60 = None
    if refault is not None and q.get("refault") is None:
        raise JobError("its file refaults have not been sampled by the admission loop yet; try again after its next "
                       "cycle (about %d s)" % settings["sample_interval_s"])
    why = _shrink_blocked(full60, None if refault is None else refault > q["refault"])
    if why:
        raise JobError("not shrunk now: %s; nothing changed" % why)
    _set_memory_max(job_cg, limit)
    token = q["token"]

    def undo():
        """Put back the limit it ran under, but never above the limit recorded for it now (a resize that ran
        meanwhile may have lowered it), and never over a memory.max someone else has set since."""
        try:
            now_cg = _read_cg_int(job_cg, "memory.max")
            if now_cg is not None and abs(now_cg - limit) >= 65536:
                return  # changed since this resize set it: not this resize's to put back
            rec = Admission(settings).read_queue(token)
            recorded = (rec or {}).get("memory_max")
            if not recorded:
                sys.stderr.write("job resize: the RAM limit of %s was left at %s: its recorded limit could not be "
                                 "read\n" % (token, _gbs(limit)))
                return
            back = min(limit_now, recorded)
            if back > limit:
                _set_memory_max(job_cg, back)
        except Exception as e:  # noqa: BLE001  (it runs in a finally: it must never hide the refusal it undoes)
            sys.stderr.write("job resize: could not put the RAM limit of %s back: %s\n" % (token, e))
    return {"memory_max": limit, "ram_counted": limit, "was_memory_max": q.get("memory_max")}, undo


HOW_LABEL = {"exit": "exit", "memory_limit": "memory limit", "host_oom": "host out of memory", "sigkill": "killed",
             "scope_killed": "killed", "killed": "killed", "setup_error": "wrapper error",
             "wrapper_error": "wrapper error"}


def _short_hostname():
    return socket.gethostname().split(".")[0]


def _resume_command(group, host=None):
    """The command that starts a paused group, for a message (the host as job names it, or this host's name)."""
    return "job resume %s --group %s" % (host or _short_hostname(), shlex.quote(str(group)))


def _task_status(t):
    return next(iter(t.get("status") or {"?": 0})) if t else None


class Loop:
    """The admission loop of one host (docs/admission.md, "The admission loop")."""

    def __init__(self, settings, measure=None, clock=time.time):
        self.s, self.adm = settings, Admission(settings)
        self.m = measure or _measure_from_env()
        self.clock = clock
        self.throttled = False  # a running job was held at its soft limit this cycle
        self.samples = []
        self.keep_s = max(settings["outside_window_s"], settings["cpu_window_s"], GPU_BUSY_WINDOW_S) + 60
        self.warming = None
        self.disk_names = {}
        for p in settings["disks"]:
            d = self.m.disk_of(p)
            if d:
                self.disk_names[p] = d
        self.capacity = _capacity(self.m)
        self.room = self.room_empty = None
        self.peaks = {}
        self.holds = []
        self.hold_present = {}  # hold id -> whether the unit or cgroup it names exists, from the last sample
        self.alerts_cleaned = 0.0
        self.scopes_now = {}
        self.fair = None  # the oldest held job the fairness rule protects, for the snapshot
        self.m.cpu(self.clock())  # so the first cycle has CPU and disk readings
        self.m.disks(self.clock(), set(self.disk_names.values()))
        con = self.adm.db()
        try:  # the windows carry on from before a restart (an install re-executes the loop)
            rows = con.execute("SELECT sample FROM recent WHERE t >= ? ORDER BY t", (self.clock() - self.keep_s,))
            self.samples = [json.loads(x) for (x,) in rows]
        finally:
            con.close()

    def covered(self, now):
        """Seconds of unbroken measurement up to now; a gap longer than the heartbeat limit breaks it."""
        ts = [x["t"] for x in self.samples]
        if not ts:
            return 0.0
        gap, start = _heartbeat_limit(self.s), ts[-1]
        for i in range(len(ts) - 1, 0, -1):
            if ts[i] - ts[i - 1] > gap:
                break
            start = ts[i - 1]
        return now - start

    # -- one cycle -----------------------------------------------------------------------------------------------

    def sample(self, now, scopes, holds=(), every=None):
        """One sample. every: all of this user's job scopes (admitted or not), whose own stalls against their own
        limits are not host memory pressure."""
        busy, iowait = self.m.cpu(now)
        mem = self.m.meminfo()
        try:
            cards = self.m.gpus()
        except (OSError, ValueError):
            cards = []
        jobs = self.m.job_use(now, scopes)
        by_cg = {}
        for tok, path in scopes.items():
            by_cg[path[len(self.m.cg):]] = tok
        hold_pids = {h["id"]: _pid_tree(self.m.proc, h["while_pid"]) for h in holds if h.get("while_pid")}
        hold_cgs = {h["id"]: _hold_cgroups(h) for h in holds if h.get("unit") or h.get("cgroup")}
        # None: systemd could not be asked this cycle, so the hold is neither seen nor gone, and its use this cycle
        # counts as outside use (the safe side)
        self.hold_present = {hid: None if cgs is None else any(os.path.isdir(self.m.cg + c) for c in cgs)
                             for hid, cgs in hold_cgs.items()}
        hold_cgs = {hid: cgs or [] for hid, cgs in hold_cgs.items()}
        held_use, others = {}, {}
        for c in cards:
            for pid, used in c["procs"].items():
                cg = self.m.cgroup_of(pid) or ""
                for prefix, tok in by_cg.items():
                    if (cg == prefix or cg.startswith(prefix + "/")) and tok in jobs:
                        g = jobs[tok].setdefault("gpu", {})
                        g[c["uuid"]] = g.get(c["uuid"], 0) + used
                        break
                else:
                    # a hold's own use is its processes' use on its own card; on another card (or for a RAM-only
                    # hold) their GPU memory is outside use, so it is never taken out of the room uncounted
                    for h in holds:
                        hid = h["id"]
                        if h.get("uuid") == c["uuid"] and (pid in hold_pids.get(hid, ()) or any(
                                cg == x or cg.startswith(x + "/") for x in hold_cgs.get(hid, ()))):
                            u = held_use.setdefault(hid, {})
                            u[c["uuid"]] = u.get(c["uuid"], 0) + used
                            break
                    else:
                        others[c["uuid"]] = others.get(c["uuid"], 0) + 1
            if not c.get("procs_ok", True):
                others[c["uuid"]] = others.get(c["uuid"], 0) + 1
        hold_ram = self.hold_ram(holds, hold_cgs, hold_pids)
        pr = self.m.pressure(scopes if every is None else every)
        for tok, j in jobs.items():
            j["psi"] = pr["jobs"].get(tok)
        s = {"t": now, "busy": busy, "iowait": iowait or 0.0, "avail": mem.get("MemAvailable", 0),
             "psi": pr["psi"], "psi_system": pr["system"], "psi_source": pr["source"], "psi_where": pr["where"],
             "psi_unreadable": pr["unreadable"], "psi_cgroups": pr["cgroups"], "psi_cg_where": pr["cg_where"],
             "psi_outside": pr["outside"], "psi_global": pr["global"], "psi_unreadable_paths": pr["unreadable_paths"],
             "disks": self.m.disks(now, set(self.disk_names.values())),
             "gpus": {c["uuid"]: dict({k: c[k] for k in ("index", "name", "total", "used", "util")},
                                     others=others.get(c["uuid"], 0)) for c in cards},
             "jobs": {tok: {"ram": j["ram"], "cpu": j["cpu"], "gpu": j.get("gpu", {})} for tok, j in jobs.items()},
             "holds": held_use, "hold_ram": hold_ram}
        self.samples.append(s)
        self.samples = [x for x in self.samples if now - x["t"] <= self.keep_s]
        return s, jobs

    def hold_ram(self, holds, hold_cgs, hold_pids):
        """Each RAM hold's own use. A process or cgroup is the own use of one hold only, the oldest that names it:
        two holds naming the same or nested processes (a service that registers again before its old hold ends)
        would otherwise add its RAM back to the room twice."""
        out, taken_cg, taken_pids = {}, {}, set()  # taken_cg: path -> its whole measured use
        for h in sorted((h for h in holds if h.get("ram")), key=lambda h: h.get("start") or 0):
            hid, own = h["id"], 0
            if hid in hold_cgs:
                for c in hold_cgs[hid]:
                    if _in_cgroups(c, taken_cg):
                        continue  # inside an older hold's cgroup: counted there
                    whole = self.m.cgroup_ram(c) or 0
                    inner = [x for x in taken_cg if x.startswith(c + "/")]
                    pids = [p for p in taken_pids if _in_cgroups(self.m.cgroup_of(p) or "", [c])]
                    own += max(0, whole - sum(taken_cg.pop(x) for x in inner) - self.m.pids_ram(pids))
                    taken_pids.difference_update(pids)  # now inside c, which covers them
                    taken_cg[c] = whole
            elif hid in hold_pids:
                pids = [p for p in hold_pids[hid]
                        if p not in taken_pids and not _in_cgroups(self.m.cgroup_of(p) or "", taken_cg)]
                own = self.m.pids_ram(pids)
                taken_pids.update(pids)
            out[hid] = own
        return out

    def own_scopes(self, scopes):
        """The job scopes of jobs this loop admitted (in its queue, or with a record). Another job scope of the user
        is not counted as an admitted job, so its use must stay outside use, not be added back to the room."""
        try:
            queued = {n[:-5] for n in os.listdir(self.adm.path("queue")) if n.endswith(".json")}
        except OSError:
            queued = set()
        rest = [tok for tok in scopes if tok not in queued]
        known = set()
        if rest:
            con = self.adm.db()
            try:
                for tok in rest:
                    if con.execute("SELECT 1 FROM jobs WHERE token = ?", (tok,)).fetchone():
                        known.add(tok)
            finally:
                con.close()
        return {tok: p for tok, p in scopes.items() if tok in queued or tok in known}

    def cycle(self):
        """Measure, account, end, release; returns the seconds to sleep before the next cycle."""
        now = self.clock()
        every = self.m.scopes()
        scopes = self.scopes_now = self.own_scopes(every)
        holds = _holds(self.adm)  # ended or added under the queue lock in release(), which reads them again
        s, use = self.sample(now, scopes, holds, every)
        read_at = time.time()
        try:
            st = _pueue_status()
        except JobError:
            st = None
        queue = self.adm.queue()
        con = self.adm.db()
        try:
            if st is not None:
                tasks = {}
                for _, t in st.get("tasks", {}).items():
                    tok = _env_token(t)
                    if tok:
                        tasks[tok] = t
                self.account(con, now, queue, tasks, use, st)
                inflight = [q for q in queue if q.get("state") == "released"]
                hl = [{"id": h["id"], "gid": h.get("uuid"), "size": h.get("size") or 0, "ram": h.get("ram") or 0}
                      for h in holds]
                covered = self.covered(now)
                if covered >= self.s["warmup_s"]:
                    self.warming = None
                    self.room = compute_room(self.s, self.samples, [self._counted(q, now) for q in inflight], hl,
                                             now)
                    self.room_empty = compute_room(self.s, self.samples, [], hl, now)  # as if no admitted job ran
                    self.throttled = False
                    self.auto_grow(con, now, inflight, tasks, use)
                else:  # too little history to know the outside use over the windows: release nothing yet
                    self.warming = {"covered_s": covered, "needed_s": self.s["warmup_s"]}
                    self.room = self.room_empty = None
                self.release(con, now, queue, tasks, st, holds)
                self.clean_scopes(con, scopes, queue, tasks, use, read_at)
            con.execute("DELETE FROM recent WHERE t < ?", (now - self.keep_s,))
            con.execute("INSERT INTO recent VALUES (?, ?)", (s["t"], json.dumps(s)))
            con.execute("DELETE FROM samples WHERE t < ?", (now - 7 * 86400,))
            con.executemany("INSERT INTO samples VALUES (?, ?, ?, ?)", self._sample_rows(s))
            con.commit()
        finally:
            con.close()
        if st is not None:  # a cycle that could not read pueue admitted nothing, so it does not renew the heartbeat
            self.adm.write_json(self.adm.path("heartbeat"), {"t": now, "pid": os.getpid(), "version": VERSION})
        self.clean_alerts(queue)
        pilots = any(q.get("pilot") and q.get("state") == "released" for q in queue)
        fast = pilots or self.throttled  # a job held at its soft limit makes no progress until it is raised
        return self.s["pilot_sample_interval_s"] if fast else self.s["sample_interval_s"]

    def _sample_rows(self, s):
        rows = [(s["t"], "host", "busy", s["busy"]), (s["t"], "host", "avail", s["avail"]),
                (s["t"], "host", "psi", s["psi"]), (s["t"], "host", "iowait", s["iowait"])]
        rows += [(s["t"], "disk", n, v) for n, v in s["disks"].items()]
        for u, g in s["gpus"].items():
            rows += [(s["t"], "gpu_used", u, g["used"]), (s["t"], "gpu_util", u, g["util"])]
        return [r for r in rows if r[3] is not None]

    def _counted(self, q, now):
        # a job is counted at its RAM limit. One released by a loop that did not record it (no memory_max in its
        # queue entry) is counted at the limit in its assignment file, which is the one it runs under, or, with no
        # assignment, at the limit its size would get now
        limit = q.get("memory_max")
        if limit is None:
            limit = self._assigned_limit(q["token"])
        if limit is None and not q.get("pilot"):
            limit = ram_limit(self.s, q["size"]["ram"])
        # and never below the limit its cgroup has now (a resize lowers the limit before the count)
        path = self.scopes_now.get(q["token"])
        actual = _read_cg_int(os.path.join(path, "job"), "memory.max") if path else None
        ram = max(q.get("ram_counted") or q["size"]["ram"], limit or 0, actual or 0)
        if q.get("memory_high") and path and not _read_cg_int(os.path.join(path, "job"), "memory.high"):
            # its cgroup has no soft limit (the job restarted into a new scope): nothing holds it there, so it is
            # counted at its hard limit until the loop cuts it again
            q.pop("memory_high", None)
        if q.get("memory_high") and path:
            # a pilot the loop has cut to its use: counted at its soft limit (memory.high) or what it uses now if
            # more (a soft limit slows a job, it does not stop it), never at the hard limit it keeps
            job_cg = os.path.join(path, "job")
            ram = max(q["memory_high"], _read_cg_int(job_cg, "memory.high") or 0,
                      _read_cg_int(job_cg, "memory.current") or 0)
        c = {"token": q["token"], "released": q["released"], "size": q["size"], "gpus": q.get("gpus", []),
             "ram_counted": ram,
             "gpu_counted": q.get("gpu_counted", {})}
        if ((q.get("constraints") or {}).get("in_containers") and q.get("started")
                and now - q["started"] >= self.s["outside_window_s"]):
            # its containers' use now shows as outside use; counting its size too would count it twice
            c.update(size=dict(q["size"], cpus=0.0), ram_counted=0, gpu_counted={})
        return c

    def _assigned_limit(self, token):
        """JOB_MEMORY_MAX from a job's assignment file, or None."""
        try:
            with open(self.adm.assign_path(token)) as f:
                for line in f:
                    if line.startswith("JOB_MEMORY_MAX="):
                        return int(line.split("=", 1)[1])
        except (OSError, ValueError):
            pass
        return None

    def account(self, con, now, queue, tasks, use, st):
        """Track released jobs until their scope is empty; record peaks; end jobs; enforce time limits."""
        for q in queue:
            t = tasks.get(q["token"])
            status = _task_status(t)
            u = use.get(q["token"])
            if q.get("state") == "held" and t is not None and status not in ("Stashed", "Locked", None):
                # started though the loop did not release it (a person enqueued it): it has no assignment, so its
                # wrapper ends it at once; count it at its size until then, with no RAM limit and no GPUs recorded
                q.update({"state": "released", "released": now, "gpus": [], "ram_counted": q["size"]["ram"],
                          "gpu_counted": {}, "memory_max": None, "reason": None})
                self.adm.save(q)
                self.adm.record(con, {"token": q["token"], "released": now, "gpus": [], "ram_counted": q["ram_counted"],
                                      "gpu_counted": {}, "memory_max": None})
            if q.get("state") == "held":
                if t is None:  # removed before release, or still being added: give a submit time to finish
                    if now - q["submitted"] > 120:
                        self.end(con, q, now, "removed", None)
                elif q["constraints"].get("stop_at") and q["constraints"]["stop_at"] <= now:
                    _pueue(["remove", str(t["id"])])
                    self.end(con, q, now, "dropped at stop-at", None)
                continue
            # released
            if status == "Stashed":  # marked released, but the loop stopped before pueue enqueue: hold it again
                # the record first, committed: if the loop stops before the queue file says held, the next cycle
                # comes here again, so the record never keeps a release the queue file has dropped
                self.adm.record(con, {"token": q["token"], "released": None, "gpus": [], "ram_counted": None,
                                      "gpu_counted": None, "memory_max": None})
                con.commit()
                q.update({"state": "held", "reason": None, "released": None})
                for k in ("gpus", "ram_counted", "gpu_counted", "memory_max"):
                    q.pop(k, None)
                self.adm.save(q)
                try:
                    os.remove(self.adm.assign_path(q["token"]))
                except FileNotFoundError:
                    pass
                continue
            p = self.peaks.get(q["token"])
            if p is None:
                p = self.peaks[q["token"]] = self._stored_peaks(con, q["token"])
            if u:
                if u.get("populated"):
                    p["n"] += 1
                p["cpu"] = max(p["cpu"], u["cpu"] or 0.0)
                p["disk"] = max(p["disk"], u.get("disk_mb_s") or 0.0)
                p["ram"] = max(p["ram"], u["ram"])
                p["current"] = max(p.get("current") or 0, u.get("current") or 0)
                p["gpu"] = max([p["gpu"]] + list(u.get("gpu", {}).values()))
                stray = sorted(uu for uu, b in u.get("gpu", {}).items() if b and uu not in q.get("gpus", []))
                if stray:
                    self.adm.alert(q, "gpu_not_given", "uses GPU memory on a card it was not given (%s); it is counted "
                                   "there, but a job should use only the GPUs in CUDA_VISIBLE_DEVICES" % ", ".join(stray))
                over = [uu for uu, b in u.get("gpu", {}).items() if b > q["size"]["gpu_mem"] > 0 and not q.get("pilot")]
                if over:
                    self.adm.alert(q, "gpu_over_size", "uses %s on a GPU, over its GPU memory size of %s; no new job "
                                   "goes on that card until it is back under" % (
                                       _gbs(max(u["gpu"].values())), _gbs(q["size"]["gpu_mem"])))
            if status == "Running" and not q.get("started"):
                q["started"] = now
            if status == "Running" and q.get("stop_reason") is None:  # a paused job is stopped once resumed
                limit = None
                if q.get("pilot"):  # a pilot's time counts from its start, not from its release
                    limit = q["started"] + 60 * min(float(q["constraints"].get("max_minutes") or
                                                          self.s["pilot"]["max_minutes"]),
                                                    self.s["pilot"]["max_minutes_ceiling"])
                    reason = "pilot time limit"
                if q["constraints"].get("stop_at"):
                    at = q["constraints"]["stop_at"]
                    if limit is None or at < limit:
                        limit, reason = at, "stop-at"
                if limit is not None and now >= limit:
                    try:
                        host_kill({"id": t["id"], "token": q["token"], "stopped_by": reason})
                    except JobError as e:  # tried again next cycle
                        self.adm.alert(q, "stop_failed", "could not stop it at its %s: %s" % (reason, e))
                        self.adm.save(q)
                    else:
                        q["stop_reason"] = reason
                        self.adm.save(q)
                        continue
            running = status in IN_FLIGHT or (u is not None and u["populated"])
            if running:
                self.track_progress(q, now, u)
                self.keep_resized_limit(q)
                self.track_memory(q, u)
                if self.s["auto_resize"]:
                    q["oversize"] = None  # the loop shrinks it itself (auto_shrink); its owner is not asked to
                    self.auto_shrink(con, q, now, status, p, u)
                else:
                    self.check_oversize(q, now, status, p, u)
                self.check_undersize(q, now, status, u)
                self.record_peaks(con, q, final=False)
                self.adm.save(q)
                continue
            if t is None and st is None:
                continue  # never end a job on a failed pueue read
            self.end(con, q, now, None, t)

    def track_progress(self, q, now, u):
        """Add the job's newest progress line; project its end; ALERT when its RAM trend passes its limit."""
        got = _read_progress(q["token"])
        if got is None:
            return
        pts = q.setdefault("progress", [])
        if pts and pts[-1][1] == got[0] and pts[-1][2] == got[1]:
            return
        if pts and got[1] != pts[-1][2]:
            del pts[:]  # a new total starts a new series
        pts.append([now, got[0], got[1], (u or {}).get("ram", 0)])
        del pts[:-PROGRESS_KEEP]
        q["projected_end"] = _projected_end(pts)
        limit = q.get("memory_max")
        ram = _ram_at_total(pts)
        if limit and ram is not None and ram > limit:
            self.adm.alert(q, "ram_trend", "its RAM grows with its progress: %s at %g of %g, on course for %s at the "
                           "end, over its RAM limit of %s, where it would be stopped" % (
                               _gbs(pts[-1][3]), pts[-1][1], pts[-1][2], _gbs(ram), _gbs(limit)))

    def track_memory(self, q, u):
        """Keep, in the job's queue file, its own stall (full avg60), its file refault count at this sample and
        whether that grew since the last one: what job resize and the oversize ALERT check before a shrink
        (_shrink_blocked). Not measured this cycle: neither is known, which blocks a shrink."""
        if not u:
            q["refault_grew"] = q["stall60"] = None
            return
        ref, last = u.get("refault"), q.get("refault")
        q["refault_grew"] = None if ref is None or last is None else ref > last  # None: not known
        q["refault"] = ref
        q["stall60"] = (u.get("psi") or {}).get("full60")

    def check_oversize(self, q, now, status, p, u):
        """Note a running job whose RAM peak stays well under its size, and ALERT its owner once: it is counted at
        its hard limit, so room other jobs wait for is idle (docs/admission.md, "Resizing a job"). The peak, the
        suggestion and the floor job resize checks are all on the same basis (file cache excluded, _resize_floor), so
        the size it suggests is one job resize accepts when the alert is made."""
        q["oversize"] = None
        size = q["size"]["ram"]
        if (q.get("pilot") or status != "Running" or not q.get("started") or not size
                or (q.get("constraints") or {}).get("in_containers")
                or now - q["started"] < 60 * self.s["oversize_after_min"] or p["n"] < LIKE_MIN_SAMPLES):
            return
        # a RAM trend still rising (its progress lines) counts as its peak: a job on course to need its size is
        # not oversized, and the suggestion must cover where it is going
        projected = _ram_at_total(q.get("progress") or []) or 0
        need = max(p["ram"], projected)
        if need >= self.s["oversize_fraction"] * size:
            return
        if _shrink_blocked(q.get("stall60"), q.get("refault_grew")):
            return  # short of memory in its own cgroup, or its file cache is working set: not a size to give back
        path = self.scopes_now.get(q["token"])
        kernel_peak = (_read_cg_int(os.path.join(path, "job"), "memory.peak") or 0) if path else 0
        use, cache = (u or {}).get("need") or 0, (u or {}).get("cache") or 0
        limits = [x for x in (q.get("memory_max"), (u or {}).get("limit")) if x]
        suggest = _resize_suggestion(self.s, p["ram"], use, kernel_peak, cache, projected, p.get("current") or 0,
                                     min(limits) if limits else None)
        if suggest >= size:
            return  # its floor (memory.peak at its limit or between samples, not file cache) leaves nothing to give
        counted = self._counted(q, now)["ram_counted"]
        if limits and ram_limit(self.s, _parse_size(_size_arg(suggest))) > min(limits):
            return  # ram_hard_factor was raised since its release: no size both covers its floor and is under the
            # limit it runs under, so job resize would refuse any shrink
        q["oversize"] = {"peak": p["ram"], "size": size, "counted": counted, "suggest": _size_arg(suggest),
                         "after_s": now - q["started"], "projected": projected or None}
        self.adm.alert(q, "oversize", "oversized: in %s its RAM peaked at %s%s, under %g%% of its size of %s, and it is "
                       "counted at %s (its limit), room other jobs may be waiting for; it can shrink while it runs "
                       "to --ram %s with job resize" % (
                           _fmt_dur(now - q["started"]), _gbs(p["ram"]),
                           " (its progress trend projects %s at its end, which the size covers)" % _gbs(projected)
                           if projected > p["ram"] else "", 100 * self.s["oversize_fraction"], _gbs(size),
                           _gbs(counted), _size_arg(suggest)), extra={"resize": {"ram": _size_arg(suggest)}})

    def check_undersize(self, q, now, status, u):
        """Note a running job that spends a large share of its time stalled reclaiming memory against its own RAM
        limit, and ALERT its owner once: it is undersized. Its stall is not host memory pressure and holds no other
        job (Measure.pressure); it shows here instead (docs/admission.md, "Memory pressure")."""
        psi = (u or {}).get("psi")
        if (status != "Running" or not psi or not (psi.get("at_limit") or q.get("memory_high"))
                or psi["full60"] < self.s["undersize_stall_pct"]):
            q["undersized"] = None
            return
        last = self.samples[-1] if self.samples else {}
        outside = last.get("psi_outside")
        if (last.get("psi_global") is not False or outside is None or outside >= OUTSIDE_QUIET_PCT
                or (last.get("avail") or 0) <= self.s["ram_headroom_gb"] * GB):
            # the host may be short of RAM (in global reclaim, or not known to be out of it; something outside the
            # jobs stalls, or its pressure could not all be read; or MemAvailable is under the headroom): global
            # reclaim may be what stalls it, so the once-per-job ALERT is not spent on a doubtful case
            q["undersized"] = None
            return
        if self.s["auto_resize"] and not q.get("grow_blocked"):
            q["undersized"] = None  # the loop grows it (auto_grow) while the host has room; no ALERT unless it has none
            return
        limit = u.get("limit") or q.get("memory_max") or 0
        files = u.get("files", u.get("cache")) or 0
        q["undersized"] = {"stall": psi["full60"], "limit": limit, "ram": u.get("ram") or 0,
                           "cache": files, "since": (q.get("undersized") or {}).get("since") or now}
        self.adm.alert(q, "undersized", "undersized: over the last minute it spent %.0f%% of its time stalled reclaiming "
                       "memory against its own RAM limit of %s (it uses %s, file cache %s more), so it runs slowly. "
                       "This is not host memory pressure and holds no other job. %s" % (psi["full60"], _gbs(limit), _gbs(u.get("ram") or 0), _gbs(files),
                           "The loop raises its limit when this host has room, and it has none now; it is raised as "
                           "soon as room frees" if self.s["auto_resize"] else
                           "A running job's limit is not raised here (auto_resize is off): to give it more, kill it "
                           "and submit it again with a larger --ram, or measure it with --pilot"),
                       extra={"undersized": {"stall": psi["full60"], "limit": limit}})

    def auto_shrink(self, con, q, now, status, p, u):
        """Count a running job that uses well under its limit at the size --like would give it, and a pilot at its peak
        times pilot.shrink_margin once it has run pilot.shrink_after_min, by giving it that soft limit (_soft_limit,
        memory.high); its hard limit is kept, so a job whose later phase needs more is held there (no swap), never stopped, and the
        loop raises the soft limit while the host has room. Its owner is not asked. The size covers the resize floor
        job resize checks (_resize_floor), and nothing is cut while the job stalls in its own cgroup or reads dropped
        file pages back. The count is lowered only when that saves at least auto_shrink_min_saving of it. A job grown in the last oversize_after_min is not shrunk (it needed the room
        lately), and one whose shrink was refused is tried again only after auto_resize_retry_min. A pilot's GPU count
        is left as it is: GPU memory has no limit to hold it to, and a pilot may load its data before it uses a GPU.
        Returns True when it shrank."""
        pilot = q.get("pilot")
        after = self.s["pilot"]["shrink_after_min"] if pilot else self.s["oversize_after_min"]
        if (status != "Running" or not q.get("started") or (q.get("constraints") or {}).get("in_containers")
                or now - q["started"] < 60 * after or p["n"] < LIKE_MIN_SAMPLES):
            return False
        grows = [r.get("t") or 0 for r in q.get("resized") or [] if isinstance(r, dict) and r.get("auto") == "grow"]
        if grows and now - max(grows) < 60 * self.s["oversize_after_min"]:
            return False
        if now - (q.get("auto_resize_refused_at") or 0) < 60 * self.s["auto_resize_retry_min"]:
            return False
        if _shrink_blocked(q.get("stall60"), q.get("refault_grew")):
            return False
        path = self.scopes_now.get(q["token"])
        limits = [x for x in (q.get("memory_max"), (u or {}).get("limit")) if x]
        if not path or not limits:
            return False
        limit_now = min(limits)
        counted_now = q.get("memory_high") or limit_now
        projected = _ram_at_total(q.get("progress") or []) or 0
        kernel_peak = _read_cg_int(os.path.join(path, "job"), "memory.peak") or 0
        use, cache = (u or {}).get("need") or 0, (u or {}).get("cache") or 0
        s = self.s
        if pilot:  # its limit comes to its peak times shrink_margin: --like's margin is for a measured job
            s = json.loads(json.dumps(self.s))
            s["margins"]["ram"] = self.s["pilot"]["shrink_margin"] / self.s["ram_hard_factor"]
        # a soft limit stops nothing, so its floor is what the job holds now, not job resize's floor (which keeps a
        # whole memory.peak near the limit: a pilot whose clean file cache fills its large limit would never be cut)
        want = max(max(p["ram"], projected) * s["margins"]["ram"], use * 1.1 / self.s["ram_hard_factor"],
                   SCOPE_MIN_MEMORY)
        new_high = _whole_pages(max(ram_limit(self.s, int(math.ceil(want / 1e8 - 1e-9)) * 10 ** 8), int(use * 1.1)))
        if new_high > (1 - self.s["auto_shrink_min_saving"]) * counted_now:
            return False
        return self._soft_limit(con, q, new_high, "shrink")

    def auto_grow(self, con, now, inflight, tasks, use):
        """Raise the RAM limit of a running job that presses against it (its use, file cache excluded, at
        grow_at_fraction of the limit, a stall against it over grow_stall_pct of the last minute, or a RAM trend on
        course for it) to grow_factor times the limit, or what it needs if more, as far as the host's RAM room
        allows. The room this cycle releases from is lowered by what it took. A job that needs more than the room
        is marked grow_blocked, which is what makes its undersized ALERT."""
        if not self.s["auto_resize"] or self.room is None or not self.room.get("pressure_ok"):
            return
        for q in inflight:
            u, path = use.get(q["token"]), self.scopes_now.get(q["token"])
            if (_task_status(tasks.get(q["token"])) != "Running" or q.get("stop_reason") or not u or not path
                    or (q.get("constraints") or {}).get("in_containers") or not u.get("limit")):
                continue
            limit, need, psi = u["limit"], u.get("need") or 0, u.get("psi") or {}
            high = q.get("memory_high")
            if high and high >= limit:  # its soft limit has grown to its hard limit: it presses that one now
                if self._soft_limit(con, q, None, "grow"):
                    self.adm.save(q)
                high = None
            projected = _ram_at_total(q.get("progress") or []) or 0
            if high:
                limit = high
                # held at its soft limit: memory.events high grew and it stalls (no swap, so its own memory can't go
                # anywhere). A job that only streams files through its soft limit also raises that count, but the
                # kernel drops clean file cache without a stall, so that is not held
                held = bool(psi.get("at_limit")) and max(psi.get("full10") or 0, psi.get("full60") or 0) >= \
                    self.s["grow_stall_pct"]
                pressing = held or need >= self.s["grow_at_fraction"] * limit
                self.throttled = self.throttled or held
                if held and not q.get("soft_capped"):
                    q["soft_capped"] = now  # its peak may be its soft limit, not its need: not a --like source
                    try:
                        self.adm.record(con, {"token": q["token"], "soft_capped": 1})
                    except sqlite3.Error:
                        pass
            else:
                pressing = (need >= self.s["grow_at_fraction"] * limit
                            or (projected >= self.s["grow_at_fraction"] * limit and need >= 0.75 * limit)
                            or (psi.get("at_limit") and (psi.get("full60") or 0) >= self.s["grow_stall_pct"]))
            if not pressing:
                if q.pop("grow_blocked", None) is not None:
                    self.adm.save(q)
                continue
            counted = self._counted(q, now)["ram_counted"]
            # at most this per grow, so a trend fit or a leak takes room by steps; a job held at its soft limit doubles
            want = limit * (2.0 if high and held else self.s["grow_factor"])
            new_limit = _whole_pages(int(min(want, counted + max(0, self.room["ram"]["room"]))))
            if high and new_limit >= 0.95 * u["limit"]:  # as far as its hard limit: lift the soft limit
                if new_limit >= u["limit"] or u["limit"] - counted <= max(0, self.room["ram"]["room"]):
                    if self._soft_limit(con, q, None, "grow"):
                        self.room["ram"]["room"] -= max(0, u["limit"] - counted)
                        q.pop("grow_blocked", None)
                        self.adm.save(q)
                    continue
                new_limit = min(new_limit, u["limit"])
            if new_limit < 1.05 * limit:
                if not q.get("grow_blocked"):
                    q["grow_blocked"] = now
                    self.adm.save(q)
                continue
            if high:
                if self._soft_limit(con, q, new_limit, "grow"):
                    self.room["ram"]["room"] -= max(0, new_limit - counted)
                    q.pop("grow_blocked", None)
                    self.adm.save(q)
                continue
            job_cg = os.path.join(path, "job")
            old = dict(q["size"], ram=max(q["size"]["ram"] or 0, int(math.ceil(limit / self.s["ram_hard_factor"]))))
            new = dict(q["size"], ram=int(math.ceil(new_limit / self.s["ram_hard_factor"])))

            def do(job_cg=job_cg, new_limit=new_limit, q=q):
                # no undo: the job may already use more than its old limit, and a raised limit is counted anyway
                # (_counted takes its cgroup's memory.max when that is higher than its record)
                _set_memory_max(job_cg, new_limit)
                return ({"memory_max": new_limit, "ram_counted": new_limit, "was_memory_max": q.get("memory_max")},
                        None)
            if self._apply_resize(con, q, old, new, "grow", do):
                self.room["ram"]["room"] -= max(0, new_limit - counted)
                q.pop("grow_blocked", None)
                self.adm.save(q)

    def _soft_limit(self, con, q, high, how):
        """Set a running job's soft RAM limit (its job cgroup's memory.high; None lifts it) and count it there
        (_counted: at its soft limit, or its use now if more). Its hard limit (memory.max) is kept, so a job that
        needs more than it has used so far is held there (no swap), never stopped, and the loop raises the soft limit while the host
        has room. Only the loop sets a soft limit, and only in the job's queue file and record, which job resize
        does not write, so no lock is taken. Returns True when it was set."""
        path = self.scopes_now.get(q["token"])
        if not path:
            return False
        con.commit()  # writing a lower memory.high reclaims at once: never with the records held
        try:
            with open(os.path.join(path, "job", "memory.high"), "w") as f:
                f.write("max" if high is None else str(int(high)))
        except OSError as e:
            if q.get("auto_resize_refused") != str(e):
                sys.stderr.write("job _admit: %s of %s not made: %s\n" % (how, q["token"], e))
            q["auto_resize_refused"], q["auto_resize_refused_at"] = str(e), time.time()
            return False
        old = q.get("memory_high") or q.get("memory_max") or 0
        resized = (q.get("resized") or []) + [{"t": time.time(), "state": "released", "auto": how,
                                               "soft_limit": {"from": old, "to": high}}]
        q.update(resized=resized)
        if high is None:
            q.pop("memory_high", None)
            q["ram_counted"] = q.get("memory_max") or q.get("ram_counted")
        else:
            q.update(memory_high=high, ram_counted=high)
        q.pop("auto_resize_refused", None)
        q.pop("auto_resize_refused_at", None)
        try:
            self.adm.record(con, {"token": q["token"], "ram_counted": q["ram_counted"], "resized": resized})
            con.commit()
        except sqlite3.Error as e:  # the queue file, saved this cycle, holds it; the record catches up at its end
            sys.stderr.write("job _admit: the record of %s's %s was not written: %s\n" % (q["token"], how, e))
        return True

    def _apply_resize(self, con, q, old, new, how, do):
        """Resize a running job from the loop, as job resize does, under the queue lock: do() sets its cgroup's limit
        and returns (change, undo); then its record, its resize file (what the loop counts it by) and its assignment
        (what a restart runs under). A job resize made since this cycle read the job wins: nothing is done, and the
        job is looked at again next cycle. A step that fails undoes the ones before it. Returns True when it
        resized."""
        token = q["token"]

        def same(cur):
            return (cur and cur.get("state") == "released" and cur.get("size") == q.get("size")
                    and cur.get("memory_max") == q.get("memory_max"))
        con.commit()  # lock order is queue.lock, then the records: a submit holds the lock while it writes one
        if not same(self.adm.read_queue(token)):
            return False
        try:  # before the lock, as job resize does: lowering memory.max can force a long reclaim
            change, undo = do()
        except (JobError, sqlite3.Error, OSError) as e:
            if q.get("auto_resize_refused") != str(e):
                sys.stderr.write("job _admit: %s of %s not made: %s\n" % (how, token, e))
            q["auto_resize_refused"], q["auto_resize_refused_at"] = str(e), time.time()
            return False
        fd = self.adm.lock("queue.lock")
        try:
            if not same(self.adm.read_queue(token)):  # a job resize landed meanwhile: it wins
                if undo:
                    undo()
                return False
            resized = (q.get("resized") or []) + [{"t": time.time(), "state": "released", "auto": how, "from": {
                "cpus": old["cpus"], "ram": old["ram"]}, "to": {"cpus": new["cpus"], "ram": new["ram"]}}]
            before = {"token": token, "size": q["size"], "resized": q.get("resized") or None,
                      "memory_max": q.get("memory_max"), "ram_counted": q.get("ram_counted")}
            try:
                self.adm.record(con, dict({k: v for k, v in change.items() if k in RECORD_FIELDS}, token=token,
                                          size=new, resized=resized))
                con.commit()
                try:
                    self.adm.write_json(self.adm.resize_path(token), dict(change, size=new, resized=_no_soft(resized)))
                except OSError:
                    self.adm.record(con, before)
                    con.commit()
                    raise
            except (OSError, sqlite3.Error) as e:
                try:
                    con.rollback()
                except sqlite3.Error:
                    pass
                if undo:
                    undo()
                sys.stderr.write("job _admit: %s of %s not made: %s\n" % (how, token, e))
                q["auto_resize_refused_at"] = time.time()
                return False
            _set_assigned_limit(self.adm, token, change["memory_max"])
            q.update(size=new, resized=resized, memory_max=change["memory_max"], ram_counted=change["ram_counted"])
            q.pop("auto_resize_refused", None)
            q.pop("auto_resize_refused_at", None)
            return True
        finally:
            os.close(fd)

    def keep_resized_limit(self, q):
        """A job resized while its scope was starting may have been given its old RAM limit: lower it again."""
        path = self.scopes_now.get(q["token"])
        if not q.get("resized") or not q.get("memory_max") or not path:
            return
        try:
            with open(os.path.join(path, "job", "memory.max")) as f:
                have = f.read().strip()
            if have == "max" or int(have) > q["memory_max"] + 65536:
                _set_memory_max(os.path.join(path, "job"), q["memory_max"])
        except (OSError, ValueError, JobError) as e:
            if (isinstance(e, OSError) and _gone(e)) or not os.path.isdir(os.path.join(path, "job")):
                return  # ended while its limit was being set
            sys.stderr.write("job _admit: could not keep the resized RAM limit of %s: %s\n" % (q["token"], e))

    def _stored_peaks(self, con, token):
        """The peaks recorded so far (by this loop or one before a restart), so a restart never lowers them."""
        r = con.execute("SELECT peak_cpu, peak_ram, peak_gpu_mem, peak_samples, peak_disk_mb_s, peak_current FROM jobs "
                        "WHERE token = ?", (token,)).fetchone()
        r = r or (None,) * 6
        return {"cpu": r[0] or 0.0, "ram": r[1] or 0, "gpu": r[2] or 0, "n": r[3] or 0, "disk": r[4] or 0.0,
                "current": r[5] or 0}

    def record_peaks(self, con, q, final):
        p = self.peaks.get(q["token"]) or self._stored_peaks(con, q["token"])
        row = {"token": q["token"], "released": q.get("released"), "started": q.get("started"),
               "gpus": q.get("gpus", []), "peak_cpu": p["cpu"], "peak_ram": p["ram"],
               "peak_gpu_mem": p["gpu"], "peak_samples": p["n"], "peak_disk_mb_s": p["disk"],
               "peak_current": p.get("current") or 0,
               "peaks_final": int(final), "progress": q.get("progress"), "projected_end": q.get("projected_end")}
        self.adm.record(con, row)
        # also written at release; a write lost there (or by a loop before records kept them) is filled in here, but
        # only where the record has none: q is this cycle's copy, read before a job resize that may have landed since
        # and written its new limit to the record
        for k in ("ram_counted", "gpu_counted", "memory_max"):
            if q.get(k) is not None:
                v = json.dumps(q[k]) if isinstance(q[k], (dict, list)) else q[k]
                con.execute("UPDATE jobs SET %s = ? WHERE token = ? AND %s IS NULL" % (k, k), (v, q["token"]))

    def end(self, con, q, now, how, t):
        """A job ended (or left the queue): write its final record and forget it."""
        row = {"token": q["token"], "ended": now}
        ran = how is None
        if how is None:
            res = _scope_result(q["token"]) or {}
            rec = os.path.join(STATE_DIR, "results", q["token"] + ".exit")
            try:
                with open(rec) as f:
                    row["exit"] = int(f.read().strip())
            except (OSError, ValueError):
                row["exit"] = None
            if q.get("stop_reason"):
                how = q["stop_reason"]
            elif t is not None and (t.get("status") or {}).get("Done", {}).get("result") == "Killed":
                how = "killed"
            elif t is None and not res and row["exit"] is None:
                how = "removed"  # removed from pueue before it ran
            else:
                how = HOW_LABEL.get(res.get("how"), res.get("how") or "exit")
            row["memory_peak"] = res.get("memory_peak_incl_cache")
            if res.get("memory_max_at_end"):
                row["memory_max"] = res["memory_max_at_end"]  # the limit it ended under
        row["how"] = how
        if q.get("resized"):
            row["resized"] = q["resized"]  # its final list, without the repeats a 0.9.1 record could hold (TASK-021)
        # Under the queue lock, which job resize holds from reading the queue file to writing its own: a resize either
        # finishes before the job's files are removed (and its change is in the record) or finds the job gone.
        con.commit()  # lock order is queue.lock, then the records
        fd = self.adm.lock("queue.lock")
        try:
            if ran:
                self.record_peaks(con, q, final=True)
            self.adm.record(con, row)
            for path in (self.adm.path("queue", q["token"] + ".json"), self.adm.assign_path(q["token"]),
                         self.adm.resize_path(q["token"])):
                try:
                    os.remove(path)
                except FileNotFoundError:
                    pass
            con.commit()
        finally:
            os.close(fd)
        self.peaks.pop(q["token"], None)
        q["state"] = "ended"

    def release(self, con, now, queue, tasks, st, counted_holds=()):
        """Under the queue lock: bring holds up to date, release held jobs that fit (oldest first; once the
        oldest has waited fairness_wait_min, a younger job is released only if it takes nothing from a resource
        the oldest is short of), and write the snapshot, so a hold decided after the lock sees these releases."""
        con.commit()  # lock order is queue.lock, then the records: a submit holds the lock while it writes one
        fd = self.adm.lock("queue.lock")
        try:
            for q in queue:  # a resize since the cycle read the queue: release by the new size
                if q.get("state") != "ended":
                    self.adm.overlay(q)
            self.sweep_resizes()
            self.fair = None
            room = json.loads(json.dumps(self.room)) if self.room is not None else None
            self.update_holds(now, room, {h["id"] for h in counted_holds})
            if room is not None:
                self._release(con, now, queue, tasks, st, room)
                self.room = room  # the snapshot shows the room left after this cycle's releases
            elif self.warming:
                for q in queue:
                    if q.get("state") == "held":
                        q["reason"] = "the loop is measuring this host first (%s of %s)" % (
                            _fmt_dur(self.warming["covered_s"]), _fmt_dur(self.warming["needed_s"]))
                        self.adm.save(q)
            self.write_snapshot(now, queue)
        finally:
            try:
                con.commit()
            finally:
                os.close(fd)

    def sweep_resizes(self):
        """Under the queue lock: remove resize files whose job has left the queue (written by a resize that raced the
        job's end before the end took the lock)."""
        try:
            names = os.listdir(self.adm.path("resize"))
        except OSError:
            return
        for name in names:
            if name.endswith(".json") and not os.path.exists(self.adm.path("queue", name)):
                try:
                    os.remove(self.adm.path("resize", name))
                except OSError:
                    pass

    def update_holds(self, now, room, counted):
        """End holds whose process, time to live, unit or cgroup is gone, and give back to the room what it counted
        for them; take holds this cycle's room did not count (granted since it read them) out of the room."""
        live = []
        for h in _holds(self.adm):
            alive, why = _hold_alive(h, self.m.proc, now)
            present = self.hold_present.get(h["id"])
            if alive and present is False and h.get("seen"):
                alive, why = False, "its unit or cgroup is gone"
            if not alive:
                _end_hold(self.adm, h, why)
                if room is not None and h["id"] in counted:
                    # the room counted it at the larger of its size and its use; its size comes back (the safe
                    # side, as for a hold ended at a grant), so a service that reloads now finds its room
                    if h.get("uuid") in room["gpus"]:
                        g = room["gpus"][h["uuid"]]
                        g["room"] += h.get("size") or 0
                        g["holds"] -= h.get("size") or 0
                    room["ram"]["room"] += h.get("ram") or 0
                    room["ram"]["holds"] -= h.get("ram") or 0
                continue
            if present and not h.get("seen"):
                h["seen"] = True
                self.adm.write_json(self.adm.path("holds", h["id"] + ".json"), h)
            if room is not None and h["id"] not in counted:
                if h.get("uuid") in room["gpus"]:
                    g = room["gpus"][h["uuid"]]
                    g["room"] -= h.get("size") or 0
                    g["holds"] += h.get("size") or 0  # a hold on the card: a later hold does not get the headroom
                room["ram"]["room"] -= h.get("ram") or 0
                room["ram"]["holds"] += h.get("ram") or 0
            live.append(h)
        self.holds = live

    def _release(self, con, now, queue, tasks, st, room):
        groups = st.get("groups", {})
        running = {}
        for t in st.get("tasks", {}).values():
            if _task_status(t) in ("Running", "Queued"):  # an enqueued job takes a slot as soon as one is free
                running[t.get("group")] = running.get(t.get("group"), 0) + 1
        blocked = blocker = None  # {resource: what the waiting oldest job lacks of it}, and that job
        taken = {}  # what younger jobs released past it, and still in flight, take of each of those resources
        inflight = {q["token"] for q in queue if q.get("state") == "released"}
        ending = [self._frees(q, now) for q in queue if q.get("state") == "released"]  # for start estimates
        for q in queue:
            if q.get("state") != "held":
                continue
            t = tasks.get(q["token"])
            if t is None or _task_status(t) != "Stashed":
                continue
            g = groups.get(q["group"]) or {}
            if g.get("status") == "Paused":
                q["reason"], q["hint"] = "its group %s is paused; start it with: %s" % (
                    q["group"], _resume_command(q["group"])), None
                self.adm.alert(q, "group_paused", "held: its pueue group %s on %s is paused; start it with: %s" % (
                    q["group"], _short_hostname(), _resume_command(q["group"])), {"resume": {"group": q["group"]}})
                self.adm.save(q)
                continue
            if running.get(q["group"], 0) >= (g.get("parallel_tasks") or 1):
                q["reason"], q["hint"] = "its group %s is full" % q["group"], None
                self.adm.save(q)
                continue
            ok, got = fits(self.s, room, q, q.get("data_disk"))
            lack = None  # what it lacks; for a job waiting behind the oldest, of the resources they share
            if ok and blocked is not None:
                # A job that takes under a small share of what the oldest lacks barely delays it, and may start. The
                # share is a budget kept with the oldest job over cycles: the jobs let past it that still run, together,
                # take less than the share of the smaller of what it lacked when it was first blocked and what it
                # lacks now, so a stream of small jobs cannot hold it back for long.
                passes, passed = _fair_pass(self.s, {"lack": blocked, "taken": taken}, q, got)
                if passes and passed:
                    for r, n in passed.items():
                        taken[r] = taken.get(r, 0) + n
                    blocker.setdefault("fair_passed", {})[q["token"]] = passed
                    self.adm.save(blocker)
                elif not passes:
                    lack = {r: blocked[r] + n for r, n in passed.items()}
                    ok, got = False, "waiting behind an older job, %s (token %s), that needs: %s" % (
                        _shown_task(blocker["task"]), blocker["token"],
                        blocker.get("reason_core") or blocker.get("reason"))
                    q["hint"] = None  # the older job's own reason carries any hint once, not this one
            if not ok:
                if lack is None:
                    lack = _lack(self.s, room, q)
                    q["reason_core"] = got  # its own reason, without the estimate, as a younger job shows it
                    q["hint"] = _ram_hint(q, lack)
                q["start_estimate"] = None
                if lack:
                    got += "; " + self._estimate_text(q, room, lack, ending, now)
                q["reason"] = got
                self.adm.save(q)
                if (blocked is None and now - q["submitted"] >= 60 * self.s["fairness_wait_min"]
                        and fits(self.s, self.room_empty, q, q.get("data_disk"))[0]):
                    # it would fit once admitted jobs end, so younger jobs must not take that room
                    blocked, blocker = self._short_of(room, q), q
                    if q.get("fair_base") is None:
                        q["fair_base"], q["fair_base_at"] = dict(blocked), time.time()
                    base = q["fair_base"]
                    for r in blocked:
                        blocked[r] = min(blocked[r], base.get(r, blocked[r]))
                    q["fair_passed"] = {tok: n for tok, n in (q.get("fair_passed") or {}).items() if tok in inflight}
                    for n in q["fair_passed"].values():
                        for r, v in n.items():
                            taken[r] = taken.get(r, 0) + v
                    self.adm.save(q)
                continue
            if self.enqueue(con, now, q, t, got):
                _take(room, q, got)
                running[q["group"]] = running.get(q["group"], 0) + 1
                ending.append(self._frees(q, now))
        # for the first held line of a job submitted before the next cycle (_submit_reason)
        self.fair = None if blocker is None else {
            "token": blocker["token"], "task": blocker["task"], "reason": blocker.get("reason_core"),
            "lack": blocked, "taken": taken}

    def _frees(self, q, now):
        """What a running job frees when it ends, and when that should be: (projected end, {resource: amount},
        task)."""
        c = self._counted(q, now)
        frees = {"ram": c["ram_counted"], "cpu": c["size"]["cpus"]}
        frees.update({"gpu:" + u: b for u, b in (c["gpu_counted"] or {}).items()})
        return q.get("projected_end"), frees, q["task"]

    def _estimate_text(self, q, room, lack, ending, now):
        model = (q.get("constraints") or {}).get("gpu_model")
        matching = [u for u, g in room["gpus"].items() if not model or model.lower() in g["name"].lower()]
        fitting = len([u for u in matching if "gpu:" + u not in lack])
        got, why = start_estimate(lack, ending, q["size"].get("gpus") or 0, fitting)
        if got is None:
            return "start estimate: " + why
        q["start_estimate"] = got[0]
        at = dt.datetime.fromtimestamp(got[0]).astimezone().strftime("%Y-%m-%d %H:%M %Z")
        if got[0] <= now:
            return "enough room should free when %s ends, which is past its projected end (%s), so any time now" % (
                _shown_task(got[1]), at)
        return "enough room should free about %s, when %s ends (its projected end)" % (at, _shown_task(got[1]))

    def _short_of(self, room, q):
        """{resource: how much a held job lacks of it now}; empty when it is held for some other reason. A resource
        it is short of in a way no amount measures (a busy GPU, a busy disk) lacks 0, so no younger job may take
        from it. A pilot lacks the RAM it is short of its floor (pilot.ram_floor_gb), like any other job."""
        return _lack(self.s, room, q)

    def enqueue(self, con, now, q, t, got):
        """Release one job: write its assignment, then pueue enqueue <id> (never without an id)."""
        memory_max = (_whole_pages(max(int(got["ram_counted"]), SCOPE_MIN_MEMORY)) if q.get("pilot")
                      else ram_limit(self.s, q["size"]["ram"]))
        lines = ["JOB_MEMORY_MAX=%d" % memory_max, "CUDA_VISIBLE_DEVICES=%s" % ",".join(got["gpus"]),
                 "JOB_GPU_UUIDS=%s" % ",".join(got["gpus"])]
        path = self.adm.assign_path(q["token"])
        with open(path + ".tmp", "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(path + ".tmp", path)
        q.update({"state": "released", "released": now, "gpus": got["gpus"], "ram_counted": got["ram_counted"],
                  "gpu_counted": got["gpu_counted"], "memory_max": memory_max, "reason": None})
        self.adm.save(q)
        try:
            _pueue(["enqueue", str(int(t["id"]))])
        except JobError as e:
            # pueue may have acted before it failed, so the job stays counted with its assignment; the next
            # cycle holds it again if its task is still Stashed
            sys.stderr.write("job _admit: pueue enqueue %s failed: %s\n" % (t["id"], e))
        self.adm.record(con, {"token": q["token"], "released": now, "gpus": got["gpus"], "pueue_id": int(t["id"]),
                              "ram_counted": got["ram_counted"], "gpu_counted": got["gpu_counted"],
                              "memory_max": memory_max})
        return True

    def clean_scopes(self, con, scopes, queue, tasks, use, read_at):
        """Stop a job scope that still has processes after its task is Done or gone (the shim was killed, so
        nothing else stops them). Scopes of other names, and of tasks pueue still runs, are never touched."""
        queued = {q["token"] for q in queue}
        for tok in scopes:
            t = tasks.get(tok)
            if t is not None and _task_status(t) != "Done":
                continue
            if t is None and not os.path.exists(os.path.join(STATE_DIR, "scripts", tok + ".shim")):
                continue  # not a job of this host's pueue: leave it alone
            if tok not in queued and con.execute("SELECT 1 FROM jobs WHERE token = ?", (tok,)).fetchone() is None:
                continue  # not an admitted job of this host
            try:
                if os.path.getmtime(os.path.join(STATE_DIR, "results", tok + ".started")) >= read_at:
                    continue  # restarted since pueue's status was read
            except OSError:
                continue  # not started, or starting again: its shim decides
            if use.get(tok, {}).get("populated"):
                _stop_scope(tok)

    def write_snapshot(self, now, queue):
        held = [{"token": q["token"], "task": q["task"], "reason": q.get("reason"), "waited_s": now - q["submitted"],
                 "size": q["size"], "pilot": q.get("pilot"), "start_estimate": q.get("start_estimate")}
                for q in queue if q.get("state") == "held"]
        jobs = [{"token": q["token"], "task": q["task"], "id": q.get("pueue_id"), "size": q["size"],
                 "gpus": q.get("gpus"), "released": q.get("released"),
                 "progress": (q.get("progress") or [[0, None, None]])[-1][1:3],
                 "projected_end": q.get("projected_end"), "ram_counted": self._counted(q, now)["ram_counted"],
                 "peak_ram": (self.peaks.get(q["token"]) or {}).get("ram"), "oversize": q.get("oversize"),
                 "memory_high": q.get("memory_high"),
                 "undersized": q.get("undersized"),
                 "resized": bool(q.get("resized"))}
                for q in queue if q.get("state") == "released"]
        holds = [{k: h.get(k) for k in ("id", "name", "index", "uuid", "size", "ram", "start", "expires")} for h in self.holds]
        self.adm.write_json(self.adm.path("room.json"), {"t": now, "written": time.time(), "host": socket.gethostname(),
                                                         "room": self.room, "capacity": self.capacity, "held": held,
                                                         "jobs": jobs, "holds": holds, "warmup": self.warming,
                                                         "fairness": self.fair})

    def clean_alerts(self, queue):
        """Once an hour, remove alert files of jobs that left the queue more than SCRIPT_KEEP_DAYS ago."""
        if time.time() - self.alerts_cleaned < 3600:
            return
        self.alerts_cleaned = time.time()
        keep = {q["token"] for q in queue}
        d = self.adm.path("alerts")
        try:
            for name in os.listdir(d):
                p = os.path.join(d, name)
                if name.split(".")[0] not in keep and os.path.getmtime(p) < time.time() - SCRIPT_KEEP_DAYS * 86400:
                    os.remove(p)
        except OSError:
            pass


def _mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return None


def admit_main(once=False):
    """`job _admit`: run the admission loop of this host (one instance per host)."""
    settings = _admission_settings()
    if settings is None:
        raise JobError("no admission settings at %s; this host is not an admission host" % ADMISSION_CONFIG)
    adm = Admission(settings)
    fd = os.open(adm.path("loop.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise JobError("the admission loop already runs on %s" % socket.gethostname())
    me = os.path.realpath(__file__)
    started_mtime = os.path.getmtime(me)
    settings_mtime = _mtime(ADMISSION_CONFIG)
    loop = Loop(settings)
    results = os.path.join(STATE_DIR, "results")
    os.makedirs(results, mode=0o700, exist_ok=True)
    if not once:  # Loop() took the first CPU and disk readings; the first cycle's rates cover a whole interval
        time.sleep(settings["sample_interval_s"])
    while True:
        if once:
            loop.cycle()
            return 0
        try:
            wait = loop.cycle()
        except Exception:  # logged to the journal; the heartbeat is not renewed, so a lasting error shows as stale
            sys.stderr.write("job _admit: cycle failed:\n%s" % traceback.format_exc())
            sys.stderr.flush()
            wait = settings["sample_interval_s"]
        marks = (os.path.getmtime(results), os.path.getmtime(adm.path("queue")))
        end = time.monotonic() + wait
        while time.monotonic() < end:
            time.sleep(1)
            try:
                if (os.path.getmtime(results), os.path.getmtime(adm.path("queue"))) != marks:
                    break  # a job ended or one was submitted
            except OSError:
                break
        restart = False
        try:
            restart = os.path.getmtime(me) != started_mtime  # a new job was installed: run it
        except OSError:
            pass
        if not restart and _mtime(ADMISSION_CONFIG) != settings_mtime:
            # the settings changed: submits read them at once, so the loop must count by them too
            settings_mtime = _mtime(ADMISSION_CONFIG)
            try:
                restart = _admission_settings() is not None
            except JobError as e:
                sys.stderr.write("job _admit: the changed settings are not valid, so the loop keeps its own: %s\n" % e)
                sys.stderr.flush()
        if restart:
            try:
                os.close(fd)
                os.execv(sys.executable, [sys.executable, me, "_admit"])
            except OSError:
                pass


def _hold_alive(h, proc="/proc", now=None):
    """Whether a hold still holds: its process lives (--while-pid) and its time-to-live has not run out."""
    now = time.time() if now is None else now
    if h.get("expires") and now >= h["expires"]:
        return False, "its time to live ran out"
    pid = h.get("while_pid")
    if pid:
        try:
            with open(os.path.join(proc, str(pid), "stat")) as f:
                start = f.read().rsplit(")", 1)[1].split()[19]  # field 22, start time: a reused pid differs
        except (OSError, IndexError):
            return False, "process %d exited" % pid
        if h.get("pid_start") and start != h["pid_start"]:
            return False, "process %d exited" % pid
    return True, None


def _hold_cgroups(h):
    """The cgroup paths whose processes are the hold's own use; None when systemd could not be asked, so a slow or
    failed lookup never reads as the unit being gone."""
    if h.get("cgroup"):
        return [h["cgroup"].rstrip("/")]
    if h.get("unit"):
        out, unknown = [], False
        for flag in ("--user", "--system"):
            env = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % os.getuid())
            try:
                p = subprocess.run(["systemctl", flag, "show", "-p", "ControlGroup", "--value", h["unit"]], env=env,
                                   capture_output=True, text=True, timeout=5)  # each cycle: a hung call delays it
            except (OSError, subprocess.TimeoutExpired):
                unknown = True
                continue
            cg = p.stdout.strip()
            if p.returncode == 0 and cg.startswith("/"):
                out.append(cg.rstrip("/"))
        return None if unknown and not out else out
    return []


def _in_cgroups(cg, paths):
    """Whether cgroup path cg is one of paths or inside one."""
    return any(cg == x or cg.startswith(x + "/") for x in paths)


def _pid_tree(proc, root):
    """root and all its descendants, from /proc."""
    children = {}
    for name in os.listdir(proc):
        if name.isdigit():
            try:
                with open(os.path.join(proc, name, "stat")) as f:
                    ppid = int(f.read().rsplit(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            children.setdefault(ppid, []).append(int(name))
    out, todo = set(), [root]
    while todo:
        p = todo.pop()
        if p not in out:
            out.add(p)
            todo += children.get(p, [])
    return out


def host_hold(req):
    """Register, renew or release a GPU hold on an admission host (docs/admission.md, "Holds")."""
    settings = _admission_settings()
    if settings is None:
        raise JobError("%s is not an admission host" % socket.gethostname())
    adm = Admission(settings)
    os.makedirs(adm.path("holds"), mode=0o700, exist_ok=True)
    # systemd is asked before the lock, which every submit and loop cycle waits on; a unit found gone a moment before
    # the lock is treated as gone, as the loop treats a unit it found gone at its last sample
    gone = set() if req.get("release") or req.get("renew") else _gone_hold_cgroups(adm)
    fd = adm.lock("queue.lock")
    try:
        if req.get("release") or req.get("renew"):
            hid = str(req.get("release") or req.get("renew"))
            if not hid.isalnum():
                raise JobError("bad hold id")
            h = adm.read_json(adm.path("holds", hid + ".json"))
            if h is None:
                raise JobError("no hold %s on %s" % (hid, socket.gethostname()))
            if req.get("release"):
                _end_hold(adm, h, "released")
                return {"id": hid, "action": "released"}
            if not h.get("ttl_min"):
                raise JobError("hold %s has no time to live to renew" % hid)
            h["expires"] = time.time() + 60 * h["ttl_min"]
            adm.write_json(adm.path("holds", hid + ".json"), h)
            return {"id": hid, "action": "renewed", "expires": h["expires"]}
        name, size, ram = req.get("name"), req.get("mem"), req.get("ram")
        want_gpu = req.get("gpu") is not None
        if req.get("cgroup") is not None and not (isinstance(req["cgroup"], str) and req["cgroup"].startswith("/")):
            raise JobError("--cgroup is a path from the cgroup root, starting with /")
        if (not isinstance(name, str) or not name or (want_gpu and (not isinstance(size, int) or size <= 0))
                or (ram is not None and (not isinstance(ram, int) or ram <= 0)) or (not want_gpu and ram is None)
                or (size is not None and not want_gpu)):
            raise JobError("a hold needs --name, and --gpu with --mem, --ram, or both")
        snap = adm.read_json(adm.path("room.json"))
        age = _heartbeat_age(adm)
        if not snap or age is None or age > _heartbeat_limit(settings):
            raise JobError("the admission loop on %s is not running, so no hold can be granted" % socket.gethostname())
        if not snap.get("room"):
            raise JobError("the admission loop on %s is still measuring the host, so no hold can be granted yet"
                           % socket.gethostname())
        # a hold whose owner is already gone (its process exited, its time to live ran out, its unit or cgroup went)
        # still counts in the snapshot until the loop's next cycle: end it now and credit back what the snapshot
        # counted for it, so a service that reloads at once is not refused against its own dead hold
        credit_ram, credit_gpu = _end_dead_holds(adm, snap, gone)
        # the snapshot is written under this lock after each cycle's releases; holds since then are not in it
        newer = [h for h in _holds(adm) if h["start"] > snap.get("written", snap["t"])]
        if ram:
            running = (adm.read_json(adm.path("heartbeat")) or {}).get("version")
            if running != VERSION:  # just after an install, until the loop restarts into this file (one cycle)
                raise JobError("the admission loop on %s runs job %s, which does not count RAM holds as job %s does; "
                               "no RAM hold can be granted until it restarts" % (socket.gethostname(), running or "?",
                                                                                 VERSION))
            free_ram = snap["room"]["ram"]["room"] + credit_ram - sum(h.get("ram") or 0 for h in newer)
            if ram > free_ram:
                raise NoRoom("%s has %s of RAM free to hold; the hold needs %s" % (
                    socket.gethostname(), _gbs(max(0, free_ram)), _gbs(ram)))
        gid = index = None
        if want_gpu:
            gpus = snap["room"]["gpus"]
            want = str(req.get("gpu"))
            gid = next((u for u, g in gpus.items() if u == want or str(g["index"]) == want), None)
            if gid is None:
                raise JobError("no GPU %s on %s" % (want, socket.gethostname()))
            g, index = gpus[gid], gpus[gid]["index"]
            on_card = [h for h in newer if h.get("uuid") == gid]
            free = g["room"] + credit_gpu.get(gid, 0) - sum(h.get("size") or 0 for h in on_card)
            holds_left = (g.get("holds") or 0) - credit_gpu.get(gid, 0)
            if not g.get("jobs") and holds_left <= 0 and not g.get("others", 1) and not on_card:
                # the headroom keeps parties on one card apart; a hold alone on its card may use it (a snapshot
                # from before the loop counted other users gives no headroom)
                free += settings["gpu_headroom_mb"] * MB
            if size > free:
                raise NoRoom("GPU %d on %s has %s free; the hold needs %s" % (index, socket.gethostname(),
                                                                               _gbs(max(0, free)), _gbs(size)))
        h = {"id": uuid.uuid4().hex[:12], "name": name, "uuid": gid, "index": index, "size": size or 0,
             "ram": ram or 0, "start": time.time(), "unit": req.get("unit"), "cgroup": req.get("cgroup"),
             "ttl_min": req.get("ttl")}
        if req.get("while_pid"):
            pid = int(req["while_pid"])
            try:
                with open(os.path.join(_measure_from_env().proc, str(pid), "stat")) as f:
                    h["pid_start"] = f.read().rsplit(")", 1)[1].split()[19]
            except (OSError, IndexError):
                raise JobError("no process %d on %s" % (pid, socket.gethostname()))
            h["while_pid"] = pid
        if h["ttl_min"]:
            h["expires"] = h["start"] + 60 * float(h["ttl_min"])
        adm.write_json(adm.path("holds", h["id"] + ".json"), h)
        con = adm.db()
        try:
            con.execute("INSERT INTO holds (id, name, card, size, start, ram) VALUES (?, ?, ?, ?, ?, ?)",
                        (h["id"], name, gid, h["size"], h["start"], h["ram"]))
            con.commit()
        finally:
            con.close()
        out = {"id": h["id"], "action": "granted", "ram": h["ram"]}
        if gid:
            out.update(gpu=index, uuid=gid)
        return out
    finally:
        os.close(fd)


def _gone_hold_cgroups(adm):
    """The ids of seen holds whose unit or cgroup is gone. It asks systemd (up to 5 s a call), so it runs before
    the queue lock is taken; _end_dead_holds acts on it under the lock."""
    m = _measure_from_env()
    gone = set()
    for h in _holds(adm):
        if h.get("seen") and (h.get("unit") or h.get("cgroup")):
            cgs = _hold_cgroups(h)  # None: systemd could not be asked, so the hold is kept
            if cgs is not None and not any(os.path.isdir(m.cg + c) for c in cgs):
                gone.add(h["id"])
    return gone


def _end_dead_holds(adm, snap, gone=frozenset()):
    """Under the queue lock: end every hold whose owner is gone, by the loop's own test (update_holds; gone: the
    holds _gone_hold_cgroups found without their unit or cgroup), and return what the snapshot counted for those it
    counted: (RAM bytes, {GPU uuid: bytes}). The snapshot counted a hold at the larger of its size and its measured
    use; only its size is credited back, the safe side."""
    m = _measure_from_env()
    counted = {h.get("id") for h in snap.get("holds") or []}
    ram, gpu = 0, {}
    for h in _holds(adm):
        alive, why = _hold_alive(h, m.proc)
        if alive and h["id"] in gone:
            alive, why = False, "its unit or cgroup is gone"
        if alive:
            continue
        _end_hold(adm, h, why)
        if h.get("id") in counted:
            ram += h.get("ram") or 0
            if h.get("uuid"):
                gpu[h["uuid"]] = gpu.get(h["uuid"], 0) + (h.get("size") or 0)
    return ram, gpu


def _holds(adm):
    d = adm.path("holds")
    try:
        names = os.listdir(d)
    except OSError:
        return []
    return [h for h in (adm.read_json(os.path.join(d, n)) for n in names if n.endswith(".json")) if h]


def _end_hold(adm, h, how):
    try:
        os.remove(adm.path("holds", h["id"] + ".json"))
    except FileNotFoundError:
        pass
    con = adm.db()
    try:
        con.execute("UPDATE holds SET ended = ?, how = ? WHERE id = ?", (time.time(), how, h["id"]))
        con.commit()
    finally:
        con.close()


def host_room(req):
    """The admission loop's last snapshot and its age; {"admission": false} on other hosts."""
    settings = _admission_settings()
    if settings is None:
        return {"admission": False, "hostname": socket.gethostname()}
    adm = Admission(settings)
    snap = adm.read_json(adm.path("room.json")) or {}
    age = _heartbeat_age(adm)
    snap.update({"admission": True, "hostname": socket.gethostname(), "heartbeat_age": age,
                 "stale": age is None or age > _heartbeat_limit(settings), "settings": settings,
                 "paths": [x for x in (req.get("paths") or []) if isinstance(x, str) and os.path.exists(x)]})
    return snap


ADMIT_UNIT = "agent-pueue-admit.service"
ADMIT_UNIT_TEXT = """[Unit]
Description=agent-pueue admission loop (job _admit): starts held jobs when they fit
After=pueued.service

[Service]
ExecStart=%h/.local/bin/job _admit
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
"""


def host_admission(req):
    """Start, stop or report this host's admission loop service (a systemd user service)."""
    action = req.get("action")
    env = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % os.getuid())

    def ctl(*args):
        p = subprocess.run(["systemctl", "--user"] + list(args), env=env, capture_output=True, text=True, timeout=60)
        return p.returncode, (p.stdout + p.stderr).strip()

    if action == "start":
        if _admission_settings() is None:  # raises with the reason when the file is unusable
            raise JobError("no admission settings at %s; write them first" % ADMISSION_CONFIG)
        why = _scope_probe(env)
        if why:
            raise JobError("this host cannot run admitted jobs, so admission stays off: %s" % why)
        p = subprocess.run(["loginctl", "show-user", str(os.getuid()), "-p", "Linger", "--value"], env=env,
                           capture_output=True, text=True, timeout=30)
        if p.stdout.strip() != "yes":
            raise JobError("the systemd user manager does not outlive logins here, so the loop would stop at logout; "
                           "turn on lingering (loginctl enable-linger) first")
        unit_dir = os.path.expanduser("~/.config/systemd/user")
        os.makedirs(unit_dir, exist_ok=True)
        with open(os.path.join(unit_dir, ADMIT_UNIT + ".tmp"), "w") as f:
            f.write(ADMIT_UNIT_TEXT)
        os.replace(os.path.join(unit_dir, ADMIT_UNIT + ".tmp"), os.path.join(unit_dir, ADMIT_UNIT))
        for args in (("daemon-reload",), ("enable", "--now", ADMIT_UNIT)):
            rc, out = ctl(*args)
            if rc != 0:
                raise JobError("systemctl --user %s failed: %s" % (" ".join(args), out))
    elif action == "stop":
        rc, out = ctl("disable", "--now", ADMIT_UNIT)
        if rc != 0 and "not loaded" not in out and "does not exist" not in out:
            raise JobError("systemctl --user disable --now %s failed: %s" % (ADMIT_UNIT, out))
    elif action != "status":
        raise JobError("admission action must be start, stop or status")
    _, active = ctl("is-active", ADMIT_UNIT)
    out = {"service": active, "hostname": socket.gethostname()}
    try:
        settings = _admission_settings()
        out["settings"] = "none" if settings is None else "valid"
    except JobError as e:
        settings, out["settings"] = None, "invalid: %s" % e
    if settings is not None:
        out["heartbeat_age"] = _heartbeat_age(Admission(settings))
    return out


PROBE_SCRIPT = r"""
d=/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup)
mkdir "$d/shim" "$d/job" && echo $$ > "$d/shim/cgroup.procs" && echo +memory > "$d/cgroup.subtree_control" &&
  echo 67108864 > "$d/job/memory.max" && echo 0 > "$d/job/memory.swap.max" && echo 1 > "$d/job/memory.oom.group" &&
  [ "$(cat "$d/job/memory.max")" = 67108864 ] && [ "$(cat "$d/job/memory.swap.max")" = 0 ] &&
  [ "$(cat "$d/job/memory.oom.group")" = 1 ] && [ -e "$d/job/memory.peak" ] && echo PROBE-OK
"""


def _scope_probe(env):
    """Why this host cannot give a job the scope admission relies on (docs/admission.md), or None."""
    if not os.path.exists("/sys/fs/cgroup/cgroup.controllers"):
        return "cgroup v2 is not mounted at /sys/fs/cgroup"
    unit = "agent-pueue-probe-%s.scope" % uuid.uuid4().hex[:12]
    try:
        # on stdin: systemd-run would rewrite "$$" in its arguments (environment expansion, systemd 254 and later)
        p = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--unit=" + unit, "-p", "Delegate=yes",
                            "-p", "OOMPolicy=continue", "--", "bash", "-s"], input=PROBE_SCRIPT,
                           env=env, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return "systemd-run failed: %s" % e
    finally:
        subprocess.run(["systemctl", "--user", "reset-failed", unit], env=env, capture_output=True, timeout=30)
    if "PROBE-OK" not in p.stdout:
        return ("a test scope could not set a RAM limit, no swap and whole-job kill on its job cgroup "
                "(systemd-run exit %d: %s)" % (p.returncode, (p.stdout + p.stderr).strip()[-300:] or "no output"))
    return None


HISTORY_FIELDS = ("token", "task", "session", "pueue_id", "submitted", "released", "started", "ended", "exit", "how",
                  "size", "size_source", "like_from", "pilot", "peak_cpu", "peak_ram", "memory_peak", "peak_gpu_mem",
                  "peak_samples", "peak_disk_mb_s", "projected_end", "ram_counted", "gpu_counted", "memory_max",
                  "resized")


def host_history(req):
    """This host's admission records, newest first, optionally for one task or session."""
    settings = _admission_settings()
    if settings is None:
        return {"admission": False, "hostname": socket.gethostname(), "jobs": []}
    where, vals = [], []
    for k in ("task", "session", "token"):
        if isinstance(req.get(k), str) and req[k]:
            where.append("%s = ?" % k)
            vals.append(req[k])
    limit = req.get("limit") if isinstance(req.get("limit"), int) and 0 < req["limit"] <= 10000 else 50
    con = Admission(settings).db()
    try:
        rows = con.execute("SELECT %s FROM jobs%s ORDER BY submitted DESC LIMIT %d" % (
            ", ".join(HISTORY_FIELDS), (" WHERE " + " AND ".join(where)) if where else "", limit), vals).fetchall()
    finally:
        con.close()
    jobs = []
    for r in rows:
        j = dict(zip(HISTORY_FIELDS, r))
        for k in ("size", "gpu_counted"):  # JSON objects; anything else in the row is read as missing
            try:
                j[k] = json.loads(j[k]) if j[k] else None
            except (TypeError, ValueError):
                j[k] = None
            if not isinstance(j[k], dict):
                j[k] = None
        try:
            j["resized"] = json.loads(j["resized"]) if j.get("resized") else None
        except (TypeError, ValueError):
            j["resized"] = None
        if not isinstance(j["resized"], list):
            j["resized"] = None
        jobs.append(j)
    return {"admission": True, "hostname": socket.gethostname(), "jobs": jobs}


HOST_OPS = {"submit": host_submit, "probe": host_probe, "ls": host_ls,
            "group": host_group, "kill": host_kill, "room": host_room, "admission": host_admission,
            "hold": host_hold, "history": host_history, "resize": host_resize, "log": host_log, "show": host_show,
            "resume": host_resume, "delivered": host_delivered}


def host_main(op):
    try:
        req = json.loads(sys.stdin.read() or "{}")
        if req.get("pueue_config"):  # tests: point the host side at a throwaway pueued
            os.environ["JOB_PUEUE_CONFIG"] = req["pueue_config"]
            global STATE_DIR, ADMISSION_CONFIG
            STATE_DIR = os.path.join(os.path.dirname(req["pueue_config"]), "state")
            # nor at the host's admission settings: a throwaway daemon is not admitted by the host's loop
            ADMISSION_CONFIG = os.path.join(os.path.dirname(req["pueue_config"]), "admission.json")
        if req.get("protocol") not in ACCEPTED_PROTOCOLS:
            raise JobError("protocol mismatch: client %s, host %s (job %s on %s); install the same "
                           "version on both (install.sh)" % (req.get("protocol"),
                                                             "/".join(str(p) for p in ACCEPTED_PROTOCOLS),
                                                             VERSION, socket.gethostname()))
        reply = {"ok": True, "data": HOST_OPS[op](req)}
    except NoRoom as e:
        reply = {"ok": False, "error": str(e), "kind": "no_room"}
    except JobError as e:
        reply = {"ok": False, "error": str(e)}
    except Exception as e:  # report, never hang the client
        reply = {"ok": False, "error": "%s: %s" % (type(e).__name__, e)}
    sys.stdout.write("\n" + json.dumps(reply) + "\n")
    return 0


# --------------------------------------------------------------------------
# client side
# --------------------------------------------------------------------------

class Unreachable(Exception):
    pass


def call(host, op, req, timeout=120):
    """Run a host op on `host` and return its data, raising JobError or Unreachable."""
    if host not in HOSTS:
        raise JobError("unknown host %r; known hosts: %s (add it to %s)" % (host, ", ".join(HOSTS), HOSTS_FILE))
    req = dict(req, protocol=_request_protocol(op, req))
    dest = HOSTS[host]
    if dest is None:
        try:
            return HOST_OPS[op](req)
        except OSError as e:
            raise JobError(str(e))
    if os.environ.get("JOB_REMOTE_PUEUE_CONFIG"):
        req["pueue_config"] = os.environ["JOB_REMOTE_PUEUE_CONFIG"]
    remote_cmd = "$HOME/.local/bin/job _host %s" % op
    try:
        p = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20",
             "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4",
             "-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/job-cm-%C", "-o", "ControlPersist=5m",
             dest, remote_cmd],
            input=json.dumps(req), capture_output=True, encoding="utf-8", errors="replace", timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Unreachable("ssh %s timed out after %ds" % (dest, timeout))
    except OSError as e:
        raise JobError("cannot run ssh: %s" % e)
    if p.returncode == 255:
        raise Unreachable("ssh %s: %s" % (dest, p.stderr.strip()[-500:]))
    reply = None
    for line in reversed(p.stdout.splitlines()):  # tolerate login noise before the reply
        if line.startswith("{"):
            try:
                reply = json.loads(line)
            except ValueError:
                reply = None
            break
    if not isinstance(reply, dict):
        text = (p.stderr or p.stdout).strip()[-800:]
        if (p.returncode == 2 and "usage:" in text) or p.returncode == 127:  # refused before it did anything
            raise JobError("%s: no reply from job on the host (exit %d): %s" % (host, p.returncode, text))
        raise Unreachable("%s: job on the host gave no reply (exit %d), so whether the request took effect is "
                          "unknown: %s" % (host, p.returncode, text))
    if not reply.get("ok"):
        err = reply.get("error") or ""
        if err.startswith("protocol mismatch"):
            raise ProtocolError("%s: %s" % (host, err))
        if reply.get("kind") == "no_room":
            raise NoRoom("%s: %s" % (host, err))
        raise JobError("%s: %s" % (host, err))
    return reply["data"]


def _session():
    for k in ("JOB_SESSION", "CLAUDE_CODE_HOST_SESSION_ID", "CLAUDE_CODE_SESSION_ID"):
        v = os.environ.get(k)
        if v:
            return v
    return "unknown"


def _parse_time(s):
    if not s:
        return None
    # pueue prints nanoseconds; Python before 3.11 wants at most microseconds
    try:
        head, frac_tz = s.split(".", 1)
        i = 0
        while i < len(frac_tz) and frac_tz[i].isdigit():
            i += 1
        s = head + "." + frac_tz[:i][:6].ljust(6, "0") + frac_tz[i:]
    except ValueError:
        pass
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def _fmt_dur(seconds):
    if seconds is None:
        return "?"
    seconds = float(seconds)
    if seconds < 90:
        return "%.0f s" % seconds
    if seconds < 5400:
        return "%.1f min" % (seconds / 60)
    if seconds < 172800:
        return "%.1f h" % (seconds / 3600)
    return "%.1f d" % (seconds / 86400)


def _fmt_et(t):
    """A time in this machine's local zone."""
    if t is None:
        return "?"
    return t.astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")


def _runtime(s):
    rec = s.get("exit_record") if isinstance(s.get("exit_record"), dict) else {}
    start, end = _parse_time(s.get("start")), _parse_time(rec.get("end") or s.get("end"))
    if start is None:
        return None
    end = end or dt.datetime.now(start.tzinfo)
    return (end - start).total_seconds()


def _parse_env(items):
    env = {}
    for it in items or []:
        if "=" in it:
            k, v = it.split("=", 1)
        else:
            k, v = it, os.environ.get(it)
            if v is None:
                raise JobError("--env %s: not set in this shell" % it)
        if not k or k.startswith("JOB_"):
            raise JobError("--env: bad variable name %r" % k)
        env[k] = v
    return env


def submit(args, command):
    """Queue the command, on args.host or, for auto, on the host admission places it on."""
    adm = _admission_request(args)
    if args.host == "auto":
        if adm is None:
            raise JobError("auto needs a size: --pilot, --like TOKEN, --small, or --cpus/--ram/--gpus/--gpu-mem")
        if getattr(args, "only_hosts", None):
            adm["hosts"] = args.only_hosts
        host, tid, token = place(args, command, adm)
        args.host = host
        return {"id": tid, "token": token}
    like = str((adm or {}).get("like") or "")
    if "#" in like and like.rsplit("#", 1)[0] != args.host:
        raise JobError("--like %s names a job on %s; submit to %s, or name the job by its token"
                       % (like, like.rsplit("#", 1)[0], like.rsplit("#", 1)[0]))
    tid, token = submit_to(args, args.host, command, adm)
    return {"id": tid, "token": token}


def submit_to(args, host, command, adm):
    """Queue on one host; retried safely when the connection drops (the token makes it idempotent)."""
    token = uuid.uuid4().hex
    req = {"command": command, "task": args.task, "group": args.group, "cwd": args.cwd,
           "session": _session(), "from": socket.gethostname(), "token": token,
           "env": _parse_env(args.env), "normal_priority": bool(args.normal_priority)}
    if adm is not None:
        req["admission"] = adm
    if args.cwd is None and HOSTS.get(host) is None:
        req["cwd"] = os.getcwd()
    last = None
    for attempt in range(4):
        try:
            r = call(host, "submit", req)
            if r.get("sized"):
                sys.stderr.write("job: %s\n" % r["sized"])
            args.held_reason = r.get("held_reason")
            args.held_hint = r.get("held_hint")
            return r["id"], r["token"]
        except Unreachable as e:
            last = e
            sys.stderr.write("job: %s unreachable while queueing (%s); retrying\n" % (host, e))
            time.sleep(15 * (attempt + 1))
    raise Unreachable("%s; the job may or may not have been queued: check 'job ls %s' for task %s"
                      % (last, host, args.task))


SIZE_UNITS = {"": 1, "K": 10 ** 3, "M": 10 ** 6, "G": 10 ** 9, "T": 10 ** 12,
              "KI": 1 << 10, "MI": 1 << 20, "GI": 1 << 30, "TI": 1 << 40}
HELD_NOTICE_S = 600


def _parse_size(text):
    """'20G' (10^9), '512Mi' (2^20), '1.5T' or plain bytes, to whole bytes."""
    t = text.strip().upper().rstrip("B")
    i = len(t)
    while i and not (t[i - 1].isdigit() or t[i - 1] == "."):
        i -= 1
    num, unit = t[:i], t[i:]
    try:
        value = float(num)
    except ValueError:
        value = None
    if value is None or unit not in SIZE_UNITS or value < 0:
        raise argparse.ArgumentTypeError("not a size: %r (examples: 20G, 512Mi, 1.5T)" % text)
    return int(value * SIZE_UNITS[unit])


def _admission_request(args):
    """The size and constraints the caller gave, or None when none were given."""
    a = {}
    for k in ("cpus", "ram", "gpus", "gpu_mem", "gpu_share", "like", "gpu_model", "data", "stop_at", "max_minutes"):
        v = getattr(args, k, None)
        if v is not None:
            a[k] = v
    for k in ("pilot", "small", "in_containers", "restartable"):
        if getattr(args, k, False):
            a[k] = True
    if getattr(args, "needs_path", None):
        a["needs_path"] = list(args.needs_path)
    if a.get("stop_at"):
        a["stop_at"] = _stop_at(a["stop_at"])
    return a or None


def _rooms(hosts, timeout=60, paths=()):
    """{host: snapshot or error text} from each host's admission loop, asked in parallel."""
    out = {}

    def ask(h):
        try:
            out[h] = call(h, "room", {"paths": list(paths)}, timeout=timeout)
        except (JobError, Unreachable) as e:
            text = str(e)
            # a host whose job predates `room` answers with argparse's usage error (exit 2)
            out[h] = "its job predates admission" if ("invalid choice" in text or "usage:" in text) else text

    threads = [threading.Thread(target=ask, args=(h,)) for h in hosts]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout + 5)
    return out


def _placement_hosts():
    names = ["local"] + [h for h in LISTED if h != "local"]
    if any(HOSTS.get(h) is None for h in names if h != "local"):
        names.remove("local")  # this machine is listed by its own name: ask it once
    return names


def place(args, command, adm):
    """`auto`: try each admission host with room now (fit_now), else hold the job on the best host."""
    names = _placement_hosts()
    rooms = _rooms(names, paths=[adm["data"]] if adm.get("data") else [])
    usable, skipped = [], []
    for h in names:
        r = rooms.get(h)
        if not isinstance(r, dict):
            skipped.append("%s (%s)" % (h, r))
        elif not r.get("admission"):
            continue
        elif r.get("stale") or not (r.get("room") or r.get("warmup")):
            skipped.append("%s (its admission loop is not running)" % h)
        else:
            usable.append(h)  # a host whose loop is still measuring can hold the job, not start it now
    if skipped:
        sys.stderr.write("job: auto skipped %s\n" % "; ".join(skipped))
    want_host = set(adm.pop("hosts", []) or [])
    like = str(adm.get("like") or "")
    if "#" in like:  # HOST#ID names a record on that host only
        want_host = (want_host & {like.rsplit("#", 1)[0]}) if want_host else {like.rsplit("#", 1)[0]}
    if want_host:
        usable = [h for h in usable if h in want_host]
    if not usable:
        raise JobError("no admission host is available for auto")

    def order(h):
        r = rooms[h]
        probe = {"size": _probe_size(adm), "pilot": bool(adm.get("pilot")), "constraints": adm}
        try:
            ok = fits(r["settings"], r["room"], probe)[0] if r.get("settings") else False
        except (KeyError, TypeError):
            ok = False
        return (not ok, -int(bool(adm.get("data")) and adm["data"] in (r.get("paths") or [])), len(r.get("held") or []))

    usable.sort(key=order)
    # A host's refusal (JobError) is definite, so the next host may be tried. Unreachable is not: the job may
    # have been queued there, so it is never sent to a second host.
    for h in usable:
        if not rooms[h].get("room"):
            continue
        try:
            tid, token = submit_to(args, h, command, dict(adm, fit_now=True))
            sys.stderr.write("job: auto placed the job on %s\n" % h)
            return h, tid, token
        except JobError:
            pass  # no room there now, or it refuses the job: try the next
    held_refused = []
    for h in usable:
        try:
            tid, token = submit_to(args, h, command, adm)
        except JobError as e:
            held_refused.append("%s: %s" % (h, e))
            continue
        sys.stderr.write("job: no host has room now; the job is held on %s until it fits\n" % h)
        return h, tid, token
    raise JobError("no admission host takes this job: %s" % "; ".join(held_refused))


def _probe_size(adm):
    small = {"cpus": 1.0, "ram": 4 * 10 ** 9}
    return {"cpus": float(adm.get("cpus") or small["cpus"]), "ram": int(adm.get("ram") or small["ram"]),
            "gpus": int(adm.get("gpus") or (1 if adm.get("gpu_mem") else 0)), "gpu_mem": int(adm.get("gpu_mem") or 0),
            "gpu_share": float(adm.get("gpu_share") or 0), "disk_mb_s": 0}


def cmd_hold(args):
    if args.renew:
        r = call(args.host, "hold", {"renew": args.renew})
    else:
        if not args.name or (args.gpu is None) != (args.mem is None) or (args.gpu is None and args.ram is None):
            raise JobError("job hold needs --name, and --gpu with --mem, --ram, or both (or --renew ID)")
        r = call(args.host, "hold", {"gpu": args.gpu, "mem": args.mem, "ram": args.ram, "name": args.name,
                                     "while_pid": args.while_pid, "unit": args.unit, "cgroup": args.cgroup,
                                     "ttl": args.ttl})
    if not args.renew and args.ram and not r.get("ram"):  # a host that predates RAM holds ignored --ram
        call(args.host, "hold", {"release": r["id"]})
        raise JobError("%s's job predates RAM holds (update it with install.sh); the hold was not kept" % args.host)
    print(r["id"])
    sys.stderr.write("job: hold %s %s on %s%s%s\n" % (r["id"], r["action"], args.host,
                                                     " GPU %s" % r["gpu"] if "gpu" in r else "",
                                                     " RAM %s" % _gbs(r["ram"]) if r.get("ram") else ""))
    return 0


def cmd_release(args):
    r = call(args.host, "hold", {"release": args.hold_id})
    sys.stderr.write("job: hold %s %s on %s\n" % (r["id"], r["action"], args.host))
    return 0


def cmd_resize(args):
    if args.ram is None and args.cpus is None:
        raise JobError("job resize needs --ram SIZE, --cpus N or both")
    try:
        r = call(args.host, "resize", {"id": args.id, "token": args.token, "ram": args.ram, "cpus": args.cpus})
    except JobError as e:
        if "invalid choice" in str(e) or "usage:" in str(e):
            raise JobError("%s's job predates job resize; update it with install.sh" % args.host)
        raise
    was, now = r["was"], r["size"]
    text = "%s#%s resized from %g CPU, %s RAM to %g CPU, %s RAM" % (
        args.host, args.id, was["cpus"], _gbs(was["ram"]), now["cpus"], _gbs(now["ram"]))
    if r["state"] == "held":
        text += "; it is still held and keeps its place in the queue"
        c = r.get("checked_against")
        if isinstance(c, dict):
            text += " (not under the RAM peak of %s of #%s, session %s, an earlier run of the task)" % (
                _gbs(c.get("peak_ram") or 0), c.get("id"), c.get("session") or "?")
    else:
        text += "; its RAM limit is now %s%s, and it is counted at that from the admission loop's next cycle" % (
            _gbs(r["memory_max"]), " (was %s)" % _gbs(r["was_memory_max"]) if r.get("was_memory_max") else "")
    print(text)
    return 0


def cmd_admission(args):
    r = call(args.host, "admission", {"action": args.action})
    age = r.get("heartbeat_age")
    print("%s: admission loop service %s; settings %s; heartbeat %s" % (
        args.host, r.get("service"), r.get("settings"), "none" if age is None else "%s old" % _fmt_dur(age)))
    return 0 if (args.action == "stop") == (r.get("service") != "active") else EXIT["WRAPPER_ERROR"]


def cmd_room(args):
    hosts = args.hosts or _placement_hosts()
    rooms = _rooms(hosts)
    if args.json:
        print(json.dumps(rooms, indent=1, default=str))
        return 0
    for h in hosts:
        r = rooms.get(h)
        if not isinstance(r, dict):
            print("%s: unreachable (%s)" % (h, r))
            continue
        if not r.get("admission"):
            print("%s: not an admission host" % h)
            continue
        if r.get("warmup") and not r.get("stale"):
            w = r["warmup"]
            print("%s: admission loop measuring the host first (%s of %s); nothing starts until then" % (
                h, _fmt_dur(w["covered_s"]), _fmt_dur(w["needed_s"])))
            continue
        if r.get("stale") or not r.get("room"):
            age = r.get("heartbeat_age")
            print("%s: admission loop not running%s" % (h, "" if age is None else " (heartbeat %s old)" % _fmt_dur(age)))
            continue
        room = r["room"]
        cap = r.get("capacity") or {}
        held = room["ram"].get("holds") or 0
        print("%s: snapshot %s old; CPU %.1f threads used or committed of %s, %.1f free to admit; RAM %s free to admit%s; "
              "memory pressure %.1f%%%s" % (h, _fmt_dur(r.get("heartbeat_age") or 0), room["cpu"]["outside"]
                                             + room["cpu"]["committed"], cap.get("threads", "?"),
                                             max(0.0, room["cpu"]["room"]), _gbs(max(0, room["ram"]["room"])),
                                             " (%s held for services)" % _gbs(held) if held else "", room["psi"],
                                             _psi_where(room) + ("; system-wide %.1f%%" % room["psi_system"]
                                                                 if room.get("psi_source") == "cgroups" else "")))
        for name, busy in sorted(room.get("disks", {}).items()):
            print("  disk %s busy %.0f%%" % (name, busy))
        for gid, g in sorted(room.get("gpus", {}).items(), key=lambda kv: kv[1]["index"]):
            print("  GPU %d %s: %s free to admit of %s; outside use %s; busy %.0f%%" % (
                g["index"], g["name"], _gbs(max(0, g["room"])), _gbs(g["total"]), _gbs(g["outside"]), g["util"]))
        for j in r.get("jobs") or []:
            end = j.get("projected_end")
            print("  running %s (%s): %g CPU, %s RAM%s%s%s%s" % (
                j["token"][:8], _shown_task(j["task"]), j["size"]["cpus"], _gbs(j["size"]["ram"]),
                (" (counted at %s, %s)" % (_gbs(j["ram_counted"]), "its use: the loop cut it to a soft limit"
                                           if j.get("memory_high") else "its limit")) if j.get("ram_counted") else "",
                "; peak %s" % _gbs(j["peak_ram"]) if j.get("peak_ram") else "",
                ", GPU %s" % ",".join(x[:12] for x in j["gpus"]) if j.get("gpus") else "",
                "; ends about %s" % dt.datetime.fromtimestamp(end).astimezone().strftime("%H:%M %Z") if end else ""))
            o = j.get("oversize")
            if isinstance(o, dict):
                print("    oversized: its RAM peaked at %s in %s, %.0f%% of its size of %s, and it is counted at %s; "
                      "shrink it with: job resize %s %s --token %s --ram %s" % (
                          _gbs(o["peak"]), _fmt_dur(o.get("after_s")), 100.0 * o["peak"] / max(1, o["size"]),
                          _gbs(o["size"]), _gbs(o["counted"]), h, j.get("id"), j["token"], o["suggest"]))
            u = j.get("undersized")
            if isinstance(u, dict):
                print("    undersized: %.0f%% of its time stalled against its own RAM limit of %s for %s (it uses %s, "
                      "file cache %s more); not host pressure, it holds no other job; to give it more, kill it and "
                      "submit it again with a larger --ram" % (
                          u["stall"], _gbs(u["limit"]), _fmt_dur(time.time() - (u.get("since") or time.time())),
                          _gbs(u["ram"]), _gbs(u["cache"])))
        for h2 in r.get("holds") or []:
            parts = (["%s on GPU %s" % (_gbs(h2.get("size") or 0), h2["index"])] if h2.get("index") is not None else []) + (
                ["%s of RAM" % _gbs(h2["ram"])] if h2.get("ram") else [])
            print("  hold %s (%s): %s" % (h2["id"], h2["name"], ", ".join(parts)))
        for j in r.get("held") or []:
            print("  held %s (%s) for %s: %s" % (j["token"][:8], _shown_task(j["task"]), _fmt_dur(j["waited_s"]),
                                                 j.get("reason") or "not checked yet"))
    return 0


def verdict_of(s):
    """Map a finished pueue task to (verdict, exit code)."""
    r, v = s.get("result"), s.get("result_value")
    if r == "Success":
        return "SUCCESS", 0
    if r == "Failed":
        try:
            return "FAILED", int(v)
        except (TypeError, ValueError):
            return "FAILED", 1
    if r == "Killed":
        return "KILLED", EXIT["KILLED"]
    if r == "FailedToSpawn":
        return "FAILED_TO_SPAWN", EXIT["FAILED_TO_SPAWN"]
    if r == "DependencyFailed":
        return "DEPENDENCY_FAILED", EXIT["DEPENDENCY_FAILED"]
    return "ERRORED", EXIT["ERRORED"]


def _gb(n):
    return "%.2f GB" % (n / 1e9)


def _shown_task(task, n=60):
    """A task id, which another session chose, as shown in a message: control characters removed, at most n
    characters."""
    t = re.sub(r"[\x00-\x1f\x7f-\x9f]", "", "?" if task is None else str(task))
    return t if len(t) <= n else t[:n - 3] + "..."


def scope_verdict(verdict, code, scope):
    """Adjust a finished job's verdict with how its scope ended. Returns (verdict, code, note or None)."""
    if not scope:
        return verdict, code, None
    how, limit = scope.get("how"), scope.get("memory_max")
    if how == "wrapper_error":
        return ("WRAPPER_ERROR", EXIT["WRAPPER_ERROR"],
                "the job's systemd scope could not be started (systemd-run exit %s), so the job never ran; "
                "systemd-run's message went to the job's log" % scope.get("rc"))
    if how == "setup_error":
        return ("WRAPPER_ERROR", EXIT["WRAPPER_ERROR"],
                "the job's memory limit could not be set up (%s), so the job never ran" % scope.get("reason"))
    if how == "memory_limit":
        return verdict, code, "it went over its RAM limit of %s; the whole job was stopped" % _gb(limit or 0)
    if how == "host_oom":
        return verdict, code, ("the host ran out of memory and its out-of-memory killer stopped the job, which was "
                               "under its RAM limit of %s; the whole job was stopped" % _gb(limit or 0))
    if how == "sigkill":
        return verdict, code, ("it ended with signal 9 and no out-of-memory event, so not by its RAM limit: "
                               "systemd-oomd under memory pressure, a person, or the job itself sent it")
    if how == "killed" and scope.get("stopped_by") == "pilot time limit":
        return "PILOT_TIME_LIMIT", EXIT["PILOT_TIME_LIMIT"], (
            "the admission loop stopped this pilot at its time limit, as planned (not an out-of-memory kill); its peaks "
            "are recorded, so size the next run with --like and this job's token, or --like last")
    if how == "killed" and scope.get("stopped_by") == "stop-at":
        return verdict, code, "the admission loop stopped it at its --stop-at time"
    if how == "scope_killed":
        return verdict, code, ("its whole scope was killed from outside, with its bookkeeping, for example by "
                               "systemd-oomd under memory pressure")
    notes = []
    ev = scope.get("memory_events") or {}
    if how == "exit" and (ev.get("oom_kill") or ev.get("oom_group_kill")):
        notes.append("after its command ended, a process it left running was killed for memory")
    elif how == "exit" and ev.get("oom"):
        notes.append("it reached its RAM limit of %s (allocations failed) but was not killed" % _gb(limit or 0))
    if scope.get("leftover"):
        notes.append("%d process(es) it left running were stopped when it ended" % scope["leftover"])
    return verdict, code, "; ".join(notes) or None


def _restart_verdict(verdict, code, note, s, host):
    """The verdict of a job the pueue daemon's stop ended or lost track of (killed_by "daemon" or "daemon-lost"):
    KILLED_BY_RESTART when the stop ended it; when the daemon died without stopping it, its real outcome from its
    own exit record once its command ended, UNTRACKED while its command still runs, and KILLED when its processes
    ended later without an exit record."""
    kb = s.get("killed_by")
    if verdict != "KILLED" or kb not in ("daemon", "daemon-lost"):
        return verdict, code, note
    d = s.get("daemon_start")
    when = " (it started again %s)" % _fmt_et(dt.datetime.fromtimestamp(d).astimezone()) if d else ""
    pids = s.get("alive_pids") or []
    tok = (" --token %s" % s["token"]) if s.get("token") else ""
    ref = "%s %s%s" % (host, s.get("id"), tok)

    def joined(*parts):
        return "; ".join(x for x in parts if x)
    lost = "the pueue daemon on %s stopped%s without stopping this job, so pueue lost track of it and lists it as " \
           "killed" % (host, when)
    rec = s.get("exit_record") if isinstance(s.get("exit_record"), dict) else None
    if kb == "daemon-lost" and rec is not None:
        stub = {"result": "Success" if rec.get("exit") == 0 else "Failed", "result_value": rec.get("exit")}
        verdict, code = verdict_of(stub)
        verdict, code, why_scope = scope_verdict(verdict, code, s.get("scope"))
        why = "%s; it ran on and ended on its own%s with exit code %s, from its own exit record" % (
            lost, (" at %s" % _fmt_et(_parse_time(rec.get("end")))) if rec.get("end") else "", rec.get("exit"))
        left = ("%d process(es) it left still run (pids %s); stop them with: job kill %s" % (
            len(pids), " ".join(map(str, pids)), ref)) if pids else None
        return verdict, code, joined(why_scope, why, left)
    if pids:
        why = ("%s, but %d of its processes still run (pids %s). Do not submit it again. To wait for them to end and "
               "get its real outcome: job wait %s (a wait after this one follows them); to stop them: job kill %s" % (
                   lost, len(pids), " ".join(map(str, pids)), ref, ref))
        return "UNTRACKED", EXIT["UNTRACKED"], joined(note, why)
    if kb == "daemon-lost":
        why = ("%s; its processes ran on but later ended without leaving an exit record, so something outside job "
               "killed them (not the restart). Read its log before submitting it again: job log %s" % (lost, ref))
        return "KILLED", EXIT["KILLED"], joined(note, why)
    why = ("it was still running when the pueue daemon on %s stopped%s; it did not end on its own. Submit it again; "
           "if jobs wait in a paused group, start it with: job resume %s --group %s" % (
               host, when, host, shlex.quote(str(s.get("group") or "default"))))
    return "KILLED_BY_RESTART", EXIT["KILLED_BY_RESTART"], joined(note, why)


def _lost_running(s):
    """Whether s is a job pueue lost track of whose command still runs (its processes live, no exit record)."""
    return (s.get("status") == "Done" and s.get("killed_by") == "daemon-lost" and bool(s.get("alive_pids"))
            and s.get("exit_record") is None)


def report(host, o, out):
    s, verdict, code = o["s"], o["verdict"], o["code"]
    label = s.get("label") or "-"
    head = "job: %s %s#%s (%s)" % (verdict, host, s.get("id"), label)
    if verdict in ("SUCCESS", "FAILED"):
        head += " exit %d" % code
    head += " after %s" % _fmt_dur(_runtime(s))
    lines = [head]
    if o.get("note"):
        lines.append("note: " + o["note"])
    if s.get("status"):
        lines.append("status: %s%s" % (s.get("status"), (" / %s" % s.get("result")) if s.get("result") else ""))
        lines.append("started: %s   ended: %s" % (
            _fmt_et(_parse_time(s.get("start"))),
            _fmt_et(_parse_time(s.get("end"))) if s.get("end") else "not ended"))
        if s.get("summary") or s.get("command"):
            lines.append("command: %s" % (s.get("summary") or s.get("command")))
        if s.get("log_path"):
            lines.append("log: %s:%s" % (host, s.get("log_path")))
    still = s.get("status") not in (None, "Done") or _lost_running(s)
    if verdict in ("ALERT", "STALLED") and s.get("status") == "Done" and not still:
        v, c, _ = scope_verdict(*verdict_of(s), s.get("scope"))
        v, c, _ = _restart_verdict(v, c, None, s, host)
        lines.append("the job has also ended: %s exit %d" % (v, c))
    if verdict in URGENT and still:
        tok = (" --token %s" % s["token"]) if s.get("token") else ""
        lines.append("the job was left %s; reattach: job wait %s %s%s ; stop it: job kill %s %s%s"
                     % ("running" if s.get("status") == "Running" or _lost_running(s)
                        else "as it is (%s)" % s.get("status"), host, s.get("id"), tok, host, s.get("id"), tok))
    tail = o.get("tail")
    if tail:
        lines.append("--- last %d log lines ---" % len(tail))
        lines.extend(tail)
        lines.append("--- end of log tail ---")
    out.write("\n".join(lines) + "\n")


def run_check(check, data, host, tid):
    env = dict(os.environ, JOB_HOST=host, JOB_ID=str(tid))
    try:
        p = subprocess.run([check], input=data, capture_output=True, env=env, timeout=300)
    except subprocess.TimeoutExpired:
        return False, "check script timed out after 300 s"
    except OSError as e:
        return False, "check script could not run: %s" % e
    msg = (p.stdout + p.stderr).decode("utf-8", "replace").strip()
    return p.returncode == 0, msg[-4000:] or ("check exited %d" % p.returncode)


class Waiter:
    """Follows one pueue task; step() returns None while it should keep waiting, else an outcome."""

    AGAIN = "again"  # more log output is waiting; step again before sleeping

    def __init__(self, host, tid, token=None, stall_min=30.0, stall_cpu=0.5, check=None,
                 from_start=False, tail=40, unreachable_min=15.0):
        self.host, self.tid, self.token = host, int(tid), token
        self.stall_s = stall_min * 60.0
        self.stall_cpu = stall_cpu / 100.0  # fraction of one core
        self.check, self.from_start, self.tail = check, from_start, tail
        self.unreachable_s = unreachable_min * 60.0
        self.offset = None
        self.partial = b""
        self.samples = []  # (monotonic time, log size, cpu ticks) while Running
        self.err_since = None
        self.told_queued = False
        self.told_notoken = False
        self.alert_cursor = None  # admission alerts already seen; a new wait starts at the current end
        self.told_held = None
        self.told_stale = False
        self.told_paused = False
        self.following = False  # following the processes of a job pueue lost track of
        self.told_untracked = False

    def _outcome(self, verdict, code, s, note=None, tail=True):
        """The verdict is already decided; a last probe only refreshes what is shown (status, tail). ended says
        whether the job had ended when the verdict was decided (a later probe may find it ended after a STALLED or
        ALERT verdict that said it was left running: that is not a report of its end)."""
        ended = not self.following and (verdict == "GONE" or (
            s.get("status") == "Done" and verdict not in ("UNTRACKED", "STALLED", "UNREACHABLE")))
        o = {"verdict": verdict, "code": code, "s": s, "note": note, "ended": ended}
        if tail and s.get("found"):
            try:
                fresh = call(self.host, "probe", {"id": self.tid, "token": self.token, "tail_lines": self.tail})
            except (JobError, Unreachable):
                fresh = None
            if fresh and fresh.get("found") and not fresh.get("token_mismatch"):
                o["s"], o["tail"] = fresh, fresh.get("tail")
        return o

    def _run_check(self, data, s):
        ok, msg = run_check(self.check, data, self.host, self.tid)
        if ok:
            return None
        return self._outcome("ALERT", EXIT["ALERT"], s, note="check %s failed: %s" % (self.check, msg))

    def step(self):
        req = {"id": self.tid, "token": self.token}
        if self.alert_cursor is not None:
            req["alert_cursor"] = self.alert_cursor
        if self.check and self.offset is not None:
            req["log_offset"] = self.offset
        try:
            s = call(self.host, "probe", req)
        except ProtocolError as e:
            return self._outcome("WRAPPER_ERROR", EXIT["WRAPPER_ERROR"], {"id": self.tid},
                                 note="%s. The job keeps running; after reinstalling, reattach with: "
                                      "job wait %s %s%s" % (e, self.host, self.tid,
                                                            (" --token %s" % self.token) if self.token else ""),
                                 tail=False)
        except (Unreachable, JobError) as e:
            if isinstance(e, JobError) and BAD_TOKEN_RX.search(str(e)):  # retrying cannot fix it
                return self._outcome("WRAPPER_ERROR", EXIT["WRAPPER_ERROR"], {"id": self.tid}, tail=False,
                                     note="%s; nothing was waited on" % e)
            now = time.monotonic()
            self.err_since = self.err_since or now
            if now - self.err_since >= self.unreachable_s:
                return self._outcome(
                    "UNREACHABLE", EXIT["UNREACHABLE"], {"id": self.tid},
                    note="no state from %s for %s (last error: %s). The job may still be running; "
                         "reattach with: job wait %s %s%s" % (
                             self.host, _fmt_dur(now - self.err_since), e, self.host, self.tid,
                             (" --token %s" % self.token) if self.token else ""), tail=False)
            sys.stderr.write("job: cannot get the state of %s#%s (%s); retrying\n" % (self.host, self.tid, e))
            return None
        self.err_since = None
        if not s.get("found") or s.get("token_mismatch"):
            why = ("task id %s on %s now belongs to a different job" % (self.tid, self.host)
                   if s.get("token_mismatch") else
                   "task %s no longer exists in pueue on %s" % (self.tid, self.host))
            if s.get("removed") and not s.get("token_mismatch"):
                at = dt.datetime.fromtimestamp(s["removed"]["at"]).astimezone().isoformat()
                stub = {"id": self.tid, "status": "Done", "end": at, "result": "Killed"}
                return self._outcome("KILLED", EXIT["KILLED"], stub, tail=False,
                                     note="removed from the queue by job kill before it ran")
            rec = s.get("record")
            if rec is not None:  # the job's own exit record survived pueue's cleanup
                stub = {"id": self.tid, "status": "Done", "end": rec["end"],
                        "result": "Success" if rec["exit"] == 0 else "Failed", "result_value": rec["exit"]}
                verdict, code = verdict_of(stub)
                verdict, code, why_scope = scope_verdict(verdict, code, rec.get("scope"))
                note = ("%s (its pueue entry was removed); the exit code comes from the job's own record; "
                        "the log is gone" % why)
                return self._outcome(verdict, code, stub, tail=False,
                                     note=(why_scope + ". " + note) if why_scope else note)
            return self._outcome("GONE", EXIT["GONE"], {"id": self.tid},
                                 note="%s; the job left no exit record (removed before it ran, or killed "
                                      "outright)" % why, tail=False)
        self.token = self.token or s.get("token")
        status, size = s.get("status"), s.get("log_size", 0)
        self.following = _lost_running(s) and (self.following or _untracked_told(self.token))
        if self.following:  # an earlier wait reported it UNTRACKED: wait for its processes as for a running job
            status = "Running"
            if not self.told_untracked:
                self.told_untracked = True
                sys.stderr.write("job: %s#%s: pueue lost track of it, but its processes still run (pids %s); waiting "
                                 "for them to end. Stop them with: job kill %s %s%s\n" % (
                                     self.host, self.tid, " ".join(map(str, s.get("alive_pids") or [])), self.host,
                                     self.tid, (" --token %s" % self.token) if self.token else ""))
        if "alert_count" in s:
            if self.alert_cursor is None:
                self.alert_cursor = s["alert_count"]
            elif s.get("alerts"):
                self.alert_cursor += len(s["alerts"])
                msgs = []
                for a in s["alerts"]:
                    m = a.get("message") or a.get("kind") or "?"
                    rs = a.get("resize") if isinstance(a.get("resize"), dict) else {}
                    rg = a.get("resume") if isinstance(a.get("resume"), dict) else {}
                    if rg.get("group"):  # the host's message names the machine; here it is named as job knows it
                        m = "held: its pueue group %s on %s is paused; start it with: %s" % (
                            rg["group"], self.host, _resume_command(rg["group"], self.host))
                    if rs.get("ram"):
                        m += " (exact command: job resize %s %s%s --ram %s)" % (
                            self.host, self.tid, (" --token %s" % self.token) if self.token else "", rs["ram"])
                    msgs.append(m)
                return self._outcome("ALERT", EXIT["ALERT"], s, note="admission: %s; the job keeps its place" %
                                     "; ".join(msgs))
        if status == "Stashed" and s.get("held"):
            now = time.monotonic()
            if self.told_held is None or now - self.told_held >= HELD_NOTICE_S:
                self.told_held = now
                hint = s.get("held_hint") if not getattr(self, "told_hint", False) else None
                self.told_hint = getattr(self, "told_hint", False) or bool(hint)  # the hint is said once
                sys.stderr.write("job: %s#%s held: %s%s\n" % (self.host, self.tid,
                                                               s.get("held_reason") or
                                                               "not looked at by the admission loop yet",
                                                               "; " + hint if hint else ""))
            if s.get("admission_stale") and not self.told_stale:
                self.told_stale = True
                return self._outcome("ALERT", EXIT["ALERT"], s, note="the admission loop on %s is not running, so "
                                     "the job stays held until it runs again" % self.host)

        if self.check:
            if self.offset is None:
                # first probe: start at the current end unless asked to read it all
                self.offset = 0 if self.from_start else size
                if self.offset < size:
                    return self.AGAIN
            elif s.get("new_bytes") is not None:
                data = self.partial + base64.b64decode(s["new_bytes"])
                self.offset = s["new_offset"]
                complete = status == "Done" and self.offset >= size
                cut = max(data.rfind(b"\n"), data.rfind(b"\r"))  # \r ends a progress-bar line
                if complete or len(data) - (cut + 1) > PARTIAL_MAX:
                    self.partial = b""
                else:  # hold back an unfinished last line until it is finished
                    self.partial, data = data[cut + 1:], data[:cut + 1]
                if data:
                    alert = self._run_check(data, s)
                    if alert:
                        return alert
                if self.offset < size:
                    return self.AGAIN
            if status == "Done" and self.partial:
                data, self.partial = self.partial, b""
                alert = self._run_check(data, s)
                if alert:
                    return alert

        if status == "Done":
            verdict, code = verdict_of(s)
            verdict, code, note = scope_verdict(verdict, code, s.get("scope"))
            verdict, code, note = _restart_verdict(verdict, code, note, s, self.host)
            return self._outcome(verdict, code, s, note=note)

        if status != "Running":  # queued, paused, stashed: not a stall
            self.samples = []
            if status in ("Queued", "Paused") and s.get("group_status") == "Paused" and not self.told_paused:
                self.told_paused = True
                g = shlex.quote(str(s.get("group")))
                return self._outcome("ALERT", EXIT["ALERT"], s, tail=False, note=(
                    "its group %s on %s is paused, so the job will not %s until the group is started again (a pueue "
                    "daemon restart pauses the groups that had running jobs). Start it with: job resume %s --group %s"
                    % (g, self.host, "start" if status == "Queued" else "go on", self.host, g)))
            running, limit = s.get("group_running") or 0, s.get("group_parallel") or 0
            if status == "Queued" and not self.told_queued and limit and running >= limit:
                self.told_queued = True
                sys.stderr.write("job: %s#%s is queued behind %s running job(s) in group %s (limit %s); "
                                 "it starts when one ends\n" % (self.host, self.tid, s.get("group_running"),
                                                                 s.get("group"), s.get("group_parallel")))
            return None
        if not self.token:  # started with plain pueue add: its processes cannot be found
            if not self.told_notoken:
                self.told_notoken = True
                sys.stderr.write("job: %s#%s was not started by job; stall detection is off for it\n"
                                 % (self.host, self.tid))
            return None
        now = time.monotonic()
        ticks = s.get("cpu_ticks")
        self.samples.append((now, size, ticks, s.get("runnable") or 0))
        if self.stall_s <= 0:
            return None
        base = None
        while len(self.samples) > 1 and self.samples[1][0] <= now - self.stall_s:
            self.samples.pop(0)
        if self.samples[0][0] <= now - self.stall_s:
            base = self.samples[0]
        if base is None or size != base[1]:
            return None
        if any(x[3] for x in self.samples):
            return None  # a process was running or waiting for a CPU: starved, not idle
        if ticks is None and any(x[2] is not None for x in self.samples):
            return None  # the processes just went away: the job is ending, or pueue has not noticed yet
        span = now - base[0]
        used = max(0, (ticks or 0) - (base[2] or 0)) / float(s.get("clk_tck") or 100)
        if used / span >= self.stall_cpu:
            return None
        what = ("its processes used %.2f%% of one CPU" % (100 * used / span) if ticks is not None
                else "no live process of the job was found")
        return self._outcome("STALLED", EXIT["STALLED"], s,
                             note="for %s the log did not grow and %s; the job was left running"
                                  % (_fmt_dur(span), what))


GOOD = ("SUCCESS", "PILOT_TIME_LIMIT")  # outcomes that do not end a wait on several jobs early
# the worst first: when several jobs ended badly, the wait reports the worst and exits with its code
SEVERITY = ("UNTRACKED", "WRAPPER_ERROR", "GONE", "UNREACHABLE", "STALLED", "ALERT", "KILLED_BY_RESTART")


def _severity(o):
    return SEVERITY.index(o["verdict"]) if o["verdict"] in SEVERITY else len(SEVERITY)


REPORTED_DIR = os.path.join(STATE_DIR, "reported")  # one empty file per job token whose end a wait here reported
UNTRACKED_DIR = os.path.join(STATE_DIR, "untracked")  # one per job token a wait here reported UNTRACKED
DELIVERED_TIMEOUT_S = 5  # the best-effort "delivered" mark after a report never holds the wait's exit longer
BAD_TOKEN_RX = re.compile(r"(^|: )bad token")  # a host's refusal of a token: fatal, not retried


def _prune(d, max_age):
    """Remove the marks in d older than max_age seconds."""
    cutoff = time.time() - max_age
    try:
        for name in os.listdir(d):
            p = os.path.join(d, name)
            try:
                if os.path.getmtime(p) < cutoff:
                    os.remove(p)
            except OSError:
                pass
    except OSError:
        pass


def _mark_in(d, token, max_age):
    if not _token_ok(token):
        return
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        _prune(d, max_age)
        with open(os.path.join(d, token), "w"):
            pass
    except OSError:
        pass  # job wait --mine may report it again: noise, never a lost verdict


def _mark_reported(token):
    # kept as long as a host keeps a job's records: a host whose "delivered" mark was not set (unreachable after the
    # report) still lists the job, and job wait --mine must not report it again
    _mark_in(REPORTED_DIR, token, SCRIPT_KEEP_DAYS * 86400)


def _reported(token):
    return _token_ok(token) and os.path.exists(os.path.join(REPORTED_DIR, token))


def _untracked_told(token):
    return _token_ok(token) and os.path.exists(os.path.join(UNTRACKED_DIR, token))


def _really_ended(o):
    """Whether the job of an outcome had ended when its verdict was decided (not a STALLED, ALERT, UNREACHABLE or
    UNTRACKED job that still runs)."""
    if "ended" in o:
        return o["ended"]
    return o["s"].get("status") == "Done" or o["verdict"] == "GONE"


def wait_all(host, waiters, poll=None, out=sys.stdout, notes=()):
    """Wait on one or more jobs (each waiter knows its host). A wait on several jobs ends as soon as one of them
    ends badly (any outcome not in GOOD), or when all have ended. Returns the exit code."""
    if poll is None:
        poll = min(POLL_REMOTE if HOSTS.get(w.host) else POLL_LOCAL for w in waiters)
    pending = list(waiters)
    done = []
    while pending:
        bad = []
        for w in list(pending):
            for _ in range(10000):
                o = w.step()
                if o != Waiter.AGAIN:
                    break
            if o is None or o == Waiter.AGAIN:
                continue
            pending.remove(w)
            done.append((w, o))
            if o["verdict"] not in GOOD:
                bad.append(o)
        if len(waiters) > 1 and bad:
            # the round is finished first: every job was looked at, so each knows its token for the reattach line,
            # and every job that has already ended is reported now, the worst first
            return _finish(waiters, done, pending, min(bad, key=_severity), out, notes)
        if pending:
            time.sleep(poll)
    return _finish(waiters, done, [], None, out, notes)


def _ref(w):
    return "%s#%s" % (w.host, w.tid)


def _keep_waiting(ws):
    """The exact commands that wait on these jobs again, one per host."""
    by = {}
    for w in ws:
        by.setdefault(w.host, []).append("%d:%s" % (w.tid, w.token) if w.token else str(w.tid))
    return " ; ".join("job wait %s %s" % (h, " ".join(ids)) for h, ids in by.items())


def _finish(waiters, done, pending, urgent, out, notes=()):
    """Print the report, then record what it reported: only once the whole report was written and flushed, so a
    report lost to a closed pipe, a full disk or a killed app is given again by the next wait."""
    import io
    buf = io.StringIO()
    code = _report_text(waiters, done, pending, urgent, buf, notes)
    try:
        out.write(buf.getvalue())
        out.flush()
    except (OSError, ValueError):
        return code
    delivered = {}
    for w, o in done:
        if _really_ended(o):
            _mark_reported(w.token)
            if _token_ok(w.token):
                delivered.setdefault(w.host, []).append(w.token)
        elif o["verdict"] == "UNTRACKED":
            _mark_in(UNTRACKED_DIR, w.token, SCRIPT_KEEP_DAYS * 86400)  # the next wait follows its processes
    _mark_delivered(delivered)
    return code


def _mark_delivered(delivered):
    """Tell each host which of its jobs' outcomes were reported (the host keeps them in pueue's list until then, for
    session-group cleanup), all hosts at once, waiting DELIVERED_TIMEOUT_S at most in all. Best effort: a host whose
    job predates the op, or that is unreachable or slow, keeps the jobs longer, and nothing is lost."""
    import threading

    def one(h, toks):
        try:
            call(h, "delivered", {"tokens": toks}, timeout=DELIVERED_TIMEOUT_S)
        except Exception:  # noqa: BLE001
            pass
    threads = [threading.Thread(target=one, args=(h, toks), daemon=True) for h, toks in delivered.items()]
    end = time.monotonic() + DELIVERED_TIMEOUT_S
    for t in threads:
        t.start()
    for t in threads:
        t.join(max(0.0, end - time.monotonic()))


def _report_text(waiters, done, pending, urgent, out, notes=()):
    if len(waiters) == 1:
        w, o = done[0]
        report(w.host, o, out)
        for n in notes:
            out.write("note: %s\n" % n)
        out.write(_last_line(o["verdict"], _ref(w), o["code"]))
        return o["code"]
    by_id = sorted(done, key=lambda wo: (wo[0].host, wo[0].tid))
    ended = sum(1 for _, o in done if _really_ended(o))
    counts = {}
    for _, o in by_id:
        counts[o["verdict"]] = counts.get(o["verdict"], 0) + 1
    count_text = ", ".join("%d %s" % (n, v) for v, n in sorted(counts.items()))
    hosts = sorted({w.host for w in waiters})
    if urgent:
        uw = next(w for w, o in done if o is urgent)
        code = urgent["code"]
        not_ended = [_ref(w) for w, o in by_id if not _really_ended(o)] + [_ref(w) for w in pending]
        out.write("job: %s %s; %d of %d jobs ended; not ended: %s\n" % (
            urgent["verdict"], _ref(uw), ended, len(waiters), " ".join(not_ended) or "none"))
        report(uw.host, urgent, out)
        if pending:
            out.write("keep waiting on the others with: %s\n" % _keep_waiting(pending))
        others = [wo for wo in by_id if wo[1] is not urgent]
        last = _last_line(urgent["verdict"], _ref(uw), code, "%d of %d jobs ended" % (ended, len(waiters)))
    else:
        bad = sorted((wo for wo in by_id if wo[1]["code"] != 0), key=lambda wo: _severity(wo[1]))
        code = bad[0][1]["code"] if bad else 0
        out.write("job: ALL ENDED %s: %s\n" % (", ".join(hosts), count_text))
        others = by_id
        if bad:
            last = _last_line(bad[0][1]["verdict"], _ref(bad[0][0]), code,
                              "all %d jobs ended: %s" % (len(waiters), count_text))
        else:
            last = _last_line("SUCCESS" if counts.get("SUCCESS") == len(waiters) else "ALL ENDED",
                              " ".join("%s#%s" % (h, ",".join(str(w.tid) for w, _ in by_id if w.host == h))
                                       for h in hosts), code)
    for w, o in others:
        out.write("\n")
        report(w.host, o, out)
    for n in notes:
        out.write("note: %s\n" % n)
    out.write(last)
    out.flush()
    return code


def _last_line(verdict, where, code, more=None):
    """The last line of a run or wait: the verdict, which job, and the exit code, so it survives `| tail`."""
    return "job: %s %s exit %d%s\n" % (verdict, where, code, " (%s)" % more if more else "")


QUEUED_HINT = None


def _command_from(args):
    if args.script:
        if args.command:
            raise JobError("give either --script FILE or a command after --, not both")
        with open(args.script, encoding="utf-8", errors="replace") as f:
            return f.read()
    cmd = list(args.command or [])
    if not cmd:
        raise JobError("no command given; put it after --, or use --script FILE")
    if len(cmd) == 1:
        return cmd[0]  # one argument: a shell command line
    return shlex.join(cmd)


def _check_ok(args):
    if getattr(args, "check", None):
        if not (os.path.isfile(args.check) and os.access(args.check, os.X_OK)):
            raise JobError("--check %s: not an executable file" % args.check)
        args.check = os.path.abspath(args.check)


CHECKS_DIR = os.path.join(STATE_DIR, "checks")  # --check scripts kept per job token, on the waiting machine


def _keep_check(token, path):
    """Keep a copy of a job's --check script, so a later `job wait` (after a restart cleared a temporary folder)
    still runs it. Copies older than SCRIPT_KEEP_DAYS are removed."""
    if not _token_ok(token) or not path:
        return
    try:
        os.makedirs(CHECKS_DIR, mode=0o700, exist_ok=True)
        cutoff = time.time() - SCRIPT_KEEP_DAYS * 86400
        for name in os.listdir(CHECKS_DIR):
            q = os.path.join(CHECKS_DIR, name)
            if os.path.getmtime(q) < cutoff:
                os.remove(q)
        dest = os.path.join(CHECKS_DIR, token)
        with open(path, "rb") as f:
            data = f.read()
        with open(dest + ".tmp", "wb") as f:
            f.write(data)
        os.chmod(dest + ".tmp", 0o700)
        os.replace(dest + ".tmp", dest)
    except OSError as e:
        sys.stderr.write("job: could not keep a copy of --check %s (%s); a later job wait needs --check again\n"
                         % (path, e))


def _kept_check(token):
    p = os.path.join(CHECKS_DIR, token) if _token_ok(token) else None
    return p if p and os.path.isfile(p) and os.access(p, os.X_OK) else None


def _waiter(args, tid, token, host=None):
    check = args.check
    if check:
        if not getattr(args, "check_kept", False):
            _keep_check(token, check)
    elif _kept_check(token):
        check = _kept_check(token)
        sys.stderr.write("job: %s#%s: using the --check script kept with the job (%s)\n" % (
            host or args.host, tid, check))
    return Waiter(host or args.host, tid, token=token, stall_min=args.stall, stall_cpu=args.stall_cpu,
                  check=check, from_start=getattr(args, "from_start", True), tail=args.tail)


def cmd_run(args, queue_only=False):
    command = _command_from(args)
    if not queue_only:
        _check_ok(args)
    sub = submit(args, command)
    tid, tok = sub["id"], sub["token"]
    if not queue_only and args.check:
        _keep_check(tok, args.check)  # before anything is printed: a wait lost from here on can reattach with it
        args.check_kept = True
    again = "job wait %s %s --token %s" % (args.host, tid, tok)
    global QUEUED_HINT
    QUEUED_HINT = "the job %s#%s was queued and keeps running; reattach with: %s" % (args.host, tid, again)
    if queue_only:
        print(tid)
        sys.stderr.write("job: queued %s#%s (%s). Wait on it with: %s\n" % (args.host, tid, args.task, again))
        if getattr(args, "held_reason", None):
            sys.stderr.write("job: %s#%s held: %s%s\n" % (args.host, tid, args.held_reason,
                                                         "; " + args.held_hint if getattr(args, "held_hint", None)
                                                         else ""))
        return 0
    sys.stderr.write("job: queued %s#%s (%s); waiting. If this wait is lost, reattach with: %s\n"
                     % (args.host, tid, args.task, again))
    sys.stderr.flush()
    args.from_start = True
    return wait_all(args.host, [_waiter(args, tid, tok)], poll=args.poll)


def _id_token(text):
    """ID or ID:TOKEN."""
    tid, _, tok = str(text).partition(":")
    try:
        tid = int(tid)
    except ValueError:
        raise JobError("%r is not a job id (ID or ID:TOKEN)" % text)
    if tok and not (len(tok) == 32 and all(c in "0123456789abcdef" for c in tok)):
        raise JobError("%r: the token after the colon is the 32-character token job printed" % text)
    return tid, tok or None


def _ls_hosts(hosts=None):
    """The hosts job ls and job wait --mine ask: each machine once (a listed name for this one replaces local)."""
    if hosts:
        return hosts
    here = [h for h in LISTED if h != "local" and HOSTS[h] is None]
    return [h for h in LISTED if not (h == "local" and here)]


def _ls_all(hosts):
    """{host: ls reply, or the exception}, asked in parallel."""
    results = {}

    def fetch(h):
        try:
            results[h] = call(h, "ls", {}, timeout=60)
        except (JobError, Unreachable) as e:
            results[h] = e

    threads = [threading.Thread(target=fetch, args=(h,)) for h in hosts]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return results


MINE_RECENT_S = 24 * 3600  # on a host that does not say which jobs were delivered: job wait --mine reports a job of
# the session that ended this recently, if not yet reported


def _unreported_end(s):
    """Whether job wait --mine reports this finished job of the session: no wait on this machine reported it, and its
    host says no wait marked it delivered, whatever its age (the host keeps it listed until one does). A host that does
    not say (it predates the "delivered" mark) is asked about the last MINE_RECENT_S only."""
    if _reported(s["token"]):
        return False
    if "delivered" in s:
        return not s["delivered"]
    rec = s.get("exit_record") if isinstance(s.get("exit_record"), dict) else {}
    end = _parse_time(rec.get("end") or s.get("end"))
    return bool(end) and (dt.datetime.now(end.tzinfo) - end).total_seconds() < MINE_RECENT_S


def cmd_wait_mine(args):
    """Wait on every unfinished job this session submitted, on every host, and report each of its finished jobs that
    no wait has reported (_unreported_end)."""
    me = _session()
    if me == "unknown":
        raise JobError("this shell has no session id (JOB_SESSION, or Claude Code's session variables), so --mine "
                       "cannot tell your jobs from others'; wait on them by id")
    hosts = _ls_hosts()
    results = _ls_all(hosts)
    waiters, notes, unlisted, ended = [], [], False, 0
    for h in hosts:
        r = results.get(h)
        if isinstance(r, Exception):
            notes.append("%s could not be listed (%s); its jobs are not in this wait" % (h, r))
            sys.stderr.write("job: %s\n" % notes[-1])  # now, not only when the wait ends
            unlisted = True
            continue
        for s in r["tasks"]:
            if s.get("session") != me or not s.get("token"):
                continue
            if s["status"] != "Done" or _lost_running(s):  # a job pueue lost track of runs until its processes end
                waiters.append(_waiter(args, s["id"], s["token"], host=h))
                continue
            if _unreported_end(s):
                waiters.append(_waiter(args, s["id"], s["token"], host=h))
                ended += 1
    if not waiters:
        print("job: no unfinished or unreported job of session %s on %s" % (me, ", ".join(hosts)))
        for n in notes:
            print("note: " + n)
        code = EXIT["UNREACHABLE"] if unlisted else 0
        print("job: %s exit %d" % ("UNREACHABLE" if unlisted else "NONE", code))
        return code
    sys.stderr.write("job: waiting on %d job(s) of session %s (%d of them ended and not reported yet): %s\n" % (
        len(waiters), me, ended, " ".join(_ref(w) for w in waiters)))
    return wait_all(None, waiters, poll=args.poll, notes=notes)


def cmd_wait(args):
    _check_ok(args)
    if args.mine:
        if args.host or args.ids or args.token:
            raise JobError("job wait --mine takes no host, id or --token")
        return cmd_wait_mine(args)
    if not args.host or not args.ids:
        raise JobError("job wait needs a host and at least one job id (or --mine)")
    if args.host not in HOSTS:
        raise JobError("unknown host %r; known hosts: %s (add it to %s)" % (args.host, ", ".join(HOSTS), HOSTS_FILE))
    pairs = [_id_token(x) for x in args.ids]
    if args.token:
        if len(pairs) != 1:
            raise JobError("--token goes with a single job id; for several, give each as ID:TOKEN")
        pairs = [(pairs[0][0], args.token)]
    return wait_all(args.host, [_waiter(args, tid, tok) for tid, tok in pairs], poll=args.poll)


def _history_size(j):
    """The SIZE text of a record in job history. A pilot is counted at, and limited to, the free room at its
    release, not at its size (which holds only its CPUs and GPU count; its RAM and GPU memory are placeholders).
    A job a person started while it was held was counted at its size, with no RAM limit and no GPUs."""
    z = j.get("size") if isinstance(j.get("size"), dict) else {}
    cpus, ngpu = z.get("cpus") or 0, z.get("gpus") or 0
    by_hand = j.get("ram_counted") is not None and j.get("memory_max") is None
    if not j.get("pilot"):
        rs = j.get("resized") if isinstance(j.get("resized"), list) else []
        hard = [r for r in rs if isinstance(r, dict) and isinstance(r.get("from"), dict)]
        first = hard[0]["from"] if hard else None
        soft = [r for r in rs if isinstance(r, dict) and isinstance(r.get("soft_limit"), dict)]
        cut = (", counted at %s by the loop (its use)" % _gbs(j.get("ram_counted") or 0)
               if soft and soft[-1]["soft_limit"].get("to") else "")
        return "%g CPU, %s%s%s%s%s" % (cpus, _gbs(z.get("ram") or 0), cut,
                                     ", %d GPU %s" % (ngpu, _gbs(z.get("gpu_mem") or 0)) if ngpu else "",
                                     ", not released by the loop" if by_hand else "",
                                     ", resized from %g CPU, %s" % (first.get("cpus") or 0, _gbs(first.get("ram") or 0))
                                     if first else "")
    base = "%g CPU%s" % (cpus, ", %d GPU" % ngpu if ngpu else "")
    if j.get("memory_max") is not None:  # released by the loop
        gc = j.get("gpu_counted")
        gc = [v for v in gc.values() if isinstance(v, (int, float))] if isinstance(gc, dict) else []
        gpus = (", %d GPU%s with %s" % (len(gc), "s" if len(gc) > 1 else "", " and ".join(_gbs(v) for v in gc))
                if gc else ", %d GPU" % ngpu if ngpu else "")
        rs = j.get("resized") if isinstance(j.get("resized"), list) else []
        soft = [r["soft_limit"] for r in rs if isinstance(r, dict) and isinstance(r.get("soft_limit"), dict)]
        if soft:  # cut by the loop to its use: counted at its soft limit
            return "%g CPU, %s%s, cut by the loop from %s, the free room at its release" % (
                cpus, _gbs(j.get("ram_counted") or 0), gpus, _gbs(j.get("memory_max") or 0))
        return "%g CPU, %s%s, the free room at its release" % (cpus, _gbs(j.get("ram_counted") or 0), gpus)
    if by_hand:
        return base + ", not released by the loop"
    if not j.get("released") and not j.get("started"):
        return base + (", never released" if j.get("how") else ", to be counted at the free room at its release")
    return base + ", room counted not recorded"


def cmd_history(args):
    hosts = args.hosts or _placement_hosts()
    req = {k: getattr(args, k) for k in ("task", "session", "token") if getattr(args, k)}
    req["limit"] = args.limit
    out = {}

    def fetch(h):
        try:
            out[h] = call(h, "history", req, timeout=60)
        except (JobError, Unreachable) as e:
            text = str(e)
            out[h] = "its job predates admission" if ("invalid choice" in text or "usage:" in text) else text
    threads = [threading.Thread(target=fetch, args=(h,)) for h in hosts]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    if args.json:
        print(json.dumps(out, indent=1, default=str))
        return 0

    def when(t):
        return dt.datetime.fromtimestamp(t).astimezone().strftime("%m-%d %H:%M") if t else "-"
    rows = []
    for h in hosts:
        r = out.get(h)
        if not isinstance(r, dict):
            sys.stderr.write("job: %s: %s\n" % (h, r))
            continue
        for j in r["jobs"]:
            size = _history_size(j)
            peaks = "-" if not j.get("peak_samples") else "%.1f CPU, %s%s (%d samples)" % (
                j.get("peak_cpu") or 0, _gbs(j.get("peak_ram") or 0),
                ", GPU %s" % _gbs(j["peak_gpu_mem"]) if j.get("peak_gpu_mem") else "", j["peak_samples"])
            state = j.get("how") or ("running" if j.get("started") else "held" if not j.get("released") else "released")
            if j.get("exit") not in (None, 0):
                state += " (exit %s)" % j["exit"]
            rows.append((h, str(j.get("pueue_id") or "-"), j.get("task") or "-", when(j.get("ended") or
                         j.get("started") or j.get("submitted")), state, "%s: %s" % (j.get("size_source"), size),
                         peaks, j.get("token") or ""))
    head = ("HOST", "ID", "TASK", "WHEN", "ENDED BY", "SIZE", "PEAKS", "TOKEN")
    if not rows:
        print("no records on the admission hosts asked")
        return 0
    widths = [max(len(r[i]) for r in rows + [head]) for i in range(len(head))]
    for r in [head] + rows:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip())
    return 0


def cmd_ls(args):
    if args.hosts:
        hosts = args.hosts
    else:  # each machine once: a listed name for this machine replaces "local"
        here = [h for h in LISTED if h != "local" and HOSTS[h] is None]
        hosts = [h for h in LISTED if not (h == "local" and here)]
    bad = [h for h in hosts if h not in HOSTS]
    if bad:
        raise JobError("unknown host(s) %s; known hosts: %s (add it to %s)" % (
            ", ".join(bad), ", ".join(HOSTS), HOSTS_FILE))
    results = {}

    def fetch(h):
        try:
            results[h] = call(h, "ls", {}, timeout=60)
        except (JobError, Unreachable) as e:
            results[h] = e

    threads = [threading.Thread(target=fetch, args=(h,)) for h in hosts]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    rows, unreachable = [], []
    for h in hosts:
        r = results.get(h)
        if isinstance(r, Exception):
            unreachable.append("%s: UNREACHABLE: %s" % (h, r))
            continue
        for s in r["tasks"]:
            if not args.all and s["status"] == "Done":
                end = _parse_time(s.get("end"))
                if end and (dt.datetime.now(end.tzinfo) - end).total_seconds() > args.recent * 3600:
                    continue
            state = s["status"]
            if state == "Done":
                v, c, n = scope_verdict(*verdict_of(s), s.get("scope"))
                v, c, _ = _restart_verdict(v, c, n, s, h)
                state = v if v != "FAILED" else "FAILED(%d)" % c
            what = (s.get("summary") or s.get("command") or "")[:60]
            if s.get("held"):
                state, what = "Held", "[%s] %s" % (s.get("held_reason") or "not checked yet", what)
            elif s.get("progress"):
                end = s.get("projected_end")
                what = "[%g of %g%s] %s" % (s["progress"][0], s["progress"][1], ", ends about %s" % dt.datetime.fromtimestamp(
                    end).astimezone().strftime("%Y-%m-%d %H:%M %Z") if end else "", what)
            rows.append((h, str(s["id"]), s.get("label") or "-", state, _fmt_dur(_runtime(s)),
                         s.get("group") or "", s.get("session") or "unknown", s.get("token") or "-", what))
    head = ("HOST", "ID", "TASK", "STATUS", "RUN TIME", "GROUP", "SESSION", "TOKEN", "COMMAND")
    if rows:
        widths = [max(len(r[i]) for r in rows + [head]) for i in range(len(head))]
        for r in [head] + rows:
            print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip())
    else:
        print("no jobs on the reachable hosts" + ("" if args.all else
              " (finished jobs older than %g h hidden; --all shows them)" % args.recent))
    for u in unreachable:
        print(u)
    return EXIT["UNREACHABLE"] if unreachable else 0


def _newer_op(host, op, req):
    """call() for an op added in job 0.8; a host running an older job says so instead of a usage error."""
    try:
        return call(host, op, req)
    except JobError as e:
        if "invalid choice" in str(e) or "usage:" in str(e):
            raise JobError("%s's job predates job %s; update it with install.sh" % (host, op))
        raise


def cmd_log(args):
    if args.lines < 1:
        raise JobError("--lines must be at least 1 (use --full for the whole log)")
    r = _newer_op(args.host, "log", {"id": args.id, "token": args.token, "lines": args.lines, "grep": args.grep,
                                     "full": bool(args.full)})
    if args.full:
        if r.get("cut"):
            sys.stderr.write("job: the log is %s; only its last %s follow (all of it: %s:%s)\n" % (
                _gbs(r["size"]), _gbs(LOG_FULL_MAX), args.host, r["log_path"]))
        sys.stdout.write(r.get("text") or "")
    else:
        for line in r.get("lines") or []:
            print(line)
        what = ("%d of %d lines matching %r" % (len(r["lines"]), r["matches"], args.grep) if args.grep is not None
                else "last %d lines" % len(r.get("lines") or []))
        sys.stderr.write("job: %s#%s (%s) %s; log %s:%s\n" % (args.host, args.id, r.get("status"), what, args.host,
                                                               r["log_path"]))
    return 0


def cmd_show(args):
    s = _newer_op(args.host, "show", {"id": args.id, "token": args.token})
    state = s.get("status")
    if state == "Done":
        v, c, note = scope_verdict(*verdict_of(s), s.get("scope"))
        v, c, note = _restart_verdict(v, c, note, s, args.host)
        state = "Done: %s exit %d%s" % (v, c, " (%s)" % note if note else "")
    adm = s.get("admission") or {}
    if s.get("held"):
        state += ", held: %s" % (s.get("held_reason") or "not looked at by the admission loop yet")
    rows = [("job", "%s#%s" % (args.host, s.get("id"))), ("task", s.get("label")), ("state", state),
            ("group", "%s (%s, %s at a time)" % (s.get("group"), s.get("group_status"), s.get("group_parallel"))),
            ("session", s.get("session")), ("token", s.get("token")),
            ("submitted from", s.get("submitted_from")), ("working directory", s.get("path")),
            ("queued", _fmt_et(_parse_time(s.get("enqueued_at"))) if s.get("enqueued_at") else None),
            ("started", _fmt_et(_parse_time(s.get("start"))) if s.get("start") else None),
            ("ended", _fmt_et(_parse_time(s.get("end"))) if s.get("end") else None),
            ("run time", _fmt_dur(_runtime(s)) if s.get("start") else None)]
    z = adm.get("size")
    if isinstance(z, dict):
        rows.append(("size", "%g CPU, %s RAM%s (%s%s)" % (
            z.get("cpus") or 0, _gbs(z.get("ram") or 0),
            ", %d GPU %s" % (z["gpus"], _gbs(z.get("gpu_mem") or 0)) if z.get("gpus") else "",
            "pilot" if adm.get("pilot") else adm.get("size_source") or "?",
            " %s" % adm["like_from"] if adm.get("like_from") else "")))
        if adm.get("memory_max"):
            rows.append(("RAM limit", _gbs(adm["memory_max"])))
    rows += [("log", "%s:%s" % (args.host, s.get("log_path"))), ("pueue runs", s.get("runner"))]
    for k, v in rows:
        if v is not None:
            print("%-18s %s" % (k + ":", v))
    cmd = s.get("full_command") or s.get("command") or ""
    print("command:")
    for line in cmd.rstrip("\n").splitlines() or [""]:
        print("  " + line)
    return 0


def cmd_resume(args):
    r = _newer_op(args.host, "resume", {"group": args.group})
    print("%s: group %s was %s, now %s; %d job(s) waiting in it" % (
        args.host, r["group"], r.get("was"), r.get("status"), r.get("waiting") or 0))
    return 0


def cmd_group(args):
    r = call(args.host, "group", {"name": args.name, "parallel": args.parallel})
    print("%s: group %s %s, runs %d at a time" % (args.host, r["name"],
                                                  "created" if r["created"] else "exists", r["parallel"]))
    return 0


def _kill_text(host, tid, r):
    text = "%s#%s %s" % (host, tid, r["action"])
    if r["action"].startswith("killed") and "left" in r:
        text += ": %d process(es) of the job were running" % r.get("processes", 0)
        text += ("; none is left" if not r["left"] else
                 "; %d still alive after SIGKILL: pids %s" % (len(r["left"]), " ".join(map(str, r["left"]))))
    return text


def cmd_kill(args):
    if args.task is None:
        if args.id is None:
            raise JobError("job kill needs a job id, or --task NAME")
        r = call(args.host, "kill", {"id": int(args.id), "token": args.token})
        print(_kill_text(args.host, args.id, r))
        if r.get("left"):
            sys.stdout.write(_last_line("WRAPPER_ERROR", "%s#%s" % (args.host, args.id), EXIT["WRAPPER_ERROR"],
                                        "%d process(es) of the job still alive after SIGKILL" % len(r["left"])))
            return EXIT["WRAPPER_ERROR"]
        return 0
    if args.id is not None or args.token:
        raise JobError("give a job id or --task NAME, not both")
    tasks = [s for s in call(args.host, "ls", {}, timeout=60)["tasks"]
             if s.get("label") == args.task and (s["status"] != "Done" or (
                 s.get("killed_by") == "daemon-lost" and s.get("alive_pids")))]
    if not tasks:
        print("%s: no unfinished job of task %s" % (args.host, args.task))
        return 0
    me = _session()
    others = [s for s in tasks if s.get("session") != me]
    if others and not args.all_sessions:
        raise JobError("task %s on %s has %d unfinished job(s) of other sessions (%s); nothing was killed. Add "
                       "--all-sessions to kill them too" % (args.task, args.host, len(others), ", ".join(
                           "#%s of %s" % (s["id"], s.get("session") or "unknown") for s in others)))
    # waiting jobs first: killing a running job frees its slot, and pueue would start a queued one in it
    tasks.sort(key=lambda s: (s["status"] in ("Running", "Paused", "Done"), int(s["id"])))
    failed = []
    for s in tasks:
        try:
            r = call(args.host, "kill", {"id": int(s["id"]), "token": s.get("token")})
            print(_kill_text(args.host, s["id"], r))
            if r.get("left"):
                failed.append("#%s left %d process(es) alive" % (s["id"], len(r["left"])))
        except JobError as e:
            print("%s#%s not killed: %s" % (args.host, s["id"], e))
            failed.append("#%s not killed" % s["id"])
    if failed:
        sys.stdout.write(_last_line("WRAPPER_ERROR", "%s task %s" % (args.host, _shown_task(args.task)),
                                    EXIT["WRAPPER_ERROR"], "; ".join(failed)))
        return EXIT["WRAPPER_ERROR"]
    return 0


HELP_RULES = """rules (docs/usage.md has the rest):
  - never pipe job run or job wait (| tail, | head, | grep): the pipe's exit code replaces the job's, and the
    verdict can be cut off. Use --tail N for fewer log lines. The first and the last line carry the verdict.
  - run job run / job wait in the background; their exit is the wake-up. Lost the wait? Reattach with
    job wait HOST ID --token T (job run printed it; job ls shows tokens), or after a restart of this machine or
    the app, job wait --mine: every unfinished job of this session on every host, and each that ended in the
    last 24 h with no wait here reporting it. --check scripts are kept.
  - a job without --group runs in your session's own group, as many at a time as the host's default group; it
    never waits behind another session's jobs. For a limit of your own: job group HOST NAME N, then --group NAME.
  - on admission hosts every job needs a size: best --pilot first, then --like TOKEN (or --like last).
  - job kill HOST ID also removes a queued or held job.
  - job log HOST ID, job show HOST ID and job resume HOST --group G instead of raw pueue (not on ssh's PATH).
"""

RUN_RULES = """never pipe it (| tail, | head, | grep): the pipe's exit code replaces the job's and the verdict can be
cut off; use --tail N. The first and the last line carry the verdict; the exit code is the job's own."""


def build_parser():
    p = argparse.ArgumentParser(prog="job", description="Run long jobs under pueue and wait on them correctly.",
                                epilog=HELP_RULES, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version="job %s" % VERSION)
    sub = p.add_subparsers(dest="cmd")
    p.intermixed = {}  # subcommands parsed with parse_intermixed_args (see main)

    def waitopts(q):
        q.add_argument("--stall", type=float, default=30.0, metavar="MIN",
                       help="end with STALLED after MIN minutes in which the log did not grow and the job "
                            "used less than --stall-cpu of one CPU (default 30; 0 turns it off)")
        q.add_argument("--stall-cpu", type=float, default=0.5, metavar="PCT",
                       help="CPU use, in percent of one core, below which the job counts as idle (default 0.5)")
        q.add_argument("--check", metavar="SCRIPT",
                       help="run SCRIPT on each new chunk of whole output lines (on stdin); nonzero exit "
                            "ends the wait with ALERT")
        q.add_argument("--poll", type=float, default=None, metavar="SEC",
                       help="seconds between probes (default %g local, %g remote)" % (POLL_LOCAL, POLL_REMOTE))
        q.add_argument("--tail", type=int, default=40, metavar="N",
                       help="log lines to print at the end (default 40); use this, never | tail")

    for name in ("run", "submit"):
        q = sub.add_parser(name, help="queue a command and wait for it" if name == "run" else "queue a command, print its id",
                           epilog=RUN_RULES if name == "run" else None)
        q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
        q.add_argument("task", help="the task id the job belongs to (becomes the pueue label)")
        q.add_argument("--group", default=None,
                       help="pueue group (create it with 'job group'); default: your session's own group, one job at "
                            "a time (sched on admission hosts)")
        q.add_argument("--cwd", default=None, help="working directory on the host (default: here for local, home for remote)")
        q.add_argument("--script", default=None, metavar="FILE", help="read the command from FILE instead of after --")
        q.add_argument("--env", action="append", metavar="NAME[=VALUE]",
                       help="pass this variable to the job (repeatable); only a small fixed set is passed otherwise")
        q.add_argument("--normal-priority", action="store_true",
                       help="run the job at normal CPU and disk priority instead of nice 19 / ionice idle")
        a = q.add_argument_group("size and constraints, for admission hosts and auto (docs/admission.md)")
        a.add_argument("--pilot", action="store_true", help="a first run to measure the job (time-limited)")
        a.add_argument("--max-minutes", type=int, default=None, metavar="N", help="a pilot's time limit")
        a.add_argument("--like", default=None, metavar="TOKEN|HOST#ID|last",
                       help="size it from that earlier job's peaks; last: the last good run of this task id there")
        a.add_argument("--small", action="store_true", help="the host's small size")
        a.add_argument("--cpus", type=float, default=None, metavar="N", help="CPU threads")
        a.add_argument("--ram", type=_parse_size, default=None, metavar="SIZE", help="RAM, e.g. 20G or 512Mi")
        a.add_argument("--gpus", type=int, default=None, metavar="N", help="GPUs on one host")
        a.add_argument("--gpu-mem", type=_parse_size, default=None, metavar="SIZE", help="GPU memory per GPU")
        a.add_argument("--gpu-share", type=float, default=None, metavar="PCT", help="share of the GPU's time")
        a.add_argument("--gpu-model", default=None, metavar="TEXT", help="only GPUs whose name contains TEXT")
        a.add_argument("--data", default=None, metavar="PATH", help="the data it reads (names its disk)")
        a.add_argument("--stop-at", default=None, metavar="TIME", help="stop it then (YYYY-MM-DDTHH:MM+-HH:MM)")
        a.add_argument("--in-containers", action="store_true", help="its work runs in containers")
        a.add_argument("--needs-path", action="append", metavar="PATH",
                       help="run only on a host where PATH exists (repeatable)")
        a.add_argument("--restartable", action="store_true", help="it may run on hosts that can be reclaimed")
        a.add_argument("--host", dest="only_hosts", action="append", default=None, metavar="NAME",
                       help="with auto: only this host (repeatable)")
        if name == "run":
            waitopts(q)

    q = p.intermixed["wait"] = sub.add_parser("wait", help="wait on one or more queued or finished jobs on one host",
                                              epilog=RUN_RULES)
    q.add_argument("host", nargs="?", default=None, help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("--mine", action="store_true",
                   help="every unfinished job this session submitted, on every host, and each that ended in the last "
                        "24 h with no wait on this machine reporting it (after a restart)")
    q.add_argument("ids", nargs="*", metavar="ID[:TOKEN]",
                   help="job ids; ID:TOKEN refuses an id that now belongs to another job")
    q.add_argument("--token", default=None, help="with one id: the token 'job submit' printed; refuses a reused id")
    q.add_argument("--from-start", action="store_true",
                   help="with --check: check the output already written too (default: only new output)")
    waitopts(q)

    q = sub.add_parser("ls", help="list jobs on all hosts")
    q.add_argument("hosts", nargs="*", help="hosts to list (default: all)")
    q.add_argument("--all", action="store_true", help="include finished jobs older than --recent")
    q.add_argument("--recent", type=float, default=24.0, metavar="H", help="hide finished jobs older than H hours (default 24)")

    q = sub.add_parser("hold", help="hold GPU memory or RAM for a service that runs outside job (first come)")
    q.add_argument("host", help="an admission host")
    q.add_argument("--gpu", default=None, metavar="INDEX|UUID", help="the card")
    q.add_argument("--mem", type=_parse_size, default=None, metavar="SIZE", help="GPU memory to hold")
    q.add_argument("--ram", type=_parse_size, default=None, metavar="SIZE", help="RAM to hold")
    q.add_argument("--name", default=None, help="who holds it")
    q.add_argument("--while-pid", type=int, default=None, metavar="PID", help="the hold ends when PID exits")
    q.add_argument("--unit", default=None, help="the service whose processes are the hold's own use")
    q.add_argument("--cgroup", default=None, metavar="PATH", help="the cgroup whose processes are its own use")
    q.add_argument("--ttl", type=float, default=None, metavar="MIN", help="it ends unless renewed within MIN minutes")
    q.add_argument("--renew", default=None, metavar="ID", help="renew hold ID's time to live")

    q = sub.add_parser("release", help="end a hold")
    q.add_argument("host", help="an admission host")
    q.add_argument("hold_id", metavar="ID")

    q = sub.add_parser("admission", help="start, stop or check a host's admission loop")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("action", choices=("start", "stop", "status"))

    q = sub.add_parser("history", help="admission records: sizes, peaks and how each job ended (newest first)")
    q.add_argument("hosts", nargs="*", help="hosts to ask (default: all)")
    q.add_argument("--task", default=None, help="only this task id")
    q.add_argument("--session", default=None, help="only this session")
    q.add_argument("--token", default=None, help="only this job")
    q.add_argument("--limit", type=int, default=50, help="records per host (default 50)")
    q.add_argument("--json", action="store_true", help="print the records as JSON")

    q = sub.add_parser("resize", help="change a held admitted job's size, or shrink a running one")
    q.add_argument("host", help="an admission host")
    q.add_argument("id", type=int)
    q.add_argument("--token", default=None, help="refuse if the id now belongs to another job")
    q.add_argument("--ram", type=_parse_size, default=None, metavar="SIZE", help="the new RAM size, e.g. 20G")
    q.add_argument("--cpus", type=float, default=None, metavar="N", help="the new CPU threads")

    q = sub.add_parser("room", help="free room on admission hosts")
    q.add_argument("hosts", nargs="*", help="hosts to show (default: all)")
    q.add_argument("--json", action="store_true", help="print the hosts' snapshots as JSON")

    q = sub.add_parser("group", help="create a group or set its parallel limit")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("name")
    q.add_argument("parallel", type=int)

    q = sub.add_parser("log", help="a job's output (default: its last 50 lines)")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("id", type=int)
    q.add_argument("--token", default=None, help="refuse if the id now belongs to another job")
    q.add_argument("--lines", type=int, default=50, metavar="N", help="how many lines (default 50)")
    q.add_argument("--grep", default=None, metavar="RE", help="only lines matching this regular expression (last N)")
    q.add_argument("--full", action="store_true", help="the whole log")

    q = sub.add_parser("show", help="everything about one job: command, task, group, size, state, times, token, log")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("id", type=int)
    q.add_argument("--token", default=None, help="refuse if the id now belongs to another job")

    q = sub.add_parser("resume", help="start a paused group again")
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("--group", required=True, help="the paused group")

    kill_help = "kill a running job (and every process it started) or remove a queued or held one"
    q = p.intermixed["kill"] = sub.add_parser("kill", help=kill_help, description=kill_help)
    q.add_argument("host", help="local, or a name from %s" % HOSTS_FILE)
    q.add_argument("id", type=int, nargs="?", default=None)
    q.add_argument("--token", default=None, help="refuse if the id now belongs to another job")
    q.add_argument("--task", default=None, metavar="NAME", help="every unfinished job of this task id on the host")
    q.add_argument("--all-sessions", action="store_true",
                   help="with --task: also other sessions' jobs (refused without it)")
    return p


def parse_args(argv):
    """(parser, args) for the arguments before any --."""
    parser = build_parser()
    if argv[:1] and argv[0] in parser.intermixed:
        # an optional positional (wait's host and ids, kill's id) followed by options and then more positionals
        # ("wait local --token T 5") parses only with intermixed parsing before Python 3.12
        args = parser.intermixed[argv[0]].parse_intermixed_args(argv[1:])
        args.cmd = argv[0]
    else:
        args = parser.parse_args(argv)
    return parser, args


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) == 2 and argv[0] == "_host" and argv[1] in HOST_OPS:
        return host_main(argv[1])
    if argv[:1] == ["_admit"] and set(argv[1:]) <= {"--once"}:
        try:
            return admit_main(once="--once" in argv)
        except JobError as e:
            sys.stderr.write("job _admit: %s\n" % e)
            return EXIT["WRAPPER_ERROR"]
    command = None
    if "--" in argv:  # everything after the first -- is the job's command, untouched
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    parser, args = parse_args(argv)
    args.command = command
    if command is not None and args.cmd not in ("run", "submit"):
        parser.error("only run and submit take a command after --")
    if not args.cmd:
        parser.print_help()
        return EXIT["USAGE"]
    if getattr(args, "host", None) is not None and args.host not in HOSTS:
        mine = [n for n in HOSTS if HOSTS[n] is None and n != "local"
                and n.split(".")[0].lower() == args.host.split(".")[0].lower()]
        if mine:  # this machine's name in another case, or its full name
            args.host = mine[0]
    auto = args.cmd in ("run", "submit") and args.host == "auto"  # admission chooses the host
    if getattr(args, "host", None) is not None and args.host not in HOSTS and not auto:
        sys.stdout.write("job: WRAPPER_ERROR unknown host %r; known hosts: %s (add it to %s)\njob: WRAPPER_ERROR exit %d\n"
                         % (args.host, ", ".join(HOSTS), HOSTS_FILE, EXIT["WRAPPER_ERROR"]))
        return EXIT["WRAPPER_ERROR"]
    tok = getattr(args, "token", None)
    if tok is not None and not _token_ok(tok):
        sys.stdout.write("job: WRAPPER_ERROR --token %r is not a job token: a token is the 32-character token job "
                         "printed (job ls shows it)\njob: WRAPPER_ERROR exit %d\n" % (str(tok)[:40], EXIT["WRAPPER_ERROR"]))
        return EXIT["WRAPPER_ERROR"]
    handlers = {"run": cmd_run, "submit": lambda a: cmd_run(a, queue_only=True), "wait": cmd_wait,
                "ls": cmd_ls, "group": cmd_group, "kill": cmd_kill, "room": cmd_room, "admission": cmd_admission, "history": cmd_history,
                "hold": cmd_hold, "release": cmd_release, "resize": cmd_resize, "log": cmd_log, "show": cmd_show,
                "resume": cmd_resume}
    try:
        return handlers[args.cmd](args)
    except NoRoom as e:  # a hold the host has no room for: the service refuses its load (other errors: its own guard)
        sys.stdout.write("job: NO_ROOM %s\njob: NO_ROOM exit %d\n" % (e, EXIT["NO_ROOM"]))
        return EXIT["NO_ROOM"]
    except JobError as e:
        sys.stdout.write("job: WRAPPER_ERROR %s\n%sjob: WRAPPER_ERROR exit %d\n" % (
            e, ("note: %s\n" % QUEUED_HINT) if QUEUED_HINT else "", EXIT["WRAPPER_ERROR"]))
        return EXIT["WRAPPER_ERROR"]
    except Unreachable as e:
        sys.stdout.write("job: UNREACHABLE %s\njob: UNREACHABLE exit %d\n" % (e, EXIT["UNREACHABLE"]))
        return EXIT["UNREACHABLE"]
    except KeyboardInterrupt:
        sys.stderr.write("job: interrupted; the job itself keeps running under pueue\n")
        return 130
    except Exception as e:  # never exit 1, which would look like the job's own exit 1
        sys.stdout.write("job: WRAPPER_ERROR internal error %s: %s\n%sjob: WRAPPER_ERROR exit %d\n"
                         % (type(e).__name__, e, ("note: %s\n" % QUEUED_HINT) if QUEUED_HINT else "",
                            EXIT["WRAPPER_ERROR"]))
        return EXIT["WRAPPER_ERROR"]


if __name__ == "__main__":
    sys.exit(main())
